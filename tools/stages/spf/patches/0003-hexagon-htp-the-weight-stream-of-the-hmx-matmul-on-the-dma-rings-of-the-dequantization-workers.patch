diff --git a/ggml/src/ggml-hexagon/htp/hmx-mm-kernels-tiled.h b/ggml/src/ggml-hexagon/htp/hmx-mm-kernels-tiled.h
index 48390a0311688751e3337847921e32bbd4e7cd75..c1f3f9a33f01648d0c79ff117ecfdd27456492b8 100644
--- a/ggml/src/ggml-hexagon/htp/hmx-mm-kernels-tiled.h
+++ b/ggml/src/ggml-hexagon/htp/hmx-mm-kernels-tiled.h
@@ -506,6 +506,81 @@ static void dequantize_tiled_weight_to_fp16_task_q8_0(
     }
 }
 
+// One Q8_0 tile of the packed layout from its 8 vectors of int8 values and the vector whose first 64 bytes are its 32
+// f16 scales: the arithmetic of dequantize_tiled_weight_to_fp16_task_q8_0, thus the f16 tile has the same bits.
+static inline __attribute__((always_inline)) void dequantize_q8_0_packed_tile(const HVX_Vector vq[8], HVX_Vector v_sc,
+                                                                              __fp16 * dst_ptr) {
+    const HVX_Vector v_scale_duplicated = Q6_V_lo_W(Q6_W_vshuff_VVR(v_sc, v_sc, -2));
+#pragma unroll
+    for (int g = 0; g < 8; g++) {
+        HVX_VectorPair vp = Q6_Wh_vunpack_Vb(vq[g]);
+        hvx_vmem(dst_ptr + (2 * g + 0) * 64) =
+            Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(Q6_Vhf_equals_Vh(Q6_V_lo_W(vp)), v_scale_duplicated));
+        hvx_vmem(dst_ptr + (2 * g + 1) * 64) =
+            Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(Q6_Vhf_equals_Vh(Q6_V_hi_W(vp)), v_scale_duplicated));
+    }
+}
+
+// The task of dequantize_tiled_weight_to_fp16_task_q8_0 for the packed layout: tile t starts at t * tile_size (1088
+// bytes) in a buffer that starts at a vector edge, thus an even tile starts at a vector edge and an odd tile 64 bytes
+// after one. Two tiles from an even tile are 17 vectors (2176 bytes): the task reads them with 17 aligned loads, and
+// puts the vectors of the odd tile together with valign. A tile with no partner in the range (an odd first tile, an
+// even last tile) goes alone. The scales of a lone odd tile end 64 bytes before the end of its last aligned vector: the
+// start of the next tile, or the pad of the buffer after the last tile (a buffer holds its tiles at the pitch
+// aligned_tile_size). The loops have a fixed count and the compiler unrolls them: the kernel lab measures 144 cycles
+// for each tile when the 8 vectors of a tile go to the stack, against 72 for the aligned task. The shuffle uses only
+// the scales. O(tiles).
+static void dequantize_tiled_weight_to_fp16_task_q8_0_packed(
+        const tiled_dequantize_state_t *state,
+        uint32_t start_tile, uint32_t end_tile) {
+
+    uint32_t t = start_tile;
+    while (t < end_tile) {
+        const uint8_t * tile_src = state->src + (size_t) t * state->tile_size;
+        __fp16 *        dst_ptr  = state->dst + t * HTP_MM_HMX_TILE_N_ELMS;
+        const uint32_t  off      = (uint32_t) ((uintptr_t) tile_src & (VLEN - 1));
+        HVX_Vector      vq[8];
+
+        if (off == 0 && t + 1 < end_tile) {
+            const HVX_Vector * a = (const HVX_Vector *) tile_src;
+            HVX_Vector         v[17];
+#pragma unroll
+            for (int i = 0; i < 17; i++) {
+                v[i] = a[i];
+            }
+            dequantize_q8_0_packed_tile(v, v[8], dst_ptr);
+#pragma unroll
+            for (int g = 0; g < 8; g++) {
+                vq[g] = Q6_V_valign_VVR(v[g + 9], v[g + 8], 64);
+            }
+            dequantize_q8_0_packed_tile(vq, Q6_V_vror_VR(v[16], 64), dst_ptr + HTP_MM_HMX_TILE_N_ELMS);
+            t += 2;
+            continue;
+        }
+
+        HVX_Vector v_sc;
+        if (off == 0) {
+#pragma unroll
+            for (int g = 0; g < 8; g++) {
+                vq[g] = hvx_vmem(tile_src + g * 128);
+            }
+            v_sc = hvx_vmem(tile_src + 1024);
+        } else {
+            const HVX_Vector * base = (const HVX_Vector *) (tile_src - off);
+            HVX_Vector         prev = base[0];
+#pragma unroll
+            for (int g = 0; g < 8; g++) {
+                const HVX_Vector next = base[g + 1];
+                vq[g]                 = Q6_V_valign_VVR(next, prev, off);
+                prev                  = next;
+            }
+            v_sc = Q6_V_valign_VVR(base[9], prev, off);
+        }
+        dequantize_q8_0_packed_tile(vq, v_sc, dst_ptr);
+        t++;
+    }
+}
