+// ---- The weight stream of the pipelined loop for Q8_0 weights (HTP_MM_WSTREAM_PACKED and HTP_MM_WSTREAM_RINGS)
+//
+// With RINGS, worker w of the dequantization owns the tiles [w * per, (w + 1) * per) of each chunk, where per is its
+// share of a full chunk. For a chunk it waits for its tiles on its own DMA ring (ctx->dma[w]: worker w is thread w of
+// the work queue, and the op thread is worker 0), dequantizes them, and then moves its tiles of the chunk two steps
+// later into the same bytes of the raw buffer. Only the last chunk can have fewer tiles, and a chunk two steps later
+// exists only when this chunk is not the last, thus a worker writes only bytes of its own range, which no other worker
+// reads. The pushes and the pops of one ring are in chunk order, thus each pop gets the transfer of its own chunk. No
+// other phase of the loop has a transfer in flight on these rings (the activation transfer ends before the loop, and
+// the output transfer uses no DMA).
+
+typedef struct {
+    struct htp_context *     ctx;
+    tiled_dequantize_state_t dq;          // src: the raw buffer of the chunk, dst: its f16 buffer, n_tot_tiles: its tiles
+    uint32_t                 per;         // the tiles of each worker in a full chunk
+    uint8_t *                raw[2];      // the raw buffers of the prologue
+    const uint8_t *          src[2];      // the first tile in DDR of each chunk of the prologue, or NULL
+    uint32_t                 tiles[2];    // the tiles of each chunk of the prologue
+    const uint8_t *          next_src;    // the first tile in DDR of the chunk two steps later, or NULL
+    uint32_t                 next_tiles;  // the tiles of that chunk
+} hmx_wring_state_t;
+
+// The tile range of worker i in a chunk of n_tiles tiles. O(1).
+static inline void hmx_wring_range(uint32_t per, uint32_t n_tiles, unsigned int i, uint32_t * lo, uint32_t * hi) {
+    const uint32_t a = i * per;
+    const uint32_t b = a + per;
+    *lo = a < n_tiles ? a : n_tiles;
+    *hi = b < n_tiles ? b : n_tiles;
+}
+
+// Push the tiles [lo, hi) of a chunk as one row at the pitch tile_size. A range with no tile gives no transfer. O(1).
+static inline void hmx_wring_push(dma_queue * q, uint8_t * raw, const uint8_t * src, uint32_t lo, uint32_t hi,
+                                  uint32_t tile_size) {
+    if (hi <= lo) {
+        return;
+    }
+    const size_t off   = (size_t) lo * tile_size;
+    const size_t bytes = (size_t) (hi - lo) * tile_size;
+    dma_queue_push(q, dma_make_ptr(raw + off, src + off), bytes, bytes, bytes, 1);
+}
+
+// The prologue: each worker moves its tiles of the first two chunks on its own ring.
+static void hmx_wring_prologue_worker(unsigned int n, unsigned int i, void * data) {
+    (void) n;
+    hmx_wring_state_t * st = (hmx_wring_state_t *) data;
+    for (int c = 0; c < 2; c++) {
+        if (st->src[c]) {
+            uint32_t lo, hi;
+            hmx_wring_range(st->per, st->tiles[c], i, &lo, &hi);
+            hmx_wring_push(st->ctx->dma[i], st->raw[c], st->src[c], lo, hi, st->dq.tile_size);
+        }
+    }
+}
+
+// One chunk step of one worker: wait for its tiles, dequantize them, and move its tiles of the chunk two steps later.
+// O(tiles of the worker).
+static void hmx_wring_step_worker(unsigned int n, unsigned int i, void * data) {
+    (void) n;
+    hmx_wring_state_t *       st = (hmx_wring_state_t *) data;
+    struct htp_thread_trace * tr = &st->ctx->trace[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_W_DEQUANT, i);
+    uint32_t lo, hi;
+    hmx_wring_range(st->per, st->dq.n_tot_tiles, i, &lo, &hi);
+    if (hi > lo) {
+        dma_queue_pop(st->ctx->dma[i]);
+        dequantize_tiled_weight_to_fp16_task_q8_0_packed(&st->dq, lo, hi);
+    }
+    if (st->next_src) {
+        uint32_t nlo, nhi;
+        hmx_wring_range(st->per, st->next_tiles, i, &nlo, &nhi);
+        hmx_wring_push(st->ctx->dma[i], (uint8_t *) st->dq.src, st->next_src, nlo, nhi, st->dq.tile_size);
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_W_DEQUANT, i);
+}
+
+// The pipelined loop of one Q8_0 weight for one block of rows, with the weight stream mode (PACKED or RINGS), for
+// hmx_mm_2d_f32 and hmx_mm_nx_2d_f32. The order of the HMX jobs and of the output transfers is that of the TILES loop
+// of those functions, and the f16 tiles have the same bits, thus the output has the bits of that loop.
+// weight: the first tile of the weight in DDR, n: its columns, weight_stride: the bytes of one column in the tiled
+// layout, raw: the two raw buffers, wbuf: the two f16 buffers, obuf: the two output buffers, dst_rows and src2_rows:
+// the first row of the block in dst and in src2 (or NULL). O(n * k) bytes through the DMA.
+static void hmx_mm_q8_0_stream(struct htp_context * ctx, int mode, const uint8_t * weight, size_t n,
+                               size_t weight_stride, int k, int n_k_tiles, struct fastdiv_values n_k_tiles_div,
+                               size_t row_stride, size_t n_chunk_n_cols, int n_threads, __fp16 * raw[2],
+                               void * wbuf[2], void * obuf[2], __fp16 * act, __fp16 * scales, size_t n_rows,
+                               float * dst_rows, const float * src2_rows, size_t dst_stride, uint32_t src2_stride,
+                               int dst_cols, hmx_matmul_job_t job_slots[2]) {
+    const uint32_t tile_size   = HTP_MM_WEIGHT_TILE_SIZE_Q8_0;
+    const int      n_chunk_cnt = hmx_ceil_div(n, n_chunk_n_cols);
+    const uint32_t full_tiles  = (uint32_t) (n_chunk_n_cols / HTP_MM_HMX_TILE_N_COLS) * (uint32_t) n_k_tiles;
+
+    // The first tile in DDR and the tile count of chunk c
+#define WS_SRC(c)   (weight + (size_t) (c) * n_chunk_n_cols * weight_stride)
+#define WS_TILES(c) ((uint32_t) (hex_smin(n - (size_t) (c) * n_chunk_n_cols, n_chunk_n_cols) / HTP_MM_HMX_TILE_N_COLS) * \
+                     (uint32_t) n_k_tiles)
+
+    hmx_wring_state_t st;
+    memset(&st, 0, sizeof(st));
+    st.ctx                  = ctx;
+    st.per                  = (full_tiles + (uint32_t) n_threads - 1) / (uint32_t) n_threads;
+    st.dq.ctx               = ctx;
+    st.dq.traces            = ctx->trace;
+    st.dq.tile_size         = tile_size;
+    st.dq.aligned_tile_size = HTP_MM_WEIGHT_ALIGNED_TILE_SIZE_Q8_0;
+    st.dq.n_k_tiles         = n_k_tiles;
+    st.dq.n_k_tiles_div     = n_k_tiles_div;
+    st.dq.k_block           = k;
+    st.dq.row_stride        = row_stride;
+    st.dq.weight_type       = HTP_TYPE_Q8_0;
+
+    if (mode == HTP_MM_WSTREAM_RINGS) {
+        st.raw[0]   = (uint8_t *) raw[0];
+        st.raw[1]   = (uint8_t *) raw[1];
+        st.src[0]   = WS_SRC(0);
+        st.tiles[0] = WS_TILES(0);
+        st.src[1]   = n_chunk_cnt > 1 ? WS_SRC(1) : NULL;
+        st.tiles[1] = n_chunk_cnt > 1 ? WS_TILES(1) : 0;
+        worker_pool_run_func(ctx->worker_pool, hmx_wring_prologue_worker, &st, n_threads);
+    } else {
+        hmx_wring_push(ctx->dma[0], (uint8_t *) raw[0], WS_SRC(0), 0, WS_TILES(0), tile_size);
+        if (n_chunk_cnt > 1) {
+            hmx_wring_push(ctx->dma[0], (uint8_t *) raw[1], WS_SRC(1), 0, WS_TILES(1), tile_size);
+        }
+    }
+
+    for (int i = 0; i < n_chunk_cnt; ++i) {
+        const size_t nc     = (size_t) i * n_chunk_n_cols;
+        const size_t n_cols = hex_smin(n - nc, n_chunk_n_cols);
+
+        if (mode == HTP_MM_WSTREAM_RINGS) {
+            st.dq.src         = (const uint8_t *) raw[i % 2];
+            st.dq.dst         = (__fp16 *) wbuf[i % 2];
+            st.dq.n_cols      = (uint32_t) n_cols;
+            st.dq.n_tot_tiles = WS_TILES(i);
+            st.next_src       = i + 2 < n_chunk_cnt ? WS_SRC(i + 2) : NULL;
+            st.next_tiles     = i + 2 < n_chunk_cnt ? WS_TILES(i + 2) : 0;
+            worker_pool_run_func(ctx->worker_pool, hmx_wring_step_worker, &st, n_threads);
+        } else {
+            void * curr_raw = dma_queue_pop(ctx->dma[0]).dst;
+            dequantize_tiled_weight_chunk_to_fp16_tiles(ctx, (__fp16 *) wbuf[i % 2], curr_raw, (int) n_cols, k,
+                                                        row_stride, HTP_TYPE_Q8_0, n_k_tiles, n_k_tiles_div,
+                                                        dequantize_tiled_worker_loop_q8_0_packed, n_threads);
+            if (i + 2 < n_chunk_cnt) {
+                hmx_wring_push(ctx->dma[0], (uint8_t *) curr_raw, WS_SRC(i + 2), 0, WS_TILES(i + 2), tile_size);
+            }
+        }
+
+        hmx_matmul_job_init(&job_slots[i % 2], (__fp16 *) obuf[i % 2], act, (__fp16 *) wbuf[i % 2], scales,
+                            hmx_ceil_div(n_rows, HTP_MM_HMX_TILE_N_ROWS), hmx_ceil_div(n_cols, HTP_MM_HMX_TILE_N_COLS),
+                            k / HTP_MM_HMX_TILE_N_ROWS);
+        hmx_queue_push(ctx->hmx_queue, hmx_queue_make_desc(hmx_matmul_worker_fn, &job_slots[i % 2]));
+
+        if (i > 0) {
+            hmx_queue_pop(ctx->hmx_queue);
+            const size_t nc_prev     = nc - n_chunk_n_cols;
+            const size_t n_cols_prev = hex_smin(n - nc_prev, n_chunk_n_cols);
+            const int    cols        = dst_cols - (int) nc_prev;
