+// The task of dequantize_tiled_weight_to_fp16_task_q8_0 for the packed layout: tile t starts at t * tile_size
+// (1088 bytes), thus an odd tile starts 64 bytes after a vector edge and each load is an unaligned load. The
+// arithmetic and the order of the stores are those of the aligned task, thus the f16 tiles have the same bits. The
+// load of the scales reads the 64 bytes after the scales of a tile: the start of the next tile, or the pad of the
+// buffer after the last tile (a buffer holds its tiles at the pitch aligned_tile_size). The shuffle uses only the
+// scales. O(tiles).
+static void dequantize_tiled_weight_to_fp16_task_q8_0_packed(
+        const tiled_dequantize_state_t *state,
+        uint32_t start_tile, uint32_t end_tile) {
+
+    for (uint32_t t = start_tile; t < end_tile; t++) {
+        const uint8_t * tile_src = state->src + (size_t) t * state->tile_size;
+        __fp16 * dst_ptr = state->dst + t * HTP_MM_HMX_TILE_N_ELMS;
+
+        HVX_Vector v_sc = *(const HVX_UVector *) (tile_src + 1024);
+        HVX_Vector v_scale_duplicated = Q6_V_lo_W(Q6_W_vshuff_VVR(v_sc, v_sc, -2));
+
+        HVX_Vector vq[8];
+        for (int g = 0; g < 8; g++) {
+            vq[g] = *(const HVX_UVector *) (tile_src + g * 128);
+        }
+        for (int g = 0; g < 8; g++) {
+            HVX_VectorPair vp = Q6_Wh_vunpack_Vb(vq[g]);
+            hvx_vmem(dst_ptr + (2 * g + 0) * 64) =
+                Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(Q6_Vhf_equals_Vh(Q6_V_lo_W(vp)), v_scale_duplicated));
+            hvx_vmem(dst_ptr + (2 * g + 1) * 64) =
+                Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(Q6_Vhf_equals_Vh(Q6_V_hi_W(vp)), v_scale_duplicated));
+        }
+    }
+}
