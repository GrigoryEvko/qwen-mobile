 // the norm (a, b, c, s of gdn-step.h) follow in the next four params.
 #define HTP_GDN_KP_QKNORM   2
 
+// GATED_DELTA_NET: the smallest number of tokens outside the snapshot tail for version 2 of the chunked
+// kernel (GGML_HEXAGON_GDN_CHUNK_MIN). A batch with fewer tokens runs on the sequential kernel. 0 gives
+// the limit of the DSP, GDN_CH_MIN_TOKENS of gdn-chunk-ops.c.
+#define HTP_GDN_KP_CHUNK_MIN 7
