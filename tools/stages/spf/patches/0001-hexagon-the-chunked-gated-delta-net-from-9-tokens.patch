diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index b3ed0c106737c5eb8a61120b2c4bf54a0e8fffd4..fbd6710ded09eddcb35d64540c9bfb01d1d59588 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -4751,11 +4751,30 @@ struct test_gated_delta_net : public test_case {
     // With K > 1 the kernel stops the chunk loop K tokens early and runs those tokens one by one in
     // f32, one snapshot slot each. Thus the tail is tighter than the chunk, and the bound of the
     // chunk holds for the whole output. The gate of the kernel is the token count outside that tail.
+    //
+    // The smallest token count of the gate follows the switches of the host (ggml-hexagon.cpp), which
+    // the backend reads from the same environment: GGML_HEXAGON_GDN_CHUNK (0 = the sequential kernel
+    // only, 1 = version 1 with 32 tokens, 2 = version 2, the preset) and GGML_HEXAGON_GDN_CHUNK_MIN
+    // (the limit of version 2, preset 9, and 0 gives 32).
+    static int64_t htp_chunk_min_tokens() {
+        const char * s_ver = getenv("GGML_HEXAGON_GDN_CHUNK");
+        const char * s_min = getenv("GGML_HEXAGON_GDN_CHUNK_MIN");
+        const int    ver   = s_ver ? atoi(s_ver) : 2;
+        if (ver == 0) {
+            return INT64_MAX;
+        }
+        if (ver != 2) {
+            return 32;
+        }
+        const int lim = s_min ? std::max(0, atoi(s_min)) : 9;
+        return lim > 0 ? lim : 32;
+    }
+
     double max_nmse_err(ggml_backend_t backend) override {
         ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend));
         const int64_t n_tail    = K > 1 ? K : 0;
-        const bool    chunkable = n_seq_tokens - n_tail >= 32 && !kda && n_seqs == 1 &&
-                                  head_size % 32 == 0 && head_size <= 128;
+        const bool    chunkable = n_seq_tokens > 1 && n_seq_tokens - n_tail >= htp_chunk_min_tokens() && !kda &&
+                                  n_seqs == 1 && head_size % 32 == 0 && head_size <= 128;
         if (chunkable && strcmp(ggml_backend_reg_name(reg), "HTP") == 0) {
             return std::max(test_case::max_nmse_err(backend), 2e-6);
         }
