+// One K, V and mask transfer of a block into a scratchpad slot. The row loop queues this from
+// four places, and the four copies together were about 2 KB of the 21472 bytes of
+// flash_attn_ext_f16_thread. The function stays out of line, thus the body exists once: it runs
+// once for each row and not for each element, thus the call costs nothing that matters, and a
+// smaller row loop is what the instruction fetch of the phone needs.
+static __attribute__((noinline)) void fa_queue_block(dma_queue * dma, dma_cache * m_cache,
+                                                     const struct htp_fa_context * factx,
+                                                     uint8_t * k_dst, uint8_t * v_dst,
+                                                     const uint8_t * k_src, const uint8_t * v_src,
+                                                     const uint8_t * m_src, uint32_t nrows,
+                                                     uint32_t nbk1, uint32_t nbv1,
+                                                     size_t size_k_row, size_t size_v_row) {
+    dma_queue_push(dma, dma_make_ptr(k_dst, k_src), factx->size_k_row_padded, nbk1, size_k_row, nrows);
+    dma_queue_push(dma, dma_make_ptr(v_dst, v_src), factx->size_v_row_padded, nbv1, size_v_row, nrows);
+    if (m_src) {
+        dma_cache_push(dma, m_cache, m_src, nrows * 2, nrows * 2, nrows * 2, 1);
+    }
+}
