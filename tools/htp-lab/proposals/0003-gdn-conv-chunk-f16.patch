+// t = e / (1 + e) with e = exp(-|x|), 64 lanes of f16. t lies in (0, 0.5], thus f16 holds it to a
+// relative 2.4e-4 with no cancellation, where 1 - sigmoid(|x|) loses every bit for a large |x|.
+// The input is clamped: |x| >= 32 gives t = 0 in f16, and an f32 above the f16 range must not
+// reach the conversion.
+static inline HVX_Vector gdn_conv_silu_t_f16(HVX_Vector h) {
+    const HVX_Vector v_one       = hvx_vec_splat_f16(1.0f);
+    const HVX_Vector v_neg_log2e = hvx_vec_splat_f16(-EXP_LOG2E_F);
+    const HVX_Vector em_mask     = Q6_Vh_vsplat_R(0x7FFF);
+
+    const HVX_Vector u = hvx_vec_mul_f16_f16(Q6_V_vand_VV(h, em_mask), v_neg_log2e);
+    const HVX_Vector e = hvx_vec_exp2_f16(u);
+    return hvx_vec_mul_f16_f16(e, hvx_vec_inverse_f16(hvx_vec_add_f16_f16(v_one, e)));
+}
+
+// The SiLU of two f32 blocks through one f16 vector: x * t for a negative x, x - x * t for the rest.
+// The products with x stay in f32, thus the error is relative to t and not to a sigmoid near 1.
+static inline void gdn_conv_silu2_f16(HVX_Vector a, HVX_Vector b, HVX_Vector * ya, HVX_Vector * yb) {
+    const HVX_Vector lim_hi = hvx_vec_splat_f32(32.0f);
+    const HVX_Vector lim_lo = hvx_vec_splat_f32(-32.0f);
+    const HVX_Vector zero   = Q6_V_vzero();
+
+    const HVX_Vector ca = Q6_Vsf_vmin_VsfVsf(Q6_Vsf_vmax_VsfVsf(a, lim_lo), lim_hi);
+    const HVX_Vector cb = Q6_Vsf_vmin_VsfVsf(Q6_Vsf_vmax_VsfVsf(b, lim_lo), lim_hi);
+
+    const HVX_VectorPair t32 = hvx_vec_f16_to_f32(gdn_conv_silu_t_f16(hvx_vec_f32_to_f16(ca, cb)));
+    const HVX_Vector pa = hvx_vec_mul_f32_f32(a, Q6_V_lo_W(t32));
+    const HVX_Vector pb = hvx_vec_mul_f32_f32(b, Q6_V_hi_W(t32));
+
+    // the sign bit decides: a negative f32 is a negative int32
+    *ya = Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VwVw(zero, a), pa, hvx_vec_sub_f32_f32(a, pa));
+    *yb = Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VwVw(zero, b), pb, hvx_vec_sub_f32_f32(b, pb));
+}
+
+// Mode 2: the taps of two blocks as f16 in the interleaved lane order, thus the widening multiply
+// gives block a in the low half and block b in the high half. The sum stays in qf32.
+static inline void gdn_conv_tap_acc2_f16_wide(const HVX_Vector * th, const HVX_Vector * wh,
+                                              HVX_Vector * acc_a, HVX_Vector * acc_b) {
+    HVX_VectorPair p = Q6_Wqf32_vmpy_VhfVhf(th[0], wh[0]);
+    HVX_Vector lo = Q6_V_lo_W(p);
+    HVX_Vector hi = Q6_V_hi_W(p);
+    for (int j = 1; j < 4; j++) {
+        p  = Q6_Wqf32_vmpy_VhfVhf(th[j], wh[j]);
+        lo = Q6_Vqf32_vadd_Vqf32Vqf32(lo, Q6_V_lo_W(p));
+        hi = Q6_Vqf32_vadd_Vqf32Vqf32(hi, Q6_V_hi_W(p));
+    }
+    *acc_a = Q6_Vsf_equals_Vqf32(lo);
+    *acc_b = Q6_Vsf_equals_Vqf32(hi);
+}
+
+// Mode 3: as mode 2, but every product and the sum are f16. The SiLU stays in f16 as well.
+static inline HVX_Vector gdn_conv_tap_silu2_f16_narrow(const HVX_Vector * th, const HVX_Vector * wh) {
+    HVX_Vector acc = hvx_vec_mul_f16_f16(th[0], wh[0]);
+    for (int j = 1; j < 4; j++) {
+        acc = hvx_vec_add_f16_f16(acc, hvx_vec_mul_f16_f16(th[j], wh[j]));
+    }
+    const HVX_Vector t   = gdn_conv_silu_t_f16(acc);
+    const HVX_Vector p   = hvx_vec_mul_f16_f16(acc, t);
+    const HVX_Vector em  = Q6_Vh_vsplat_R(0x7FFF);
+    const HVX_VectorPred neg = Q6_Q_vcmp_gt_VhVh(Q6_V_vand_VV(acc, em), acc);
+    return Q6_V_vmux_QVV(neg, p, hvx_vec_sub_f16_f16(acc, p));
+}
