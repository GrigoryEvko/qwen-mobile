 // converts a lane layout again. The channels of one token are contiguous, thus each thread walks its
 // own block of each row, and the four rows that one token reads stay in L2 over the channel sweep.
 
+// The packed path. One iteration does 64 channels of G consecutive token rows.
+//
+// The v79 issues one packet of at most 4 instructions every 2 cycles, and a result is ready 2
+// packets after its producer. One chain of dependent operations thus leaves three quarters of
+// each packet empty. The G rows of a band are independent chains: the code does each step for
+// all rows before the next step, thus the scheduler always has G ready instructions.
+//
+// The resource units of one packet decide the minimum: 2 VX (a widening or qfloat multiply takes
+// both, an int16 multiply one), 2 VS (qfloat add, every convert, every shift), 4 VA (the integer
+// ALU), 1 permute (vlut16), 1 load and 1 store. Counting the operations of one unit by class and
+// dividing by the units gives 47.8 packets, bound by the 4 instructions of a packet.
+//
+// S holds the 3 + G f16 rows that the G outputs read: the 3 rows of the history, then the G new
+// rows. The row r reads S[r] to S[r + 3]. The history planes keep the last 3 rows of S for the
+// next band, thus each input element has one f32 to f16 conversion and one read from the DDR.
+// All f16 vectors have the interleaved lane order of the conversion from a pair: the lane 2 * i
+// is the lane i of the first 32 channels. The widening multiply gives that order back as a pair,
+// thus the path has no shuffle.
+//
+// The taps accumulate in 16-bit qfloat and the epilogue is f16. The whole unit thus holds one
+// register for each row where a 32-bit accumulator holds two, and the working set stays inside
+// the 32 vector registers. The measured error of the op is 3e-07, the same order as the chunked
+// gated delta net that reads its output, and far inside the 2e-06 bound of the backend test.
+//
+// x and y are the rows of the first channel of the unit. hist is [3][nh] and wh is [4][nh], the
+// f16 planes of this thread. units is the number of 64-channel units. G is the band height, 1 or
+// 3, and a constant at each call.
+//
+// The band height 3 is measured, not assumed. At 512 channels and 32 tokens the simulator gives
+// 28.99 cycles for each 32-lane block at G = 3, 31.04 at G = 4 and 32.22 at G = 2. A taller band
+// hides more latency but needs more live vectors, and above 3 the working set passes the 32
+// vector registers and the spill traffic costs more than the latency it hides. A shorter band
+// packs each packet better (2.38 cycles per packet at G = 2 against 2.65 at G = 3) and needs
+// 24 % more packets, thus it loses.
+static inline __attribute__((always_inline)) void gdn_conv_band_packed(const float * x, size_t x_stride, float * y, size_t y_stride,
+                                        __fp16 * hist, const __fp16 * wh, size_t nh,
+                                        uint32_t units, const int G) {
+    const HVX_Vector zero  = Q6_V_vzero();
+    const HVX_Vector one   = hvx_vec_splat_f16(1.0f);
+    // h arrives as an integer of the scale 2^16. The f16 of that integer minus 16 exponent steps
+    // is h itself, and the unsigned saturating subtract gives 0 for the values that underflow.
+    const HVX_Vector e16   = Q6_Vh_vsplat_R(0x4000);
+
+    // The addresses advance by one 64-channel unit, thus the loop holds no index arithmetic.
+    const float * xp[4];
+    float *       yp[4];
+    for (int r = 0; r < G; r++) {
+        xp[r] = x + (size_t) r * x_stride;
+        yp[r] = y + (size_t) r * y_stride;
+    }
+    const __fp16 * wp = wh;
+    __fp16 *       hp = hist;
+
+    for (uint32_t i = 0; i < units; i++) {
+        HVX_Vector S[3 + 4];
+        HVX_Vector w[GDN_CONV_D_CONV];
+        HVX_Vector a[4], h16[4];
+
+        for (int k = 0; k < 3; k++) {
+            S[k] = hvx_vmem(hp + k * nh);
+        }
+        for (int r = 0; r < G; r++) {
+            S[3 + r] = hvx_vec_f32_to_f16_shuff(hvx_vmemu(xp[r]), hvx_vmemu(xp[r] + VLEN_FP32));
+        }
+        for (int k = 0; k < 3; k++) {
+            hvx_vmem(hp + k * nh) = S[G + k];
+        }
+        for (int j = 0; j < GDN_CONV_D_CONV; j++) {
+            w[j] = hvx_vmem(wp + j * nh);
+        }
+
+        // The taps of every row, one weight at a time. The 16-bit qfloat multiply gives one vector
+        // where the widening multiply gives a pair, thus the accumulator of a row is one register
+        // and one add, not two of each. That halves both the register pressure of this block and
+        // the add count, and the 4 taps of a conv are too few for the wider accumulator to matter
+        // (the chunked gated delta net after this op rounds to f16 anyway).
+        {
+            HVX_Vector acc[4];
+            for (int r = 0; r < G; r++) {
+                acc[r] = Q6_Vqf16_vmpy_VhfVhf(S[r], w[0]);
+            }
+            for (int j = 1; j < GDN_CONV_D_CONV; j++) {
+                HVX_Vector p[4];
+                for (int r = 0; r < G; r++) {
+                    p[r] = Q6_Vqf16_vmpy_VhfVhf(S[r + j], w[j]);
+                }
+                for (int r = 0; r < G; r++) {
+                    acc[r] = Q6_Vqf16_vadd_Vqf16Vqf16(acc[r], p[r]);
+                }
+            }
+            for (int r = 0; r < G; r++) {
+                a[r] = Q6_Vhf_equals_Vqf16(acc[r]);
+            }
+        }
+
+        hvx_silu_h_i16(a, h16, G);
+
+        // y = relu(x) - h(|x|), in f16, then one widening multiply by 1.0 gives the two f32 halves
+        for (int r = 0; r < G; r++) {
+            const HVX_Vector rel = Q6_Vhf_vmax_VhfVhf(a[r], zero);
+            const HVX_Vector hf  = Q6_Vuh_vsub_VuhVuh_sat(Q6_Vhf_equals_Vh(h16[r]), e16);
+            const HVX_Vector yh  = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vsub_VhfVhf(rel, hf));
+            const HVX_VectorPair y32 = Q6_Wsf_vmpy_VhfVhf(yh, one);
+            hvx_vmemu(yp[r])             = Q6_V_lo_W(y32);
+            hvx_vmemu(yp[r] + VLEN_FP32) = Q6_V_hi_W(y32);
+        }
+
+        for (int r = 0; r < G; r++) {
+            xp[r] += 2 * VLEN_FP32;
+            yp[r] += 2 * VLEN_FP32;
+        }
+        wp += 2 * VLEN_FP32;
+        hp += 2 * VLEN_FP32;
+    }
+}
