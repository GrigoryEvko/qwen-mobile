% Стиль отчёта. Палитра и приёмы вёрстки взяты из дизайн-системы
% TheArtisan.ai (docs/paper/artisan.sty проекта artisan_upscaler).
%
% Отличие одно и оно вынужденное: фирменная гарнитура Coolvetica не содержит
% кириллицы, поэтому заголовки набраны гротеском с кириллицей, а текст —
% шрифтом STIX Two Text, близким по рисунку к newtx из исходного шаблона.
% Сборка: lualatex (fontspec и polyglossia требуют его).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{qwen}[2026/09/18 Отчёт о запуске Qwen3.5 на Android]

\RequirePackage{xcolor}
\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\RequirePackage{microtype}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{siunitx}
\RequirePackage{caption}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}

% ------------------------------------------------------------------ палитра
\definecolor{artPage}      {HTML}{F8F8F7}
\definecolor{artCard}      {HTML}{FFFFFF}
\definecolor{artField}     {HTML}{F2F2F2}
\definecolor{artInk}       {HTML}{0F0F0F}
\definecolor{artGray}      {HTML}{C4C4C4}
\definecolor{artBlue}      {HTML}{003AB5}
\definecolor{artRed}       {HTML}{B50003}
\definecolor{artPurple}    {HTML}{8A38F5}
\definecolor{artGrid}      {HTML}{E4E4E4}
\colorlet{artAccent}{artBlue}
\colorlet{artTextMuted}{artInk!55}

% ------------------------------------------------------------------ язык
\setmainlanguage{russian}
\setotherlanguage{english}

% ------------------------------------------------------------------ шрифты
\setmainfont{STIX Two Text}[Ligatures=TeX, Numbers=Lining]
\newfontfamily\displayfamily{Noto Sans}[Ligatures=TeX]
\setmonofont{Liberation Mono}[Scale=0.84]
% Математика берёт гарнитуру того же семейства, иначе стрелка в таблице
% приходит из Computer Modern и выбивается из набора.
\RequirePackage{unicode-math}
\setmathfont{STIX Two Math}

% ------------------------------------------------------------------ заголовки
\setcounter{secnumdepth}{3}
\titleformat{\section}{\displayfamily\large\bfseries\color{artInk}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\displayfamily\normalsize\bfseries\color{artInk}}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\displayfamily\normalsize\bfseries\color{artInk}}{\thesubsubsection}{0.6em}{}
\titleformat{\paragraph}[runin]{\displayfamily\normalsize\bfseries\color{artInk}}{}{0pt}{}[.]
\titlespacing*{\section}{0pt}{1.4em}{0.6em}
\titlespacing*{\subsection}{0pt}{1.0em}{0.4em}
\titlespacing*{\subsubsection}{0pt}{0.9em}{0.35em}
\titlespacing*{\paragraph}{0pt}{0.7em}{0.5em}

% ------------------------------------------------------------------ подписи
\captionsetup{font=small,labelfont={bf,color=artAccent},skip=6pt}

% ------------------------------------------------------------------ таблицы
% Числовые столбцы выравниваются по десятичной точке: столбец с 0.15, 1.0 и
% 1558 иначе теряет сопоставимость порядков.
\sisetup{group-separator={\,},group-minimum-digits=4,output-decimal-marker={,}}
\newcolumntype{N}[2]{S[table-format=#1.#2]}
%% P{ширина} — текстовый столбец без выключки: в узком столбце выключка
%% оставляет дыры между словами.
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}

%% \thead{ТЕКСТ} — шапка столбца: мелкий гротеск, прописные, разрядка.
\newcommand{\artletterspace}[1]{\addfontfeature{LetterSpace=8}#1}
\newcommand{\thead}[1]{{\displayfamily\fontsize{8.0}{9.6}\selectfont
  \color{artTextMuted}\MakeUppercase{\artletterspace{#1}}}}

%% \tstub{ТЕКСТ} — левый столбец таблицы.
\newcommand{\tstub}[1]{{\displayfamily\fontsize{9.6}{11.4}\selectfont #1}}

%% Окружение таблицы: подпись сверху, правила booktabs, ширина по строке.
\newenvironment{qtable}[4][!htbp]{%
  \begin{table}[#1]\small
    \caption{#3}\label{#4}
    \begin{tabular*}{\linewidth}{@{\extracolsep{\fill}}#2}\toprule
}{%
    \bottomrule\end{tabular*}
  \end{table}}

%% \srcnote{ЧТО} — откуда число. Ставится в конце подписи.
\newcommand{\srcnote}[1]{{\color{artTextMuted}\hspace{0.4em}Источник:\penalty0
  \hspace{0.33em}\texttt{\footnotesize #1}.}}

% ------------------------------------------------------------------ акценты
%% \lead{ТЕКСТ} — цветной зачин абзаца, как в резюме исходного шаблона.
\newcommand{\lead}[1]{\textcolor{artAccent}{\textbf{#1}}}

%% Красные пометки в скобках. \remeasure{ЧТО} — число подлежит перемеру:
%% за ним нет коммита, или оно получено один раз, или оценкой.
%% \doubt{ЧТО} — утверждение, которое при сверке с записью оказалось
%% сомнительным или неверным.
\newcommand{\remeasure}[1]{{\color{artRed}(перемерить: #1)}}
\newcommand{\doubt}[1]{{\color{artRed}(вероятно неверно: #1)}}

%% \hairline — тонкая линейка цвета сетки.
\newcommand{\hairline}{\par\vspace{0.5em}{\color{artGrid}\hrule height 0.6pt}\par\vspace{0.7em}}

%% Врезка: заливка поля, левая линейка акцентом. Содержимое сначала собирается
%% в бокс, потому что \colorbox берёт аргумент целиком и не переживает разрыва
%% между началом и концом окружения.
\newsavebox{\qwen@notebox}
\newenvironment{note}{%
  \par\smallskip
  \begin{lrbox}{\qwen@notebox}%
  \begin{minipage}{\dimexpr\linewidth-3.4em\relax}%
  \small\color{artInk}\setlength{\parskip}{0.4em}%
}{%
  \end{minipage}%
  \end{lrbox}%
  \noindent\colorbox{artField}{\color{artAccent}%
    \raisebox{0pt}[\ht\qwen@notebox][\dp\qwen@notebox]{%
      \rule[-\dp\qwen@notebox]{2.2pt}{\dimexpr\ht\qwen@notebox+\dp\qwen@notebox\relax}}%
    \hspace{0.7em}\usebox{\qwen@notebox}}%
  \par\smallskip}

\setlist{itemsep=2pt,topsep=3pt,parsep=0pt}

% Длинные идентификаторы в \texttt не переносятся; третий проход
% разбиения абзаца с запасом растяжения убирает выступы за поле.
\setlength{\emergencystretch}{2.5em}

% ------------------------------------------------------------------ колонтитул
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{{\displayfamily\footnotesize\color{artTextMuted}\thepage}}
