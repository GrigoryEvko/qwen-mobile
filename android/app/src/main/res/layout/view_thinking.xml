<?xml version="1.0" encoding="utf-8"?>
<!-- The thinking field of an answer: a separate box, closed until the header is tapped.
     Include it in the message item, then bind it with Thinking.bind(thinkingHeader, thinkingBody, parts). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_thinking"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/thinkingHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/thinkingChevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/thinking_chevron"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/thinkingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/thinking_in_progress"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>

    <TextView
        android:id="@+id/thinkingBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="10dp"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
