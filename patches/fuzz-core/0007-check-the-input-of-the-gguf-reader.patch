+// Recompute the offsets of the tensor data for the alignment of ctx: the data stays one
+// contiguous block with each tensor padded to the alignment. O(n) in the count of tensors.
+static void gguf_update_offsets(struct gguf_context * ctx) {
+    for (size_t i = 1; i < ctx->info.size(); ++i) {
+        ctx->info[i].offset = ctx->info[i - 1].offset + GGML_PAD(ggml_nbytes(&ctx->info[i - 1].t), ctx->alignment);
+    }
+}
