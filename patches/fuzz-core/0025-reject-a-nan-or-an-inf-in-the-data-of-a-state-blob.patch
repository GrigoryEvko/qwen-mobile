diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 7117b32..fb851b1 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -2826,6 +2826,19 @@ private:
     std::vector<write_info> winfos;
 };
 
+// Reject the bytes of a state blob for a tensor of the memory when they hold a NaN or an Inf (for a
+// quantized type, in a block scale). The memory keeps the rows of a cell after a remove of its
+// sequence, and the attention without flash attention reads each cell of its window. A masked cell
+// gets the weight 0 there, but 0 * NaN and NaN + -inf are NaN. Thus one non-finite value of a damaged
+// blob gives NaN logits to the other sequences of the stream, and to each later sequence, until a
+// clear with data. A decode that overflows can also write a NaN: this check does not cover that
+// path. O(size), at a load only.
+static void llama_state_check_tensor_data(const ggml_tensor * tensor, const void * data, size_t size) {
+    if (!ggml_validate_row_data(tensor->type, data, size)) {
+        throw std::runtime_error(format("the state data of %s holds a NaN or an Inf value, or a size that is not a whole number of blocks", tensor->name));
+    }
+}
