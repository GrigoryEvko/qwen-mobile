+++ b/src/llama-context.h
@@ -420,6 +420,7 @@ private:
     // no GET_ROWS node for them and no split on the CPU
     bool embd_lookup_host = false;
     std::vector<float> embd_lookup_buf;
+    std::vector<llama_pos> embd_lookup_pos;  // n_pos_per_embd copies of the positions, for an M-RoPE model
 
     bool embd_lookup(const llama_batch & batch);
 };
