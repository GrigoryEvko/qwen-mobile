+    // true after the read of the memory starts: a failure from then on removes the sequence
+    bool reading = false;
     try {
         uint32_t magic_read;
         io->read(&magic_read, sizeof(magic_read));
@@ -3348,14 +3428,25 @@ size_t llama_context::state_seq_set_data(llama_seq_id seq_id, const uint8_t * sr
         llama_seq_id seq_id_read;
         io->read(&seq_id_read, sizeof(seq_id_read));
 
+        reading = true;
         const int64_t t0 = hostprof ? ggml_time_us() : 0;
         const size_t  n  = state_seq_read_data(*io, seq_id, flags);
         if (hostprof) {
             LLAMA_LOG_INFO("hostprof: state_seq_set seq %d flags %u bytes %zu us %lld\n", seq_id, (unsigned) flags, n, (long long) (ggml_time_us() - t0));
         }
+        // the host reader writes the tensor data here, and it checks each part before it writes it
+        if (!io->flush()) {
+            throw std::runtime_error("the state data holds a NaN or an Inf value");
+        }
         return n;
     } catch (const std::exception & err) {
         LLAMA_LOG_ERROR("%s: error loading state: %s\n", __func__, err.what());
+        // No part of a failed load stays in the memory. A part of the memory removes its own
+        // cells when its read fails, but the parts before it (the KV cache before the recurrent
+        // memory of a hybrid model) and a failure of the check in flush() keep theirs.
+        if (reading && memory) {
+            memory->seq_rm(seq_id, -1, -1);
+        }
         return 0;
     }
 }
