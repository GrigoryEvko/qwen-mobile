-// Reject the bytes of a state blob for a tensor of the memory when they hold a NaN or an Inf (for a
-// quantized type, in a block scale). The memory keeps the rows of a cell after a remove of its
-// sequence, and the attention without flash attention reads each cell of its window. A masked cell
-// gets the weight 0 there, but 0 * NaN and NaN + -inf are NaN. Thus one non-finite value of a damaged
-// blob gives NaN logits to the other sequences of the stream, and to each later sequence, until a
-// clear with data. A decode that overflows can also write a NaN: this check does not cover that
-// path. O(size), at a load only.
-static void llama_state_check_tensor_data(const ggml_tensor * tensor, const void * data, size_t size) {
-    if (!ggml_validate_row_data(tensor->type, data, size)) {
-        throw std::runtime_error(format("the state data of %s holds a NaN or an Inf value, or a size that is not a whole number of blocks", tensor->name));
+// The check of the tensor data of a state blob: a NaN or an Inf (for a quantized type, in a block
+// scale) rejects the load. The memory keeps the rows of a cell after a remove of its sequence, and
+// the attention without flash attention reads each cell of its window. A masked cell gets the weight
+// 0 there, but 0 * NaN and NaN + -inf are NaN. Thus one non-finite value of a damaged blob gives NaN
+// logits to the other sequences of the stream, and to each later sequence, until a clear with data.
+// A decode that overflows can also write a NaN: this check does not cover that path.
+//
+// The types of the caches of the app (F32, F16, BF16, Q8_0) take one integer pass that the compiler
+// vectorizes: the largest magnitude bits of the values (for Q8_0, of the f16 block scales) against
+// the bits of Inf, which the exponent of a NaN also has. The bytes of a blob have no alignment, thus
+// the pass reads each value with memcpy. ggml_validate_row_data gives the same result for these
+// types, but its per-element tests in ggml-base run at 3.6 GB/s for F16 on x86. A different type
+// goes through an aligned copy to ggml_validate_row_data.
+template <typename T, size_t STRIDE>
+static bool llama_state_finite_bits(const uint8_t * data, size_t n, T mask, T inf) {
+    T m = 0;
+    for (size_t i = 0; i < n; ++i) {
+        T v;
+        memcpy(&v, data + i * STRIDE, sizeof(T));
+        m = std::max<T>(m, v & mask);
+    }
+    return m < inf;
+}
+
+// True when the bytes of a state blob for a tensor of the type hold whole blocks with no NaN or Inf. O(size).
+static bool llama_state_data_finite(ggml_type type, const uint8_t * data, size_t size) {
+    const size_t block = ggml_type_size(type);
+    if (block == 0 || size % block != 0) {
+        return false;
     }
+    const size_t n = size / block;
+    switch (type) {
+        case GGML_TYPE_F32:
+            return llama_state_finite_bits<uint32_t, 4>(data, n, 0x7fffffffu, 0x7f800000u);
+        case GGML_TYPE_F16:
+            return llama_state_finite_bits<uint16_t, 2>(data, n, 0x7fff, 0x7c00);
+        case GGML_TYPE_BF16:
+            return llama_state_finite_bits<uint16_t, 2>(data, n, 0x7fff, 0x7f80);
+        case GGML_TYPE_Q8_0:
+            // a block of 34 bytes is the f16 scale d, then 32 int8 values
+            if (block == 34) {
+                return llama_state_finite_bits<uint16_t, 34>(data, n, 0x7fff, 0x7c00);
+            }
+            break;
+        default:
+            break;
+    }
+    // parts of 64 KiB or more (a whole number of blocks) in an aligned buffer
+    const size_t part = std::max<size_t>(1, 65536 / block) * block;
+    std::vector<double> buf((std::min(size, part) + sizeof(double) - 1) / sizeof(double));
+    for (size_t off = 0; off < size; off += part) {
+        const size_t len = std::min(part, size - off);
+        memcpy(buf.data(), data + off, len);
+        if (!ggml_validate_row_data(type, buf.data(), len)) {
+            return false;
+        }
+    }
+    return true;
 }
 
