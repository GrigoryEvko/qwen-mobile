+    // Write the saved reads in parts of about PART_BYTES (a whole number of blocks). Each part is
+    // checked and then written while it is in the cache, thus the load reads the blob from memory
+    // one time. At a part with a NaN or an Inf the flush stops and gives false: the parts before
+    // it are written, and the caller then removes the sequence.
+    bool flush() override {
+        bool ok = true;
+        for (size_t i = 0; ok && i < rinfos.size(); ++i) {
+            const read_info & r = rinfos[i];
+            const size_t block = std::max<size_t>(1, ggml_type_size(r.tensor->type));
+            const size_t part  = std::max<size_t>(1, PART_BYTES / block) * block;
+            for (size_t off = 0; ok && off < r.size; off += part) {
+                const size_t len = std::min(part, r.size - off);
+                ok = llama_state_data_finite(r.tensor->type, r.ptr + off, len);
+                if (ok) {
+                    ggml_backend_tensor_set(r.tensor, r.ptr + off, r.offset + off, len);
+                }
+            }
+        }
+        rinfos.clear();
+        return ok;
+    }
+
     size_t n_bytes() override {
         return size_read;
     }
 
 private:
+    static constexpr size_t PART_BYTES = 256 * 1024;
+
     const uint8_t * ptr;
     size_t buf_size = 0;
     size_t size_read = 0;
