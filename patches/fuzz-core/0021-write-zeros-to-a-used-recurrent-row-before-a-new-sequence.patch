+void llama_memory_recurrent::zero_new_state() {
+    if (rs_z >= 0 && !cell_zero[rs_z]) {
+        // one tensor_set of zeros for each state tensor of each layer: the first group of row rs_z
+        for (const auto * v : { &r_l, &s_l, &p_l }) {
+            for (ggml_tensor * t : *v) {
+                if (t == nullptr) {
+                    continue;
+                }
+                const size_t row = t->nb[1];
+                if (zero_row.size() < row) {
+                    zero_row.assign(row, 0);
+                }
+                ggml_backend_tensor_set(t, zero_row.data(), (size_t) rs_z * row, row);
+            }
+        }
+        cell_zero[rs_z] = true;
+    }
+
+    // the graph of this ubatch writes the rows of the cells from head to head + n
+    for (uint32_t i = head; i < head + n && i < size; ++i) {
+        cell_zero[i] = false;
+    }
+}
