diff --git a/ggml/src/ggml-hexagon/htp-gdn-qknorm.h b/ggml/src/ggml-hexagon/htp-gdn-qknorm.h
new file mode 100644
index 0000000..e0346bd
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp-gdn-qknorm.h
@@ -0,0 +1,176 @@
+// The graph match of the L2 norm of q and k before a gated delta net op (host side).
+//
+// A gated delta net layer normalizes each head row of q and of k before GATED_DELTA_NET. Qwen3.5 does
+// it with build_gdn_l2_norm, SCALE(RMS_NORM(x, eps / n), 1 / sqrt(n)), and the tests of the op with
+// L2_NORM(x, eps). Each form is two or one extra passes over q and over k in DDR. The DSP ops
+// GATED_DELTA_NET and GDN_STATE_STEP can apply the norm when they load a row, thus the host removes
+// the norm ops and gives the op the raw rows and the four values of the norm (gdn-step.h):
+//   r = s / sqrt(max(a * sum(x^2) + b, c))
+//   L2_NORM(x, eps)                       (a, b, c, s) = (1, 0, eps^2, 1)
+//   SCALE(RMS_NORM(x, e), s), no bias     (a, b, c, s) = (1 / n, e, 0, s)
+// The CPU op L2_NORM divides by max(sqrt(sum), eps), which is the square root of max(sum, eps^2).
+//
+// The match needs the same norm for q and for k, the norm along ne[0] of the raw rows, an epsilon above
+// zero, no other reader of a replaced tensor (also in another split), no node between a norm op and the
+// GATED_DELTA_NET that writes the bytes of the raw rows, and no byte that the raw rows and the output of
+// the op share. This header depends on ggml and htp-gdn-match.h only.
+
+#ifndef HTP_GDN_QKNORM_H
+#define HTP_GDN_QKNORM_H
+
+#include "htp-gdn-match.h"
+#include "htp-gdn-params.h"
+
+#include <cmath>
+#include <cstring>
+
+struct ggml_hexagon_gdn_qknorm_match {
+    ggml_tensor * q = nullptr;              // the raw q rows, the input of the norm of q
+    ggml_tensor * k = nullptr;              // the raw k rows
+    float         a = 0.0f;
+    float         b = 0.0f;
+    float         c = 0.0f;
+    float         s = 0.0f;
+    std::vector<ggml_tensor *> members;     // the norm ops, in graph order of their chains
+};
+
+// One norm chain that ends in t: the raw input, the four values, and the nodes of the chain. Returns
+// nullptr when t is such a chain, or the first failed condition.
+static inline const char * ggml_hexagon_gdn_qknorm_chain(ggml_tensor * t, ggml_tensor ** raw, float v[4],
+                                                         std::vector<ggml_tensor *> & nodes) {
+    if (!t || t->type != GGML_TYPE_F32) {
+        return "the input is not F32";
+    }
+    if (t->op == GGML_OP_L2_NORM) {
+        float eps;
+        memcpy(&eps, t->op_params, sizeof(float));
+        *raw = t->src[0];
+        v[0] = 1.0f;
+        v[1] = 0.0f;
+        v[2] = eps * eps;
+        v[3] = 1.0f;
+        nodes = { t };
+    } else if (t->op == GGML_OP_SCALE) {
+        float sc, bias;
+        memcpy(&sc, &t->op_params[0], sizeof(float));
+        memcpy(&bias, &t->op_params[1], sizeof(float));
+        ggml_tensor * rn = t->src[0];
+        if (bias != 0.0f) {
+            return "the SCALE has a bias";
+        }
+        if (!rn || rn->op != GGML_OP_RMS_NORM || rn->type != GGML_TYPE_F32) {
+            return "the SCALE input is not an RMS_NORM";
+        }
+        float eps;
+        memcpy(&eps, rn->op_params, sizeof(float));
+        *raw = rn->src[0];
+        if (!*raw || (*raw)->ne[0] < 1) {
+            return "the RMS_NORM has no input row";
+        }
+        v[0] = 1.0f / (float) (*raw)->ne[0];
+        v[1] = eps;
+        v[2] = 0.0f;
+        v[3] = sc;
+        nodes = { rn, t };
+    } else {
+        return "not an L2_NORM or a SCALE of an RMS_NORM";
+    }
+    ggml_tensor * x = *raw;
+    if (!x || x->type != GGML_TYPE_F32 || x->nb[0] != sizeof(float)) {
+        return "the raw rows are not F32 with contiguous elements";
+    }
+    for (int d = 0; d < 4; d++) {
+        if (x->ne[d] != t->ne[d]) {
+            return "the norm changes the shape";
+        }
+    }
+    if (!(std::isfinite(v[0]) && std::isfinite(v[1]) && std::isfinite(v[2]) && std::isfinite(v[3]))) {
+        return "a value of the norm is not finite";
+    }
+    // The chunked kernel pads the last chunk with zero rows. Their factor is s / sqrt(max(b, c)), and a
+    // zero there gives an infinite factor and a NaN in the tiles of the chunk.
+    if (!(v[1] > 0.0f || v[2] > 0.0f)) {
+        return "the norm has no epsilon";
+    }
+    return nullptr;
+}
+
+// The norm chains of q and k of the GATED_DELTA_NET node at graph index ig. extra_members are the
+// other nodes that the caller replaces together with G (the members of a state chain), or empty.
+// O(nodes * GGML_MAX_SRC * members).
+static inline const char * ggml_hexagon_gdn_qknorm_check(const ggml_cgraph * gf,
+                                                         const std::unordered_map<const ggml_tensor *, int> & index,
+                                                         int ig, const std::vector<ggml_tensor *> & extra_members,
+                                                         ggml_hexagon_gdn_qknorm_match & m) {
+    ggml_tensor * G = gf->nodes[ig];
+    if (G->op != GGML_OP_GATED_DELTA_NET) {
+        return "not a GATED_DELTA_NET";
+    }
+    float vq[4], vk[4];
+    std::vector<ggml_tensor *> nq, nk;
+    ggml_tensor * q = nullptr;
+    ggml_tensor * k = nullptr;
+    if (const char * r = ggml_hexagon_gdn_qknorm_chain(G->src[0], &q, vq, nq)) {
+        return r;
+    }
+    if (const char * r = ggml_hexagon_gdn_qknorm_chain(G->src[1], &k, vk, nk)) {
+        return r;
+    }
+    if (memcmp(vq, vk, sizeof(vq)) != 0) {
+        return "q and k have different norms";
+    }
+    if (G->src[0] == G->src[1]) {
+        return "q and k are one tensor";
+    }
+
+    // The norm ops write the replaced tensors. Only G, or the chain that G is a part of, reads them.
+    std::vector<ggml_tensor *> intermediates = nq;
+    intermediates.insert(intermediates.end(), nk.begin(), nk.end());
+    std::vector<ggml_tensor *> members = intermediates;
+    members.push_back(G);
+    members.insert(members.end(), extra_members.begin(), extra_members.end());
+    if (const char * reason = ggml_hexagon_gdn_chain_is_private(gf, intermediates, members, nullptr, 0)) {
+        return reason;
+    }
+
+    // G reads the raw rows at its own index and not at the index of the norm op. No node between the
+    // two can write their bytes.
+    for (ggml_tensor * n : intermediates) {
+        auto it = index.find(n);
+        if (it == index.end()) {
+            return "a norm op is not a node of the graph";
+        }
+        if (it->second > ig) {
+            return "a norm op comes after the GATED_DELTA_NET";
+        }
+        ggml_tensor * raw = n->src[0];
+        if (!ggml_hexagon_gdn_move_is_safe(gf, ig, it->second, raw, false, members)) {
+            return "a node between a norm op and the GATED_DELTA_NET writes the bytes of the raw rows";
+        }
+    }
+    // The op reads the raw rows while it writes its output. The norm outputs kept them apart before.
+    if (ggml_hexagon_gdn_bytes_overlap(G, q) || ggml_hexagon_gdn_bytes_overlap(G, k)) {
+        return "the output of the GATED_DELTA_NET shares bytes with the raw rows";
+    }
+
+    m.q = q;
+    m.k = k;
+    m.a = vq[0];
+    m.b = vq[1];
+    m.c = vq[2];
+    m.s = vq[3];
+    m.members = intermediates;
+    return nullptr;
+}
+
+// The kernel params of the norm for GATED_DELTA_NET and GDN_STATE_STEP, from HTP_GDN_KP_QKNORM on
+// (htp-gdn-params.h). kp is the kernel params array of the op.
+static inline void ggml_hexagon_gdn_qknorm_params(const ggml_hexagon_gdn_qknorm_match & m, int32_t * kp) {
+    kp[HTP_GDN_KP_QKNORM] = 1;
+    memcpy(&kp[HTP_GDN_KP_QKNORM + 1], &m.a, sizeof(float));
+    memcpy(&kp[HTP_GDN_KP_QKNORM + 2], &m.b, sizeof(float));
+    memcpy(&kp[HTP_GDN_KP_QKNORM + 3], &m.c, sizeof(float));
+    memcpy(&kp[HTP_GDN_KP_QKNORM + 4], &m.s, sizeof(float));
+}
+
+#endif // HTP_GDN_QKNORM_H
