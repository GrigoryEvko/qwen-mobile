 // E[t][s] = exp(gamma_t - gamma_s) for s <= t, 0 for s > t
+// The largest span of the cumulative log decay over one chunk that the factored decay matrix
+// accepts. The factors reach exp(span / 2), and an f32 holds exp(88), thus 80 leaves a margin.
+#define GDN_CH_DECAY_MAX_SPAN 80.0f
+
+// The decay matrix by two vector exponentials of the chunk instead of two for each row.
+//
+// E[t][s] = exp(gamma_t - gamma_s). With gamma_m the log decay in the middle of the chunk,
+//   E[t][s] = exp(gamma_t - gamma_m) * exp(gamma_m - gamma_s) = u[t] * w[s],
+// thus E is one outer product and a row of it is one broadcast and two multiplies. The pivot is
+// the middle and not the first token, thus each factor reaches only exp(span / 2).
+//
+// gamma is not increasing, thus the span is gamma_0 - gamma_(C-1). A span above
+// GDN_CH_DECAY_MAX_SPAN would overflow a factor, and the exponential of each row runs instead.
+// A real gate gives a span far below that limit.
 static void gdn_ch_decay_matrix(struct gdn_ch_row * rw, const struct gdn_ch_gates * ga) {
     const HVX_Vector vg0 = hvx_vmem(ga->gam);
     const HVX_Vector vg1 = hvx_vmem(ga->gam + 32);
     const HVX_Vector zero = Q6_V_vzero();
+
+    const float span = ga->gam[0] - ga->gam[GDN_CH_C - 1];
+    if (!(span >= 0.0f && span <= GDN_CH_DECAY_MAX_SPAN)) {
+        for (uint32_t t = 0; t < GDN_CH_C; ++t) {
+            const HVX_Vector vt = hvx_vec_splat_f32(ga->gam[t]);
+            HVX_Vector e0 = hvx_vec_exp_f32(hvx_vec_sub_f32_f32(vt, vg0));
+            HVX_Vector e1 = hvx_vec_exp_f32(hvx_vec_sub_f32_f32(vt, vg1));
+            if (t < 32) {
+                e0 = Q6_V_vmux_QVV(Q6_Q_vsetq2_R((t + 1) * 4), e0, zero);
+                e1 = zero;
+            } else {
+                e1 = Q6_V_vmux_QVV(Q6_Q_vsetq2_R((t - 31) * 4), e1, zero);
+            }
+            hvx_vmem(rw->e32 + (size_t) t * GDN_CH_C)      = e0;
+            hvx_vmem(rw->e32 + (size_t) t * GDN_CH_C + 32) = e1;
+        }
+        return;
+    }
+
+    const HVX_Vector vgm = hvx_vec_splat_f32(ga->gam[GDN_CH_C / 2]);
+
+    // w[s] = exp(gamma_m - gamma_s), the two halves of the row factor
+    const HVX_Vector w0 = hvx_vec_exp_f32(hvx_vec_sub_f32_f32(vgm, vg0));
+    const HVX_Vector w1 = hvx_vec_exp_f32(hvx_vec_sub_f32_f32(vgm, vg1));
+
+    // u[t] = exp(gamma_t - gamma_m). The broadcast reads one lane, thus u goes to the stack:
+    // a scalar read of the VTCM is slow.
+    float u[GDN_CH_C] __attribute__((aligned(VLEN)));
+    hvx_vmem(u)      = hvx_vec_exp_f32(hvx_vec_sub_f32_f32(vg0, vgm));
+    hvx_vmem(u + 32) = hvx_vec_exp_f32(hvx_vec_sub_f32_f32(vg1, vgm));
