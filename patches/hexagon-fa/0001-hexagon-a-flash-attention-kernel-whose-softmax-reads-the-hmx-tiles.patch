+// ============================================================================
+// The softmax of the tile-layout flash attention (fa2)
+// ============================================================================
+
+// The polynomial p(r) of 2^-r for r in [0, 1), degree 3, with f16 coefficients. The coefficients
+// come from a minimax fit with a search over the neighboring f16 values. The maximum relative
+// error of the polynomial with these f16 coefficients is 1.1e-4, which is less than half of one
+// f16 unit in the last place. The qf16 arithmetic adds its own rounding.
+#define FA2_EXP_C0 0x3c00  //  1.0
+#define FA2_EXP_C1 0xb988  // -0.69140625
+#define FA2_EXP_C2 0x3360  //  0.23046875
+#define FA2_EXP_C3 0xa900  // -0.0390625
+
+// The f16 value 30.0. For u >= 30 the result is 0.
+#define FA2_EXP_U_MAX 0x4f80
+
+// 2^-u for each f16 lane u >= 0, as f16.
+//
+// The integer part k = trunc(u) goes into the exponent field with a saturated subtraction, thus
+// a result below the f16 normal range (u > 15) is 0. For u in [14, 15) the exponent field becomes
+// 0 and the bits read as a subnormal value, which is less than 2^-14 as the true value is. The
+// flash attention of hvx_vec_exp2_f16 has the same behavior in that range. u = +Inf and u > 30
+// give 0, because the clamp to 30 comes first. A negative u is outside the contract.
+//
+// 15 HVX instructions: the clamp, two conversions, the subtraction, six for the polynomial, the
+// qf16 conversion, the shift and the saturated subtraction.
+static inline HVX_Vector hvx_vec_exp2_neg_f16(HVX_Vector u) {
+    u = Q6_Vhf_vmin_VhfVhf(u, Q6_Vh_vsplat_R(FA2_EXP_U_MAX));
+
+    const HVX_Vector k  = Q6_Vh_equals_Vhf(u);
+    const HVX_Vector kf = Q6_Vhf_equals_Vh(k);
+    const HVX_Vector r  = Q6_Vqf16_vsub_VhfVhf(u, kf);
+
+    HVX_Vector p = Q6_Vqf16_vmpy_Vqf16Vhf(r, Q6_Vh_vsplat_R(FA2_EXP_C3));
+    p            = Q6_Vqf16_vadd_Vqf16Vhf(p, Q6_Vh_vsplat_R(FA2_EXP_C2));
+    p            = Q6_Vqf16_vmpy_Vqf16Vqf16(p, r);
+    p            = Q6_Vqf16_vadd_Vqf16Vhf(p, Q6_Vh_vsplat_R(FA2_EXP_C1));
+    p            = Q6_Vqf16_vmpy_Vqf16Vqf16(p, r);
+    p            = Q6_Vqf16_vadd_Vqf16Vhf(p, Q6_Vh_vsplat_R(FA2_EXP_C0));
+
+    const HVX_Vector y = Q6_Vhf_equals_Vqf16(p);
+    return Q6_Vuh_vsub_VuhVuh_sat(y, Q6_Vh_vasl_VhR(k, 10));
+}
