+// ============================================================================
+// HTP_FA_KERNEL_HMX2: the tile-layout softmax (refer to flash-attn-ops.h)
+// ============================================================================
+
+// The lowest finite f16. A masked score gets this value, and exp2 of (m - it) is 0.
+#define FA2_NEG_HF       0xfbff
+// A mask value above -16 keeps its score, as in fa_softmax_impl.
+#define FA2_MASK_MIN_HF  0xcc00
+// A mask value times log2(e) is above -24 when the mask value is above -16.
+#define FA2_SCALED_MIN_HF 0xce00
+
+typedef struct {
+    struct hmx_fa_context * factx;
+    __fp16 *                s_tiles;   // the S tiles of the block. The masked values are written back.
+    __fp16 *                p_tiles;
+    __fp16 *                d_tiles;
+    const __fp16 *          mask;      // the mask rows of the block in VTCM, NULL for no mask
+    uint32_t                mask_rows; // the valid mask rows (the Q rows of the block)
+    uint32_t                kv_rows;   // the valid columns of the block
+    uint32_t                n_tiles_per_bc;
+    uint32_t                n_rows_g;
+    uint32_t                pairs_per_thread;
+} fa2_softmax_args_t;
+
+// True when each mask value of the rows of the pairs [p0, p1) is 0 or at most -16: then a kept
+// score gets no addition. O(rows / G * kv_rows / 64).
+static bool fa2_mask_is_binary(const fa2_softmax_args_t * a, uint32_t p0, uint32_t p1) {
+    const struct hmx_fa_context * factx = a->factx;
+    const uint32_t r_first = 2 * p0;
+    const uint32_t r_last  = hex_smin(2 * p1, a->n_rows_g) - 1;
+    const uint32_t q_first = hex_smin(fastdiv(r_first, &factx->div_G), a->mask_rows - 1);
+    const uint32_t q_last  = hex_smin(fastdiv(r_last, &factx->div_G), a->mask_rows - 1);
+    const uint32_t n_vec   = hmx_ceil_div(a->kv_rows, 64);
+    const uint32_t tail    = a->kv_rows % 64;
+    const size_t   line    = factx->mask_buf_row_stride;
+
+    const HVX_Vector     v_min  = Q6_Vh_vsplat_R(FA2_MASK_MIN_HF);
+    const HVX_Vector     v_abs  = Q6_Vh_vsplat_R(0x7fff);
+    const HVX_Vector     v_zero = Q6_V_vzero();
+    const HVX_VectorPred q_tail = Q6_Q_vsetq2_R(tail ? tail * 2 : 128);
+    HVX_Vector           acc    = v_zero;
+
+    for (uint32_t qr = q_first; qr <= q_last; ++qr) {
+        const HVX_Vector * row = (const HVX_Vector *) (a->mask + qr * line);
+        for (uint32_t c = 0; c < n_vec; ++c) {
+            const HVX_Vector     m    = row[c];
+            const HVX_VectorPred kept = Q6_Q_vcmp_gt_VhfVhf(m, v_min);
+            const HVX_VectorPred zero = Q6_Q_vcmp_eq_VhVh(Q6_V_vand_VV(m, v_abs), v_zero);
+            HVX_VectorPred       bad  = Q6_Q_and_QQn(kept, zero);
+            if (c + 1 == n_vec) {
+                bad = Q6_Q_and_QQ(bad, q_tail);
+            }
+            acc = Q6_V_vmux_QVV(bad, v_abs, acc);
+        }
+    }
+    for (uint32_t s = 4; s < 128; s *= 2) {
+        acc = Q6_V_vor_VV(acc, Q6_V_vror_VR(acc, s));
+    }
+    return Q6_R_vextract_VR(acc, 0) == 0;
+}
+
+// Pass A of one row pair with a mask: a masked score becomes FA2_NEG_HF in the S tile, a kept
+// score gets the mask value times log2(e) when mask_general is true. The return value holds the
+// maximum of row 2v in each even lane and of row 2v + 1 in each odd lane, before the reduction.
+// ma and mb are the mask rows of the two rows. O(n_tiles).
+static inline __attribute__((always_inline)) HVX_Vector fa2_mask_max(HVX_Vector * restrict sv, const HVX_Vector * restrict ma,
+                                      const HVX_Vector * restrict mb, uint32_t n_full, uint32_t n_tiles,
+                                      HVX_VectorPred q_tail, const bool mask_general) {
+    const size_t     tvec    = HMX_FP16_TILE_N_ELMS / 64;
+    const HVX_Vector v_neg   = Q6_Vh_vsplat_R(FA2_NEG_HF);
+    const HVX_Vector v_mmin  = Q6_Vh_vsplat_R(FA2_MASK_MIN_HF);
+    const HVX_Vector v_thr   = mask_general ? Q6_Vh_vsplat_R(FA2_SCALED_MIN_HF) : v_mmin;
+    const HVX_Vector v_log2e = hvx_vec_splat_f16(EXP_LOG2E_F);
+    HVX_Vector       acc0    = v_neg;
+    HVX_Vector       acc1    = v_neg;
+
+    uint32_t c = 0;
+    for (; c + 2 <= n_full; c += 2) {
+        HVX_Vector mva = ma[c / 2];
+        HVX_Vector mvb = mb[c / 2];
+        if (mask_general) {
+            mva = Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VhfVhf(mva, v_mmin), hvx_vec_mul_f16_f16(mva, v_log2e), v_neg);
+            mvb = Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VhfVhf(mvb, v_mmin), hvx_vec_mul_f16_f16(mvb, v_log2e), v_neg);
+        }
+        const HVX_VectorPair w  = Q6_W_vshuff_VVR(mvb, mva, -2);
+        HVX_Vector           x0 = sv[c * tvec];
+        HVX_Vector           x1 = sv[(c + 1) * tvec];
+        if (mask_general) {
+            x0 = hvx_vec_add_f16_f16(x0, Q6_V_lo_W(w));
+            x1 = hvx_vec_add_f16_f16(x1, Q6_V_hi_W(w));
+        }
+        x0                 = Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VhfVhf(Q6_V_lo_W(w), v_thr), x0, v_neg);
+        x1                 = Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VhfVhf(Q6_V_hi_W(w), v_thr), x1, v_neg);
+        sv[c * tvec]       = x0;
+        sv[(c + 1) * tvec] = x1;
+        acc0               = Q6_Vhf_vmax_VhfVhf(acc0, x0);
+        acc1               = Q6_Vhf_vmax_VhfVhf(acc1, x1);
+    }
+    if (c < n_tiles) {
+        // One or two tiles are left: a full tile, a partial tile, or both.
+        HVX_Vector mva = ma[c / 2];
+        HVX_Vector mvb = mb[c / 2];
+        if (mask_general) {
+            mva = Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VhfVhf(mva, v_mmin), hvx_vec_mul_f16_f16(mva, v_log2e), v_neg);
+            mvb = Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VhfVhf(mvb, v_mmin), hvx_vec_mul_f16_f16(mvb, v_log2e), v_neg);
+        }
+        const HVX_VectorPair w = Q6_W_vshuff_VVR(mvb, mva, -2);
+        for (uint32_t j = 0; j < 2 && c + j < n_tiles; ++j) {
+            const HVX_Vector mv   = j ? Q6_V_hi_W(w) : Q6_V_lo_W(w);
+            HVX_VectorPred   keep = Q6_Q_vcmp_gt_VhfVhf(mv, v_thr);
+            if (c + j == n_full) {
+                keep = Q6_Q_and_QQ(keep, q_tail);
+            }
+            HVX_Vector x = sv[(c + j) * tvec];
+            if (mask_general) {
+                x = hvx_vec_add_f16_f16(x, mv);
+            }
+            x                  = Q6_V_vmux_QVV(keep, x, v_neg);
+            sv[(c + j) * tvec] = x;
+            acc0               = Q6_Vhf_vmax_VhfVhf(acc0, x);
+        }
+    }
+    return Q6_Vhf_vmax_VhfVhf(acc0, acc1);
+}
+
+// Pass A of one row pair without a mask. O(n_tiles).
+static inline __attribute__((always_inline)) HVX_Vector fa2_max(HVX_Vector * restrict sv, uint32_t n_full, uint32_t n_tiles, HVX_VectorPred q_tail) {
+    const size_t     tvec  = HMX_FP16_TILE_N_ELMS / 64;
+    const HVX_Vector v_neg = Q6_Vh_vsplat_R(FA2_NEG_HF);
+    HVX_Vector       acc0  = v_neg;
+    HVX_Vector       acc1  = v_neg;
+    uint32_t         c     = 0;
+    for (; c + 2 <= n_full; c += 2) {
+        acc0 = Q6_Vhf_vmax_VhfVhf(acc0, sv[c * tvec]);
+        acc1 = Q6_Vhf_vmax_VhfVhf(acc1, sv[(c + 1) * tvec]);
+    }
+    if (c < n_full) {
+        acc0 = Q6_Vhf_vmax_VhfVhf(acc0, sv[c * tvec]);
+    }
+    if (n_tiles > n_full) {
+        const HVX_Vector x = Q6_V_vmux_QVV(q_tail, sv[n_full * tvec], v_neg);
+        sv[n_full * tvec]  = x;
+        acc1               = Q6_Vhf_vmax_VhfVhf(acc1, x);
+    }
+    return Q6_Vhf_vmax_VhfVhf(acc0, acc1);
+}
+
+// Pass B of one row pair: P = 2^(S - m) for each tile vector. Four vectors at a time are four
+// independent chains, thus the packets hold the instructions of all four. O(n_tiles).
+static inline __attribute__((always_inline)) void fa2_exp_row_pair(HVX_Vector * restrict pv, const HVX_Vector * restrict sv, uint32_t n_tiles,
+                                    HVX_Vector m) {
+    const size_t tvec = HMX_FP16_TILE_N_ELMS / 64;
+    uint32_t     c    = 0;
+    for (; c + 4 <= n_tiles; c += 4) {
+        const HVX_Vector x0 = sv[(c + 0) * tvec];
+        const HVX_Vector x1 = sv[(c + 1) * tvec];
+        const HVX_Vector x2 = sv[(c + 2) * tvec];
+        const HVX_Vector x3 = sv[(c + 3) * tvec];
+        const HVX_Vector u0 = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vsub_VhfVhf(m, x0));
+        const HVX_Vector u1 = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vsub_VhfVhf(m, x1));
+        const HVX_Vector u2 = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vsub_VhfVhf(m, x2));
+        const HVX_Vector u3 = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vsub_VhfVhf(m, x3));
+        pv[(c + 0) * tvec]  = hvx_vec_exp2_neg_f16(u0);
+        pv[(c + 1) * tvec]  = hvx_vec_exp2_neg_f16(u1);
+        pv[(c + 2) * tvec]  = hvx_vec_exp2_neg_f16(u2);
+        pv[(c + 3) * tvec]  = hvx_vec_exp2_neg_f16(u3);
+    }
+    for (; c < n_tiles; ++c) {
+        pv[c * tvec] = hvx_vec_exp2_neg_f16(Q6_Vhf_equals_Vqf16(Q6_Vqf16_vsub_VhfVhf(m, sv[c * tvec])));
+    }
+}
+
+// The softmax of the row pairs [v0, v1) of the row tile t: the pairs 2v and 2v + 1 of the rows
+// t * 32 .. t * 32 + 31. A tile vector holds the two rows of a pair with the values interleaved
+// for each column, thus the maximum and the exponent work on it as it is.
+//   Pass A: apply the mask (the value is written back to the S tile), and keep the maximum of
+//           each row in the even and the odd lanes.
+//   Pass B: P = 2^(S - m) with m the new maximum of the row.
+// Then D = 2^(m_prev - m) for the segment goes to the diagonal of the D tile, and m to m_vec.
+// has_mask and mask_general are constants of each caller, and the function is always inlined,
+// thus each caller gets a copy without the dead branches. O((v1 - v0) * kv_rows / 32).
+static inline __attribute__((always_inline)) void fa2_softmax_segment(const fa2_softmax_args_t * a, uint32_t t, uint32_t v0, uint32_t v1,
+                                       const bool has_mask, const bool mask_general) {
+    struct hmx_fa_context * factx   = a->factx;
+    const uint32_t          n_full  = a->kv_rows / HMX_FP16_TILE_N_COLS;
+    const uint32_t          tail    = a->kv_rows % HMX_FP16_TILE_N_COLS;
+    const uint32_t          n_tiles = n_full + (tail ? 1 : 0);
+    const size_t            rt_elms = (size_t) a->n_tiles_per_bc * HMX_FP16_TILE_N_ELMS;
+    HVX_Vector * const      s_rt    = (HVX_Vector *) (a->s_tiles + t * rt_elms);
+    HVX_Vector * const      p_rt    = (HVX_Vector *) (a->p_tiles + t * rt_elms);
+    const HVX_VectorPred    q_tail  = Q6_Q_vsetq_R(tail * 4);
+
+    HVX_Vector * const m_slot   = factx->vtcm_m_vec + t;
+    const HVX_Vector   m_prev32 = *m_slot;
+    HVX_Vector         m_new32  = m_prev32;
+
+    for (uint32_t v = v0; v < v1; ++v) {
+        HVX_Vector acc;
+        if (!has_mask) {
+            acc = fa2_max(s_rt + v, n_full, n_tiles, q_tail);
+        } else {
+            const uint32_t ra = t * HMX_FP16_TILE_N_ROWS + 2 * v;
+            const uint32_t qa = hex_smin(fastdiv(ra, &factx->div_G), a->mask_rows - 1);
+            const uint32_t qb = hex_smin(fastdiv(ra + 1, &factx->div_G), a->mask_rows - 1);
+            acc = fa2_mask_max(s_rt + v, (const HVX_Vector *) (a->mask + qa * factx->mask_buf_row_stride),
+                               (const HVX_Vector *) (a->mask + qb * factx->mask_buf_row_stride), n_full, n_tiles,
+                               q_tail, mask_general);
+        }
+
+        // The maximum of row 2v in each even lane and of row 2v + 1 in each odd lane.
+        for (uint32_t s = 4; s < 128; s *= 2) {
+            acc = Q6_Vhf_vmax_VhfVhf(acc, Q6_V_vror_VR(acc, s));
+        }
+        const HVX_Vector m_prev = hvx_vec_repl_f32(Q6_V_vror_VR(m_prev32, 4 * v));
+        const HVX_Vector m_new  = Q6_Vhf_vmax_VhfVhf(m_prev, acc);
+
+        fa2_exp_row_pair(p_rt + v, s_rt + v, n_tiles, m_new);
+
+        const HVX_VectorPred q_word = Q6_Q_and_QQn(Q6_Q_vsetq_R(4 * v + 4), Q6_Q_vsetq_R(4 * v));
+        m_new32                     = Q6_V_vmux_QVV(q_word, m_new, m_new32);
+    }
+
+    const HVX_Vector     du  = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vsub_VhfVhf(m_new32, m_prev32));
+    const HVX_Vector     d32 = hvx_vec_exp2_neg_f16(du);
+    const HVX_VectorPred q_s = Q6_Q_and_QQn(Q6_Q_vsetq_R(4 * v1), Q6_Q_vsetq_R(4 * v0));
+    const HVX_Vector     off = *(const HVX_Vector *) d_tile_scatter_offsets;
+    Q6_vscatter_QRMVhV(q_s, (size_t) (a->d_tiles + t * HMX_FP16_TILE_N_ELMS), HMX_FP16_TILE_SIZE - 1, off, d32);
+    Q6_vmem_QRIV(q_s, m_slot, m_new32);
+}
+
+static void fa2_softmax_thread(unsigned int n, unsigned int i, void * data) {
+    const fa2_softmax_args_t * a       = (const fa2_softmax_args_t *) data;
+    const uint32_t             n_pairs = (a->n_rows_g + 1) / 2;
+    const uint32_t             p0      = i * a->pairs_per_thread;
+    const uint32_t             p1      = hex_smin(p0 + a->pairs_per_thread, n_pairs);
+    if (p0 >= p1) {
+        return;
+    }
+
+    struct htp_thread_trace * tr = &a->factx->octx->ctx->trace[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_FA_SFM, (uint16_t) p0);
+
+    const bool binary = a->mask ? fa2_mask_is_binary(a, p0, p1) : true;
+    for (uint32_t t = p0 / 16; t * 16 < p1; ++t) {
+        const uint32_t v0 = hex_smax(p0, t * 16) - t * 16;
+        const uint32_t v1 = hex_smin(p1, t * 16 + 16) - t * 16;
+        if (!a->mask) {
+            fa2_softmax_segment(a, t, v0, v1, false, false);
+        } else if (binary) {
+            fa2_softmax_segment(a, t, v0, v1, true, false);
+        } else {
+            fa2_softmax_segment(a, t, v0, v1, true, true);
+        }
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_FA_SFM, (uint16_t) p0);
+}
+
+static void fa2_phase_softmax(struct hmx_fa_context * factx, fa2_softmax_args_t * sargs) {
+    const uint32_t n_pairs = (sargs->n_rows_g + 1) / 2;
+    const uint32_t n       = hex_smin(factx->n_threads, n_pairs);
+    sargs->pairs_per_thread = hmx_ceil_div(n_pairs, n);
+    work_queue_run(factx->octx->ctx->work_queue, fa2_softmax_thread, sargs, n);
+}
+
+// ---- The O update with the row sum ----
+
+typedef struct {
+    __fp16 *       o_curr;
+    const __fp16 * o_prev;
+    const __fp16 * p_tiles;
+    const __fp16 * v_tiles;      // the first V tile of the block
+    const __fp16 * d_tiles;
+    const __fp16 * ones;
+    uint8_t *      hmx_scales;
+    uint32_t       n_row_tiles;
+    uint32_t       n_col_tiles;
+    uint32_t       n_tiles_per_bc;  // the P tiles between two row tiles
+    uint32_t       o_stride;        // the O tiles between two column tiles
+    uint32_t       v_stride;        // the V tiles between two column tiles
+    uint32_t       DV;
+    bool           first;           // O = P V, no rescale of the previous O
+} hmx_fa2_ou_job_t;
+
+// O(:, c) = D O_prev(:, c) + P V(:, c) for each column tile c of V, and one more column tile with
+// V = 1, thus the O tile of that column holds the row sum of P, rescaled by D as O is.
+static void hmx_fa2_o_update_worker(void * data) {
+    const hmx_fa2_ou_job_t * job   = (const hmx_fa2_ou_job_t *) data;
+    const uint32_t           n_out = job->DV / HMX_FP16_TILE_N_COLS + 1;
+    const size_t             tile  = HMX_FP16_TILE_N_ELMS;
+    __builtin_assume(job->n_row_tiles > 0);
+    __builtin_assume(job->n_col_tiles > 0);
+
+    asm volatile(HMX_SET_BIAS("%0") :: "r"((unsigned int) job->hmx_scales));
+    for (uint32_t r = 0; r < job->n_row_tiles; ++r) {
+        const __fp16 * d_diag = job->d_tiles + r * tile;
+        const __fp16 * p_row  = job->p_tiles + (size_t) r * job->n_tiles_per_bc * tile;
+        for (uint32_t c = 0; c < n_out; ++c) {
+            const size_t   o_off  = ((size_t) c * job->o_stride + r) * tile;
+            const bool     ones   = c + 1 == n_out;
+            const __fp16 * v_col  = ones ? job->ones : job->v_tiles + (size_t) c * job->v_stride * tile;
+            const size_t   v_step = ones ? 0 : tile;
+            if (!job->first) {
+                asm volatile(HMX_LOAD_MPY_F16("%1", "%2", "%0") :: "r"(2047), "r"(d_diag), "r"(job->o_prev + o_off));
+            }
+            const __fp16 * p_in = p_row;
+            const __fp16 * v_in = v_col;
+            for (uint32_t k = 0; k < job->n_col_tiles; ++k) {
+                asm volatile(HMX_LOAD_MPY_F16("%1", "%2", "%0") :: "r"(2047), "r"(p_in), "r"(v_in));
+                p_in += tile;
+                v_in += v_step;
+            }
+            asm volatile(HMX_STORE_AFTER_F16("%0", "%1") :: "r"(job->o_curr + o_off), "r"(0) : "memory");
+        }
+    }
+}
+
+// ---- The Q load and the state of a q block ----
+
+typedef struct {
+    struct hmx_fa_context *   factx;
+    const struct htp_tensor * q;
+    uint32_t                  kv_head;
+    size_t                    n_rows_g;
+    size_t                    n_rows_q;
+    size_t                    rows_per_t;
+    bool                      q_transposed;
+} fa2_q_load_args_t;
+
+static void fa2_q_load_thread(unsigned int n, unsigned int i, void * data) {
+    const fa2_q_load_args_t * a     = (const fa2_q_load_args_t *) data;
+    struct hmx_fa_context *   factx = a->factx;
+    const size_t              G     = factx->G;
+    const size_t              DK    = factx->DK;
+    const size_t              start = (size_t) i * a->rows_per_t;
+    const size_t              end   = hex_smin(start + a->rows_per_t, factx->g_br);
+
+    struct htp_thread_trace * tr = &factx->octx->ctx->trace[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_FA_Q_PREP, (uint16_t) start);
+
+    if (start < end) {
+        const size_t    g_rows_end = hex_smin(end, a->n_rows_g);
+        const uint8_t * q_flat     = (const uint8_t *) factx->vtcm_q_dma;
+        __fp16 *        q_tiles    = factx->vtcm_q_tiles;
+        if (factx->is_q_fp32) {
+            const uint32_t d_limit = DK / 32;
+            switch (d_limit) {
+                case 2:  hmx_fa_q_prep_fp32_d2(q_tiles, q_flat, start, end, g_rows_end, DK, G, a->n_rows_q, &factx->div_G, a->q_transposed); break;
+                case 4:  hmx_fa_q_prep_fp32_d4(q_tiles, q_flat, start, end, g_rows_end, DK, G, a->n_rows_q, &factx->div_G, a->q_transposed); break;
+                default: hmx_fa_q_prep_fp32(q_tiles, q_flat, start, end, g_rows_end, DK, G, a->n_rows_q, &factx->div_G, d_limit, a->q_transposed); break;
+            }
+        } else {
+            const uint32_t d_limit = DK / 64;
+            switch (d_limit) {
+                case 1:  hmx_fa_q_prep_fp16_d1(q_tiles, q_flat, start, end, g_rows_end, DK, G, a->n_rows_q, &factx->div_G, a->q_transposed); break;
+                case 2:  hmx_fa_q_prep_fp16_d2(q_tiles, q_flat, start, end, g_rows_end, DK, G, a->n_rows_q, &factx->div_G, a->q_transposed); break;
+                default: hmx_fa_q_prep_fp16(q_tiles, q_flat, start, end, g_rows_end, DK, G, a->n_rows_q, &factx->div_G, d_limit, a->q_transposed); break;
+            }
+        }
+    }
+
+    // With sinks, the first O update rescales O[0]: its DV columns are 0 (each thread writes a byte
+    // range), and its row sum column holds the sink term (thread 0 writes it below).
+    if (factx->sinks) {
+        const size_t n_row_tiles = factx->g_br / HMX_FP16_TILE_N_ROWS;
+        const size_t dv_bytes    = (size_t) (factx->DV / HMX_FP16_TILE_N_COLS) * n_row_tiles * HMX_FP16_TILE_SIZE;
+        const size_t dv_per_t    = hex_align_up(hmx_ceil_div(dv_bytes, n), 128);
+        uint8_t *    o0          = (uint8_t *) factx->vtcm_o_tiles[0];
+        if (i * dv_per_t < dv_bytes) {
+            hvx_splat_u8_a(o0 + i * dv_per_t, 0, hex_smin(dv_per_t, dv_bytes - i * dv_per_t));
+        }
+    }
+
+    // The maximum of each row: -10000, or the sink value in log2 units. One 128-byte slot of f16
+    // for each row tile. Thread 0 writes them all, from a buffer on the stack (a scalar write to
+    // VTCM is slow).
+    //
+    // With sinks, m holds the sink rounded to f16, thus the sink term of the row sum is
+    // 2^(sink - f16(sink)) and not 1. Each of the 32 columns of the row sum tile holds it, as the O
+    // update with the tile of ones gives the same sum in each column.
+    if (i == 0) {
+        const size_t n_row_tiles = factx->g_br / HMX_FP16_TILE_N_ROWS;
+        if (factx->sinks) {
+            const float * sinks  = (const float *) (uintptr_t) factx->sinks->data;
+            const size_t  o_step = (size_t) n_row_tiles * HMX_FP16_TILE_N_ELMS;
+            __fp16 *      l_til  = factx->vtcm_o_tiles[0] + (size_t) (factx->DV / HMX_FP16_TILE_N_COLS) * o_step;
+            __fp16        slot[64] __attribute__((aligned(128)));
+            __fp16        ltile[HMX_FP16_TILE_N_ELMS] __attribute__((aligned(128)));
+            for (size_t t = 0; t < n_row_tiles; ++t) {
+                for (size_t j = 0; j < HMX_FP16_TILE_N_ROWS; ++j) {
+                    const size_t r = t * HMX_FP16_TILE_N_ROWS + j;
+                    __fp16       m = (__fp16) HTP_FA_M_INITIAL_VAL;
+                    __fp16       l = (__fp16) 1.0f;
+                    if (r < a->n_rows_g) {
+                        const size_t head = a->kv_head * G + fastmodulo(r, G, &factx->div_G);
+                        const float  s    = sinks[head] * EXP_LOG2E_F;
+                        m                 = (__fp16) s;
+                        l                 = (__fp16) exp2f(s - (float) m);
+                    }
+                    slot[j]      = m;
+                    slot[j + 32] = m;
+                    // The tile vector j / 2 holds the rows j & ~1 and j | 1, interleaved for each column.
+                    for (size_t c = 0; c < HMX_FP16_TILE_N_COLS; ++c) {
+                        ltile[(j / 2) * 64 + c * 2 + (j % 2)] = l;
+                    }
+                }
+                factx->vtcm_m_vec[t] = *(const HVX_Vector *) slot;
+                for (size_t v = 0; v < HMX_FP16_TILE_N_ELMS / 64; ++v) {
+                    ((HVX_Vector *) (l_til + t * HMX_FP16_TILE_N_ELMS))[v] = ((const HVX_Vector *) ltile)[v];
+                }
+            }
+        } else {
+            const HVX_Vector v_init = hvx_vec_splat_f16(HTP_FA_M_INITIAL_VAL);
+            for (size_t t = 0; t < n_row_tiles; ++t) {
+                factx->vtcm_m_vec[t] = v_init;
+            }
+        }
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_FA_Q_PREP, (uint16_t) start);
+}
+
+static void fa2_phase_q_load(struct hmx_fa_context * factx, const struct htp_tensor * q, uint32_t kv_head,
+                             size_t n_rows_q, size_t n_rows_g) {
+    fa2_q_load_args_t args;
+    args.factx        = factx;
+    args.q            = q;
+    args.kv_head      = kv_head;
+    args.n_rows_g     = n_rows_g;
+    args.n_rows_q     = n_rows_q;
+    args.q_transposed = q->nb[1] < q->nb[2];
+    const uint32_t n  = factx->n_threads;
+    args.rows_per_t   = hex_align_up(hmx_ceil_div(factx->g_br, n), 2);
+    work_queue_run(factx->octx->ctx->work_queue, fa2_q_load_thread, &args, n);
+}
+
+// ---- The O store: each row divided by its row sum ----
+
+typedef struct {
+    struct hmx_fa_context *   factx;
+    const struct htp_tensor * dst;
+    const __fp16 *            o_tiles;
+    uint32_t                  q_start;
+    uint32_t                  kv_head;
+    uint32_t                  ib3;
+    size_t                    n_rows_g;
+    size_t                    rows_per_t;
+} fa2_o_store_args_t;
+
+// The row pairs of [start, end). A row with the row sum 0 (every score masked) gets 0, as the CPU
+// backend gives. O((end - start) * DV / 32).
+static void fa2_o_store_thread(unsigned int n, unsigned int i, void * data) {
+    const fa2_o_store_args_t * a     = (const fa2_o_store_args_t *) data;
+    struct hmx_fa_context *    factx = a->factx;
+    const size_t               G     = factx->G;
+    const size_t               DV    = factx->DV;
+    const size_t               start = (size_t) i * a->rows_per_t;
+    const size_t               end   = hex_smin(start + a->rows_per_t, a->n_rows_g);
+    if (start >= end) {
+        return;
+    }
+
+    struct htp_thread_trace * tr = &factx->octx->ctx->trace[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_O_PROC, (uint16_t) start);
+
+    const struct htp_tensor * dst      = a->dst;
+    const size_t              o_stride = (size_t) (factx->g_br / HMX_FP16_TILE_N_ROWS) * HMX_FP16_TILE_N_ELMS;
+    const __fp16 *            l_tiles  = a->o_tiles + (DV / HMX_FP16_TILE_N_COLS) * o_stride;
+    const HVX_Vector          v_zero   = Q6_V_vzero();
+
+    for (size_t r = start; r < end; r += 2) {
+        const size_t   t    = r / HMX_FP16_TILE_N_ROWS;
+        const size_t   vi   = (r % HMX_FP16_TILE_N_ROWS) / 2;
+        const bool     two  = r + 1 < end;
+        const HVX_Vector lv = ((const HVX_Vector *) (l_tiles + t * HMX_FP16_TILE_N_ELMS))[vi];
+        const HVX_VectorPair lp = hvx_vec_f16_to_f32_shuff(lv);
+
+        HVX_Vector inv[2];
+        for (int h = 0; h < 2; ++h) {
+            const HVX_Vector l = h ? Q6_V_hi_W(lp) : Q6_V_lo_W(lp);
+            inv[h]             = Q6_V_vmux_QVV(Q6_Q_vcmp_eq_VwVw(l, v_zero), v_zero, hvx_vec_inverse_f32(l));
+        }
+
+        for (int h = 0; h < (two ? 2 : 1); ++h) {
+            const size_t rr    = r + h;
+            const size_t q_idx = fastdiv(rr, &factx->div_G);
+            const size_t h_idx = rr - q_idx * G;
+            uint8_t *    out   = (uint8_t *) dst->data + (a->kv_head * G + h_idx) * dst->nb[1] +
+                            (a->q_start + q_idx) * dst->nb[2] + a->ib3 * dst->nb[3];
+            const __fp16 * o_col = a->o_tiles + t * HMX_FP16_TILE_N_ELMS;
+            if (factx->is_dst_fp32) {
+                for (size_t d = 0; d < DV / 32; ++d) {
+                    const HVX_VectorPair vp = hvx_vec_f16_to_f32_shuff(((const HVX_Vector *) (o_col + d * o_stride))[vi]);
+                    const HVX_Vector     x  = h ? Q6_V_hi_W(vp) : Q6_V_lo_W(vp);
+                    *(HVX_UVector *) (out + d * 32 * sizeof(float)) = HVX_OP_MUL_F32(x, inv[h]);
+                }
+            } else {
+                for (size_t d = 0; d < DV / 32; d += 2) {
+                    const HVX_VectorPair vp0 = hvx_vec_f16_to_f32_shuff(((const HVX_Vector *) (o_col + d * o_stride))[vi]);
+                    const HVX_VectorPair vp1 = hvx_vec_f16_to_f32_shuff(((const HVX_Vector *) (o_col + (d + 1) * o_stride))[vi]);
+                    const HVX_Vector     x0  = HVX_OP_MUL_F32(h ? Q6_V_hi_W(vp0) : Q6_V_lo_W(vp0), inv[h]);
+                    const HVX_Vector     x1  = HVX_OP_MUL_F32(h ? Q6_V_hi_W(vp1) : Q6_V_lo_W(vp1), inv[h]);
+                    *(HVX_UVector *) (out + d * 32 * sizeof(__fp16)) = hvx_vec_f32_to_f16(x0, x1);
+                }
+            }
+        }
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_O_PROC, (uint16_t) start);
+}
+
+static void fa2_phase_o_store(struct hmx_fa_context * factx, const struct htp_tensor * dst, const __fp16 * o_tiles,
+                              uint32_t q_start, uint32_t kv_head, uint32_t ib3, size_t n_rows_g) {
+    const uint32_t     n = factx->n_threads;
+    fa2_o_store_args_t args = { factx, dst, o_tiles, q_start, kv_head, ib3, n_rows_g,
+                                hex_align_up(hmx_ceil_div(n_rows_g, n), 2) };
+    work_queue_run(factx->octx->ctx->work_queue, fa2_o_store_thread, &args, n);
+}
+
+// ---- The K and V tiles ----
+
+// Zero the V rows [kv_rows, align_up(kv_rows, 32)) of the V tiles, thus a P of 0 multiplies 0 and
+// not an old value of VTCM (0 times a NaN is a NaN). An odd kv_rows has its last row zeroed by
+// the conversion. v_tiles is the first tile of the block, v_stride the tiles between two column
+// tiles. O(DV / 32 * 16).
+static void fa2_zero_v_tail(__fp16 * v_tiles, uint32_t kv_rows, size_t v_stride, uint32_t DV) {
+    const uint32_t rem = kv_rows % HMX_FP16_TILE_N_ROWS;
+    if (rem == 0) {
+        return;
+    }
+    const uint32_t t     = kv_rows / HMX_FP16_TILE_N_ROWS;
+    const uint32_t first = (rem + 1) / 2;
+    for (uint32_t d = 0; d < DV / HMX_FP16_TILE_N_COLS; ++d) {
+        HVX_Vector * tile = (HVX_Vector *) (v_tiles + ((size_t) d * v_stride + t) * HMX_FP16_TILE_N_ELMS);
+        for (uint32_t j = first; j < HMX_FP16_TILE_N_ROWS / 2; ++j) {
+            tile[j] = Q6_V_vzero();
+        }
+    }
+}
+
+// ---- The HMX queue ----
+
+// Pop the HMX jobs until *popped equals count: the pops retire in the order of the pushes.
+static inline void fa2_hmx_wait(hmx_queue_t q, uint32_t * popped, uint32_t count) {
+    while (*popped < count) {
+        hmx_queue_pop(q);
+        ++*popped;
+    }
+}
+
+static void fa2_push_mask(dma_queue * dma, struct hmx_fa_context * factx, const struct htp_tensor * mask,
+                          uint32_t q_start, uint32_t im3, uint32_t kv_start, uint32_t kv_rows, uint32_t n_rows_q) {
+    const uint32_t  slot = factx->mask_slot_next;
+    uint8_t *       dst  = (uint8_t *) factx->vtcm_mask_buf + slot * factx->mask_slot_bytes;
+    const uint8_t * src  = (const uint8_t *) mask->data + q_start * mask->nb[1] + im3 * mask->nb[3] + kv_start * sizeof(__fp16);
+    dma_queue_push(dma, dma_make_ptr(dst, src), factx->mask_buf_row_stride * sizeof(__fp16), mask->nb[1],
+                   kv_rows * sizeof(__fp16), n_rows_q);
+    factx->mask_slot_next = (slot + 1) % FA2_MASK_SLOTS;
+}
+
+// ---- The q blocks of one op ----
+
+// The state of one op of HTP_FA_KERNEL_HMX2 that the phases of its q blocks share.
+typedef struct {
+    struct hmx_fa_context *   factx;
+    const struct htp_tensor * q;
+    const struct htp_tensor * k;
+    const struct htp_tensor * v;
+    const struct htp_tensor * mask;
+    const struct htp_tensor * dst;
+    // The DMA queue of the thread that runs the op: Q, K, V and the masks, popped in the order of the
+    // pushes. The DMA engine of a hardware thread follows one descriptor chain. A push to a second
+    // queue while the engine works on the first chain links to a chain that the engine does not read,
+    // thus the transfer never starts. Thus the thread uses one queue only.
+    dma_queue *               dma;
+    // The q block whose Q transfer fa2_run pushes after the last pop of the current q block, or NULL
+    const struct fa2_qblock * q_next;
+    hmx_queue_t               hmx_q;
+    uint32_t                  hmx_pushed;
+    uint32_t                  hmx_popped;
+    hmx_fa_qk_job_t           qk_job[2];
+    hmx_fa2_ou_job_t          ou_job[2];
+    fa2_softmax_args_t        sargs;
+    uint32_t                  Bc;
+    uint32_t                  n_blocks;
+    size_t                    n_tiles_per_bc;
+    size_t                    n_row_tiles_g_br;
+    size_t                    size_k_row;
+    size_t                    size_v_row;
+    size_t                    k_row_padded;
+    size_t                    v_row_padded;
+    size_t                    qo_elem;
+    size_t                    q_src_stride;
+    bool                      q_transposed;
+    bool                      first_rescales;  // sinks: the first O update rescales O[0]
+} fa2_op_t;
+
+// One q block: its position, its rows and the queue counts of its HMX jobs.
+typedef struct fa2_qblock {
+    uint32_t        ib3;
+    uint32_t        kv_head;
+    uint32_t        q_start;
+    uint32_t        im3;
+    const uint8_t * k_head;
+    const uint8_t * v_head;
+    uint32_t        n_rows_q;
+    size_t          n_rows_g;
+    size_t          n_row_tiles;
+    uint32_t        qk_count;     // prefill: the queue count of QK(0)
+    uint32_t        ou_last;      // the queue count of the last O update
+} fa2_qblock_t;
+
+static void fa2_q_dma_push(fa2_op_t * op, const fa2_qblock_t * qb) {
+    const struct htp_tensor * q      = op->q;
+    const uint32_t            G      = op->factx->G;
+    const uint32_t            DK     = op->factx->DK;
+    const uint8_t *           q_ptr  = (const uint8_t *) q->data + qb->q_start * q->nb[1] + (qb->kv_head * G) * q->nb[2] +
+                             qb->ib3 * q->nb[3];
+    const size_t              q_row  = op->q_transposed ? qb->n_rows_q * DK * op->qo_elem : G * DK * op->qo_elem;
+    const size_t              q_rows = op->q_transposed ? G : qb->n_rows_q;
+    dma_queue_push(op->dma, dma_make_ptr(op->factx->vtcm_q_dma, q_ptr), q_row, hex_smax(op->q_src_stride, q_row), q_row,
+                   q_rows);
+}
+
+// The Q transfer of op->q_next, after the last pop of the current q block: then the transfer is the
+// next pop of the queue, and it runs during the last softmax and O update of the current q block.
+static inline void fa2_push_q_next(fa2_op_t * op) {
+    if (op->q_next) {
+        fa2_q_dma_push(op, op->q_next);
+        op->q_next = NULL;
+    }
+}
+
+static void fa2_push_qk(fa2_op_t * op, const fa2_qblock_t * qb, size_t slot, const __fp16 * k_tiles, uint32_t rows) {
+    hmx_fa_qk_job_t * j = &op->qk_job[slot];
+    j->q_tiles          = op->factx->vtcm_q_tiles;
+    j->k_tiles          = k_tiles;
+    j->s_tiles          = op->factx->vtcm_s_tiles[slot];
+    j->n_row_tiles      = qb->n_row_tiles;
+    j->n_col_tiles      = hmx_ceil_div(rows, HMX_FP16_TILE_N_COLS);
+    j->n_dot_tiles      = op->factx->DK / 32;
+    j->n_tiles_per_bc   = op->n_tiles_per_bc;
+    j->hmx_scales       = op->factx->vtcm_hmx_scales_qk;
+    hmx_queue_push(op->hmx_q, hmx_queue_make_desc(hmx_fa_qk_dot_worker, j));
+    ++op->hmx_pushed;
+}
+
+// The softmax of block b (buffer slot b % 2) of kv_rows columns, then the O update job of block gb
+// of the q block into ou_job[slot]. The block loop pushes the job.
+static void fa2_softmax_and_ou(fa2_op_t * op, const fa2_qblock_t * qb, size_t slot, const __fp16 * mask_vtcm,
+                               uint32_t kv_rows, const __fp16 * v_tiles, size_t v_stride, uint32_t gb) {
+    struct hmx_fa_context * factx = op->factx;
+    op->sargs.s_tiles             = factx->vtcm_s_tiles[slot];
+    op->sargs.p_tiles             = factx->vtcm_p_tiles[slot];
+    op->sargs.d_tiles             = factx->vtcm_d_tiles[slot];
+    op->sargs.mask                = mask_vtcm;
+    op->sargs.kv_rows             = kv_rows;
+    fa2_phase_softmax(factx, &op->sargs);
+
+    hmx_fa2_ou_job_t * ou = &op->ou_job[slot];
+    ou->o_curr            = factx->vtcm_o_tiles[(gb + 1) % 2];
+    ou->o_prev            = factx->vtcm_o_tiles[gb % 2];
+    ou->p_tiles           = factx->vtcm_p_tiles[slot];
+    ou->v_tiles           = v_tiles;
+    ou->d_tiles           = factx->vtcm_d_tiles[slot];
+    ou->ones              = factx->vtcm_ones;
+    ou->hmx_scales        = factx->vtcm_hmx_scales_id;
+    ou->n_row_tiles       = qb->n_row_tiles;
+    ou->n_col_tiles       = hmx_ceil_div(kv_rows, HMX_FP16_TILE_N_COLS);
+    ou->n_tiles_per_bc    = op->n_tiles_per_bc;
+    ou->o_stride          = op->n_row_tiles_g_br;
+    ou->v_stride          = v_stride;
+    ou->DV                = factx->DV;
+    ou->first             = gb == 0 && !op->first_rescales;}
+
+// The start of a q block: its Q (q_pushed tells that the transfer is in the queue, as the next pop), the
+// Q tiles and the state, then the first jobs of the block loop: the K, V and mask transfers of blocks 0
+// and 1, the K tiles of block 0 and its QK.
+static void fa2_prepare(fa2_op_t * op, fa2_qblock_t * qb, bool q_pushed) {
+    struct hmx_fa_context * factx = op->factx;
+    const uint32_t          Bc    = op->Bc;
+    const uint32_t          nek1  = factx->n_kv;
+    if (!q_pushed) {
+        fa2_q_dma_push(op, qb);
+    }
+    dma_queue_pop(op->dma);
+    fa2_phase_q_load(factx, op->q, qb->kv_head, qb->n_rows_q, qb->n_rows_g);
+
+    for (uint32_t b = 0; b < 2 && b < op->n_blocks; ++b) {
+        const uint32_t rows = hex_smin(Bc, nek1 - b * Bc);
+        dma_queue_push(op->dma, dma_make_ptr(factx->vtcm_k_fp16[b], qb->k_head + (size_t) b * Bc * op->k->nb[1]),
+                       op->k_row_padded, op->k->nb[1], op->size_k_row, rows);
+        dma_queue_push(op->dma, dma_make_ptr(factx->vtcm_v_fp16[b], qb->v_head + (size_t) b * Bc * op->v->nb[1]),
+                       op->v_row_padded, op->v->nb[1], op->size_v_row, rows);
+        if (op->mask) {
+            fa2_push_mask(op->dma, factx, op->mask, qb->q_start, qb->im3, b * Bc, rows, qb->n_rows_q);
+        }
+    }
+    void * k0 = dma_queue_pop(op->dma).dst;
+    fa_phase_k_interleave(factx, hex_smin(Bc, nek1), op->k_row_padded / 2, k0, 0, 0);
+    fa2_push_qk(op, qb, 0, factx->vtcm_k_tiles[0], hex_smin(Bc, nek1));
+    qb->qk_count = op->hmx_pushed;
+}
+
+// The block loop of a q block after fa2_prepare. It ends with the last O update in the queue, and its
+// queue count in qb->ou_last. In the last block, after the last pop of the DMA queue, it pushes the Q
+// transfer of op->q_next. Refer to hmx_fa2_vtcm_layout for the buffers.
+static void fa2_run(fa2_op_t * op, fa2_qblock_t * qb) {
+    struct hmx_fa_context * factx = op->factx;
+    const uint32_t          Bc    = op->Bc;
+    const uint32_t          nek1  = factx->n_kv;
+    const size_t            tpb   = op->n_tiles_per_bc;
+
+    // The pipeline of hmx_flash_attn_ext. The DMA order is K(0), V(0), M(0), K(1), V(1), M(1), then K, V
+    // and M of block b + 2 at the end of block b. At block b the HVX converts V(b) and K(b + 1)
+    // and runs the softmax of b, while the HMX runs the O update of b - 1 and the QK of b + 1.
+    uint32_t qk_count = qb->qk_count;
+    for (uint32_t b = 0; b < op->n_blocks; ++b) {
+        const uint32_t kv_start = b * Bc;
+        const uint32_t kv_rows  = hex_smin(Bc, nek1 - kv_start);
+        const size_t   slot     = b % 2;
+
+        void * cur_v = dma_queue_pop(op->dma).dst;
+        fa_phase_v_interleave(factx, kv_rows, op->v_row_padded / 2, cur_v, factx->vtcm_v_tiles[slot], tpb, kv_start);
+        fa2_zero_v_tail(factx->vtcm_v_tiles[slot], kv_rows, tpb, factx->DV);
+        const __fp16 * mask_vtcm = op->mask ? (const __fp16 *) dma_queue_pop(op->dma).dst : NULL;
+        if (b + 1 == op->n_blocks) {
+            fa2_push_q_next(op);
+        }
+
+        uint32_t ou_prev_count = 0;
+        if (b > 0) {
+            hmx_queue_push(op->hmx_q, hmx_queue_make_desc(hmx_fa2_o_update_worker, &op->ou_job[1 - slot]));
+            ou_prev_count = ++op->hmx_pushed;
+        }
+
+        uint32_t qk_next = 0;
+        if (b + 1 < op->n_blocks) {
+            const uint32_t nrows = hex_smin(Bc, nek1 - (b + 1) * Bc);
+            void *         nk    = dma_queue_pop(op->dma).dst;
+            fa_phase_k_interleave(factx, nrows, op->k_row_padded / 2, nk, (b + 1) * Bc, 1 - slot);
+            fa2_push_qk(op, qb, 1 - slot, factx->vtcm_k_tiles[1 - slot], nrows);
+            qk_next = op->hmx_pushed;
+        }
+
+        fa2_hmx_wait(op->hmx_q, &op->hmx_popped, qk_count);
+        fa2_softmax_and_ou(op, qb, slot, mask_vtcm, kv_rows, factx->vtcm_v_tiles[slot], tpb, b);
+
+        if (b > 0) {
+            fa2_hmx_wait(op->hmx_q, &op->hmx_popped, ou_prev_count);
+        }
+        if (b + 2 < op->n_blocks) {
+            const uint32_t nb   = b + 2;
+            const uint32_t rows = hex_smin(Bc, nek1 - nb * Bc);
+            dma_queue_push(op->dma, dma_make_ptr(factx->vtcm_k_fp16[slot], qb->k_head + (size_t) nb * Bc * op->k->nb[1]),
+                           op->k_row_padded, op->k->nb[1], op->size_k_row, rows);
+            dma_queue_push(op->dma, dma_make_ptr(factx->vtcm_v_fp16[slot], qb->v_head + (size_t) nb * Bc * op->v->nb[1]),
+                           op->v_row_padded, op->v->nb[1], op->size_v_row, rows);
+            if (op->mask) {
+                fa2_push_mask(op->dma, factx, op->mask, qb->q_start, qb->im3, nb * Bc, rows, qb->n_rows_q);
+            }
+        }
+        qk_count = qk_next;
+    }
+    hmx_queue_push(op->hmx_q, hmx_queue_make_desc(hmx_fa2_o_update_worker, &op->ou_job[(op->n_blocks - 1) % 2]));
+    qb->ou_last = ++op->hmx_pushed;
+}
+
+// The end of a q block: its last O update, then the O store.
+static void fa2_finish(fa2_op_t * op, const fa2_qblock_t * qb) {
+    fa2_hmx_wait(op->hmx_q, &op->hmx_popped, qb->ou_last);
+    fa2_phase_o_store(op->factx, op->dst, op->factx->vtcm_o_tiles[op->n_blocks % 2], qb->q_start, qb->kv_head, qb->ib3,
+                      qb->n_rows_g);
+}
+
+int hmx_flash_attn_ext_v2(struct htp_ops_context * octx) {
+    const struct htp_tensor * q    = octx->src[0];
+    const struct htp_tensor * k    = octx->src[1];
+    const struct htp_tensor * v    = octx->src[2];
+    const struct htp_tensor * mask = (octx->src[3] && octx->src[3]->data) ? octx->src[3] : NULL;
+    const struct htp_tensor * dst  = octx->dst;
+    struct htp_context * const ctx = octx->ctx;
+    struct htp_thread_trace *  tr_hvx = &ctx->trace[0];
+
+    if (!ctx->hmx_enabled) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+
+    const struct htp_fa_kernel_params * kparams = (const struct htp_fa_kernel_params *) octx->kernel_params;
+    const uint32_t DK         = q->ne[0];
+    const uint32_t DV         = v->ne[0];
+    const uint32_t neq1       = q->ne[1];
+    const uint32_t neq3       = q->ne[3];
+    const uint32_t nek1       = k->ne[1];
+    const uint32_t n_kv_heads = k->ne[2];
+    if (DK % 64 != 0 || DV % 64 != 0 || DK != DV || nek1 == 0 || (mask && mask->ne[2] != 1)) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    // The layout and the loops below need these relations of the plan of the host.
+    if (kparams->Br == 0 || kparams->Bc == 0 || kparams->G == 0 ||
+        kparams->u.hmx.g_br != hex_align_up((uint32_t) kparams->G * kparams->Br, HMX_FP16_TILE_N_ROWS) ||
+        kparams->n_kv_blocks != (nek1 + kparams->Bc - 1) / kparams->Bc || kparams->G * n_kv_heads != q->ne[2]) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+
+    struct hmx_fa_context factx;
+    memset(&factx, 0, sizeof(factx));
+    factx.octx        = octx;
+    factx.sinks       = octx->src[4];
+    factx.k           = k;
+    factx.v           = v;
+    factx.n_threads   = kparams->n_threads;
+    factx.DK          = DK;
+    factx.DV          = DV;
+    factx.n_kv        = nek1;
+    factx.n_kv_heads  = n_kv_heads;
+    factx.n_heads     = q->ne[2];
+    factx.G           = kparams->G;
+    factx.div_G       = kparams->u.hmx.div_G;
+    factx.neq1        = neq1;
+    factx.Br          = kparams->Br;
+    factx.Bc          = kparams->Bc;
+    factx.g_br        = kparams->u.hmx.g_br;
+    factx.n_kv_blocks = kparams->n_kv_blocks;
+    factx.is_q_fp32   = kparams->is_q_fp32 != 0;
+    factx.is_dst_fp32 = kparams->is_dst_fp32 != 0;
+    if (mask) {
+        factx.src3_div3 = kparams->src3_div3;
+    }
+
+    const uint32_t Br = factx.Br, Bc = factx.Bc, g_br = factx.g_br, G = factx.G;
+
+    struct hmx_fa2_vtcm_layout L;
+    hmx_fa2_vtcm_layout_build(&L, G, DK, DV, Br, Bc, factx.is_q_fp32);
+    if (L.total_bytes > ctx->vtcm_size) {
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+
+    uint8_t * const base = ctx->vtcm_base;
+    factx.vtcm_q_tiles       = VTCM_LAYOUT_PTR(__fp16, base, L.off_q_tiles);
+    factx.vtcm_q_dma         = VTCM_LAYOUT_PTR(__fp16, base, L.off_q_dma);
+    factx.vtcm_o_tiles[0]    = VTCM_LAYOUT_PTR(__fp16, base, L.off_o_tiles[0]);
+    factx.vtcm_o_tiles[1]    = VTCM_LAYOUT_PTR(__fp16, base, L.off_o_tiles[1]);
+    factx.vtcm_d_tiles[0]    = VTCM_LAYOUT_PTR(__fp16, base, L.off_d_tiles[0]);
+    factx.vtcm_d_tiles[1]    = VTCM_LAYOUT_PTR(__fp16, base, L.off_d_tiles[1]);
+    factx.vtcm_ones          = VTCM_LAYOUT_PTR(__fp16, base, L.off_ones);
+    factx.vtcm_hmx_scales_id = VTCM_LAYOUT_PTR(uint8_t, base, L.off_scales);
+    factx.vtcm_hmx_scales_qk = VTCM_LAYOUT_PTR(uint8_t, base, L.off_scales + 256);
+    factx.vtcm_m_vec         = VTCM_LAYOUT_PTR(HVX_Vector, base, L.off_m_vec);
+    factx.vtcm_mask_buf      = VTCM_LAYOUT_PTR(__fp16, base, L.off_mask_buf);
+    factx.vtcm_k_tiles[0]    = VTCM_LAYOUT_PTR(__fp16, base, L.off_k_tiles[0]);
+    factx.vtcm_v_tiles[0]    = VTCM_LAYOUT_PTR(__fp16, base, L.off_v_tiles[0]);
+    factx.vtcm_k_tiles[1]    = VTCM_LAYOUT_PTR(__fp16, base, L.off_k_tiles[1]);
+    factx.vtcm_v_tiles[1]    = VTCM_LAYOUT_PTR(__fp16, base, L.off_v_tiles[1]);
+    factx.vtcm_k_fp16[0]     = VTCM_LAYOUT_PTR(__fp16, base, L.off_k_dma[0]);
+    factx.vtcm_k_fp16[1]     = VTCM_LAYOUT_PTR(__fp16, base, L.off_k_dma[1]);
+    factx.vtcm_v_fp16[0]     = VTCM_LAYOUT_PTR(__fp16, base, L.off_v_dma[0]);
+    factx.vtcm_v_fp16[1]     = VTCM_LAYOUT_PTR(__fp16, base, L.off_v_dma[1]);
+    factx.vtcm_s_tiles[0]    = VTCM_LAYOUT_PTR(__fp16, base, L.off_s_tiles[0]);
+    factx.vtcm_s_tiles[1]    = VTCM_LAYOUT_PTR(__fp16, base, L.off_s_tiles[1]);
+    factx.vtcm_p_tiles[0]    = VTCM_LAYOUT_PTR(__fp16, base, L.off_p_tiles[0]);
+    factx.vtcm_p_tiles[1]    = VTCM_LAYOUT_PTR(__fp16, base, L.off_p_tiles[1]);
+    factx.mask_slot_bytes    = L.mask_slot_bytes;
+    factx.mask_buf_row_stride = L.m_line_bytes / sizeof(__fp16);
+    factx.o_tile_bytes       = L.o_tile_bytes;
+    factx.d_tile_bytes       = L.d_tile_bytes;
+
+    // The QK tiles come out scaled by scale * log2(e), thus the softmax works in base 2.
+    hmx_init_column_scales(factx.vtcm_hmx_scales_id, Q6_V_vsplat_R(0x3c00));
+    hmx_init_column_scales(factx.vtcm_hmx_scales_qk, hvx_vec_splat_f16((__fp16) (kparams->scale * EXP_LOG2E_F)));
+    hvx_splat_f16_a(factx.vtcm_ones, 1.0f, HMX_FP16_TILE_N_ELMS);
+    // The softmax writes only the diagonal of each D tile, thus the rest stays 0 for the whole op.
+    hvx_splat_u8_a(factx.vtcm_d_tiles[0], 0, 2 * L.d_tile_bytes);
+
+    if (octx->flags & HTP_OPFLAGS_SKIP_COMPUTE) {
+        return HTP_STATUS_OK;
+    }
+
+    // Multi-device: split the q blocks across the devices
+    const uint32_t n_q_blocks  = (neq1 + Br - 1) / Br;
+    uint32_t       q_start_min = 0;
+    uint32_t       q_start_max = neq1;
+    if (ctx->mdev.count > 1) {
+        const struct htp_tensor_mdev_range range = htp_tensor_mdev_partition(n_q_blocks, htp_tensor_mdev_data_aligned(dst) ? 1 : 0,
+                                                                             ctx->mdev.idx, ctx->mdev.count, &ctx->mdev.count_div);
+        if (range.count == 0) {
+            return HTP_STATUS_OK;
+        }
+        q_start_min = range.start * Br;
+        q_start_max = MIN((range.start + range.count) * Br, neq1);
+    }
+
+    fa2_op_t op;
+    memset(&op, 0, sizeof(op));
+    op.factx            = &factx;
+    op.q                = q;
+    op.k                = k;
+    op.v                = v;
+    op.mask             = mask;
+    op.dst              = dst;
+    // The queue of thread 0, as in hmx_flash_attn_ext.
+    op.dma              = ctx->dma[0];
+    op.hmx_q            = ctx->hmx_queue;
+    op.Bc               = Bc;
+    op.n_blocks         = factx.n_kv_blocks;
+    op.n_tiles_per_bc   = Bc / HMX_FP16_TILE_N_COLS;
+    op.n_row_tiles_g_br = g_br / HMX_FP16_TILE_N_ROWS;
+    op.size_k_row       = htp_tensor_get_row_size(k->type, DK);
+    op.size_v_row       = htp_tensor_get_row_size(v->type, DV);
+    op.k_row_padded     = hex_round_up(DK * sizeof(__fp16), 128);
+    op.v_row_padded     = hex_round_up(DV * sizeof(__fp16), 128);
+    op.qo_elem          = factx.is_q_fp32 ? sizeof(float) : sizeof(__fp16);
+    op.q_transposed     = q->nb[1] < q->nb[2];
+    op.q_src_stride     = op.q_transposed ? q->nb[2] : q->nb[1];
+    op.first_rescales   = factx.sinks != NULL;
+    op.sargs.factx          = &factx;
+    op.sargs.n_tiles_per_bc = op.n_tiles_per_bc;
+
+    // The q blocks in the order ib3, KV head, q start. The next q block starts (fa2_prepare) before the
+    // current one ends (fa2_finish), thus its Q load and its first QK run while the HMX does the last O
+    // update of the current q block, when that is safe: not with sinks (the Q load writes O[0]). With or
+    // without sinks, the Q transfer of the next q block goes into the queue after the last pop of the
+    // current q block (fa2_run).
+    const uint32_t n_qb_head = (q_start_max - q_start_min + Br - 1) / Br;
+    const uint32_t n_items   = neq3 * n_kv_heads * n_qb_head;
+    fa2_qblock_t   qb[2];
+    bool           prepared = false, q_pushed = false;
+
+    for (uint32_t it = 0; it < n_items; ++it) {
+        fa2_qblock_t * cur = &qb[it % 2];
+        {
+            const uint32_t ib3     = it / (n_kv_heads * n_qb_head);
+            const uint32_t kv_head = (it / n_qb_head) % n_kv_heads;
+            const uint32_t q_start = q_start_min + (it % n_qb_head) * Br;
+            const uint32_t ik3     = fastdiv(ib3, &kparams->broadcast_rk3);
+            const uint32_t iv3     = fastdiv(ib3, &kparams->broadcast_rv3);
+            cur->ib3         = ib3;
+            cur->kv_head     = kv_head;
+            cur->q_start     = q_start;
+            cur->im3         = mask ? fastmodulo(ib3, mask->ne[3], &factx.src3_div3) : 0;
+            cur->k_head      = (const uint8_t *) k->data + kv_head * k->nb[2] + ik3 * k->nb[3];
+            cur->v_head      = (const uint8_t *) v->data + kv_head * v->nb[2] + iv3 * v->nb[3];
+            cur->n_rows_q    = hex_smin(Br, neq1 - q_start);
+            cur->n_rows_g    = (size_t) cur->n_rows_q * G;
+            cur->n_row_tiles = hex_align_up(cur->n_rows_g, HMX_FP16_TILE_N_ROWS) / HMX_FP16_TILE_N_ROWS;
+        }
+        op.sargs.mask_rows = cur->n_rows_q;
+        op.sargs.n_rows_g  = cur->n_rows_g;
+
+        if (!prepared) {
+            fa2_prepare(&op, cur, q_pushed);
+        }
+        prepared = false;
+
+        const bool may_ahead = it + 1 < n_items;
+        q_pushed             = false;
+        if (may_ahead) {
+            fa2_qblock_t * nxt = &qb[(it + 1) % 2];
+            const uint32_t n_it = it + 1;
+            nxt->ib3     = n_it / (n_kv_heads * n_qb_head);
+            nxt->kv_head = (n_it / n_qb_head) % n_kv_heads;
+            nxt->q_start = q_start_min + (n_it % n_qb_head) * Br;
+            nxt->n_rows_q = hex_smin(Br, neq1 - nxt->q_start);
+            op.q_next     = nxt;
+            q_pushed      = true;
+        }
+
+        fa2_run(&op, cur);
+
+        if (may_ahead && !op.first_rescales) {
+            fa2_qblock_t * nxt = &qb[(it + 1) % 2];
+            const uint32_t ik3 = fastdiv(nxt->ib3, &kparams->broadcast_rk3);
+            const uint32_t iv3 = fastdiv(nxt->ib3, &kparams->broadcast_rv3);
+            nxt->im3         = mask ? fastmodulo(nxt->ib3, mask->ne[3], &factx.src3_div3) : 0;
+            nxt->k_head      = (const uint8_t *) k->data + nxt->kv_head * k->nb[2] + ik3 * k->nb[3];
+            nxt->v_head      = (const uint8_t *) v->data + nxt->kv_head * v->nb[2] + iv3 * v->nb[3];
+            nxt->n_rows_g    = (size_t) nxt->n_rows_q * G;
+            nxt->n_row_tiles = hex_align_up(nxt->n_rows_g, HMX_FP16_TILE_N_ROWS) / HMX_FP16_TILE_N_ROWS;
+            op.sargs.mask_rows = nxt->n_rows_q;
+            op.sargs.n_rows_g  = nxt->n_rows_g;
+            fa2_prepare(&op, nxt, true);
+            q_pushed = false;
+            prepared = true;
+        }
+        fa2_finish(&op, cur);
+    }
+    fa2_hmx_wait(op.hmx_q, &op.hmx_popped, op.hmx_pushed);
+
+    return HTP_STATUS_OK;
+}
