+// ============================================================================
+// The tile-layout kernel HTP_FA_KERNEL_HMX2
+// ============================================================================
+//
+// The softmax reads the S tiles of the HMX in their tile layout: one HVX vector of a 32x32 f16
+// tile holds two rows, with the values of the two rows interleaved for each column. Thus the
+// softmax has no row buffer and no transpose. The HMX computes the row sum of P: V has one more
+// column tile of ones, thus the O tile of that column holds the row sum l, and the rescale by the
+// diagonal D keeps it up to date as it does for O. The O store divides each row by l.
+//
+// The kernel streams the K and V rows of each KV block of Bc rows through the DMA and the
+// conversion, as HTP_FA_KERNEL_HMX does.
+
+// The cost of a plan, in core cycles at 2112 MHz. The constants are v79 measurements: the phase trace
+// of the phone stage sweep (GGML_HEXAGON_PROFILE=3, 2026-09-24, head dim 256, 16 query heads, 4 KV
+// heads, 1024 queries, 4096 KV rows) and the kernel lab (tools/htp-lab, target fa2). The HVX terms
+// divide over the threads and the HMX terms do not, thus the plan can change with the thread count.
+// A core with other HVX or HMX rates needs its own constants.
+
+// One 32x32x32 f16 tile MAC of the HMX with the job overhead (7.9 to 9.7 measured while busy).
+#define FA_COST_TILE          9
+// One work_queue_run: the dispatch, the wait of the workers and the barrier.
+#define FA_COST_PHASE         3000
+// The HVX conversion of one K row plus one V row of 256 values into the tiles, for one thread
+// (K_PREP and V_PREP of the trace: 9 us and 5 us for 1024 Q8_0 rows on 6 threads). The cost grows
+// with DK + DV, refer to hmx_fa_cost_conv.
+#define FA_COST_CONV_Q8_0     173
+#define FA_COST_CONV_F16      128
+// The softmax: one tile vector (2 rows by 32 columns) on one thread, and the fixed work of one row
+// pair in one KV block (the kernel lab, target fa2, one thread: 25.6 cycles for each tile vector at
+// 1024 columns, 161 cycles for a row pair of 64 columns).
+#define FA_COST_SMX2_VEC      28
+#define FA_COST_SMX2_PAIR     110
+// The Q preparation and the O store of one q block, per 64 values on one thread.
+#define FA_COST_QPREP_64      8
+#define FA_COST_OSTORE_64     24
+
+// The cycles of the HVX conversion of kv_rows K rows of DK values and V rows of DV values on one
+// thread. The constants hold the cost at DK = DV = 256. DV = 0 gives the cost of the K rows only.
+// O(1).
+static inline uint64_t hmx_fa_cost_conv(size_t kv_rows, size_t DK, size_t DV, bool kv_q8_0) {
+    return (uint64_t) kv_rows * (kv_q8_0 ? FA_COST_CONV_Q8_0 : FA_COST_CONV_F16) * (DK + DV) / 512;
+}
+
+// VTCM region layout of HTP_FA_KERNEL_HMX2. The host computes the total for the plan search, and the
+// device places each region at its offset: two K and two V tile blocks of Bc rows, and two DMA buffers
+// of one block for K and for V (off_k_dma, off_v_dma).
+struct hmx_fa2_vtcm_layout {
+    size_t off_q_tiles;
+    size_t off_q_dma;
+    size_t off_o_tiles[2];
+    size_t off_d_tiles[2];
+    size_t off_ones;
+    size_t off_scales;         // the HMX output scales: 1.0 at +0, the QK scale at +256
+    size_t off_m_vec;
+    size_t off_mask_buf;
+    size_t off_k_tiles[2];
+    size_t off_v_tiles[2];
+    size_t off_k_dma[2];
+    size_t off_v_dma[2];
+    size_t off_s_tiles[2];
+    size_t off_p_tiles[2];
+
+    size_t o_tile_bytes;       // one O buffer: g_br rows by DV + 32 columns
+    size_t d_tile_bytes;       // one D buffer: g_br / 32 diagonal tiles
+    size_t m_line_bytes;       // one mask row
+    size_t mask_slot_bytes;    // one slot of the mask ring: Br mask rows
+
+    size_t total_bytes;
+};
+
+#define FA2_MASK_SLOTS 4
+
+static inline size_t fa2_align_tile(size_t v) {
+    return hex_align_up(v, HTP_FA_HMX_TILE_SIZE);
+}
+
+static inline void hmx_fa2_vtcm_layout_build(struct hmx_fa2_vtcm_layout * L, size_t gqa_factor, size_t DK,
+                                             size_t DV, size_t Br, size_t Bc, bool is_q_fp32) {
+    const size_t g_br         = hex_align_up(gqa_factor * Br, HMX_FP16_TILE_N_ROWS);
+    const size_t n_row_tiles  = g_br / HMX_FP16_TILE_N_ROWS;
+    const size_t k_row_padded = hex_align_up(DK * sizeof(__fp16), 128);
+    const size_t v_row_padded = hex_align_up(DV * sizeof(__fp16), 128);
+    const size_t kv_rows      = hex_align_up(Bc, HMX_FP16_TILE_N_ROWS);
+
+    const size_t q_tile_size  = fa2_align_tile(g_br * DK * sizeof(__fp16));
+    const size_t q_dma_size   = fa2_align_tile(g_br * DK * (is_q_fp32 ? sizeof(float) : sizeof(__fp16)));
+    const size_t o_tile_size  = fa2_align_tile(g_br * (DV + HMX_FP16_TILE_N_COLS) * sizeof(__fp16));
+    const size_t d_tile_size  = n_row_tiles * HTP_FA_HMX_TILE_SIZE;
+    const size_t m_vec_size   = fa2_align_tile(n_row_tiles * 128);
+    const size_t m_line_size  = hex_align_up(Bc * sizeof(__fp16), 128);
+    const size_t mask_slot    = hex_align_up(Br * m_line_size, 256);
+    const size_t k_tile_size  = fa2_align_tile(kv_rows * DK * sizeof(__fp16));
+    const size_t v_tile_size  = fa2_align_tile(kv_rows * DV * sizeof(__fp16));
+    const size_t s_tile_size  = fa2_align_tile(g_br * kv_rows * sizeof(__fp16));
+    const size_t k_dma_size   = fa2_align_tile(Bc * k_row_padded);
+    const size_t v_dma_size   = fa2_align_tile(Bc * v_row_padded);
+
+    memset(L, 0, sizeof(*L));
+    size_t off = 0;
+    VTCM_LAYOUT_ALLOC(off, off_q_tiles, q_tile_size);
+    VTCM_LAYOUT_ALLOC(off, off_q_dma, q_dma_size);
+    VTCM_LAYOUT_ALLOC(off, off_o_tiles[0], o_tile_size);
+    VTCM_LAYOUT_ALLOC(off, off_o_tiles[1], o_tile_size);
+    VTCM_LAYOUT_ALLOC(off, off_d_tiles[0], d_tile_size);
+    VTCM_LAYOUT_ALLOC(off, off_d_tiles[1], d_tile_size);
+    VTCM_LAYOUT_ALLOC(off, off_ones, HTP_FA_HMX_TILE_SIZE);
+    VTCM_LAYOUT_ALLOC(off, off_scales, HTP_FA_HMX_TILE_SIZE);
+    VTCM_LAYOUT_ALLOC(off, off_m_vec, m_vec_size);
+    VTCM_LAYOUT_ALLOC(off, off_mask_buf, fa2_align_tile(mask_slot * FA2_MASK_SLOTS));
+    // The K conversion writes two adjacent tiles with one vscatter of a 4 KB region, thus a K tile
+    // region starts on 4 KB: then no scatter region crosses a boundary of the VTCM mapping (the
+    // simulator maps 1 MB pages).
+    off = hex_align_up(off, 2 * HTP_FA_HMX_TILE_SIZE);
+    VTCM_LAYOUT_ALLOC(off, off_k_tiles[0], k_tile_size);
+    VTCM_LAYOUT_ALLOC(off, off_v_tiles[0], v_tile_size);
+    off = hex_align_up(off, 2 * HTP_FA_HMX_TILE_SIZE);
+    VTCM_LAYOUT_ALLOC(off, off_k_tiles[1], k_tile_size);
+    VTCM_LAYOUT_ALLOC(off, off_v_tiles[1], v_tile_size);
+    VTCM_LAYOUT_ALLOC(off, off_k_dma[0], k_dma_size);
+    VTCM_LAYOUT_ALLOC(off, off_k_dma[1], k_dma_size);
+    VTCM_LAYOUT_ALLOC(off, off_v_dma[0], v_dma_size);
+    VTCM_LAYOUT_ALLOC(off, off_v_dma[1], v_dma_size);
+    VTCM_LAYOUT_ALLOC(off, off_s_tiles[0], s_tile_size);
+    VTCM_LAYOUT_ALLOC(off, off_s_tiles[1], s_tile_size);
+    VTCM_LAYOUT_ALLOC(off, off_p_tiles[0], s_tile_size);
+    VTCM_LAYOUT_ALLOC(off, off_p_tiles[1], s_tile_size);
+
+    L->o_tile_bytes    = o_tile_size;
+    L->d_tile_bytes    = d_tile_size;
+    L->m_line_bytes    = m_line_size;
+    L->mask_slot_bytes = mask_slot;
+    L->total_bytes     = off;
+}
+
+static inline size_t hmx_fa2_compute_vtcm_usage(size_t gqa_factor, size_t DK, size_t DV, size_t Br, size_t Bc,
+                                                bool is_q_fp32) {
+    struct hmx_fa2_vtcm_layout L;
+    hmx_fa2_vtcm_layout_build(&L, gqa_factor, DK, DV, Br, Bc, is_q_fp32);
+    return L.total_bytes;
+}
+
+// The cycles of one KV block: the HMX (QK of the next block and O update of the
+// last block) and the HVX (the K and V conversion and the softmax) run at the same time. O(1).
+static inline uint64_t hmx_fa2_cost_block(size_t rows_g, size_t cols, size_t DK, size_t DV, size_t n_threads,
+                                          bool kv_q8_0) {
+    const size_t   n_row_tiles = hmx_ceil_div(rows_g, HMX_FP16_TILE_N_ROWS);
+    const size_t   n_col_tiles = hmx_ceil_div(cols, HMX_FP16_TILE_N_COLS);
+    const size_t   pairs_thr   = hmx_ceil_div(hmx_ceil_div(rows_g, 2), n_threads);
+    const uint64_t smx  = (uint64_t) pairs_thr * (n_col_tiles * FA_COST_SMX2_VEC + FA_COST_SMX2_PAIR) + FA_COST_PHASE;
+    const uint64_t conv = hmx_fa_cost_conv(cols, DK, DV, kv_q8_0) / n_threads + 2 * FA_COST_PHASE;
+    const uint64_t hmx = (uint64_t) (n_row_tiles * n_col_tiles * (DK / 32) +
+                                     n_row_tiles * (DV / 32 + 1) * (n_col_tiles + 1)) * FA_COST_TILE;
+    return smx + conv > hmx ? smx + conv : hmx;
+}
+
+// The cycles of one q block with rows_g Q rows. O(1).
+static inline uint64_t hmx_fa2_cost_q_block(size_t rows_g, size_t kv_len, size_t Bc, size_t DK, size_t DV,
+                                            size_t n_threads, bool kv_q8_0) {
+    const size_t   n_full      = kv_len / Bc;
+    const size_t   rem         = kv_len % Bc;
+    const size_t   n_row_tiles = hmx_ceil_div(rows_g, HMX_FP16_TILE_N_ROWS);
+    const size_t   first_cols  = Bc < kv_len ? Bc : kv_len;
+    const size_t   first_tiles = hmx_ceil_div(first_cols, HMX_FP16_TILE_N_COLS);
+    const uint64_t prep  = (uint64_t) rows_g * DK / 64 * FA_COST_QPREP_64 / n_threads + FA_COST_PHASE;
+    const uint64_t fill  = (uint64_t) n_row_tiles * first_tiles * (DK / 32) * FA_COST_TILE +
+                          hmx_fa_cost_conv(first_cols, DK, 0, kv_q8_0) / n_threads;
+    const uint64_t drain = (uint64_t) n_row_tiles * (DV / 32 + 1) * (first_tiles + 1) * FA_COST_TILE +
+                           (uint64_t) rows_g * DV / 64 * FA_COST_OSTORE_64 / n_threads + FA_COST_PHASE;
+    uint64_t cost = prep + fill + drain + n_full * hmx_fa2_cost_block(rows_g, Bc, DK, DV, n_threads, kv_q8_0);
+    if (rem) {
+        cost += hmx_fa2_cost_block(rows_g, rem, DK, DV, n_threads, kv_q8_0);
+    }
+    return cost;
+}
+
+// The (Br, Bc) search: Br in steps of the GQA row unit, Bc in steps of 64, each pair
+// whose layout fits the VTCM, and the pair with the lowest modeled cost. The block sizes change the
+// rounding of the online softmax (one rescale for each Bc boundary), as they do for
+// HTP_FA_KERNEL_HMX. O(Br_max / br_unit * Bc_limit / 64).
+static inline int hmx_fa2_find_chunk_size(size_t * Br_out,
+                                          size_t * Bc_out,
+                                          size_t   gqa_factor,
+                                          size_t   DK,
+                                          size_t   DV,
+                                          size_t   qo_len,
+                                          size_t   kv_len,
+                                          size_t   vtcm_budget,
+                                          size_t   n_threads,
+                                          bool     is_q_fp32,
+                                          bool     kv_q8_0) {
+    const size_t br_unit  = hmx_ceil_div(HMX_FP16_TILE_N_ROWS, gqa_factor);
+    const size_t bc_unit  = HMX_FP16_TILE_N_COLS * 2;
+    const size_t Br_max   = qo_len >= br_unit ? hex_align_down(qo_len, br_unit) : br_unit;
+    const size_t Bc_limit = kv_len >= bc_unit ? hex_align_down(kv_len, bc_unit) : bc_unit;
+    const size_t n_thr    = n_threads > 0 ? n_threads : 1;
+
+    uint64_t best_cost = UINT64_MAX;
+    size_t   best_Br = 0, best_Bc = 0;
+
+    for (size_t Br = Br_max; Br >= br_unit; Br -= br_unit) {
+        // The largest Bc that fits for this Br. The VTCM use grows with Bc.
+        size_t Bc_fit = 0;
+        for (size_t Bc = Bc_limit; Bc >= bc_unit; Bc -= bc_unit) {
+            if (hmx_fa2_compute_vtcm_usage(gqa_factor, DK, DV, Br, Bc, is_q_fp32) <= vtcm_budget) {
+                Bc_fit = Bc;
+                break;
+            }
+        }
+        for (size_t Bc = Bc_fit; Bc >= bc_unit; Bc -= bc_unit) {
+            const size_t q_full = qo_len / Br;
+            const size_t q_rem  = qo_len % Br;
+            uint64_t     cost   = q_full * hmx_fa2_cost_q_block(Br * gqa_factor, kv_len, Bc, DK, DV, n_thr, kv_q8_0);
+            if (q_rem) {
+                cost += hmx_fa2_cost_q_block(q_rem * gqa_factor, kv_len, Bc, DK, DV, n_thr, kv_q8_0);
+            }
+            if (cost < best_cost) {
+                best_cost = cost;
+                best_Br   = Br;
+                best_Bc   = Bc;
+            }
+        }
+        if (Br == br_unit) {
+            break;
+        }
+    }
+
+    if (best_Br == 0 || best_Bc == 0) {
+        return -1;
+    }
+    *Br_out = best_Br;
+    *Bc_out = best_Bc;
+    return 0;
+}
+
 #ifdef __cplusplus
 }
 #endif
