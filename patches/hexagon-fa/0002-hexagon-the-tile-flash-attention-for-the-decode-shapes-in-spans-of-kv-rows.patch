+// Convert the KV rows of this thread into k_tiles[0] and v_tiles[0]. Each thread moves its rows
+// with its own DMA queue, FA2_STAGE_ROWS rows at a time into two buffers, thus the next transfer
+// runs while the thread converts. O(rows * (DK + DV)).
+static void fa2_convert_thread(unsigned int n, unsigned int i, void * data) {
+    const fa2_convert_args_t * a     = (const fa2_convert_args_t *) data;
+    struct hmx_fa_context *    factx = a->factx;
+    const uint32_t             r0    = i * a->tiles_per_t * HMX_FP16_TILE_N_ROWS;
+    const uint32_t             r1    = hex_smin(r0 + a->tiles_per_t * HMX_FP16_TILE_N_ROWS, a->n_kv);
+    if (r0 >= r1) {
+        return;
+    }
+
+    struct htp_thread_trace * tr  = &factx->octx->ctx->trace[i];
+    dma_queue *               dma = factx->octx->ctx->dma[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_FA_K_PREP, (uint16_t) (r0 / HMX_FP16_TILE_N_ROWS));
+
+    const uint32_t n_kv_tiles = factx->kv_tiles_rows / HMX_FP16_TILE_N_ROWS;
+    const bool     k_q8       = factx->k->type == HTP_TYPE_Q8_0;
+    const bool     v_q8       = factx->v->type == HTP_TYPE_Q8_0;
+    uint8_t *      stage[2];
+    for (int s = 0; s < 2; ++s) {
+        stage[s] = factx->vtcm_stage + (2 * i + s) * factx->stage_slot_bytes;
+    }
+    const size_t v_off = FA2_STAGE_ROWS * a->k_row_padded;
+
+    // Two transfers ahead: the chunk j goes to the buffer j % 2.
+    uint32_t next = r0;
+    for (int s = 0; s < 2 && next < r1; ++s) {
+        const uint32_t nr = hex_smin(FA2_STAGE_ROWS, r1 - next);
+        dma_queue_push(dma, dma_make_ptr(stage[s], a->k_head + next * a->k_nb1), a->k_row_padded, a->k_nb1, a->size_k_row, nr);
+        dma_queue_push(dma, dma_make_ptr(stage[s] + v_off, a->v_head + next * a->v_nb1), a->v_row_padded, a->v_nb1, a->size_v_row, nr);
+        next += nr;
+    }
+    for (uint32_t c = r0, j = 0; c < r1; c += FA2_STAGE_ROWS, ++j) {
+        const uint32_t nr  = hex_smin(FA2_STAGE_ROWS, r1 - c);
+        uint8_t *      buf = stage[j % 2];
+        dma_queue_pop(dma);
+        dma_queue_pop(dma);
+
+        __fp16 * kt = factx->vtcm_k_tiles[0] + (size_t) (c / HMX_FP16_TILE_N_ROWS) * (factx->DK / 32) * HMX_FP16_TILE_N_ELMS;
+        __fp16 * vt = factx->vtcm_v_tiles[0] + (size_t) (c / HMX_FP16_TILE_N_ROWS) * HMX_FP16_TILE_N_ELMS;
+        if (k_q8) {
+            fa_q8_0_rows_to_tiles(kt, buf, nr, factx->DK, a->k_row_padded, 0, nr);
+        } else {
+            hmx_interleave_rows_to_tiles(kt, (const __fp16 *) buf, nr, factx->DK, a->k_row_padded / 2, 0, nr);
+        }
+        if (v_q8) {
+            fa_q8_0_cols_to_tiles(vt, buf + v_off, nr, factx->DV, a->v_row_padded, n_kv_tiles, 0, nr);
+        } else {
+            hmx_interleave_cols_to_tiles(vt, (const __fp16 *) (buf + v_off), nr, factx->DV, a->v_row_padded / 2,
+                                         n_kv_tiles, 0, nr);
+        }
+
+        if (next < r1) {
+            const uint32_t nn = hex_smin(FA2_STAGE_ROWS, r1 - next);
+            dma_queue_push(dma, dma_make_ptr(buf, a->k_head + next * a->k_nb1), a->k_row_padded, a->k_nb1, a->size_k_row, nn);
+            dma_queue_push(dma, dma_make_ptr(buf + v_off, a->v_head + next * a->v_nb1), a->v_row_padded, a->v_nb1, a->size_v_row, nn);
+            next += nn;
+        }
+    }
+    if (r1 == a->n_kv) {
+        fa2_zero_v_tail(factx->vtcm_v_tiles[0], a->n_kv, n_kv_tiles, factx->DV);
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_FA_K_PREP, (uint16_t) (r0 / HMX_FP16_TILE_N_ROWS));
+}
+
+// Convert the n_kv KV rows from k_head and v_head (row 0 of the rows in DDR) into k_tiles[0] and
+// v_tiles[0] with all threads, in 32-row tiles for each thread.
+static void fa2_phase_convert(struct hmx_fa_context * factx, const uint8_t * k_head, const uint8_t * v_head,
+                              size_t k_nb1, size_t v_nb1, size_t size_k_row, size_t size_v_row, size_t k_row_padded,
+                              size_t v_row_padded, uint32_t n_kv) {
+    const uint32_t     n_tiles = hmx_ceil_div(n_kv, HMX_FP16_TILE_N_ROWS);
+    fa2_convert_args_t cargs   = { factx, k_head, v_head, k_nb1, v_nb1, size_k_row, size_v_row, k_row_padded, v_row_padded,
+                                   n_kv, (uint32_t) hmx_ceil_div(n_tiles, factx->n_threads) };
+    work_queue_run(factx->octx->ctx->work_queue, fa2_convert_thread, &cargs, factx->n_threads);
+}
