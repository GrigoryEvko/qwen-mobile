+// ---- the conv over a batch of tokens
+//
+// One op replaces the same chain over a batch of T tokens: the GET_ROWS of the conv state, the
+// transposing CONCAT of the state and the projection, the SSM_CONV, the SILU, and the CPY of the new
+// state into the cache. The unfused chain moves the batch twice, because the CONCAT writes a copy of
+// it, and this op moves it once.
+//
+// Inputs:
+//   src[0] states  [row, n_slots] F32, row = 3 * n_ch, contiguous rows
+//   src[1] s_copy  I32, the host validates the index and passes it in kernel_params[0]
+//   src[2] x       [T, n_ch] F32, the transposed projection: element (c, t) at t * nb[0] + c * nb[1]
+//                  with nb[1] = 4, thus the channels of one token are contiguous
+//   src[3] w       [4, n_ch] F32, the conv weights
+//   src[4] slot    [row, 1] F32, the destination slot
+// Outputs:
+//   dst[0] y       [n_ch, T] F32, silu(conv)
+//   dst[1] slot    the same tensor as src[4], listed for the dirty tracking of the cache
+//
+// A thread owns a range of channels, a multiple of 32, over every token. Its prologue turns the
+// weights and the state of those channels into planes (one lane per channel) in VTCM. The token loop
+// then reads one vector for each of the four taps and writes one vector of outputs. The four taps of
+// a token are four rows of the batch, or a state plane at the first three tokens, thus the loop never
+// converts a lane layout again. The channels of one token are contiguous, thus each thread walks its
+// own block of each row, and the four rows that one token reads stay in L2 over the channel sweep.
+
+struct htp_gdn_conv_chunk_context {
+    struct htp_ops_context * octx;
+    const float * src_slot;   // source slot, DDR, three floats per channel
+    float *       dst_slot;   // destination slot, DDR
+    const float * x;          // the projection, DDR
+    float *       y;          // the output, DDR
+    const float * w;          // the conv weights, DDR
+    uint32_t      x_stride;   // floats between two tokens of x
+    uint32_t      y_stride;   // floats between two tokens of y
+    uint32_t      n_ch;
+    uint32_t      n_tokens;
+    uint32_t      chunk;      // channels per thread, a multiple of 32
+    uint8_t *     vtcm;       // the plane buffers of the threads
+    size_t        vtcm_per_thread;
+};
+
+static void gdn_conv_chunk_thread(unsigned int nth, unsigned int ith, void * data) {
+    (void) nth;
+    struct htp_gdn_conv_chunk_context * cctx = (struct htp_gdn_conv_chunk_context *) data;
+    struct htp_ops_context *            octx = cctx->octx;
+
+    const uint32_t c0 = ith * cctx->chunk;
+    if (c0 >= cctx->n_ch) {
+        return;
+    }
+    const uint32_t n  = MIN(cctx->chunk, cctx->n_ch - c0);
+    const uint32_t nb = n / VLEN_FP32;
+    const uint32_t T  = cctx->n_tokens;
+
+    struct gdn_conv_masks mk __attribute__((aligned(VLEN)));
+    gdn_conv_masks_init(&mk);
+
+    float * planes = (float *) (cctx->vtcm + cctx->vtcm_per_thread * ith);
+    float * wt     = planes;             // [4][n] the weight planes
+    float * st     = planes + 4 * n;     // [3][n] the state planes
+
+    const float * w_ptr = cctx->w + (size_t) c0 * GDN_CONV_D_CONV;
+    const float * s_ptr = cctx->src_slot + (size_t) c0 * (GDN_CONV_D_CONV - 1);
+
+    struct htp_thread_trace * tr = &octx->ctx->trace[ith];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) c0);
+
+    // the planes of the weights and of the state
+    for (uint32_t i = 0; i < nb; i++) {
+        HVX_Vector p0, p1, p2, p3;
+
+        gdn_conv_deal4(hvx_vmemu(w_ptr + i * 128), hvx_vmemu(w_ptr + i * 128 + 32),
+                       hvx_vmemu(w_ptr + i * 128 + 64), hvx_vmemu(w_ptr + i * 128 + 96),
+                       &p0, &p1, &p2, &p3);
+        hvx_vmem(wt + 0 * n + i * VLEN_FP32) = p0;
+        hvx_vmem(wt + 1 * n + i * VLEN_FP32) = p1;
+        hvx_vmem(wt + 2 * n + i * VLEN_FP32) = p2;
+        hvx_vmem(wt + 3 * n + i * VLEN_FP32) = p3;
+
+        HVX_Vector c[4];
+        gdn_conv_lanes_to_c(&mk, hvx_vmemu(s_ptr + i * 96), hvx_vmemu(s_ptr + i * 96 + 32),
+                            hvx_vmemu(s_ptr + i * 96 + 64), Q6_V_vzero(), c);
+        gdn_conv_deal4(c[0], c[1], c[2], c[3], &p0, &p1, &p2, &p3);
+        hvx_vmem(st + 0 * n + i * VLEN_FP32) = p0;
+        hvx_vmem(st + 1 * n + i * VLEN_FP32) = p1;
+        hvx_vmem(st + 2 * n + i * VLEN_FP32) = p2;
+    }
+
+    // the tokens. Tap j of token t reads the row t - 3 + j, or the state plane of that index when the
+    // row is before the batch.
+    for (uint32_t t = 0; t < T; t++) {
+        const float * tap[GDN_CONV_D_CONV];
+        for (int j = 0; j < GDN_CONV_D_CONV; j++) {
+            const int idx = (int) t - (GDN_CONV_D_CONV - 1) + j;
+            tap[j] = (idx >= 0) ? (cctx->x + (size_t) idx * cctx->x_stride + c0)
+                                : (const float *) (st + (idx + (GDN_CONV_D_CONV - 1)) * n);
+        }
+
+        float * out = cctx->y + (size_t) t * cctx->y_stride + c0;
+
+        for (uint32_t i = 0; i < nb; i++) {
+            const uint32_t o = i * VLEN_FP32;
+            HVX_Vector r = gdn_conv_tap_silu(hvx_vmemu(tap[0] + o), hvx_vmemu(tap[1] + o),
+                                             hvx_vmemu(tap[2] + o), hvx_vmemu(tap[3] + o),
+                                             hvx_vmem(wt + 0 * n + o), hvx_vmem(wt + 1 * n + o),
+                                             hvx_vmem(wt + 2 * n + o), hvx_vmem(wt + 3 * n + o));
+            hvx_vmemu(out + o) = r;
+        }
+    }
+
+    // The new state is the last three tokens of the batch, in the layout of the cache. Three steps of
+    // the single token block from an empty state give exactly that, and the output of those steps is
+    // not used.
+    float * d_ptr = cctx->dst_slot + (size_t) c0 * (GDN_CONV_D_CONV - 1);
+
+    for (uint32_t i = 0; i < nb; i++) {
+        HVX_Vector w0 = hvx_vmemu(w_ptr + i * 128);
+        HVX_Vector w1 = hvx_vmemu(w_ptr + i * 128 + 32);
+        HVX_Vector w2 = hvx_vmemu(w_ptr + i * 128 + 64);
+        HVX_Vector w3 = hvx_vmemu(w_ptr + i * 128 + 96);
+
+        HVX_Vector n0 = Q6_V_vzero();
+        HVX_Vector n1 = Q6_V_vzero();
+        HVX_Vector n2 = Q6_V_vzero();
+        HVX_Vector y;
+
+        for (uint32_t t = T - (GDN_CONV_D_CONV - 1); t < T; t++) {
+            HVX_Vector xv = hvx_vmemu(cctx->x + (size_t) t * cctx->x_stride + c0 + i * VLEN_FP32);
+            gdn_conv_block(&mk, n0, n1, n2, xv, w0, w1, w2, w3, &y, &n0, &n1, &n2);
+        }
+
+        hvx_vmemu(d_ptr + i * 96)      = n0;
+        hvx_vmemu(d_ptr + i * 96 + 32) = n1;
+        hvx_vmemu(d_ptr + i * 96 + 64) = n2;
+    }
+
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) (c0 + n));
+}
+
+// The error detail codes of this op (reported to the host with the batch status)
+enum {
+    GDN_CHUNK_ERR_INPUT  = 30, // an input or the output is missing
+    GDN_CHUNK_ERR_TYPE   = 31, // a tensor type is not the expected one
+    GDN_CHUNK_ERR_SHAPE  = 32, // a shape or a stride is not the expected one
+    GDN_CHUNK_ERR_INDEX  = 33, // the slot index is out of range
+    GDN_CHUNK_ERR_VTCM   = 34, // the VTCM reservation is too small
+};
+
+#define GDN_CHUNK_FAIL(code, status) do { octx->err_detail = (code); return (status); } while (0)
+
+int op_gdn_conv_chunk(struct htp_ops_context * octx) {
+    const struct htp_tensor * states = octx->src[0];
+    const struct htp_tensor * s_copy = octx->src[1];
+    const struct htp_tensor * x      = octx->src[2];
+    const struct htp_tensor * w      = octx->src[3];
+    const struct htp_tensor * slot   = octx->src[4];
+    const struct htp_tensor * y      = octx->dst;
+
+    if (!states || !s_copy || !x || !w || !slot || !y) {
+        GDN_CHUNK_FAIL(GDN_CHUNK_ERR_INPUT, HTP_STATUS_INVAL_PARAMS);
+    }
+    if (states->type != HTP_TYPE_F32 || x->type != HTP_TYPE_F32 || w->type != HTP_TYPE_F32 ||
+        slot->type != HTP_TYPE_F32 || y->type != HTP_TYPE_F32 || s_copy->type != HTP_TYPE_I32) {
+        GDN_CHUNK_FAIL(GDN_CHUNK_ERR_TYPE, HTP_STATUS_NO_SUPPORT);
+    }
+    if (octx->ctx->mdev.count > 1) {
+        GDN_CHUNK_FAIL(GDN_CHUNK_ERR_TYPE, HTP_STATUS_NO_SUPPORT);
+    }
+
+    const uint32_t d_conv = w->ne[0];
+    const uint32_t n_ch   = w->ne[1];
+    const uint32_t T      = x->ne[0];
+
+    if (d_conv != GDN_CONV_D_CONV) {
+        GDN_CHUNK_FAIL(GDN_CHUNK_ERR_SHAPE, HTP_STATUS_NO_SUPPORT);
+    }
+    // The host matcher holds every condition below. They stay here because a mismatch would give a
+    // wrong result without a word.
+    if (n_ch == 0 || (n_ch % VLEN_FP32) != 0 || T < GDN_CONV_D_CONV) {
+        GDN_CHUNK_FAIL(GDN_CHUNK_ERR_SHAPE, HTP_STATUS_INVAL_PARAMS);
+    }
+
+    const uint32_t row = (d_conv - 1) * n_ch;
+
