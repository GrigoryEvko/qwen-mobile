+                span.ne[2]    = 1;
+                span.ne[3]    = 1;
+                span.nb[1]    = m.slot_stride;
+                span.nb[2]    = span.nb[1] * span.ne[1];
+                span.nb[3]    = span.nb[2];
+                span.op       = GGML_OP_NONE;
+                span.view_src = nullptr;
+                span.view_offs = 0;
+                for (int s = 0; s < GGML_MAX_SRC; s++) {
+                    span.src[s] = nullptr;
+                }
+                slots = node.add_dummy(span);
+            }
+            node.inputs  = { m.states, m.idx, m.xt, m.W, slots };
+            node.outputs = { m.S, slots };
+            node.fused   = m.fused;
 
             fu.at.emplace(m.emit, std::move(node));
             skip_members(m.emit, m.members);
