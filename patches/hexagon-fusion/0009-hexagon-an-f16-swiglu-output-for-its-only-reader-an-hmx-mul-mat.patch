diff --git a/ggml/src/ggml-hexagon/htp-mm-fusion.h b/ggml/src/ggml-hexagon/htp-mm-fusion.h
new file mode 100644
index 0000000..7e9c8c1
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp-mm-fusion.h
@@ -0,0 +1,121 @@
+#ifndef HTP_MM_FUSION_H
+#define HTP_MM_FUSION_H
+
+// The plans around the weight matmuls of the Hexagon backend. graph_compute calls
+// ggml_hexagon_mm_fusion_plan after it builds the op nodes of a graph. ggml-hexagon.cpp includes this
+// file after the definition of ggml_hexagon_opbatch.
+//
+// The switch (an environment variable, read at the start of the backend). 1 is the preset value and
+// enables the plan, 0 disables it. GGML_HEXAGON_OPFUSION=0 also disables it.
+//
+//   GGML_HEXAGON_FUSE_F16_ACT  an F16 SwiGLU output for its only reader, an HMX MUL_MAT
+//
+// The F16 activation. The HMX MUL_MAT converts its F32 activation to F16 before the multiply
+// (hvx_vec_f32_to_f16_shuff). When a SwiGLU output has one reader and that reader is a MUL_MAT on the
+// HMX 2D path, the SwiGLU op writes the F16 value of each lane with the same conversion, and the MUL_MAT
+// reads F16. The MUL_MAT thus gets the bytes that it gets from the F32 tensor, and the two ops move half
+// the bytes of that tensor. The plan gives the two op nodes an F16 view of the F32 tensor (the same data
+// and buffer): the output of the SwiGLU op and the src1 of the MUL_MAT.
+
+#include <cstdlib>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+static int opt_fuse_f16_act = 1;  // GGML_HEXAGON_FUSE_F16_ACT
+
+// Reads the switch of this file from the environment. The backend calls it one time, together with the
+// read of the other options.
+static void ggml_hexagon_mm_fusion_read_env() {
+    const char * s = getenv("GGML_HEXAGON_FUSE_F16_ACT");
+    if (s) {
+        opt_fuse_f16_act = atoi(s);
+    }
+}
+
+// Returns the graph index of the only reader of the node at index i, or -1. O(nodes).
+static int ggml_hexagon_mm_only_reader(const struct ggml_cgraph * graph, int i) {
+    if (!ggml_hexagon_product_has_one_reader(graph, i)) {
+        return -1;
+    }
+    const ggml_tensor * t = graph->nodes[i];
+    for (int j = i + 1; j < graph->n_nodes; j++) {
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            if (graph->nodes[j]->src[s] == t) {
+                return j;
+            }
+        }
+    }
+    return -1;
+}
+
+// The plan of the F16 activations of one graph (the part of graph_compute that builds the op nodes).
+// It changes the op nodes of each pair of a SwiGLU op and its only reader, a MUL_MAT on the HMX 2D
+// path: the SwiGLU op writes an F16 view of its output, and the MUL_MAT reads that view as src1. The
+// two op nodes own the view. O(nodes) for each SwiGLU op.
+static void ggml_hexagon_mm_fusion_plan(const struct ggml_hexagon_session * sess, const struct ggml_cgraph * graph,
+                                        std::vector<htp_opnode> & nodes) {
+    if (!opt_opfusion || !opt_fuse_f16_act) {
+        return;
+    }
+
+    std::unordered_map<const ggml_tensor *, int>    gidx;
+    std::unordered_map<const ggml_tensor *, size_t> oidx;
+    for (int i = 0; i < graph->n_nodes; i++) {
+        gidx[graph->nodes[i]] = i;
+    }
+    for (size_t j = 0; j < nodes.size(); j++) {
+        if (nodes[j].node && nodes[j].outputs.size() == 1 && nodes[j].outputs[0] == nodes[j].node) {
+            oidx[nodes[j].node] = j;
+        }
+    }
+
+    for (auto & g : nodes) {
+        if (g.opcode != HTP_OP_GLU_SWIGLU || g.outputs.size() != 1 || g.outputs[0] != g.node) {
+            continue;
+        }
+        ggml_tensor * t = g.node;
+        if (!t->src[0] || !t->src[1] || t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || t->ne[2] != 1 ||
+            t->ne[3] != 1 || !t->buffer || !t->extra) {
+            continue;
+        }
+        const auto gi = gidx.find(t);
+        if (gi == gidx.end()) {
+            continue;
+        }
+        const int ri = ggml_hexagon_mm_only_reader(graph, gi->second);
+        if (ri < 0) {
+            continue;
+        }
+        const ggml_tensor * c = graph->nodes[ri];
+        if (c->op != GGML_OP_MUL_MAT || c->src[1] != t || c->src[0] == t) {
+            continue;
+        }
+        const auto oc = oidx.find(c);
+        if (oc == oidx.end()) {
+            continue;
+        }
+        htp_opnode & cn = nodes[oc->second];
+        const auto * kp = (const struct htp_mm_kernel_params *) cn.kernel_params;
+        if (cn.opcode != HTP_OP_MUL_MAT || cn.inputs.size() < 2 || cn.inputs[1] != t || !kp->n_hmx ||
+            kp->kernel_type != HTP_MM_KERNEL_HMX_2D) {
+            continue;
+        }
+
+        ggml_tensor v = *t;
+        v.type        = GGML_TYPE_F16;
+        v.nb[0]       = ggml_type_size(GGML_TYPE_F16);
+        v.nb[1]       = v.nb[0] * v.ne[0];
+        v.nb[2]       = v.nb[1] * v.ne[1];
+        v.nb[3]       = v.nb[2] * v.ne[2];
+        auto view     = std::make_shared<ggml_tensor>(v);
+        g.dummy.push_back(view);
+        cn.dummy.push_back(view);
+        g.outputs[0]  = view.get();
+        cn.inputs[1]  = view.get();
+
+        HEX_VERBOSE("ggml-hex: %s F16 activation %s for %s\n", sess->c_name(), t->name, c->name);
+    }
+}
+
+#endif // HTP_MM_FUSION_H
