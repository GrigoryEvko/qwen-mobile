+// The F16 activation path of transfer_activation_chunk_threaded. The scratch of the F32 path holds the
+// DMA buffers: the layout gives it at least 4 F32 rows for each thread, which is room for 2 buffers
+// of 4 F16 rows. With less room the function uses fewer threads. O(n_rows * k_block).
+static void transfer_activation_chunk_f16_threaded(const struct activation_transfer_params * params) {
+    if (params->n_rows <= 0) {
+        return;
+    }
+    activation_transfer_f16_state_t st;
+    st.ctx      = params->ctx;
+    st.dst      = params->dst;
+    st.src      = params->src_f16;
+    st.scratch  = (uint8_t *) params->vtcm_f32_act;
+    st.n_rows   = (uint32_t) params->n_rows;
+    st.n_tasks  = (st.n_rows + HTP_MM_HMX_TILE_N_ROWS - 1) / HTP_MM_HMX_TILE_N_ROWS;
+    st.k_block  = (uint32_t) params->k_block;
+    st.k_stride = (uint32_t) params->k_stride;
+    st.k_valid  = (uint32_t) params->k_valid;
+
+    const size_t   min_bytes = 4 * htp_mm_act_f16_row_bytes(st.k_block);  // 2 buffers of 2 rows
+    const uint32_t fit       = params->vtcm_f32_act ? (uint32_t) (params->vtcm_f32_act_bytes / min_bytes) : 0;
+    const uint32_t n_threads = MIN(MIN((uint32_t) params->n_threads, st.n_tasks), fit);
+    if (n_threads == 0) {
+        FARF(ERROR, "hmx-act-f16: the scratch of %zu bytes holds no DMA buffers for k %u", params->vtcm_f32_act_bytes,
+             st.k_block);
+        return;
+    }
+    st.scratch_per_thread = hex_align_down(params->vtcm_f32_act_bytes / n_threads, 128);
+    if (n_threads == 1) {
+        transfer_activation_f16_worker_fn(1, 0, &st);
+    } else {
+        worker_pool_run_func(params->ctx->worker_pool, transfer_activation_f16_worker_fn, &st, n_threads);
+    }
+}
