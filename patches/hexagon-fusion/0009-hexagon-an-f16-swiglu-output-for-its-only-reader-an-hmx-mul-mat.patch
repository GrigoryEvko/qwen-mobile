diff --git a/ggml/src/ggml-hexagon/htp/matmul-ops.c b/ggml/src/ggml-hexagon/htp/matmul-ops.c
index ee3a599..e83cd06 100644
--- a/ggml/src/ggml-hexagon/htp/matmul-ops.c
+++ b/ggml/src/ggml-hexagon/htp/matmul-ops.c
@@ -2494,9 +2494,153 @@ struct activation_transfer_params {
     int                           k_valid;
     float *                       vtcm_f32_act;
     size_t                        vtcm_f32_act_bytes;
+    const __fp16 *                src_f16;     // an F16 activation in place of src, NULL for an F32 activation
 };
 
+// The rows r and r + 1 of an F16 activation into the HMX tiles. The tile vector of a column block holds
+// the two rows in alternate lanes, row r in the even lanes: the order that hvx_vec_f32_to_f16_shuff
+// gives for an F32 activation. A missing row and the columns from k_valid are zero. Each row is in VTCM
+// at a multiple of 128 bytes, with at least 64 bytes after the last value when k_block is not a
+// multiple of 64. O(k_block).
+static void transfer_activation_row_pair_f16(__fp16 * restrict vtcm_dst, const __fp16 * row0, const __fp16 * row1,
+                                             uint32_t r, uint32_t k_block, uint32_t k_valid, bool row0_valid,
+                                             bool row1_valid) {
+    const uint32_t r0          = r / HTP_MM_HMX_TILE_N_ROWS;
+    const uint32_t r1          = r % HTP_MM_HMX_TILE_N_ROWS;
+    const uint32_t n_col_tiles = k_block / HTP_MM_HMX_TILE_N_COLS;
+
+    for (uint32_t c = 0; c < k_block; c += 64) {
+        HVX_Vector v0 = row0_valid ? hvx_vmem(row0 + c) : Q6_V_vzero();
+        HVX_Vector v1 = row1_valid ? hvx_vmem(row1 + c) : Q6_V_vzero();
+        if (c + 64 > k_valid) {
+            const uint32_t       rem  = k_valid > c ? k_valid - c : 0;
+            const HVX_VectorPred mask = Q6_Q_vsetq2_R(rem * sizeof(__fp16));
+            v0 = Q6_V_vmux_QVV(mask, v0, Q6_V_vzero());
+            v1 = Q6_V_vmux_QVV(mask, v1, Q6_V_vzero());
+        }
+        const HVX_VectorPair w  = Q6_W_vshuff_VVR(v1, v0, -2);
+        const uint32_t       c0 = c / HTP_MM_HMX_TILE_N_COLS;
+        ((HVX_Vector *) (vtcm_dst + (size_t) (r0 * n_col_tiles + c0) * HTP_MM_HMX_TILE_N_ELMS))[r1 / 2] = Q6_V_lo_W(w);
+        if (c0 + 1 < n_col_tiles) {
+            ((HVX_Vector *) (vtcm_dst + (size_t) (r0 * n_col_tiles + c0 + 1) * HTP_MM_HMX_TILE_N_ELMS))[r1 / 2] =
+                Q6_V_hi_W(w);
+        }
+    }
+}
+
+typedef struct {
+    struct htp_context *      ctx;
+    __fp16 *                  dst;
+    const __fp16 *            src;
+    uint8_t *                 scratch;           // the DMA buffers of the threads
+    size_t                    scratch_per_thread;
+    uint32_t                  n_rows;
+    uint32_t                  n_tasks;
+    uint32_t                  k_block;
+    uint32_t                  k_stride;          // F16 values between two rows of src
+    uint32_t                  k_valid;
+} activation_transfer_f16_state_t;
+
+// The bytes of one row of an F16 activation in the DMA buffers of transfer_activation_f16_worker_fn: a
+// multiple of 128, thus each load of 64 values is aligned and stays in the row. O(1).
+static inline size_t htp_mm_act_f16_row_bytes(uint32_t k_block) {
+    return hex_align_up((size_t) k_block * sizeof(__fp16), 128);
+}
+
+// The F16 activation of one thread: tasks of 32 rows. The DMA moves R rows at a time into one of the
+// two buffers of the thread while the thread puts the rows of the other buffer into the tiles.
+// The caller gives each thread room for 2 buffers of at least 2 rows. O(rows * k_block) for each thread.
+static void transfer_activation_f16_worker_fn(unsigned int n, unsigned int i, void * data) {
+    const activation_transfer_f16_state_t * st = (const activation_transfer_f16_state_t *) data;
+    struct htp_thread_trace * tr = &st->ctx->trace[i];
+    dma_queue *               q  = st->ctx->dma[i];
+
+    const size_t row_bytes = htp_mm_act_f16_row_bytes(st->k_block);
+    uint32_t     R         = (uint32_t) (st->scratch_per_thread / (2 * row_bytes));
+    R = MIN(R, HTP_MM_HMX_TILE_N_ROWS) & ~1u;
+    uint8_t * bufs[2] = { st->scratch + (size_t) i * st->scratch_per_thread,
+                          st->scratch + (size_t) i * st->scratch_per_thread + (size_t) R * row_bytes };
+
+    const size_t   src_stride = (size_t) st->k_stride * sizeof(__fp16);
+    const size_t   width      = (size_t) st->k_valid * sizeof(__fp16);
+    const uint32_t n_steps    = (HTP_MM_HMX_TILE_N_ROWS + R - 1) / R;
+
+    for (uint32_t task = i; task < st->n_tasks; task += n) {
+        const uint32_t row0   = task * HTP_MM_HMX_TILE_N_ROWS;
+        const uint32_t n_rows = MIN(HTP_MM_HMX_TILE_N_ROWS, st->n_rows - row0);
+        __fp16 *       dst    = st->dst + (size_t) row0 * st->k_block;
+        const __fp16 * src    = st->src + (size_t) row0 * st->k_stride;
+
+        htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_A_PREP, row0);
+
+        // Steps of R rows: push the steps 0 and 1, then for each step pop, put into the tiles, push s + 2
+        for (uint32_t s = 0; s < 2 && s < n_steps; s++) {
+            const uint32_t r = s * R;
+            if (r < n_rows) {
+                dma_queue_push(q, dma_make_ptr(bufs[s], src + (size_t) r * st->k_stride), row_bytes, src_stride, width,
+                               MIN(R, n_rows - r));
+            }
+        }
+        for (uint32_t s = 0; s < n_steps; s++) {
+            const uint32_t  r   = s * R;
+            const uint8_t * buf = bufs[s % 2];
+            if (r < n_rows) {
+                buf = (const uint8_t *) dma_queue_pop(q).dst;
+            }
+            for (uint32_t p = 0; p < R && r + p < HTP_MM_HMX_TILE_N_ROWS; p += 2) {
+                transfer_activation_row_pair_f16(dst, (const __fp16 *) (buf + (size_t) p * row_bytes),
+                                                 (const __fp16 *) (buf + (size_t) (p + 1) * row_bytes), r + p,
+                                                 st->k_block, st->k_valid, r + p < n_rows, r + p + 1 < n_rows);
+            }
+            const uint32_t r2 = (s + 2) * R;
+            if (s + 2 < n_steps && r2 < n_rows) {
+                dma_queue_push(q, dma_make_ptr((void *) buf, src + (size_t) r2 * st->k_stride), row_bytes, src_stride,
+                               width, MIN(R, n_rows - r2));
+            }
+        }
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_A_PREP, row0);
+    }
+}
