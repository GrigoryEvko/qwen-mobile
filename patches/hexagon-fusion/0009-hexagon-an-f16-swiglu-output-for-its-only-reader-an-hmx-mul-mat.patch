+// The FFN block of Qwen3.5 on a whole graph: an optional RMS_NORM + MUL of the input, the gate and the
+// up MUL_MAT of one activation, the SwiGLU of the two products, and an optional down MUL_MAT with the
+// residual ADD. On the HMX path the Hexagon backend gives the SwiGLU op an F16 output that the down
+// MUL_MAT reads (GGML_HEXAGON_FUSE_F16_ACT).
+struct test_ffn_swiglu : public test_case {
+    const ggml_type type;
+    const int64_t   k;          // the input width
+    const int64_t   n;          // the rows of the gate and the up weight
+    const int64_t   m;          // the tokens
+    const bool      gate_first; // the gate MUL_MAT comes before the up MUL_MAT in the graph
+    const bool      with_norm;
+    const int64_t   k_down;     // the rows of the down weight, 0 for no down MUL_MAT
+
+    test_ffn_swiglu(ggml_type type, int64_t k, int64_t n, int64_t m, bool gate_first = true, bool with_norm = false,
+                    int64_t k_down = 0)
+        : type(type), k(k), n(n), m(m), gate_first(gate_first), with_norm(with_norm), k_down(k_down) {}
+
+    std::string vars() override {
+        return VARS_TO_STR7(type, k, n, m, gate_first, with_norm, k_down);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "FFN_SWIGLU";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, m);
+        ggml_set_name(x, "x");
+
+        ggml_tensor * cur = x;
+        if (with_norm) {
+            ggml_tensor * w_norm = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, k);
+            ggml_set_name(w_norm, "w_norm");
+            cur = ggml_mul(ctx, ggml_rms_norm(ctx, x, 1e-6f), w_norm);
+            ggml_set_name(cur, "norm");
+        }
+
+        ggml_tensor * w_gate = ggml_new_tensor_2d(ctx, type, k, n);
+        ggml_tensor * w_up   = ggml_new_tensor_2d(ctx, type, k, n);
+        ggml_set_name(w_gate, "w_gate");
+        ggml_set_name(w_up, "w_up");
+
+        ggml_tensor * gate = nullptr;
+        ggml_tensor * up   = nullptr;
+        if (gate_first) {
+            gate = ggml_mul_mat(ctx, w_gate, cur);
+            up   = ggml_mul_mat(ctx, w_up, cur);
+        } else {
+            up   = ggml_mul_mat(ctx, w_up, cur);
+            gate = ggml_mul_mat(ctx, w_gate, cur);
+        }
+        ggml_set_name(gate, "gate");
+        ggml_set_name(up, "up");
+
+        ggml_tensor * out = ggml_swiglu_split(ctx, gate, up);
+        ggml_set_name(out, "swiglu");
+
+        if (k_down > 0) {
+            ggml_tensor * w_down = ggml_new_tensor_2d(ctx, type, n, k_down);
+            ggml_tensor * res    = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k_down, m);
+            ggml_set_name(w_down, "w_down");
+            ggml_set_name(res, "res");
+            out = ggml_add(ctx, ggml_mul_mat(ctx, w_down, out), res);
+        }
+
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    // Values like the values of the model: a weight has the range sqrt(3 / its input width), thus a product has
+    // about the range of its input. With the preset range [-1, 1] the down output of the 4B shape has a standard
+    // deviation of about 1e4 and at times a value above 65504, the largest value of the F16 output tiles of the HMX.
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            const std::string name = ggml_get_name(t);
+            if (name == "w_gate" || name == "w_up") {
+                const float a = std::sqrt(3.0f / (float) k);
+                init_tensor_uniform(t, -a, a);
+            } else if (name == "w_down") {
+                const float a = std::sqrt(3.0f / (float) n);
+                init_tensor_uniform(t, -a, a);
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+
+    double max_nmse_err() override {
+        return 1e-3;
+    }
+};
