+// Converts the first n F32 values of each VTCM row to F16 in place, at the start of the row. The value
+// of a lane is the value that the HMX activation load of a MUL_MAT gives for the F32 value
+// (hvx_vec_f32_to_f16_shuff), thus a MUL_MAT that reads the F16 row gets the bytes of the F32 path.
+// Iteration j reads the vectors 2j and 2j + 1 and writes the vector j, which the loop read before.
+// O(n_rows * n).
+static void htp_act_rows_f32_to_f16(uint8_t * restrict rows, uint32_t n_rows, size_t row_stride, uint32_t n) {
+    const uint32_t nvec = (n + 31) / 32;
+    for (uint32_t r = 0; r < n_rows; r++) {
+        HVX_Vector * v = (HVX_Vector *) (rows + r * row_stride);
+        for (uint32_t j = 0; 2 * j < nvec; j++) {
+            const HVX_Vector lo = v[2 * j];
+            const HVX_Vector hi = (2 * j + 1 < nvec) ? v[2 * j + 1] : Q6_V_vzero();
+            v[j] = hvx_vec_f32_to_f16(lo, hi);
+        }
+    }
+}
