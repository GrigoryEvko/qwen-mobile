+// GATED_DELTA_NET over a batch of tokens.
+//
+// A backend can run a batch as the chunked delta rule, which rewrites the recurrence of a chunk as
+// matrix products (the Hexagon HMX kernel). The rewrite is exact, thus the error is the rounding of
+// the products: an fp16 product with f32 accumulation gives an NMSE near 3e-7 against this f32 CPU
+// reference, flat in the token count. The tolerance holds that with a margin of 20.
+//
+// The gate of the parent case runs from -20, which decays the state in one or two tokens. That hides
+// every error of the state that travels between chunks, thus these cases keep the gate near zero.
+struct test_gated_delta_net_batch : public test_gated_delta_net {
+    const float gate_min;
+
+    test_gated_delta_net_batch(int64_t head_count, int64_t head_size, int64_t n_seq_tokens, int64_t n_seqs,
+            int v_repeat = 1, bool permuted = false, float gate_min = -0.5f)
+        : test_gated_delta_net(GGML_TYPE_F32, head_count, head_size, n_seq_tokens, n_seqs, v_repeat, permuted, false, 1),
+          gate_min(gate_min) {}
+
+    std::string vars() override {
+        return test_gated_delta_net::vars() + "," + VARS_TO_STR1(gate_min);
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (ggml_is_view_op(t->op)) { continue; }
+            if (strcmp(t->name, "g") == 0) {
+                init_tensor_uniform(t, gate_min, -1e-4f);
+            } else if (strcmp(t->name, "beta") == 0) {
+                init_tensor_uniform(t, 0.0f, 1.0f);
+            } else if (strcmp(t->name, "v") == 0) {
+                init_tensor_uniform(t, -0.3f, 5.0f);
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+
+    double max_nmse_err() override {
+        return 1e-5;
+    }
+};
