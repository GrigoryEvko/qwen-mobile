+    test_cases.emplace_back(new test_gated_delta_net_batch(16, 128, 512, 1));
+    test_cases.emplace_back(new test_gated_delta_net_batch(16, 128, 672, 1));
+    test_cases.emplace_back(new test_gated_delta_net_batch(16, 128, 512, 1, 1, false, -20.0f));
+    test_cases.emplace_back(new test_gated_delta_net_batch(4, 128, 100, 1));
+    test_cases.emplace_back(new test_gated_delta_net_batch(4, 128, 64, 1));
+    test_cases.emplace_back(new test_gated_delta_net_batch(4, 64, 70, 2));
+    test_cases.emplace_back(new test_gated_delta_net_batch(2, 32, 33, 1));
