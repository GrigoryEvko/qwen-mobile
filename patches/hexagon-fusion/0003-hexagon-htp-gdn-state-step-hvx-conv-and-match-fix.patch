+// The graph match of the fused recurrent state step of a gated delta net layer (host side).
+//
+// At one token, a gated delta net layer (Qwen3.5, Qwen3-Next) reads its two recurrent states with
+// GET_ROWS, updates them, and writes them back with CPY. Two chains become one op each:
+//
+//   GET_ROWS(cache_r, s_copy) -> CONCAT(., x^T) -> SSM_CONV -> SILU, and CPY(view of the CONCAT, slot of cache_r)
+//     -> HTP_OP_GDN_CONV_STEP
+//   GET_ROWS(cache_s, s_copy) -> GATED_DELTA_NET(K = 1), and CPY(state tail, slot of cache_s)
+//     -> HTP_OP_GDN_STATE_STEP
+//
+// The DSP reads the source slot index from s_copy and writes the destination slot of the CPY. When the
+// two slots are the same, the update is in place. The match needs one token, one sequence, one CPY, no
+// other reader of the replaced tensors, and no other node that touches the cache inside the chain span.
+// The state_zero SCALE of build_rs comes before the chain, thus it stays a separate op and runs first.
+//
+// This header depends on ggml only. A host program can run the same checks on a graph. Each check
+// returns nullptr when the chain matches, or a short text for the first failed condition.
+
+#ifndef HTP_GDN_MATCH_H
+#define HTP_GDN_MATCH_H
+
+#include "ggml.h"
+#include "ggml-impl.h"
+
+#include <algorithm>
+#include <unordered_map>
+#include <vector>
+
+struct ggml_hexagon_gdn_conv_match {
+    ggml_tensor * S      = nullptr; // SILU, the output
+    ggml_tensor * C      = nullptr; // SSM_CONV
+    ggml_tensor * CI     = nullptr; // CONCAT
+    ggml_tensor * W      = nullptr; // the conv weights [d_conv, n_ch]
+    ggml_tensor * R      = nullptr; // GET_ROWS of the conv state
+    ggml_tensor * states = nullptr; // the state table [row, n_slots]
+    ggml_tensor * idx    = nullptr; // the s_copy view [1]
+    ggml_tensor * xt     = nullptr; // the transposed projection [1, n_ch]
+    ggml_tensor * P      = nullptr; // CPY into the slot
+    ggml_tensor * slot   = nullptr; // the destination slot view [row, 1]
+    std::vector<ggml_tensor *> members; // every node the fused op replaces
+    int     emit   = -1;                // graph index where the fused op goes
+    int64_t d_conv = 0;
+    int64_t n_ch   = 0;
+};
+
+struct ggml_hexagon_gdn_state_match {
+    ggml_tensor * G      = nullptr; // GATED_DELTA_NET, the output
+    ggml_tensor * q      = nullptr;
+    ggml_tensor * k      = nullptr;
+    ggml_tensor * v      = nullptr;
+    ggml_tensor * g      = nullptr;
+    ggml_tensor * beta   = nullptr;
+    ggml_tensor * R      = nullptr; // GET_ROWS of the delta net state
+    ggml_tensor * states = nullptr; // the state table [D, n_slots]
+    ggml_tensor * idx    = nullptr; // the s_copy view [1]
+    ggml_tensor * P      = nullptr; // CPY into the slot
+    ggml_tensor * slot   = nullptr; // the destination slot view [D, 1]
+    std::vector<ggml_tensor *> members; // every node the fused op replaces
+    int     emit = -1;
+    int64_t S_v  = 0;
+    int64_t H    = 0;
+};
+
+static inline ggml_tensor * ggml_hexagon_gdn_root(ggml_tensor * t) {
+    return t->view_src ? t->view_src : t;
+}
+
+static inline bool ggml_hexagon_gdn_is_view_op(const ggml_tensor * t) {
+    return t->op == GGML_OP_VIEW || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_PERMUTE || t->op == GGML_OP_TRANSPOSE;
+}
+
+// A contiguous F32 row of n elements with unit outer dimensions
+static inline bool ggml_hexagon_gdn_is_f32_row(const ggml_tensor * t, int64_t n) {
+    return t->type == GGML_TYPE_F32 && t->ne[0] == n && t->ne[1] == 1 && t->ne[2] == 1 && t->ne[3] == 1 &&
+           t->nb[0] == sizeof(float);
+}
+
+// The "states" tensor of build_rs: an F32 table [row, n_slots] of the cache with contiguous rows
+static inline bool ggml_hexagon_gdn_is_state_table(const ggml_tensor * t, int64_t row) {
+    return t->type == GGML_TYPE_F32 && t->ne[0] == row && t->ne[1] >= 1 && t->ne[2] == 1 && t->ne[3] == 1 &&
+           t->nb[0] == sizeof(float) && t->nb[1] == (size_t) row * sizeof(float);
+}
+
+template <typename T>
+static inline bool ggml_hexagon_gdn_contains(const std::vector<T> & v, const T & x) {
+    return std::find(v.begin(), v.end(), x) != v.end();
+}
+
+// True when the node reads or writes the root tensor through any view
+static inline bool ggml_hexagon_gdn_node_touches(ggml_tensor * n, const ggml_tensor * root) {
+    if (ggml_hexagon_gdn_root(n) == root) {
+        return true;
+    }
+    for (int i = 0; i < GGML_MAX_SRC; i++) {
+        if (n->src[i] && ggml_hexagon_gdn_root(n->src[i]) == root) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static inline std::unordered_map<const ggml_tensor *, int> ggml_hexagon_gdn_index(const ggml_cgraph * gf) {
+    std::unordered_map<const ggml_tensor *, int> index;
+    index.reserve(gf->n_nodes);
+    for (int i = 0; i < gf->n_nodes; i++) {
+        index.emplace(gf->nodes[i], i);
+    }
+    return index;
+}
+
+// Every node that reads an intermediate (also through a view) must be a member of the chain. A view of
+// `out` is permitted for any node when the view lies in the first `out_head_bytes` bytes of `out`.
+static inline const char * ggml_hexagon_gdn_chain_is_private(const ggml_cgraph * gf,
+                                                             const std::vector<ggml_tensor *> & intermediates,
+                                                             const std::vector<ggml_tensor *> & members,
+                                                             const ggml_tensor * out, size_t out_head_bytes) {
+    for (auto * t : intermediates) {
+        if (t->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return "an intermediate is a graph output";
+        }
+    }
+    if (out && (out->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return "the output is a graph output";
+    }
+    for (int i = 0; i < gf->n_nodes; i++) {
+        ggml_tensor * n = gf->nodes[i];
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            ggml_tensor * src = n->src[s];
+            if (!src) {
+                continue;
+            }
+            ggml_tensor * root = ggml_hexagon_gdn_root(src);
+            if (out && root == out) {
+                // The region that the reader touches: the view node itself when n is a view of out
+                // (its src is the whole tensor), else the view that n reads.
+                const ggml_tensor * region = (src == out && ggml_hexagon_gdn_is_view_op(n)) ? n : src;
+                if (region != out && region->view_offs + ggml_nbytes(region) <= out_head_bytes) {
+                    continue;
+                }
+                if (ggml_hexagon_gdn_contains(members, n)) {
+                    continue;
+                }
+                return "the state part of the output has a reader outside the chain";
+            }
+            if (ggml_hexagon_gdn_contains(intermediates, root) && !ggml_hexagon_gdn_contains(members, n)) {
+                return "an intermediate has a reader outside the chain";
+            }
+        }
+    }
+    return nullptr;
+}
+
+// No node in (first, last] outside the chain touches the cache. Empty nodes do nothing and are ignored.
+static inline bool ggml_hexagon_gdn_chain_span_is_clean(const ggml_cgraph * gf, int first, int last,
+                                                        const ggml_tensor * cache,
+                                                        const std::vector<ggml_tensor *> & members) {
+    for (int i = first + 1; i <= last; i++) {
+        ggml_tensor * n = gf->nodes[i];
+        if (ggml_is_empty(n) || ggml_hexagon_gdn_is_view_op(n) || ggml_hexagon_gdn_contains(members, n)) {
+            continue;
+        }
+        if (ggml_hexagon_gdn_node_touches(n, cache)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// The one CPY whose source is a view of `src_root`. Two of them (rollback snapshots) give nullptr and set `n_found`.
+static inline ggml_tensor * ggml_hexagon_gdn_find_cpy(const ggml_cgraph * gf, const ggml_tensor * src_root, int & n_found) {
+    ggml_tensor * P = nullptr;
+    n_found = 0;
+    for (int i = 0; i < gf->n_nodes; i++) {
+        ggml_tensor * n = gf->nodes[i];
+        if (n->op != GGML_OP_CPY || !n->src[0] || !n->src[1] || ggml_hexagon_gdn_root(n->src[0]) != src_root) {
+            continue;
+        }
+        n_found++;
+        P = n;
+    }
+    return n_found == 1 ? P : nullptr;
+}
+
+// True for the node that ends the conv chain: SILU of an SSM_CONV
+static inline bool ggml_hexagon_gdn_is_conv_candidate(const ggml_tensor * t) {
+    return t->op == GGML_OP_UNARY && ggml_get_unary_op(t) == GGML_UNARY_OP_SILU && t->src[0] &&
+           t->src[0]->op == GGML_OP_SSM_CONV;
+}
+
+static inline const char * ggml_hexagon_gdn_conv_chain_check(const ggml_cgraph * gf,
+                                                             const std::unordered_map<const ggml_tensor *, int> & index,
+                                                             int is, ggml_hexagon_gdn_conv_match & m) {
+    ggml_tensor * S = gf->nodes[is];
+    if (!ggml_hexagon_gdn_is_conv_candidate(S)) {
+        return "not a SILU of an SSM_CONV";
+    }
+    if (S->type != GGML_TYPE_F32 || !ggml_is_contiguous(S)) {
+        return "the SILU output is not contiguous F32";
+    }
+    ggml_tensor * C = S->src[0];
+    if (C->type != GGML_TYPE_F32) {
+        return "the SSM_CONV output is not F32";
+    }
+    ggml_tensor * CI = C->src[0];
+    ggml_tensor * W  = C->src[1];
+    if (!CI || !W || CI->op != GGML_OP_CONCAT || ggml_get_op_params_i32(CI, 0) != 0) {
+        return "the SSM_CONV input is not a CONCAT on dim 0";
+    }
+    if (CI->type != GGML_TYPE_F32 || !ggml_is_contiguous(CI) || CI->ne[2] != 1 || CI->ne[3] != 1) {
+        return "the CONCAT is not one contiguous F32 sequence";
+    }
+    const int64_t d_conv = CI->ne[0];
+    const int64_t n_ch   = CI->ne[1];
+    if (d_conv != 4) {
+        return "the conv kernel is not 4 wide (the DSP kernel is for d_conv = 4)";
+    }
+    if (n_ch < 1) {
+        return "no channels";
+    }
+    const int64_t row = (d_conv - 1) * n_ch;
+    if (W->type != GGML_TYPE_F32 || W->ne[0] != d_conv || W->ne[1] != n_ch || W->nb[0] != sizeof(float) ||
+        W->nb[1] != (size_t) d_conv * sizeof(float)) {
+        return "the conv weights are not a contiguous F32 [d_conv, n_ch]";
+    }
+    if (!ggml_hexagon_gdn_is_f32_row(C, n_ch) || !ggml_hexagon_gdn_is_f32_row(S, n_ch)) {
+        return "the conv output is not one token";
+    }
+
+    // the state read: the first CONCAT input is a reshape of GET_ROWS(states, s_copy)
+    ggml_tensor * cs = CI->src[0];
+    if (!cs || !ggml_hexagon_gdn_is_view_op(cs) || cs->view_offs != 0 || !ggml_is_contiguous(cs)) {
+        return "the first CONCAT input is not a contiguous view at offset 0";
+    }
+    if (cs->ne[0] != d_conv - 1 || cs->ne[1] != n_ch || cs->ne[2] != 1 || cs->ne[3] != 1) {
+        return "the first CONCAT input is not [d_conv - 1, n_ch, 1, 1]";
+    }
+    ggml_tensor * R = ggml_hexagon_gdn_root(cs);
+    if (R->op != GGML_OP_GET_ROWS) {
+        return "the conv state does not come from GET_ROWS";
+    }
+    if (!ggml_hexagon_gdn_is_f32_row(R, row)) {
+        return "the GET_ROWS of the conv state is not one row";
+    }
+    ggml_tensor * states = R->src[0];
+    ggml_tensor * idx    = R->src[1];
+    if (!states || !ggml_hexagon_gdn_is_state_table(states, row)) {
+        return "the conv state table is not [row, n_slots] with contiguous rows";
+    }
+    if (!idx || idx->type != GGML_TYPE_I32 || ggml_nelements(idx) != 1) {
+        return "s_copy is not one I32 index";
+    }
+    ggml_tensor * cache = ggml_hexagon_gdn_root(states);
+
+    // the new column: the second CONCAT input is the transposed projection [1, n_ch]
+    ggml_tensor * xt = CI->src[1];
+    if (!xt || xt->type != GGML_TYPE_F32 || xt->ne[0] != 1 || xt->ne[1] != n_ch || xt->ne[2] != 1 ||
+        xt->ne[3] != 1 || xt->nb[1] != sizeof(float)) {
+        return "the second CONCAT input is not a transposed contiguous column [1, n_ch]";
+    }
+
+    // the state write: the one CPY of the last d_conv - 1 columns of the CONCAT into a slot of the cache
+    int n_cpy = 0;
+    ggml_tensor * P = ggml_hexagon_gdn_find_cpy(gf, CI, n_cpy);
+    if (!P) {
+        return n_cpy == 0 ? "no CPY of the CONCAT into the cache" : "more than one CPY of the CONCAT (rollback snapshots)";
+    }
+    if (P->type != GGML_TYPE_F32) {
+        return "the CPY is not F32";
+    }
+    ggml_tensor * last = P->src[0];
+    ggml_tensor * slot = P->src[1];
+    if (last->view_offs != sizeof(float) || last->ne[0] != d_conv - 1 || last->ne[1] != n_ch ||
+        last->ne[2] != 1 || last->ne[3] != 1 || last->nb[0] != sizeof(float) || last->nb[1] != CI->nb[1]) {
+        return "the CPY source is not the last d_conv - 1 columns of the CONCAT";
+    }
+    if (slot == cache || ggml_hexagon_gdn_root(slot) != cache) {
+        return "the CPY destination is not a view of the conv cache";
+    }
+    if (!ggml_hexagon_gdn_is_f32_row(slot, row)) {
+        return "the CPY destination is not one contiguous row";
+    }
+
+    const std::vector<ggml_tensor *> intermediates = { R, CI, C };
+    const std::vector<ggml_tensor *> members       = { R, cs, CI, C, S, last, P };
+    if (const char * reason = ggml_hexagon_gdn_chain_is_private(gf, intermediates, members, nullptr, 0)) {
+        return reason;
+    }
+
+    auto ir = index.find(R);
+    auto ip = index.find(P);
+    if (ir == index.end() || ip == index.end()) {
+        return "GET_ROWS or CPY is not a node of the graph";
+    }
+    const int emit     = std::min(is, ip->second);
+    const int last_idx = std::max(is, ip->second);
+    if (ir->second > emit) {
+        return "the GET_ROWS comes after the SILU or the CPY";
+    }
+    if (!ggml_hexagon_gdn_chain_span_is_clean(gf, ir->second, last_idx, cache, members)) {
+        return "another node touches the conv cache inside the chain span";
+    }
+
+    m.S      = S;
+    m.C      = C;
+    m.CI     = CI;
+    m.W      = W;
+    m.R      = R;
+    m.states = states;
+    m.idx    = idx;
+    m.xt     = xt;
+    m.P      = P;
+    m.slot   = slot;
+    m.members = members;
+    m.emit   = emit;
+    m.d_conv = d_conv;
+    m.n_ch   = n_ch;
+    return nullptr;
+}
+
+static inline const char * ggml_hexagon_gdn_state_chain_check(const ggml_cgraph * gf,
+                                                              const std::unordered_map<const ggml_tensor *, int> & index,
+                                                              int ig, ggml_hexagon_gdn_state_match & m) {
+    ggml_tensor * G = gf->nodes[ig];
+    if (G->op != GGML_OP_GATED_DELTA_NET) {
+        return "not a GATED_DELTA_NET";
+    }
+    if (G->type != GGML_TYPE_F32 || !ggml_is_contiguous(G)) {
+        return "the output is not contiguous F32";
+    }
+    if (ggml_get_op_params_i32(G, 0) != 1) {
+        return "K is not 1";
+    }
+    ggml_tensor * q    = G->src[0];
+    ggml_tensor * k    = G->src[1];
+    ggml_tensor * v    = G->src[2];
+    ggml_tensor * g    = G->src[3];
+    ggml_tensor * beta = G->src[4];
+    ggml_tensor * st   = G->src[5];
+    if (!q || !k || !v || !g || !beta || !st) {
+        return "an input is missing";
+    }
+    const int64_t S_v = v->ne[0];
+    const int64_t H   = v->ne[1];
+    if (v->ne[2] != 1 || v->ne[3] != 1) {
+        return "not one token of one sequence";
+    }
+    if (q->ne[2] != 1 || q->ne[3] != 1 || k->ne[2] != 1 || k->ne[3] != 1) {
+        return "q or k is not one token of one sequence";
+    }
+    const int64_t D = S_v * S_v * H;
+    if (G->ne[0] != S_v * H || G->ne[1] != 1 + S_v || G->ne[2] != 1 || G->ne[3] != 1) {
+        return "the output is not [S_v * H, 1 + S_v]";
+    }
+    const size_t head_bytes = (size_t) S_v * H * sizeof(float);
+
+    // the state read: a reshape of GET_ROWS(states, s_copy)
+    if (!ggml_hexagon_gdn_is_view_op(st)) {
+        return "the state input is not a view";
+    }
+    if (st->view_offs != 0 || !ggml_is_contiguous(st) || ggml_nelements(st) != D) {
+        return "the state input is not a contiguous view of D elements at offset 0";
+    }
+    ggml_tensor * R = ggml_hexagon_gdn_root(st);
+    if (R->op != GGML_OP_GET_ROWS) {
+        return "the state does not come from GET_ROWS";
+    }
+    if (!ggml_hexagon_gdn_is_f32_row(R, D)) {
+        return "the GET_ROWS of the state is not one row of D";
+    }
+    ggml_tensor * states = R->src[0];
+    ggml_tensor * idx    = R->src[1];
+    if (!states || !ggml_hexagon_gdn_is_state_table(states, D)) {
+        return "the state table is not [D, n_slots] with contiguous rows";
+    }
+    if (!idx || idx->type != GGML_TYPE_I32 || ggml_nelements(idx) != 1) {
+        return "s_copy is not one I32 index";
+    }
+    ggml_tensor * cache = ggml_hexagon_gdn_root(states);
+
+    // the state write: the one CPY of the state tail of the output into a slot of the cache
+    int n_cpy = 0;
+    ggml_tensor * P = ggml_hexagon_gdn_find_cpy(gf, G, n_cpy);
+    if (!P) {
+        return n_cpy == 0 ? "no CPY of the output into the cache" : "more than one CPY of the output (rollback snapshots)";
+    }
+    if (P->type != GGML_TYPE_F32) {
+        return "the CPY is not F32";
+    }
+    ggml_tensor * tail = P->src[0];
+    ggml_tensor * slot = P->src[1];
+    if (tail == G) {
+        return "the CPY source is the whole output";
+    }
+    if (tail->view_offs != head_bytes || !ggml_is_contiguous(tail) || ggml_nelements(tail) != D) {
+        return "the CPY source is not the contiguous state tail of the output";
+    }
+    if (slot == cache || ggml_hexagon_gdn_root(slot) != cache) {
+        return "the CPY destination is not a view of the state cache";
+    }
+    if (slot->type != GGML_TYPE_F32 || slot->ne[0] != D || ggml_nelements(slot) != D || slot->nb[0] != sizeof(float)) {
+        return "the CPY destination is not one contiguous row of D";
+    }
+
+    const std::vector<ggml_tensor *> intermediates = { R };
+    const std::vector<ggml_tensor *> members       = { R, st, G, tail, P };
+    if (const char * reason = ggml_hexagon_gdn_chain_is_private(gf, intermediates, members, G, head_bytes)) {
+        return reason;
+    }
+
+    auto ir = index.find(R);
+    auto ip = index.find(P);
+    if (ir == index.end() || ip == index.end()) {
+        return "GET_ROWS or CPY is not a node of the graph";
+    }
+    if (ir->second > ig || ip->second < ig) {
+        return "the GET_ROWS or the CPY is not around the GATED_DELTA_NET";
+    }
+    if (!ggml_hexagon_gdn_chain_span_is_clean(gf, ir->second, ip->second, cache, members)) {
+        return "another node touches the state cache inside the chain span";
+    }
+
+    m.G      = G;
+    m.q      = q;
+    m.k      = k;
+    m.v      = v;
+    m.g      = g;
+    m.beta   = beta;
+    m.R      = R;
+    m.states = states;
+    m.idx    = idx;
+    m.P      = P;
+    m.slot   = slot;
+    m.members = members;
+    m.emit   = ig;
+    m.S_v    = S_v;
+    m.H      = H;
+    return nullptr;
+}
+
+#endif // HTP_GDN_MATCH_H
