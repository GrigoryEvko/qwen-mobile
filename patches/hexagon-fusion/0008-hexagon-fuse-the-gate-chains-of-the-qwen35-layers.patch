diff --git a/ggml/src/ggml-hexagon/htp-gate-fusion.h b/ggml/src/ggml-hexagon/htp-gate-fusion.h
new file mode 100644
index 0000000..9175180
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp-gate-fusion.h
@@ -0,0 +1,395 @@
+// The graph match of the two gate chains of the Qwen3.5 layers (host side). Refer to htp/gate-ops.h for
+// the DSP ops.
+//
+//   MUL(MUL(RMS_NORM(x), w), SILU(z))                  -> HTP_OP_RMS_NORM_GATE (x, w, z)
+//   MUL(a, SIGMOID(CONT(g))) or MUL(a, SIGMOID(g))     -> HTP_OP_SIGMOID_GATE (a, g)
+//
+// Each MUL can also have its two operands in the other sequence. The fused op reads a CONT source with
+// its strides, thus the CONT goes away.
+//
+// The fused op goes to the index of the last MUL, thus it reads each input at that index and not at the
+// index of the node that reads the input in the graph. Two parts keep the inputs intact until the MUL:
+//   - ggml_hexagon_gate_keep_inputs (graph_optimize, before ggml-alloc) asks the scheduler to keep each
+//     input allocated until the MUL. Thus ggml-alloc gives no byte of an input to a node before the MUL.
+//   - ggml_hexagon_gate_match_all (graph_compute) checks the bytes of the allocated graph: no node
+//     between the two indexes writes a byte of an input, and the output shares no byte with an input
+//     unless the two have the same rows at the same addresses.
+// The fused op does not write the replaced nodes, thus the match rejects a chain when a node outside the
+// chain reads one of them.
+//
+// The switches: GGML_HEXAGON_FUSE_NORM_GATE and GGML_HEXAGON_FUSE_ATTN_GATE. 1 (the preset value) fuses
+// the chain, and 0 keeps the unfused ops. GGML_HEXAGON_OPFUSION=0 also keeps them.
+
+#ifndef HTP_GATE_FUSION_H
+#define HTP_GATE_FUSION_H
+
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-backend-impl.h"
+#include "ggml-impl.h"
+
+#include "htp-gdn-match.h"
+#include "htp-opnode.h"
+#include "htp/gate-ops.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+// The value of one switch: 1 when the variable is not set or is not 0
+static inline bool ggml_hexagon_gate_switch(const char * name) {
+    const char * v = getenv(name);
+    return v == nullptr || atoi(v) != 0;
+}
+
+// The process reads each switch one time
+static inline bool ggml_hexagon_fuse_norm_gate() {
+    static const bool on = ggml_hexagon_gate_switch("GGML_HEXAGON_FUSE_NORM_GATE");
+    return on;
+}
+
+static inline bool ggml_hexagon_fuse_attn_gate() {
+    static const bool on = ggml_hexagon_gate_switch("GGML_HEXAGON_FUSE_ATTN_GATE");
+    return on;
+}
+
+struct ggml_hexagon_gate_match {
+    htp_op_code                opcode = HTP_OP_INVALID;
+    ggml_tensor *              out    = nullptr;  // the last MUL, the output of the fused op
+    ggml_tensor *              in0    = nullptr;  // x or a
+    ggml_tensor *              w      = nullptr;  // the norm weight of RMS_NORM_GATE
+    ggml_tensor *              in1    = nullptr;  // z or g, the tensor with the shape of the rows
+    std::vector<ggml_tensor *> members;           // the replaced nodes in graph order, the last MUL included
+    std::vector<ggml_tensor *> inter;             // the replaced nodes that the fused op does not write
+    std::vector<std::pair<ggml_tensor *, ggml_tensor *>> reads;  // each input and the member that reads it
+    float                      eps  = 0.0f;
+    bool                       swap = false;
+    bool                       cont = false;  // SIGMOID_GATE: the graph reads g through a CONT
+};
+
+// A node that the fused op replaces: an op result, not a view, F32
+static inline bool ggml_hexagon_gate_is_op(const ggml_tensor * t, ggml_op op) {
+    return t && t->op == op && t->view_src == nullptr && t->type == GGML_TYPE_F32;
+}
+
+static inline bool ggml_hexagon_gate_is_unary(const ggml_tensor * t, ggml_unary_op uop) {
+    return ggml_hexagon_gate_is_op(t, GGML_OP_UNARY) && ggml_get_unary_op(t) == uop;
+}
+
+// The rule of gate_operand_init (htp/gate-ops.c): the tensor has the shape of the rows (the shape of
+// `rows`), or it is contiguous with the same number of values. The row stride must fit in one DMA
+// transfer. Keep the two in agreement: the DSP refuses an op that this check accepts in error.
+static inline bool ggml_hexagon_gate_operand_ok(const ggml_tensor * t, const ggml_tensor * rows) {
+    if (t->type != GGML_TYPE_F32 || t->nb[0] != sizeof(float)) {
+        return false;
+    }
+    size_t nb1;
+    if (ggml_are_same_shape(t, rows)) {
+        nb1 = t->nb[1];
+    } else if (ggml_is_contiguous(t) && ggml_nelements(t) == ggml_nelements(rows)) {
+        nb1 = (size_t) rows->ne[0] * sizeof(float);
+    } else {
+        return false;
+    }
+    return nb1 <= HTP_GATE_DMA_MAX_STRIDE;
+}
+
+// True when the rows of the two tensors are at the same addresses: then the fused op reads each row of
+// the input before it writes the same row of the output. `rows` gives the shape of the rows.
+static inline bool ggml_hexagon_gate_same_rows(const ggml_tensor * a, const ggml_tensor * b, const ggml_tensor * rows) {
+    if (a->data != b->data) {
+        return false;
+    }
+    const bool a_flat = ggml_is_contiguous(a);
+    const bool b_flat = ggml_is_contiguous(b);
+    if (a_flat && b_flat) {
+        return true;
+    }
+    if (!ggml_are_same_shape(a, rows) || !ggml_are_same_shape(b, rows)) {
+        return false;
+    }
+    for (int d = 1; d < GGML_MAX_DIMS; d++) {
+        if (rows->ne[d] > 1 && a->nb[d] != b->nb[d]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// The shape of the chain that ends at the MUL `e`, without the graph. Returns nullptr when the chain
+// matches, or a short text for the first failed condition. *candidate is true when one operand of `e`
+// is a SILU or a SIGMOID, thus a failure is worth a log line.
+static inline const char * ggml_hexagon_gate_chain(ggml_tensor * e, bool norm_on, bool attn_on,
+                                                   ggml_hexagon_gate_match & m, bool * candidate) {
+    *candidate = false;
+    if (!ggml_hexagon_gate_is_op(e, GGML_OP_MUL) || !e->src[0] || !e->src[1]) {
+        return "not an F32 MUL";
+    }
+
+    ggml_tensor * s0 = e->src[0];
+    ggml_tensor * s1 = e->src[1];
+
+    const bool silu0 = ggml_hexagon_gate_is_unary(s0, GGML_UNARY_OP_SILU);
+    const bool silu1 = ggml_hexagon_gate_is_unary(s1, GGML_UNARY_OP_SILU);
+    const bool sig0  = ggml_hexagon_gate_is_unary(s0, GGML_UNARY_OP_SIGMOID);
+    const bool sig1  = ggml_hexagon_gate_is_unary(s1, GGML_UNARY_OP_SIGMOID);
+
+    m   = ggml_hexagon_gate_match();
+    m.out = e;
+
+    if (norm_on && (silu0 || silu1)) {
+        *candidate = true;
+        // The operand that is not the SILU must be the MUL of an RMS_NORM and a weight
+        ggml_tensor * S = silu1 ? s1 : s0;
+        ggml_tensor * N = silu1 ? s0 : s1;
+        m.swap = !silu1;
+        if (!ggml_hexagon_gate_is_op(N, GGML_OP_MUL) || !N->src[0] || !N->src[1]) {
+            return "no MUL of an RMS_NORM beside the SILU";
+        }
+        ggml_tensor * R = ggml_hexagon_gate_is_op(N->src[0], GGML_OP_RMS_NORM) ? N->src[0] : N->src[1];
+        ggml_tensor * w = R == N->src[0] ? N->src[1] : N->src[0];
+        if (!ggml_hexagon_gate_is_op(R, GGML_OP_RMS_NORM) || !R->src[0]) {
+            return "no RMS_NORM in the norm side";
+        }
+        ggml_tensor * x = R->src[0];
+        ggml_tensor * z = S->src[0];
+        if (!z || !w) {
+            return "a missing source";
+        }
+        if (!ggml_are_same_shape(x, e) || !ggml_are_same_shape(z, e) || !ggml_are_same_shape(R, e) ||
+            !ggml_are_same_shape(N, e) || !ggml_are_same_shape(S, e)) {
+            return "the shapes of the chain differ";
+        }
+        if (w->type != GGML_TYPE_F32 || w->ne[0] != e->ne[0] || ggml_nelements(w) != w->ne[0] || w->nb[0] != sizeof(float)) {
+            return "the weight is not one F32 row of the norm width";
+        }
+        if (!ggml_is_contiguous(e)) {
+            return "the output is not contiguous";
+        }
+        if (!ggml_hexagon_gate_operand_ok(x, z) || !ggml_hexagon_gate_operand_ok(z, z) ||
+            !ggml_hexagon_gate_operand_ok(e, z)) {
+            return "an operand has rows that the op cannot read";
+        }
+        m.opcode  = HTP_OP_RMS_NORM_GATE;
+        m.in0     = x;
+        m.w       = w;
+        m.in1     = z;
+        m.members = { R, N, S, e };
+        m.inter   = { R, N, S };
+        m.reads   = { { x, R }, { w, N }, { z, S } };
+        memcpy(&m.eps, R->op_params, sizeof(float));
+    } else if (attn_on && (sig0 || sig1)) {
+        *candidate = true;
+        ggml_tensor * SIG = sig1 ? s1 : s0;
+        ggml_tensor * a   = sig1 ? s0 : s1;
+        m.swap = !sig1;
+        ggml_tensor * g = SIG->src[0];
+        if (!g) {
+            return "a missing source";
+        }
+        ggml_tensor * C = nullptr;
+        if (ggml_hexagon_gate_is_op(g, GGML_OP_CONT) && g->src[0] && g->src[0]->type == GGML_TYPE_F32 &&
+            ggml_nelements(g->src[0]) == ggml_nelements(g)) {
+            C = g;
+            g = C->src[0];
+        }
+        if (!ggml_are_same_shape(SIG, e) || !ggml_are_same_shape(a, e) || (C && !ggml_are_same_shape(C, e))) {
+            return "the shapes of the chain differ";
+        }
+        // CONT writes the values of g in the order of its shape, thus without the CONT the gate must have
+        // the shape of the output
+        if (!C && !ggml_are_same_shape(g, e)) {
+            return "the gate has another shape";
+        }
+        if (!ggml_is_contiguous(e)) {
+            return "the output is not contiguous";
+        }
+        if (!ggml_hexagon_gate_operand_ok(a, g) || !ggml_hexagon_gate_operand_ok(g, g) ||
+            !ggml_hexagon_gate_operand_ok(e, g)) {
+            return "an operand has rows that the op cannot read";
+        }
+        m.opcode = HTP_OP_SIGMOID_GATE;
+        m.in0    = a;
+        m.in1    = g;
+        m.cont   = C != nullptr;
+        if (C) {
+            m.members = { C, SIG, e };
+            m.inter   = { C, SIG };
+            m.reads   = { { g, C }, { a, e } };
+        } else {
+            m.members = { SIG, e };
+            m.inter   = { SIG };
+            m.reads   = { { g, SIG }, { a, e } };
+        }
+    } else {
+        return "no SILU or SIGMOID operand";
+    }
+
+    const ggml_tensor * rows  = m.in1;
+    const int64_t       nrows = rows->ne[1] * rows->ne[2] * rows->ne[3];
+    if (rows->ne[0] <= 0 || nrows <= 0 || nrows > (int64_t) UINT32_MAX ||
+        rows->ne[0] * (int64_t) sizeof(float) > (int64_t) HTP_GATE_DMA_MAX_STRIDE) {
+        return "the row count or the row size is out of range";
+    }
+    return nullptr;
+}
+
+// The checks of the chain in the graph of one split: the members are nodes of the split and are not
+// part of a different fused op, no node outside the chain reads an intermediate, no node between the
+// read of an input and the output writes a byte of the input, and the output shares no byte with an
+// input unless the rows are the same. Needs the data of the allocated graph.
+// O(nodes * (GGML_MAX_SRC + members)) for each chain.
+static inline const char * ggml_hexagon_gate_placement(const ggml_cgraph * gf,
+                                                       const std::unordered_map<const ggml_tensor *, int> & index,
+                                                       const std::vector<uint8_t> & skip, const ggml_hexagon_gate_match & m,
+                                                       int * emit) {
+    for (auto * t : m.members) {
+        auto it = index.find(t);
+        if (it == index.end()) {
+            return "a member is not a node of this split";
+        }
+        if (skip[it->second]) {
+            return "a member is part of a different fused op";
+        }
+    }
+    *emit = index.at(m.out);
+
+    const char * reason = ggml_hexagon_gdn_chain_is_private(gf, m.inter, m.members, nullptr, 0);
+    if (reason) {
+        return reason;
+    }
+    for (const auto & rd : m.reads) {
+        if (!ggml_hexagon_gdn_move_is_safe(gf, *emit, index.at(rd.second), rd.first, false, m.members)) {
+            return "a node between the read of an input and the output writes a byte of the input";
+        }
+    }
+    for (const ggml_tensor * t : { m.in0, m.w, m.in1 }) {
+        if (t && ggml_hexagon_gdn_bytes_overlap(m.out, t) && (t == m.w || !ggml_hexagon_gate_same_rows(m.out, t, m.in1))) {
+            return "the output shares bytes with an input";
+        }
+    }
+    return nullptr;
+}
+
+// Builds the fused op of a matched chain. False when no block of one row fits in the VTCM.
+static inline bool ggml_hexagon_gate_make_node(const ggml_hexagon_gate_match & m, uint32_t n_threads, size_t vtcm_size,
+                                               htp_opnode & node) {
+    const ggml_tensor * rows      = m.in1;
+    const bool          has_w     = m.opcode == HTP_OP_RMS_NORM_GATE;
+    const uint32_t      nrows     = (uint32_t) (rows->ne[1] * rows->ne[2] * rows->ne[3]);
+    const uint32_t      threads   = std::min(std::max(n_threads, 1u), nrows);
+    const size_t        row_bytes = (size_t) rows->ne[0] * sizeof(float);
+    const size_t        row_align = (row_bytes + 127) / 128 * 128;
+    const uint32_t      per_thr   = (nrows + threads - 1) / threads;
+    const uint32_t      block     = htp_gate_max_block(has_w, row_align, threads, vtcm_size, per_thr);
+    if (block == 0) {
+        return false;
+    }
+
+    node = htp_opnode(m.opcode, m.out);
+    node.name = has_w ? "RMS_NORM_GATE" : "SIGMOID_GATE";
+    if (has_w) {
+        node.inputs = { m.in0, m.w, m.in1 };
+    } else {
+        node.inputs = { m.in0, m.in1 };
+    }
+    node.outputs = { m.out };
+    node.fused.assign(m.members.begin(), m.members.end() - 1);
+
+    htp_gate_kernel_params kp;
+    memset(&kp, 0, sizeof(kp));
+    kp.n_threads = threads;
+    kp.block     = block;
+    memcpy(&kp.eps_bits, &m.eps, sizeof(float));
+    kp.flags = (m.swap ? HTP_GATE_FLAG_SWAP : 0) | (m.cont ? HTP_GATE_FLAG_CONT : 0);
+    memcpy(node.kernel_params, &kp, sizeof(kp));
+    return true;
+}
+
+// graph_optimize: asks the scheduler to keep the inputs of each chain allocated until its output. A
+// weight is not a tensor of ggml-alloc, thus it needs no such request. O(nodes * members) with the
+// check of each chain.
+static inline void ggml_hexagon_gate_keep_inputs(ggml_cgraph * gf, ggml_backend_graph_optimize_params * params) {
+    const bool norm_on = ggml_hexagon_fuse_norm_gate();
+    const bool attn_on = ggml_hexagon_fuse_attn_gate();
+    if (!params || !params->add_alloc_dep || (!norm_on && !attn_on)) {
+        return;
+    }
+    for (int i = 0; i < gf->n_nodes; i++) {
+        ggml_hexagon_gate_match m;
+        bool                    candidate = false;
+        if (ggml_hexagon_gate_chain(gf->nodes[i], norm_on, attn_on, m, &candidate) ||
+            ggml_hexagon_gdn_chain_is_private(gf, m.inter, m.members, nullptr, 0)) {
+            continue;
+        }
+        for (ggml_tensor * t : { m.in0, m.w, m.in1 }) {
+            if (!t) {
+                continue;
+            }
+            const ggml_tensor * root = ggml_hexagon_gdn_root(t);
+            if (root->buffer && ggml_backend_buffer_get_usage(root->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+                continue;
+            }
+            params->add_alloc_dep(params->user_data, t, m.out);
+        }
+    }
+}
+
+// graph_compute: matches the chains of one split. A matched chain puts its fused op at the index of its
+// output into `at`, and marks each member in `skip`. The fused ops of the gated delta net state (the
+// entries that `skip` and `at` already hold) keep their nodes. `name` and `verbose` are for the log.
+static inline void ggml_hexagon_gate_match_all(const ggml_cgraph * gf, uint32_t n_threads, size_t vtcm_size,
+                                               std::vector<uint8_t> & skip, std::unordered_map<int, htp_opnode> & at,
+                                               const char * name, bool verbose) {
+    const bool norm_on = ggml_hexagon_fuse_norm_gate();
+    const bool attn_on = ggml_hexagon_fuse_attn_gate();
+    if (!norm_on && !attn_on) {
+        return;
+    }
+    const auto index = ggml_hexagon_gdn_index(gf);
+
+    for (int i = 0; i < gf->n_nodes; i++) {
+        if (skip[i] || gf->nodes[i]->op != GGML_OP_MUL) {
+            continue;
+        }
+        ggml_hexagon_gate_match m;
+        bool                    candidate = false;
+        int                     emit      = -1;
+        htp_opnode              node;
+
+        const char * reason = ggml_hexagon_gate_chain(gf->nodes[i], norm_on, attn_on, m, &candidate);
+        if (!candidate) {
+            continue;
+        }
+        if (!reason) {
+            reason = ggml_hexagon_gate_placement(gf, index, skip, m, &emit);
+        }
+        if (!reason && at.count(emit)) {
+            reason = "a different fused op has the same index";
+        }
+        if (!reason && !ggml_hexagon_gate_make_node(m, n_threads, vtcm_size, node)) {
+            reason = "no block of one row fits in the VTCM";
+        }
+        if (reason) {
+            if (verbose) {
+                GGML_LOG_DEBUG("ggml-hex: %s gate candidate %s (node %d): %s\n", name, gf->nodes[i]->name, i, reason);
+            }
+            continue;
+        }
+
+        for (auto * t : m.members) {
+            skip[index.at(t)] = 1;
+        }
+        if (verbose) {
+            GGML_LOG_DEBUG("ggml-hex: %s fused %s %s (rows %lld of %lld) at node %d\n", name, node.name.c_str(),
+                           m.out->name, (long long) (m.in1->ne[1] * m.in1->ne[2] * m.in1->ne[3]),
+                           (long long) m.in1->ne[0], emit);
+        }
+        at.emplace(emit, std::move(node));
+    }
+}
+
+#endif  // HTP_GATE_FUSION_H
