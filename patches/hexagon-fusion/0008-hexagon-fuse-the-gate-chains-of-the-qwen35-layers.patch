 };
 
+// GGML_OP_RMS_NORM + GGML_OP_MUL + GGML_UNARY_OP_SILU + GGML_OP_MUL: the gated norm of the output of a gated
+// delta net layer, out = (rms_norm(x) * w) * silu(z) for each head of each token. The Hexagon backend runs
+// the chain as one op (RMS_NORM_GATE).
+struct test_norm_gate_fusion : public test_case {
+    const int64_t head_dim;
+    const int64_t n_heads;
+    const int64_t n_tokens;
+    const bool    swap;    // MUL(silu(z), norm) in place of MUL(norm, silu(z))
+    const int     layout;  // x: 0 a tensor of its own, 1 the head of a GATED_DELTA_NET output, 2 rows with a gap after each head group
+    const bool    reuse;   // a second reader of the SILU output, which keeps the unfused ops
+    const float   eps;
+
+    std::string vars() override {
+        return VARS_TO_STR7(head_dim, n_heads, n_tokens, swap, layout, reuse, eps);
+    }
+
+    test_norm_gate_fusion(int64_t head_dim = 128, int64_t n_heads = 32, int64_t n_tokens = 1, bool swap = false,
+            int layout = 0, bool reuse = false, float eps = 1e-6f)
+        : head_dim(head_dim), n_heads(n_heads), n_tokens(n_tokens), swap(swap), layout(layout), reuse(reuse), eps(eps) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * x = nullptr;
+        if (layout == 1) {
+            // GATED_DELTA_NET writes the attention output first and the state after it
+            ggml_tensor * base = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, head_dim * n_heads, n_tokens + 3);
+            ggml_set_name(base, "gdn_out");
+            x = ggml_view_4d(ctx, base, head_dim, n_heads, n_tokens, 1,
+                    ggml_row_size(base->type, head_dim), ggml_row_size(base->type, head_dim * n_heads),
+                    ggml_row_size(base->type, head_dim * n_heads * n_tokens), 0);
+        } else if (layout == 2) {
+            // one more head in each token, thus the rows of one token are not next to the rows of the next token
+            ggml_tensor * base = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, head_dim, n_heads + 1, n_tokens);
+            ggml_set_name(base, "x_base");
+            x = ggml_view_4d(ctx, base, head_dim, n_heads, n_tokens, 1, base->nb[1], base->nb[2], base->nb[3], 0);
+        } else {
+            x = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, head_dim, n_heads, n_tokens, 1);
+            ggml_set_name(x, "x");
+        }
+        ggml_tensor * w = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, head_dim);
+        ggml_set_name(w, "w");
+        // z is the output of a projection with all heads of a token in one row
+        ggml_tensor * z2 = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, head_dim * n_heads, n_tokens);
+        ggml_set_name(z2, "z");
+        ggml_tensor * z = ggml_reshape_4d(ctx, z2, head_dim, n_heads, n_tokens, 1);
+
+        ggml_tensor * norm = ggml_mul(ctx, ggml_rms_norm(ctx, x, eps), w);
+        ggml_tensor * gate = ggml_silu(ctx, z);
+        ggml_tensor * out  = swap ? ggml_mul(ctx, gate, norm) : ggml_mul(ctx, norm, gate);
+        if (reuse) {
+            ggml_set_name(out, "gated");
+            out = ggml_add(ctx, out, gate);
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (ggml_is_view_op(t->op)) { continue; }
+            if (strcmp(t->name, "z") == 0) {
+                // the SiLU of the int16 path of the HTP has an octave table to |z| = 16 and a clamp above it
+                init_tensor_uniform(t, -20.0f, 20.0f);
+            } else if (strcmp(t->name, "w") == 0) {
+                init_tensor_uniform(t, -2.0f, 2.0f);
+            } else {
+                init_tensor_uniform(t, -10.0f, 10.0f);
+            }
+        }
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "NORM_GATE_FUSION";
+    }
+
+    bool run_whole_graph() override { return true; }
+};
+
+// GGML_OP_CONT + GGML_UNARY_OP_SIGMOID + GGML_OP_MUL: the output gate of an attention layer with a joint q and
+// gate projection, out = a * sigmoid(g). The gate is the second half of the head_dim * 2 values of each head.
+// The Hexagon backend runs the chain as one op (SIGMOID_GATE) that reads the gate half with its strides.
+struct test_sigmoid_gate_fusion : public test_case {
+    const int64_t head_dim;
+    const int64_t n_heads;
+    const int64_t n_tokens;
+    const bool    swap;   // MUL(sigmoid(g), a) in place of MUL(a, sigmoid(g))
+    const bool    cont;   // the gate is the CONT of the gate half, else a contiguous tensor of its own
+    const bool    reuse;  // a second reader of the SIGMOID output, which keeps the unfused ops
+
+    std::string vars() override {
+        return VARS_TO_STR6(head_dim, n_heads, n_tokens, swap, cont, reuse);
+    }
+
+    test_sigmoid_gate_fusion(int64_t head_dim = 256, int64_t n_heads = 16, int64_t n_tokens = 1, bool swap = false,
+            bool cont = true, bool reuse = false)
+        : head_dim(head_dim), n_heads(n_heads), n_tokens(n_tokens), swap(swap), cont(cont), reuse(reuse) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * g = nullptr;
+        if (cont) {
+            ggml_tensor * qg = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, head_dim * 2 * n_heads, n_tokens);
+            ggml_set_name(qg, "qg");
+            const size_t es = ggml_element_size(qg);
+            g = ggml_view_3d(ctx, qg, head_dim, n_heads, n_tokens, es * head_dim * 2, es * head_dim * 2 * n_heads,
+                    es * head_dim);
+            g = ggml_cont_2d(ctx, g, head_dim * n_heads, n_tokens);
+        } else {
+            g = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, head_dim * n_heads, n_tokens);
+            ggml_set_name(g, "g");
+        }
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, head_dim * n_heads, n_tokens);
+        ggml_set_name(a, "a");
+
+        ggml_tensor * gate = ggml_sigmoid(ctx, g);
+        ggml_tensor * out  = swap ? ggml_mul(ctx, gate, a) : ggml_mul(ctx, a, gate);
+        if (reuse) {
