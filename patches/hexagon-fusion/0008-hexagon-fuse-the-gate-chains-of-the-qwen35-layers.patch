index 0000000..1579fe3
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/gate-ops.c
@@ -0,0 +1,371 @@
+#pragma clang diagnostic ignored "-Wunused-function"
+#pragma clang diagnostic ignored "-Wunused-variable"
+
+#include <HAP_farf.h>
+
+#include <string.h>
+
+#include "hex-common.h"
+#include "hex-dma.h"
+#include "hex-fastdiv.h"
+#include "hex-profile.h"
+
+#include "hvx-utils.h"
+#include "hvx-act-i16.h"
+
+#include "gate-ops.h"
+#include "htp-ctx.h"
+#include "htp-ops.h"
+#include "htp-tensor.h"
+
+// The gate ops of gate-ops.h. Each thread takes a range of rows. It moves blocks of rows from DDR to
+// the VTCM with a DMA double buffer, computes a block in the VTCM, and moves the output block back
+// with the DMA. The DDR traffic of a row is one read of each input and one write of the output.
+// O(rows * D) time.
+
+// The codes of octx->err_detail when the op refuses its descriptors or its kernel params
+enum {
+    GATE_ERR_TENSOR = 1,  // a tensor is missing, or it is not F32
+    GATE_ERR_SHAPE  = 2,  // an operand has neither the shape of the rows nor their value count in a contiguous tensor
+    GATE_ERR_WEIGHT = 3,  // the weight is not one row of D values
+    GATE_ERR_EXTENT = 4,  // the last row of an operand ends past the end of its tensor
+    GATE_ERR_DMA    = 5,  // a row size or a row stride is more than one DMA transfer can move
+    GATE_ERR_BLOCK  = 6,  // the block of the kernel params is 0, or more rows than one DMA transfer can move
+    GATE_ERR_OUTPUT = 7,  // the output is not contiguous
+    GATE_ERR_ROWS   = 8,  // the row count does not fit in 32 bits
+};
+
+// The addressing of the rows of one operand
+struct gate_operand {
+    const uint8_t * data;
+    uint32_t        nb1;
+    uint32_t        nb2;
+    uint32_t        nb3;
+    bool            flat;  // row r starts at r * nb1
+};
+
+struct htp_gate_context {
+    struct htp_ops_context * octx;
+
+    struct gate_operand in0;  // x or a
+    struct gate_operand in1;  // z or g
+    struct gate_operand out;
+    const uint8_t *     w;    // the weight row of RMS_NORM_GATE, NULL for SIGMOID_GATE
+
+    uint32_t D;
+    uint32_t ne1;
+    uint32_t ne2;
+    uint32_t nrows;
+    uint32_t rows_per_thread;
+    uint32_t block;
+
+    struct fastdiv_values div_ne1;
+    struct fastdiv_values div_ne2;
+    struct fastdiv_values div_ne12;
+
+    size_t row_bytes;    // D * 4
+    size_t row_aligned;  // row_bytes rounded up to a multiple of 128
+
+    bool  has_weight;
+    bool  swap;
+    bool  all_flat;      // each operand is flat, thus a block can cross the end of dim 1
+    bool  packed;        // row_bytes == row_aligned: the rows of a block lie back to back in the VTCM
+    float eps;
+
+    uint8_t * vtcm;
+    size_t    vtcm_per_thread;
+};
+
+// Sets the row addressing of one operand. A tensor with the shape of the rows keeps its strides. A
+// contiguous tensor with the same number of values gives row r at r * D values. False, with the
+// error code in *err, for another tensor or when the last row ends past the end of the tensor.
+static bool gate_operand_init(struct gate_operand * o, const struct htp_tensor * t, uint32_t D, uint32_t ne1,
+                              uint32_t ne2, uint32_t ne3, uint32_t * err) {
+    const uint64_t row_bytes = (uint64_t) D * sizeof(float);
+    const uint64_t nvals     = (uint64_t) t->ne[0] * t->ne[1] * t->ne[2] * t->ne[3];
+
+    uint64_t nb1, nb2, nb3;
+    if (t->nb[0] != sizeof(float)) {
+        *err = GATE_ERR_SHAPE;
+        return false;
+    }
+    if (t->ne[0] == D && t->ne[1] == ne1 && t->ne[2] == ne2 && t->ne[3] == ne3) {
+        nb1 = t->nb[1];
+        nb2 = t->nb[2];
+        nb3 = t->nb[3];
+    } else if (htp_tensor_is_contiguous(t, sizeof(float)) && nvals == row_bytes / sizeof(float) * ne1 * ne2 * ne3) {
+        nb1 = row_bytes;
+        nb2 = nb1 * ne1;
+        nb3 = nb2 * ne2;
+    } else {
+        *err = GATE_ERR_SHAPE;
+        return false;
+    }
+
+    // The byte after the last value of the last row
+    const uint64_t extent = (uint64_t) (ne1 - 1) * nb1 + (uint64_t) (ne2 - 1) * nb2 + (uint64_t) (ne3 - 1) * nb3 + row_bytes;
+    if (extent > t->size) {
+        *err = GATE_ERR_EXTENT;
+        return false;
+    }
+    if (nb1 > HTP_GATE_DMA_MAX_STRIDE) {
+        *err = GATE_ERR_DMA;
+        return false;
+    }
+
+    o->data = (const uint8_t *) t->data;
+    o->nb1  = (uint32_t) nb1;
+    o->nb2  = (uint32_t) nb2;
+    o->nb3  = (uint32_t) nb3;
+    o->flat = (ne2 == 1 || nb2 == nb1 * ne1) && (ne3 == 1 || nb3 == nb1 * ne1 * ne2);
+    return true;
+}
+
+// The byte offset of row ir in one operand
+static inline size_t gate_row_offset(const struct htp_gate_context * g, const struct gate_operand * o, uint32_t ir) {
+    if (o->flat) {
+        return (size_t) ir * o->nb1;
+    }
+    const uint32_t i1 = fastmodulo(ir, g->ne1, &g->div_ne1);
+    const uint32_t i2 = fastmodulo(fastdiv(ir, &g->div_ne1), g->ne2, &g->div_ne2);
+    const uint32_t i3 = fastdiv(ir, &g->div_ne12);
+    return (size_t) i1 * o->nb1 + (size_t) i2 * o->nb2 + (size_t) i3 * o->nb3;
+}
+
+// The rows of the block that starts at row ir. One DMA transfer has one row stride, thus a block of an
+// operand that is not flat stops at the end of dim 1.
+static inline uint32_t gate_block_rows(const struct htp_gate_context * g, uint32_t ir, uint32_t end) {
+    uint32_t n = MIN(g->block, end - ir);
+    if (!g->all_flat) {
+        n = MIN(n, g->ne1 - fastmodulo(ir, g->ne1, &g->div_ne1));
+    }
+    return n;
+}
+
+// The SiLU of silu_f32 in unary-ops.c, over cnt values
+static inline void gate_silu(uint8_t * restrict dst, const uint8_t * restrict src, uint32_t cnt) {
+    if (htp_act_i16_mode) {
+        hvx_silu_i16_f32_aa(dst, src, cnt);
+    } else {
+        hvx_sigmoid_f32_aa(dst, src, cnt);
+        hvx_mul_f32_aaa(dst, src, dst, cnt);
+    }
+}
+
+// The sigmoid of sigmoid_f32 in unary-ops.c, over cnt values
+static inline void gate_sigmoid(uint8_t * restrict dst, const uint8_t * restrict src, uint32_t cnt) {
+    if (htp_act_i16_mode) {
+        hvx_sigmoid_i16_f32_aa(dst, src, cnt);
+    } else {
+        hvx_sigmoid_f32_aa(dst, src, cnt);
+    }
+}
+
+// Computes n rows in the VTCM: o from a (x or a), b (z or g) and the weight row. When the rows are
+// packed, the activation and the product take all rows of the block in one call, which gives the
+// same value for each lane as one call for each row.
+static void gate_compute(const struct htp_gate_context * g, uint8_t * o, const uint8_t * a, const uint8_t * b,
+                         uint8_t * act, const uint8_t * wrow, uint32_t n) {
+    const uint32_t D     = g->D;
+    const size_t   Ra    = g->row_aligned;
+    const uint32_t calls = g->packed ? 1 : n;
+    const uint32_t cnt   = g->packed ? n * D : D;
+
+    if (g->has_weight) {
+        for (uint32_t r = 0; r < n; r++) {
+            hvx_fast_rms_norm_mul_f32(a + r * Ra, wrow, o + r * Ra, (int) D, g->eps);
+        }
+        for (uint32_t r = 0; r < calls; r++) {
+            gate_silu(act + r * Ra, b + r * Ra, cnt);
+        }
+        for (uint32_t r = 0; r < calls; r++) {
+            if (g->swap) {
+                hvx_mul_f32_aaa(o + r * Ra, act + r * Ra, o + r * Ra, cnt);
+            } else {
+                hvx_mul_f32_aaa(o + r * Ra, o + r * Ra, act + r * Ra, cnt);
+            }
+        }
+    } else {
+        for (uint32_t r = 0; r < calls; r++) {
+            gate_sigmoid(act + r * Ra, b + r * Ra, cnt);
+        }
+        for (uint32_t r = 0; r < calls; r++) {
+            if (g->swap) {
+                hvx_mul_f32_aaa(o + r * Ra, act + r * Ra, a + r * Ra, cnt);
+            } else {
+                hvx_mul_f32_aaa(o + r * Ra, a + r * Ra, act + r * Ra, cnt);
+            }
+        }
+    }
+}
+
+// One thread: the rows [ith * rows_per_thread, +rows_per_thread). The queue holds, for each block in
+// flight, the output slot, the first input and the second input, in this sequence. A pop of the output
+// slot waits for the write of the block that used the slot two blocks before.
+static void gate_worker(unsigned int nth, unsigned int ith, void * data) {
+    const struct htp_gate_context * g    = (const struct htp_gate_context *) data;
+    struct htp_ops_context *        octx = g->octx;
+
+    const uint32_t start = ith * g->rows_per_thread;
+    if (start >= g->nrows) {
+        return;
+    }
+    const uint32_t end = MIN(start + g->rows_per_thread, g->nrows);
+
+    const size_t Ra   = g->row_aligned;
+    const size_t half = (size_t) g->block * Ra;
+
+    uint8_t * base    = g->vtcm + (size_t) ith * g->vtcm_per_thread;
+    uint8_t * in0_buf = base;
+    uint8_t * in1_buf = base + 2 * half;
+    uint8_t * out_buf = base + 4 * half;
+    uint8_t * act     = base + 6 * half;
+    uint8_t * wrow    = base + 7 * half;
+
+    dma_queue *               q  = octx->ctx->dma[ith];
+    struct htp_thread_trace * tr = &octx->ctx->trace[ith];
+
+    if (g->has_weight) {
+        dma_queue_push(q, dma_make_ptr(wrow, g->w), Ra, 0, g->row_bytes, 1);
+        dma_queue_flush(q);
+    }
+
+    uint32_t pf = start;
+    for (uint32_t k = 0; k < 2 && pf < end; k++) {
+        const uint32_t n = gate_block_rows(g, pf, end);
+        dma_queue_push(q, dma_make_ptr((void *) g->out.data, out_buf + k * half), g->out.nb1, Ra, g->row_bytes, 0);
+        dma_queue_push(q, dma_make_ptr(in0_buf + k * half, g->in0.data + gate_row_offset(g, &g->in0, pf)), Ra,
+                       g->in0.nb1, g->row_bytes, n);
+        dma_queue_push(q, dma_make_ptr(in1_buf + k * half, g->in1.data + gate_row_offset(g, &g->in1, pf)), Ra,
+                       g->in1.nb1, g->row_bytes, n);
+        pf += n;
+    }
+
+    for (uint32_t ir = start; ir < end;) {
+        const uint32_t n = gate_block_rows(g, ir, end);
+
+        uint8_t * o = (uint8_t *) dma_queue_pop(q).src;
+        uint8_t * a = (uint8_t *) dma_queue_pop(q).dst;
+        uint8_t * b = (uint8_t *) dma_queue_pop(q).dst;
+
+        htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) ir);
+        gate_compute(g, o, a, b, act, wrow, n);
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) ir);
+
+        dma_queue_push(q, dma_make_ptr((uint8_t *) g->out.data + gate_row_offset(g, &g->out, ir), o), g->out.nb1, Ra,
+                       g->row_bytes, n);
+
+        if (pf < end) {
+            const uint32_t m = gate_block_rows(g, pf, end);
+            dma_queue_push(q, dma_make_ptr(a, g->in0.data + gate_row_offset(g, &g->in0, pf)), Ra, g->in0.nb1,
+                           g->row_bytes, m);
+            dma_queue_push(q, dma_make_ptr(b, g->in1.data + gate_row_offset(g, &g->in1, pf)), Ra, g->in1.nb1,
+                           g->row_bytes, m);
+            pf += m;
+        }
+        ir += n;
+    }
+
+    dma_queue_flush(q);
+}
+
+// Refuses the op with the status and the error code
+static int gate_refuse(struct htp_ops_context * octx, int status, uint32_t code) {
+    octx->err_detail = code;
+    FARF(ERROR, "gate-op %u: refused, code %u\n", octx->op, code);
+    return status;
+}
+
+int op_gate(struct htp_ops_context * octx) {
+    const bool                has_weight = octx->op == HTP_OP_RMS_NORM_GATE;
+    const struct htp_tensor * in0        = octx->src[0];
+    const struct htp_tensor * w          = has_weight ? octx->src[1] : NULL;
+    const struct htp_tensor * in1        = has_weight ? octx->src[2] : octx->src[1];
+    const struct htp_tensor * dst        = octx->dst;
+
+    if (!in0 || !in1 || !dst || (has_weight && !w)) {
+        return gate_refuse(octx, HTP_STATUS_INVAL_PARAMS, GATE_ERR_TENSOR);
+    }
+    if (in0->type != HTP_TYPE_F32 || in1->type != HTP_TYPE_F32 || dst->type != HTP_TYPE_F32 ||
+        (has_weight && w->type != HTP_TYPE_F32)) {
+        return gate_refuse(octx, HTP_STATUS_NO_SUPPORT, GATE_ERR_TENSOR);
+    }
+    // The host sends the op only to a single device, thus the op does not split its rows between devices
+    if (octx->ctx->mdev.count > 1) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+
+    const struct htp_gate_kernel_params * kp = (const struct htp_gate_kernel_params *) octx->kernel_params;
+    if (!htp_ops_context_set_n_threads(octx, kp->n_threads)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+
+    const uint32_t D     = in1->ne[0];
+    const uint32_t ne1   = in1->ne[1];
+    const uint32_t ne2   = in1->ne[2];
+    const uint32_t ne3   = in1->ne[3];
+    const uint64_t nrows = (uint64_t) ne1 * ne2 * ne3;
+    if (nrows > UINT32_MAX) {
+        return gate_refuse(octx, HTP_STATUS_INVAL_PARAMS, GATE_ERR_ROWS);
+    }
+    if (D == 0 || nrows == 0) {
+        return HTP_STATUS_OK;
+    }
+    if ((uint64_t) D * sizeof(float) > HTP_GATE_DMA_MAX_STRIDE) {
+        return gate_refuse(octx, HTP_STATUS_NO_SUPPORT, GATE_ERR_DMA);
+    }
+
+    struct htp_gate_context g;
+    memset(&g, 0, sizeof(g));
+    uint32_t err = 0;
+    if (!gate_operand_init(&g.in0, in0, D, ne1, ne2, ne3, &err) || !gate_operand_init(&g.in1, in1, D, ne1, ne2, ne3, &err) ||
+        !gate_operand_init(&g.out, dst, D, ne1, ne2, ne3, &err)) {
+        return gate_refuse(octx, HTP_STATUS_INVAL_PARAMS, err);
+    }
+    if (!htp_tensor_is_contiguous(dst, sizeof(float))) {
+        return gate_refuse(octx, HTP_STATUS_INVAL_PARAMS, GATE_ERR_OUTPUT);
+    }
+    if (has_weight && (w->ne[0] != D || w->ne[1] != 1 || w->ne[2] != 1 || w->ne[3] != 1 || w->nb[0] != sizeof(float) ||
+                       w->size < (uint64_t) D * sizeof(float))) {
+        return gate_refuse(octx, HTP_STATUS_INVAL_PARAMS, GATE_ERR_WEIGHT);
+    }
+    if (kp->block == 0 || kp->block > HTP_GATE_DMA_MAX_ROWS) {
+        return gate_refuse(octx, HTP_STATUS_INVAL_PARAMS, GATE_ERR_BLOCK);
+    }
+
+    const uint32_t n_threads = octx->n_threads;
+
+    g.octx            = octx;
+    g.w               = has_weight ? (const uint8_t *) w->data : NULL;
+    g.D               = D;
+    g.ne1             = ne1;
+    g.ne2             = ne2;
+    g.nrows           = (uint32_t) nrows;
+    g.rows_per_thread = (uint32_t) ((nrows + n_threads - 1) / n_threads);
+    g.block           = kp->block;
+    g.div_ne1         = init_fastdiv_values(ne1);
+    g.div_ne2         = init_fastdiv_values(ne2);
+    g.div_ne12        = init_fastdiv_values(ne1 * ne2);
+    g.row_bytes       = (size_t) D * sizeof(float);
+    g.row_aligned     = hex_round_up((uint32_t) g.row_bytes, 128);
+    g.has_weight      = has_weight;
+    g.swap            = (kp->flags & HTP_GATE_FLAG_SWAP) != 0;
+    g.all_flat        = g.in0.flat && g.in1.flat && g.out.flat;
+    g.packed          = g.row_bytes == g.row_aligned;
+    memcpy(&g.eps, &kp->eps_bits, sizeof(float));
+
+    g.vtcm_per_thread = htp_gate_vtcm_per_thread(has_weight, g.row_aligned, g.block);
+    if ((uint64_t) g.vtcm_per_thread * n_threads > octx->ctx->vtcm_size) {
+        FARF(ERROR, "gate-op %u: VTCM of %zu bytes is too small, needed %zu\n", octx->op, octx->ctx->vtcm_size,
+             g.vtcm_per_thread * n_threads);
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+    g.vtcm = octx->ctx->vtcm_base;
+
+    if (octx->flags & HTP_OPFLAGS_SKIP_COMPUTE) {
+        return HTP_STATUS_OK;
+    }
+
+    work_queue_run(octx->ctx->work_queue, gate_worker, &g, n_threads);
+    return HTP_STATUS_OK;
+}
diff --git a/ggml/src/ggml-hexagon/htp/gate-ops.h b/ggml/src/ggml-hexagon/htp/gate-ops.h
new file mode 100644
index 0000000..c84ce19
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/gate-ops.h
@@ -0,0 +1,88 @@
+#ifndef HTP_GATE_OPS_H
+#define HTP_GATE_OPS_H
+
+// The two gate ops of the Qwen3.5 layers. Each op does a chain of elementwise ops in one pass over
+// the rows, thus it reads each input one time and writes the output one time.
+//
+//   HTP_OP_RMS_NORM_GATE  dst = (rms_norm(x) * w) * silu(z)
+//                         src0 = x, src1 = w (one row), src2 = z
+//                         The output of a gated delta net layer before its ssm_out projection.
+//   HTP_OP_SIGMOID_GATE   dst = a * sigmoid(g)
+//                         src0 = a, src1 = g
+//                         The output gate of an attention layer before its output projection.
+//
+// A row has D values. The shape of the rows is the shape of the last src (z or g): D = ne[0], and
+// the row count is ne[1] * ne[2] * ne[3]. Each other operand (x, a, dst) has the same shape and its
+// own strides, or it is contiguous with the same number of values: then row r starts at value r * D.
+// Thus the op reads the gate half of a joint q and gate projection with its strides, and it needs no
+// CONT of that half.
+//
+// The op calls the row routines of the unfused ops in the same sequence: hvx_fast_rms_norm_mul_f32
+// of RMS_NORM_MUL, the SiLU and the sigmoid of unary-ops.c, and hvx_mul_f32_aaa of the MUL of
+// binary-ops.c. Each routine gives each value from its own inputs only, thus the output has the bits
+// of the unfused ops.
+
+#include "hex-common.h"
+#include "htp-ops.h"
+
+// The kernel params that the host computes (htp_op_desc.kernel_params)
+struct htp_gate_kernel_params {
+    uint32_t n_threads;  // the worker threads, 1 to the thread count of the session
+    uint32_t block;      // the rows of one DMA block of one thread
+    uint32_t eps_bits;   // RMS_NORM_GATE: the epsilon of the RMS norm, the bits of an f32
+    uint32_t flags;      // HTP_GATE_FLAG_*
+};
+
+#if defined(__cplusplus)
+static_assert(sizeof(struct htp_gate_kernel_params) <= HTP_OP_MAX_KERN_PARAMS * sizeof(int32_t),
+              "htp_gate_kernel_params is too large for the kernel params of an op");
+#else
+_Static_assert(sizeof(struct htp_gate_kernel_params) <= HTP_OP_MAX_KERN_PARAMS * sizeof(int32_t),
+               "htp_gate_kernel_params is too large for the kernel params of an op");
+#endif
+
+enum htp_gate_flags {
+    // The graph multiplies the gate first: MUL(silu(z), norm) or MUL(sigmoid(g), a). The op keeps the
+    // operand order of the MUL.
+    HTP_GATE_FLAG_SWAP = 1u << 0,
+    // SIGMOID_GATE: the chain of the graph reads g through a CONT. A CONT copies the values, thus the op
+    // reads g with its strides and does not read this flag. The flag gives the form of the chain to the
+    // host tools that compare the op with the graph.
+    HTP_GATE_FLAG_CONT = 1u << 1,
+};
+
+// The limits of one 2D DMA transfer of the v75 and later cores: the fields of a stride and of a row
+// size have 24 bits, and the field of the row count has 16 bits (dma-queue.h)
+#define HTP_GATE_DMA_MAX_STRIDE 0xffffffu
+#define HTP_GATE_DMA_MAX_ROWS   0xffffu
+
+// The VTCM of one thread for a block of `block` rows of `row_aligned` bytes: two halves of the first
+// input, of the second input and of the output (the DMA double buffer), one block for the result of
+// the activation, and for RMS_NORM_GATE one row for the weight.
+static inline size_t htp_gate_vtcm_per_thread(bool has_weight, size_t row_aligned, uint32_t block) {
+    return (size_t) block * row_aligned * 7 + (has_weight ? row_aligned : 0);
+}
+
+// The largest block that fits in the VTCM, to a maximum of `rows_per_thread` rows and of the row count
+// of one DMA transfer. 0 when one row does not fit. The host and the DSP use the same function.
+static inline uint32_t htp_gate_max_block(bool has_weight, size_t row_aligned, uint32_t n_threads,
+                                          size_t vtcm_size, uint32_t rows_per_thread) {
+    if (n_threads == 0 || row_aligned == 0) {
+        return 0;
+    }
+    const size_t per_thread = vtcm_size / n_threads;
+    const size_t fixed      = has_weight ? row_aligned : 0;
+    if (per_thread <= fixed) {
+        return 0;
+    }
+    size_t block = (per_thread - fixed) / (row_aligned * 7);
+    if (block > rows_per_thread) {
+        block = rows_per_thread;
+    }
+    if (block > HTP_GATE_DMA_MAX_ROWS) {
+        block = HTP_GATE_DMA_MAX_ROWS;
+    }
+    return (uint32_t) block;
+}
+
+#endif /* HTP_GATE_OPS_H */
