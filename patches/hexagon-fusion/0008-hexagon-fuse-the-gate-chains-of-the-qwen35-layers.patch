     HTP_OP_GDN_CONV_CHUNK,  // the same conv chain over a batch of tokens
     HTP_OP_FWHT,            // a MUL_MAT by the Hadamard matrix of llama.cpp (GGML_HINT_SRC0_IS_HADAMARD)
+    HTP_OP_RMS_NORM_GATE,   // RMS_NORM + MUL (weight) + SILU + MUL: the gated norm of a gated delta net output
+    HTP_OP_SIGMOID_GATE,    // (CONT) + SIGMOID + MUL: the output gate of an attention layer
 
     HTP_OP_INVALID
 };
