+// ** fused recurrent state step of a gated delta net layer at one token
+//
+// At one token, the graph of a gated delta net layer (Qwen3.5, Qwen3-Next) reads the two recurrent
+// states with GET_ROWS, updates them, and writes them back with CPY. Two chains become one op each:
+//
+//   GET_ROWS(cache_r, s_copy) -> CONCAT(., x^T) -> SSM_CONV -> SILU, and CPY(view of the CONCAT, slot of cache_r)
+//     -> HTP_OP_GDN_CONV_STEP
+//   GET_ROWS(cache_s, s_copy) -> GATED_DELTA_NET(K = 1), and CPY(state tail, slot of cache_s)
+//     -> HTP_OP_GDN_STATE_STEP
+//
+// The DSP reads the source slot index from s_copy and writes the destination slot of the CPY. When the
+// two slots are the same, the update is in place. The match needs one token, one sequence, one CPY, no
+// other reader of the replaced tensors, and no other node that touches the cache inside the chain span.
+// The state_zero SCALE of build_rs comes before the chain, thus it stays a separate op and runs first.
+
+struct ggml_hexagon_gdn_fusion {
+    std::vector<uint8_t>                skip; // graph index -> the node is replaced by a fused op
+    std::unordered_map<int, htp_opnode> at;   // graph index -> the fused op emitted at that index
+};
+
+static inline ggml_tensor * ggml_hexagon_root(ggml_tensor * t) {
+    return t->view_src ? t->view_src : t;
+}
+
+static inline bool ggml_hexagon_is_view_op(const ggml_tensor * t) {
+    return t->op == GGML_OP_VIEW || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_PERMUTE || t->op == GGML_OP_TRANSPOSE;
+}
+
+// A contiguous F32 row of n elements with unit outer dimensions
+static inline bool ggml_hexagon_is_f32_row(const ggml_tensor * t, int64_t n) {
+    return t->type == GGML_TYPE_F32 && t->ne[0] == n && t->ne[1] == 1 && t->ne[2] == 1 && t->ne[3] == 1 &&
+           t->nb[0] == sizeof(float);
+}
+
+// The "states" tensor of build_rs: an F32 table [row, n_slots] of the cache with contiguous rows
+static inline bool ggml_hexagon_is_state_table(const ggml_tensor * t, int64_t row) {
+    return t->type == GGML_TYPE_F32 && t->ne[0] == row && t->ne[1] >= 1 &&
+           t->ne[2] == 1 && t->ne[3] == 1 && t->nb[0] == sizeof(float) && t->nb[1] == (size_t) row * sizeof(float);
+}
+
+template <typename T>
+static inline bool ggml_hexagon_contains(const std::vector<T> & v, const T & x) {
+    return std::find(v.begin(), v.end(), x) != v.end();
+}
+
+// True when the node reads or writes the root tensor through any view
+static bool ggml_hexagon_node_touches(ggml_tensor * n, const ggml_tensor * root) {
+    if (ggml_hexagon_root(n) == root) {
+        return true;
+    }
+    for (int i = 0; i < GGML_MAX_SRC; i++) {
+        if (n->src[i] && ggml_hexagon_root(n->src[i]) == root) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Every node that reads an intermediate (also through a view) must be a member of the chain. A view of
+// `out` is permitted for any node when the view lies in the first `out_head_bytes` bytes of `out`.
+static bool ggml_hexagon_chain_is_private(const ggml_cgraph * gf,
+                                          const std::vector<ggml_tensor *> & intermediates,
+                                          const std::vector<ggml_tensor *> & members,
+                                          const ggml_tensor * out, size_t out_head_bytes) {
+    for (auto * t : intermediates) {
+        if (t->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return false;
+        }
+    }
+    if (out && (out->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+    for (int i = 0; i < gf->n_nodes; i++) {
+        ggml_tensor * n = gf->nodes[i];
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            ggml_tensor * src = n->src[s];
+            if (!src) {
+                continue;
+            }
+            ggml_tensor * root = ggml_hexagon_root(src);
+            if (out && root == out) {
+                if (src != out && src->view_offs + ggml_nbytes(src) <= out_head_bytes) {
+                    continue;
+                }
+                if (ggml_hexagon_contains(members, n)) {
+                    continue;
+                }
+                return false;
+            }
+            if (ggml_hexagon_contains(intermediates, root) && !ggml_hexagon_contains(members, n)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+// No node in (first, last] outside the chain touches the cache. Empty nodes do nothing and are ignored.
+static bool ggml_hexagon_chain_span_is_clean(const ggml_cgraph * gf, int first, int last, const ggml_tensor * cache,
+                                             const std::vector<ggml_tensor *> & members) {
+    for (int i = first + 1; i <= last; i++) {
+        ggml_tensor * n = gf->nodes[i];
+        if (ggml_is_empty(n) || ggml_hexagon_is_view_op(n) || ggml_hexagon_contains(members, n)) {
+            continue;
+        }
+        if (ggml_hexagon_node_touches(n, cache)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool ggml_hexagon_match_gdn_conv_chain(const ggml_hexagon_session * sess, const ggml_cgraph * gf,
+                                              const std::unordered_map<const ggml_tensor *, int> & index,
+                                              int is, ggml_hexagon_gdn_fusion & fu) {
+    ggml_tensor * S = gf->nodes[is];
+    if (S->op != GGML_OP_UNARY || ggml_get_unary_op(S) != GGML_UNARY_OP_SILU || S->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(S)) {
+        return false;
+    }
+    ggml_tensor * C = S->src[0];
+    if (!C || C->op != GGML_OP_SSM_CONV || C->type != GGML_TYPE_F32) {
+        return false;
+    }
+    ggml_tensor * CI = C->src[0];
+    ggml_tensor * W  = C->src[1];
+    if (!CI || !W || CI->op != GGML_OP_CONCAT || ggml_get_op_params_i32(CI, 0) != 0) {
+        return false;
+    }
+    if (CI->type != GGML_TYPE_F32 || !ggml_is_contiguous(CI) || CI->ne[2] != 1 || CI->ne[3] != 1) {
+        return false;
+    }
+    const int64_t d_conv = CI->ne[0];
+    const int64_t n_ch   = CI->ne[1];
+    if (d_conv < 2 || n_ch < 1) {
+        return false;
+    }
+    const int64_t row = (d_conv - 1) * n_ch;
+    if (W->type != GGML_TYPE_F32 || W->ne[0] != d_conv || W->ne[1] != n_ch || W->nb[0] != sizeof(float) ||
+        W->nb[1] != (size_t) d_conv * sizeof(float)) {
+        return false;
+    }
+    if (!ggml_hexagon_is_f32_row(C, n_ch) || !ggml_hexagon_is_f32_row(S, n_ch)) {
+        return false;
+    }
+
+    // the state read: the first CONCAT input is a reshape of GET_ROWS(states, s_copy)
+    ggml_tensor * cs = CI->src[0];
+    if (!cs || !ggml_hexagon_is_view_op(cs) || cs->view_offs != 0 || !ggml_is_contiguous(cs) ||
+        cs->ne[0] != d_conv - 1 || cs->ne[1] != n_ch || cs->ne[2] != 1 || cs->ne[3] != 1) {
+        return false;
+    }
+    ggml_tensor * R = ggml_hexagon_root(cs);
+    if (R->op != GGML_OP_GET_ROWS || !ggml_hexagon_is_f32_row(R, row)) {
+        return false;
+    }
+    ggml_tensor * states = R->src[0];
+    ggml_tensor * idx    = R->src[1];
+    if (!states || !idx || !ggml_hexagon_is_state_table(states, row) || idx->type != GGML_TYPE_I32 ||
+        ggml_nelements(idx) != 1) {
+        return false;
+    }
+    ggml_tensor * cache = ggml_hexagon_root(states);
+
+    // the new column: the second CONCAT input is the transposed projection [1, n_ch]
+    ggml_tensor * xt = CI->src[1];
+    if (!xt || xt->type != GGML_TYPE_F32 || xt->ne[0] != 1 || xt->ne[1] != n_ch || xt->ne[2] != 1 ||
+        xt->ne[3] != 1 || xt->nb[1] != sizeof(float)) {
+        return false;
+    }
+
+    // the state write: the one CPY of the last d_conv - 1 columns of the CONCAT into a slot of the cache
+    ggml_tensor * P = nullptr;
+    for (int i = 0; i < gf->n_nodes; i++) {
+        ggml_tensor * n = gf->nodes[i];
+        if (n->op != GGML_OP_CPY || !n->src[0] || !n->src[1] || ggml_hexagon_root(n->src[0]) != CI) {
+            continue;
+        }
+        if (P) {
+            return false; // more than one write-back (rollback snapshots): keep the unfused path
+        }
+        P = n;
+    }
+    if (!P || P->type != GGML_TYPE_F32) {
+        return false;
+    }
+    ggml_tensor * last = P->src[0];
+    ggml_tensor * slot = P->src[1];
+    if (last->view_offs != sizeof(float) || last->ne[0] != d_conv - 1 || last->ne[1] != n_ch ||
+        last->ne[2] != 1 || last->ne[3] != 1 || last->nb[0] != sizeof(float) || last->nb[1] != CI->nb[1]) {
+        return false;
+    }
+    if (slot == cache || ggml_hexagon_root(slot) != cache || !ggml_hexagon_is_f32_row(slot, row)) {
+        return false;
+    }
+
+    const std::vector<ggml_tensor *> intermediates = { R, CI, C };
+    const std::vector<ggml_tensor *> members       = { cs, CI, C, S, last, P };
+    if (!ggml_hexagon_chain_is_private(gf, intermediates, members, nullptr, 0)) {
+        return false;
+    }
+
+    auto ir = index.find(R);
+    auto ip = index.find(P);
+    if (ir == index.end() || ip == index.end()) {
+        return false;
+    }
+    const int emit     = std::min(is, ip->second);
+    const int last_idx = std::max(is, ip->second);
+    if (ir->second > emit || !ggml_hexagon_chain_span_is_clean(gf, ir->second, last_idx, cache, members)) {
+        return false;
+    }
+
+    htp_opnode node(HTP_OP_GDN_CONV_STEP, S);
+    node.name    = "GDN_CONV_STEP";
+    node.inputs  = { states, idx, xt, W, slot };
+    node.outputs = { S, slot };
+    node.fused   = { R, CI, C, P };
+
+    fu.at.emplace(emit, std::move(node));
+    fu.skip[ir->second] = 1;
+    for (auto * t : members) {
+        auto it = index.find(t);
+        if (it != index.end()) {
+            fu.skip[it->second] = 1;
+        }
+    }
+
+    HEX_VERBOSE("ggml-hex: %s fused GDN_CONV_STEP %s (n_ch %d d_conv %d) at node %d\n",
+                sess->name.c_str(), S->name, (int) n_ch, (int) d_conv, emit);
+    return true;
+}
+
+static bool ggml_hexagon_match_gdn_state_chain(const ggml_hexagon_session * sess, const ggml_cgraph * gf,
+                                               const std::unordered_map<const ggml_tensor *, int> & index,
+                                               int ig, ggml_hexagon_gdn_fusion & fu) {
+    ggml_tensor * G = gf->nodes[ig];
+    if (G->op != GGML_OP_GATED_DELTA_NET || G->type != GGML_TYPE_F32 || !ggml_is_contiguous(G) ||
+        ggml_get_op_params_i32(G, 0) != 1) {
+        return false;
+    }
+    ggml_tensor * q    = G->src[0];
+    ggml_tensor * k    = G->src[1];
+    ggml_tensor * v    = G->src[2];
+    ggml_tensor * g    = G->src[3];
+    ggml_tensor * beta = G->src[4];
+    ggml_tensor * st   = G->src[5];
+    if (!q || !k || !v || !g || !beta || !st) {
+        return false;
+    }
+    const int64_t S_v = v->ne[0];
+    const int64_t H   = v->ne[1];
+    if (v->ne[2] != 1 || v->ne[3] != 1 || q->ne[2] != 1 || q->ne[3] != 1 || k->ne[2] != 1 || k->ne[3] != 1) {
+        return false;
+    }
+    const int64_t D = S_v * S_v * H;
+    if (G->ne[0] != S_v * H || G->ne[1] != 1 + S_v || G->ne[2] != 1 || G->ne[3] != 1) {
+        return false;
+    }
+    const size_t head_bytes = (size_t) S_v * H * sizeof(float);
+
+    // the state read: a reshape of GET_ROWS(states, s_copy)
+    if (!ggml_hexagon_is_view_op(st) || st->view_offs != 0 || !ggml_is_contiguous(st) || ggml_nelements(st) != D) {
+        return false;
+    }
+    ggml_tensor * R = ggml_hexagon_root(st);
+    if (R->op != GGML_OP_GET_ROWS || !ggml_hexagon_is_f32_row(R, D)) {
+        return false;
+    }
+    ggml_tensor * states = R->src[0];
+    ggml_tensor * idx    = R->src[1];
+    if (!states || !idx || !ggml_hexagon_is_state_table(states, D) || idx->type != GGML_TYPE_I32 ||
+        ggml_nelements(idx) != 1) {
+        return false;
+    }
+    ggml_tensor * cache = ggml_hexagon_root(states);
+
+    // the state write: the one CPY of the state tail of the output into a slot of the cache
+    ggml_tensor * P = nullptr;
+    for (int i = 0; i < gf->n_nodes; i++) {
+        ggml_tensor * n = gf->nodes[i];
+        if (n->op != GGML_OP_CPY || !n->src[0] || !n->src[1] || ggml_hexagon_root(n->src[0]) != G) {
+            continue;
+        }
+        if (P) {
+            return false;
+        }
+        P = n;
+    }
+    if (!P || P->type != GGML_TYPE_F32) {
+        return false;
+    }
+    ggml_tensor * tail = P->src[0];
+    ggml_tensor * slot = P->src[1];
+    if (tail == G || tail->view_offs != head_bytes || !ggml_is_contiguous(tail) || ggml_nelements(tail) != D) {
+        return false;
+    }
+    if (slot == cache || ggml_hexagon_root(slot) != cache || slot->type != GGML_TYPE_F32 || slot->ne[0] != D ||
+        ggml_nelements(slot) != D || slot->nb[0] != sizeof(float)) {
+        return false;
+    }
+
+    const std::vector<ggml_tensor *> intermediates = { R };
+    const std::vector<ggml_tensor *> members       = { st, G, tail, P };
+    if (!ggml_hexagon_chain_is_private(gf, intermediates, members, G, head_bytes)) {
+        return false;
+    }
+
+    auto ir = index.find(R);
+    auto ip = index.find(P);
+    if (ir == index.end() || ip == index.end() || ir->second > ig || ip->second < ig) {
+        return false;
+    }
+    if (!ggml_hexagon_chain_span_is_clean(gf, ir->second, ip->second, cache, members)) {
+        return false;
+    }
+
+    htp_opnode node(HTP_OP_GDN_STATE_STEP, G);
+    node.name    = "GDN_STATE_STEP";
+    node.inputs  = { q, k, v, g, beta, states, idx, slot };
+    node.outputs = { G, slot };
+    node.fused   = { R, P };
+
+    fu.at.emplace(ig, std::move(node));
+    fu.skip[ir->second] = 1;
+    for (auto * t : members) {
+        auto it = index.find(t);
+        if (it != index.end()) {
+            fu.skip[it->second] = 1;
+        }
+    }
+
+    HEX_VERBOSE("ggml-hex: %s fused GDN_STATE_STEP %s (S_v %d H %d) at node %d\n",
+                sess->name.c_str(), G->name, (int) S_v, (int) H, ig);
+    return true;
+}
+
+static void ggml_hexagon_match_gdn_fusions(const ggml_hexagon_session * sess, const ggml_cgraph * gf,
+                                           ggml_hexagon_gdn_fusion & fu) {
+    std::unordered_map<const ggml_tensor *, int> index;
+    index.reserve(gf->n_nodes);
+    for (int i = 0; i < gf->n_nodes; i++) {
+        index.emplace(gf->nodes[i], i);
+    }
+    for (int i = 0; i < gf->n_nodes; i++) {
+        if (fu.skip[i]) {
+            continue;
+        }
+        const ggml_tensor * n = gf->nodes[i];
+        if (n->op == GGML_OP_UNARY) {
+            ggml_hexagon_match_gdn_conv_chain(sess, gf, index, i, fu);
+        } else if (n->op == GGML_OP_GATED_DELTA_NET) {
+            ggml_hexagon_match_gdn_state_chain(sess, gf, index, i, fu);
+        }
+    }
+}
