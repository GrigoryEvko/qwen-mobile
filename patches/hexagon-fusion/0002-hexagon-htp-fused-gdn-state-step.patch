+// GET_ROWS + CONCAT + SSM_CONV + SILU + CPY: the conv half of the recurrent state step at one token.
+// The graph is the one that llama.cpp builds for a gated delta net layer (build_conv_state). The output
+// holds the conv output and the new state, thus the CPY into the cache is part of the graph.
+struct test_gdn_conv_state_fusion : public test_case {
+    const int64_t d_conv;
+    const int64_t n_ch;
+    const int64_t n_slots;
+    const int64_t src_slot;
+    const int64_t dst_slot;
+
+    std::string vars() override {
+        return VARS_TO_STR5(d_conv, n_ch, n_slots, src_slot, dst_slot);
+    }
+
+    test_gdn_conv_state_fusion(int64_t d_conv = 4, int64_t n_ch = 96, int64_t n_slots = 1,
+            int64_t src_slot = 0, int64_t dst_slot = 0)
+        : d_conv(d_conv), n_ch(n_ch), n_slots(n_slots), src_slot(src_slot), dst_slot(dst_slot) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t row = (d_conv - 1) * n_ch;
+
+        ggml_tensor * states = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, row, n_slots);
+        ggml_tensor * s_copy = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_slots);
+        ggml_tensor * x      = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_ch, 1);
+        ggml_tensor * w      = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_conv, n_ch);
+        ggml_set_name(states, "cache_r");
+        ggml_set_name(s_copy, "s_copy");
+        ggml_set_name(x, "qkv");
+        ggml_set_name(w, "conv_w");
+
+        ggml_tensor * idx = ggml_view_1d(ctx, s_copy, 1, 0);
+        ggml_tensor * cs  = ggml_get_rows(ctx, ggml_reshape_2d(ctx, states, row, n_slots), idx);
+        cs = ggml_reshape_3d(ctx, cs, d_conv - 1, n_ch, 1);
+
+        ggml_tensor * ci = ggml_concat(ctx, cs, ggml_transpose(ctx, x), 0);
+        ggml_set_name(ci, "conv_input");
+
