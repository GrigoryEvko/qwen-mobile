diff --git a/ggml/src/ggml-hexagon/htp/gdn-conv-ops.c b/ggml/src/ggml-hexagon/htp/gdn-conv-ops.c
new file mode 100644
index 0000000..9496908
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/gdn-conv-ops.c
@@ -0,0 +1,221 @@
+// Fused conv half of the recurrent state step of a gated delta net layer at one token.
+//
+// One op replaces GET_ROWS(cache_r, s_copy), CONCAT, SSM_CONV, SILU, and the CPY of the new
+// conv state into the cache. The op reads the slot that s_copy selects, computes the
+// convolution and the SiLU, and writes the shifted conv state into the destination slot.
+//
+// Inputs:
+//   src[0] states  [row, n_slots] F32, row = (d_conv - 1) * n_ch, contiguous rows
+//   src[1] s_copy  I32 [1], the index of the source slot
+//   src[2] x       [1, n_ch] F32, the new column (nb[1] = 4)
+//   src[3] w       [d_conv, n_ch] F32, the conv weights
+//   src[4] slot    [row, 1] F32, the destination slot
+// Outputs:
+//   dst[0] y       [n_ch, 1] F32, silu(conv)
+//   dst[1] slot    the same tensor as src[4], listed for the dirty tracking of the cache
+//
+// A slot has the layout of the CONCAT input: for each channel, d_conv - 1 floats in time order.
+// The new slot of a channel holds the last d_conv - 2 old values and the new column.
+//
+// Numerics: the sum of the d_conv products is sequential in F32, in the order of the CPU
+// reference (ggml_compute_forward_ssm_conv_f32). The SiLU uses the same two HVX routines as
+// the SILU op of this backend.
+
+#include <HAP_farf.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "hvx-utils.h"
+#include "hex-fastdiv.h"
+#include "hex-common.h"
+#include "hex-profile.h"
+
+#define GGML_COMMON_DECL_C
+#include "ggml-common.h"
+#include "htp-ctx.h"
+#include "htp-tensor.h"
+#include "hvx-arith.h"
+#include "hvx-copy.h"
+#include "hvx-sigmoid.h"
+
+#ifndef MIN
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#endif
+
+struct htp_gdn_conv_context {
+    struct htp_ops_context * octx;
+    const float * src_slot;   // source slot, DDR
+    float *       dst_slot;   // destination slot, DDR
+    const float * x;          // new column, DDR
+    const float * w;          // conv weights, DDR
+    float *       y;          // output, DDR
+    uint32_t      n_ch;
+    uint32_t      d_conv;
+    uint32_t      chunk;      // channels per thread, a multiple of VLEN_FP32
+    size_t        vtcm_per_thread;
+    size_t        off_x;      // offsets of the per-thread VTCM arrays, the slot array is at 0
+    size_t        off_w;
+    size_t        off_acc;
+    size_t        off_new;
+    size_t        off_sig;
+};
+
+static void gdn_conv_step_thread(unsigned int nth, unsigned int ith, void * data) {
+    (void) nth;
+    struct htp_gdn_conv_context * cctx = (struct htp_gdn_conv_context *) data;
+    struct htp_ops_context *      octx = cctx->octx;
+
+    const uint32_t d_conv = cctx->d_conv;
+    const uint32_t n_prev = d_conv - 1;
+    const uint32_t c0     = ith * cctx->chunk;
+    if (c0 >= cctx->n_ch) {
+        return;
+    }
+    const uint32_t n = MIN(cctx->chunk, cctx->n_ch - c0);
+
+    uint8_t * base  = (uint8_t *) octx->ctx->vtcm_base + (size_t) ith * cctx->vtcm_per_thread;
+    float *   v_s   = (float *) base;
+    float *   v_x   = (float *) (base + cctx->off_x);
+    float *   v_w   = (float *) (base + cctx->off_w);
+    float *   v_acc = (float *) (base + cctx->off_acc);
+    float *   v_new = (float *) (base + cctx->off_new);
+    float *   v_sig = (float *) (base + cctx->off_sig);
+
+    dma_queue *               dma = octx->ctx->dma[ith];
+    struct htp_thread_trace * tr  = &octx->ctx->trace[ith];
+
+    const size_t s_bytes = (size_t) n * n_prev * sizeof(float);
+    const size_t x_bytes = (size_t) n * sizeof(float);
+    const size_t w_bytes = (size_t) n * d_conv * sizeof(float);
+
+    dma_queue_push(dma, dma_make_ptr(v_s, cctx->src_slot + (size_t) c0 * n_prev), s_bytes, s_bytes, s_bytes, 1);
+    dma_queue_push(dma, dma_make_ptr(v_x, cctx->x + c0), x_bytes, x_bytes, x_bytes, 1);
+    dma_queue_push(dma, dma_make_ptr(v_w, cctx->w + (size_t) c0 * d_conv), w_bytes, w_bytes, w_bytes, 1);
+    dma_queue_pop(dma);
+    dma_queue_pop(dma);
+    dma_queue_pop(dma);
+
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) c0);
+
+    for (uint32_t c = 0; c < n; c++) {
+        const float * s  = v_s + (size_t) c * n_prev;
+        const float * w  = v_w + (size_t) c * d_conv;
+        float *       ns = v_new + (size_t) c * n_prev;
+        const float   x  = v_x[c];
+
+        float sum = 0.0f;
+        for (uint32_t t = 0; t < n_prev; t++) {
+            sum += s[t] * w[t];
+        }
+        sum += x * w[n_prev];
+        v_acc[c] = sum;
+
+        for (uint32_t t = 0; t + 1 < n_prev; t++) {
+            ns[t] = s[t + 1];
+        }
+        ns[n_prev - 1] = x;
+    }
+
+    hvx_sigmoid_f32_aa((uint8_t *) v_sig, (const uint8_t *) v_acc, n);
+    hvx_mul_f32_aaa((uint8_t *) v_sig, (const uint8_t *) v_acc, (const uint8_t *) v_sig, n);
+    hvx_copy_f32_ua((uint8_t *) (cctx->y + c0), (const uint8_t *) v_sig, n);
+
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) (c0 + n));
+
+    dma_queue_push(dma, dma_make_ptr(cctx->dst_slot + (size_t) c0 * n_prev, v_new), s_bytes, s_bytes, s_bytes, 1);
+    dma_queue_flush(dma);
+}
+
+int op_gdn_conv_step(struct htp_ops_context * octx) {
+    const struct htp_tensor * states = octx->src[0];
+    const struct htp_tensor * s_copy = octx->src[1];
+    const struct htp_tensor * x      = octx->src[2];
+    const struct htp_tensor * w      = octx->src[3];
+    const struct htp_tensor * slot   = octx->src[4];
+    const struct htp_tensor * y      = octx->dst;
+
+    if (!states || !s_copy || !x || !w || !slot || !y) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (states->type != HTP_TYPE_F32 || x->type != HTP_TYPE_F32 || w->type != HTP_TYPE_F32 ||
+        slot->type != HTP_TYPE_F32 || y->type != HTP_TYPE_F32 || s_copy->type != HTP_TYPE_I32) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if (octx->ctx->mdev.count > 1) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+
+    const uint32_t d_conv = w->ne[0];
+    const uint32_t n_ch   = w->ne[1];
+    if (d_conv < 2 || n_ch == 0) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    const uint32_t row = (d_conv - 1) * n_ch;
+
+    if (states->ne[0] != row || states->nb[0] != sizeof(float) || states->nb[1] != row * sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (x->ne[0] != 1 || x->ne[1] != n_ch || x->nb[1] != sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (w->nb[0] != sizeof(float) || w->nb[1] != d_conv * sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (slot->ne[0] != row || slot->nb[0] != sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (y->ne[0] != n_ch || y->nb[0] != sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+
+    const int32_t src_idx = *(const int32_t *) (uintptr_t) s_copy->data;
+    if (src_idx < 0 || (uint32_t) src_idx >= states->ne[1]) {
+        FARF(ERROR, "gdn-conv-step: slot index %d is out of range (%u slots)\n", src_idx, states->ne[1]);
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+
+    if (octx->flags & HTP_OPFLAGS_SKIP_COMPUTE) {
+        return HTP_STATUS_OK;
+    }
+
+    const uint32_t n_threads = octx->n_threads;
+    const uint32_t chunk     = hex_round_up(fastdiv(n_ch + n_threads - 1, &octx->n_threads_div), VLEN_FP32);
+
+    struct htp_gdn_conv_context cctx;
+    memset(&cctx, 0, sizeof(cctx));
+    cctx.octx     = octx;
+    cctx.src_slot = (const float *) ((const uint8_t *) (uintptr_t) states->data + (size_t) src_idx * states->nb[1]);
+    cctx.dst_slot = (float *) (uintptr_t) slot->data;
+    cctx.x        = (const float *) (uintptr_t) x->data;
+    cctx.w        = (const float *) (uintptr_t) w->data;
+    cctx.y        = (float *) (uintptr_t) y->data;
+    cctx.n_ch     = n_ch;
+    cctx.d_conv   = d_conv;
+    cctx.chunk    = chunk;
+
+    size_t off   = hex_align_up((size_t) chunk * (d_conv - 1) * sizeof(float), 128);
+    cctx.off_x   = off;
+    off         += hex_align_up((size_t) chunk * sizeof(float), 128);
+    cctx.off_w   = off;
+    off         += hex_align_up((size_t) chunk * d_conv * sizeof(float), 128);
+    cctx.off_acc = off;
+    off         += hex_align_up((size_t) chunk * sizeof(float), 128);
+    cctx.off_new = off;
+    off         += hex_align_up((size_t) chunk * (d_conv - 1) * sizeof(float), 128);
+    cctx.off_sig = off;
+    off         += hex_align_up((size_t) chunk * sizeof(float), 128);
+    cctx.vtcm_per_thread = off;
+
+    if (cctx.vtcm_per_thread * n_threads > octx->ctx->vtcm_size) {
+        FARF(ERROR, "gdn-conv-step: VTCM reservation %zu is too small, needed %zu\n",
+             octx->ctx->vtcm_size, cctx.vtcm_per_thread * n_threads);
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+
+    FARF(HIGH, "gdn-conv-step: n_ch %u d_conv %u slot %d -> %p chunk %u vtcm %zu n_threads %u\n",
+         n_ch, d_conv, src_idx, (void *) cctx.dst_slot, chunk, cctx.vtcm_per_thread * n_threads, n_threads);
+
+    work_queue_run(octx->ctx->work_queue, gdn_conv_step_thread, &cctx, n_threads);
+
+    return HTP_STATUS_OK;
+}
