+// GET_ROWS + GATED_DELTA_NET + CPY: the delta net half of the recurrent state step at one token.
+// The graph is the one that llama.cpp builds for a gated delta net layer (build_rs, build_recurrent_attn).
+struct test_gdn_state_fusion : public test_case {
+    const int64_t head_count;
+    const int64_t head_size;
+    const int64_t n_slots;
+    const int64_t src_slot;
+    const int64_t dst_slot;
+
+    std::string vars() override {
+        return VARS_TO_STR5(head_count, head_size, n_slots, src_slot, dst_slot);
+    }
+
+    test_gdn_state_fusion(int64_t head_count = 4, int64_t head_size = 32, int64_t n_slots = 1,
+            int64_t src_slot = 0, int64_t dst_slot = 0)
+        : head_count(head_count), head_size(head_size), n_slots(n_slots), src_slot(src_slot), dst_slot(dst_slot) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t S_v = head_size;
+        const int64_t H   = head_count;
+        const int64_t D   = S_v * S_v * H;
+
+        ggml_tensor * states = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, D, n_slots);
+        ggml_tensor * s_copy = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_slots);
+        ggml_tensor * q      = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S_v, H, 1, 1);
+        ggml_tensor * k      = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S_v, H, 1, 1);
+        ggml_tensor * v      = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, S_v, H, 1, 1);
+        ggml_tensor * g      = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 1, H, 1, 1);
+        ggml_tensor * beta   = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 1, H, 1, 1);
+        ggml_set_name(states, "cache_s");
+        ggml_set_name(s_copy, "s_copy");
+        ggml_set_name(q, "q");
+        ggml_set_name(k, "k");
+        ggml_set_name(v, "v");
+        ggml_set_name(g, "g");
+        ggml_set_name(beta, "beta");
+
+        ggml_tensor * idx = ggml_view_1d(ctx, s_copy, 1, 0);
+        ggml_tensor * st  = ggml_get_rows(ctx, ggml_reshape_2d(ctx, states, D, n_slots), idx);
+        st = ggml_reshape_4d(ctx, st, S_v, S_v, H, 1);
+
+        ggml_tensor * gdn = ggml_gated_delta_net(ctx, q, k, v, g, beta, st, 1);
+        ggml_set_name(gdn, "gdn_out");
+
+        ggml_tensor * attn = ggml_view_2d(ctx, gdn, S_v * H, 1, gdn->nb[1], 0);
+        ggml_tensor * tail = ggml_view_3d(ctx, gdn, D, 1, 1,
+                ggml_row_size(gdn->type, D), ggml_row_size(gdn->type, D), ggml_row_size(gdn->type, S_v * H));
+        ggml_tensor * upd  = ggml_view_3d(ctx, states, D, 1, 1,
+                states->nb[1], (size_t) n_slots * states->nb[1], dst_slot * states->nb[1]);
+        ggml_tensor * cpy  = ggml_cpy(ctx, tail, upd);
+        ggml_set_name(cpy, "state_update");
+
+        ggml_tensor * out = ggml_concat(ctx, attn, cpy, 0);
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (ggml_is_view_op(t->op)) { continue; }
+            if (t->type == GGML_TYPE_I32) {
+                std::vector<int32_t> data(ggml_nelements(t), (int32_t) src_slot);
+                ggml_backend_tensor_set(t, data.data(), 0, data.size() * sizeof(int32_t));
+            } else if (strcmp(t->name, "g") == 0) {
+                init_tensor_uniform(t, -20.0f, -1e-4f);
+            } else if (strcmp(t->name, "beta") == 0) {
+                init_tensor_uniform(t, 0.0f, 1.0f);
+            } else if (strcmp(t->name, "v") == 0) {
+                init_tensor_uniform(t, -0.3f, 5.0f);
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "GDN_STATE_FUSION";
+    }
+
+    bool run_whole_graph() override { return true; }
+};
