@@ -1187,3 +1198,110 @@ int op_gated_delta_net(struct htp_ops_context * octx) {
 
     return HTP_STATUS_OK;
 }
+
+// Fused GET_ROWS + GATED_DELTA_NET (K = 1) + CPY of the new state into the recurrent cache, at one token.
+//
+// Inputs:
+//   src[0..4] q, k, v, g, beta, as in GATED_DELTA_NET
+//   src[5]    states [D, n_slots] F32, D = S_v * S_v * H, contiguous rows
+//   src[6]    s_copy I32 [1], the index of the source slot
+//   src[7]    slot   [D, 1] F32, the destination slot
+// Outputs:
+//   dst[0]    the GATED_DELTA_NET output [S_v * H, 1 + S_v]. The op writes only row 0, the attention output.
+//   dst[1]    slot, the same tensor as src[7], listed for the dirty tracking of the cache
+//
+// The kernel is the single-token thread of the plain op. Only the three base pointers differ. When the
+// source slot and the destination slot are the same, each head reads its state into VTCM before it
+// writes the state back, thus the update in place is safe.
+int op_gdn_state_step(struct htp_ops_context * octx) {
+    const struct htp_tensor * q      = octx->src[0];
+    const struct htp_tensor * k      = octx->src[1];
+    const struct htp_tensor * v      = octx->src[2];
+    const struct htp_tensor * g      = octx->src[3];
+    const struct htp_tensor * beta   = octx->src[4];
+    const struct htp_tensor * states = octx->src[5];
+    const struct htp_tensor * s_copy = octx->src[6];
+    const struct htp_tensor * slot   = octx->src[7];
+    const struct htp_tensor * dst    = octx->dst;
+
+    if (!q || !k || !v || !g || !beta || !states || !s_copy || !slot || !dst) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (q->type != HTP_TYPE_F32 || k->type != HTP_TYPE_F32 || v->type != HTP_TYPE_F32 ||
+        g->type != HTP_TYPE_F32 || beta->type != HTP_TYPE_F32 || states->type != HTP_TYPE_F32 ||
+        slot->type != HTP_TYPE_F32 || dst->type != HTP_TYPE_F32 || s_copy->type != HTP_TYPE_I32) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if (octx->ctx->mdev.count > 1) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+
+    const uint32_t S_v      = v->ne[0];
+    const uint32_t H        = v->ne[1];
+    const uint32_t n_tokens = v->ne[2];
+    const uint32_t n_seqs   = v->ne[3];
+    const uint32_t K        = octx->op_params[0];
+
+    if (S_v == 0 || S_v > HTP_GDN_MAX_SV || H == 0 || n_tokens != 1 || n_seqs != 1 || K != 1) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if ((g->ne[0] != 1 && g->ne[0] != S_v) || beta->ne[0] != 1) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if (q->ne[0] != S_v || k->ne[0] != S_v || q->ne[1] == 0 || k->ne[1] == 0 ||
+        q->ne[2] != 1 || k->ne[2] != 1 || q->ne[3] != 1 || k->ne[3] != 1) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+
+    const uint32_t D = S_v * S_v * H;
+    if (states->ne[0] != D || states->nb[0] != sizeof(float) || states->nb[1] != D * sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (slot->ne[0] != D || slot->nb[0] != sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (dst->ne[0] != S_v * H || dst->ne[1] != 1 + S_v) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+
+    const int32_t src_idx = *(const int32_t *) (uintptr_t) s_copy->data;
+    if (src_idx < 0 || (uint32_t) src_idx >= states->ne[1]) {
+        FARF(ERROR, "gdn-state-step: slot index %d is out of range (%u slots)\n", src_idx, states->ne[1]);
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+
+    if (octx->flags & HTP_OPFLAGS_SKIP_COMPUTE) {
+        return HTP_STATUS_OK;
+    }
+
+    const uint32_t n_threads = octx->n_threads;
+
+    size_t state_aligned = (size_t) S_v * S_v * sizeof(float);
+    state_aligned = (state_aligned + 127) & ~(size_t) 127;
+
+    if (octx->ctx->vtcm_size < 2 * state_aligned * n_threads) {
+        FARF(ERROR, "gdn-state-step: VTCM reservation %zu is too small, needed %zu\n",
+             octx->ctx->vtcm_size, 2 * state_aligned * n_threads);
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+
+    struct htp_gdn_context gctx;
+    gctx.octx             = octx;
+    gctx.row_start        = 0;
+    gctx.nrows            = H;
+    gctx.rows_per_thread  = fastdiv(H + n_threads - 1, &octx->n_threads_div);
+    gctx.state_bytes      = (size_t) S_v * S_v * sizeof(float);
+    gctx.vtcm_base        = octx->ctx->vtcm_base;
+    gctx.vtcm_per_thread  = 2 * state_aligned;
+    gctx.state_in_base    = (const float *) ((const uint8_t *) (uintptr_t) states->data + (size_t) src_idx * states->nb[1]);
+    gctx.state_out_base   = (float *) (uintptr_t) slot->data;
+    gctx.attn_base        = (float *) (uintptr_t) dst->data;
+    gctx.state_seq_stride = 0;
+
+    FARF(HIGH, "gdn-state-step: S_v %u H %u slot %d -> %p vtcm %zu n_threads %u\n",
+         S_v, H, src_idx, (void *) gctx.state_out_base, gctx.vtcm_per_thread * n_threads, n_threads);
+
+    work_queue_run(octx->ctx->work_queue, gated_delta_net_f32_tg_thread, &gctx, n_threads);
+
+    return HTP_STATUS_OK;
+}
diff --git a/ggml/src/ggml-hexagon/htp/gdn-conv-ops.c b/ggml/src/ggml-hexagon/htp/gdn-conv-ops.c
new file mode 100644
index 0000000..01b5da7
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/gdn-conv-ops.c
@@ -0,0 +1,353 @@
+// Fused conv half of the recurrent state step of a gated delta net layer at one token.
+//
+// One op replaces GET_ROWS(cache_r, s_copy), CONCAT, SSM_CONV, SILU, and the CPY of the new
+// conv state into the cache. The op reads the slot that s_copy selects, computes the
+// convolution and the SiLU, and writes the shifted conv state into the destination slot.
+//
+// Inputs:
+//   src[0] states  [row, n_slots] F32, row = 3 * n_ch, contiguous rows
+//   src[1] s_copy  I32 [1], the index of the source slot
+//   src[2] x       [1, n_ch] F32, the new column (nb[1] = 4)
+//   src[3] w       [4, n_ch] F32, the conv weights
+//   src[4] slot    [row, 1] F32, the destination slot
+// Outputs:
+//   dst[0] y       [n_ch, 1] F32, silu(conv)
+//   dst[1] slot    the same tensor as src[4], listed for the dirty tracking of the cache
+//
+// A slot has the layout of the CONCAT input without the new column: for each channel, 3 floats in
+// time order (s0, s1, s2). The new slot of a channel holds (s1, s2, x).
+//
+// The kernel is HVX only. It reads DDR with unaligned vector loads, keeps everything in registers,
+// and writes DDR with unaligned vector stores. Scalar code never touches the data: scalar access to
+// VTCM is slow, and the layout change from 3 lanes per channel to 4 lanes per channel is done with
+// rotates and masks. For a block of 32 channels:
+//   1. The 96 slot lanes and the 32 column lanes become 4 vectors c[g] with lane 4k + t = tap t of
+//      channel 8g + k (t = 3 is the new column).
+//   2. Four vdeal ops split c[0..3] into the tap planes t0..t3 (lane = channel). The weights get
+//      the same split.
+//   3. acc = t0 * w0, acc += t1 * w1, acc += t2 * w2, acc += t3 * w3: the sum of the CPU reference
+//      (ggml_compute_forward_ssm_conv_f32) in the same order.
+//   4. y = acc * sigmoid(acc) with the two routines of the SILU op of this backend.
+//   5. The new slot lanes (s1, s2, x) of each channel come from c[g] with rotates and masks.
+
+#include <HAP_farf.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "hvx-utils.h"
+#include "hex-fastdiv.h"
+#include "hex-common.h"
+#include "hex-profile.h"
+
+#define GGML_COMMON_DECL_C
+#include "ggml-common.h"
+#include "htp-ctx.h"
+#include "htp-tensor.h"
+
+#ifndef MIN
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#endif
+
+#define GDN_CONV_D_CONV 4
+
+struct htp_gdn_conv_context {
+    struct htp_ops_context * octx;
+    const float * src_slot;   // source slot, DDR
+    float *       dst_slot;   // destination slot, DDR
+    const float * x;          // new column, DDR
+    const float * w;          // conv weights, DDR
+    float *       y;          // output, DDR
+    uint32_t      n_ch;
+    uint32_t      chunk;      // channels per thread, a multiple of VLEN_FP32
+};
+
+// Lane masks: a lane is 32 bits, a mask lane is all ones or all zeros
+struct gdn_conv_masks {
+    HVX_Vector ms[8];   // lanes [4k, 4k + 3): the three slot taps of channel k in the 4-lane layout
+    HVX_Vector mn[8];   // lanes [3k, 3k + 3): the three taps of channel k in the 3-lane layout
+    HVX_Vector mx;      // lanes 4k + 3: the new column in the 4-lane layout
+    HVX_Vector lt8;     // lanes < 8
+    HVX_Vector lt16;    // lanes < 16
+    HVX_Vector lt24;    // lanes < 24
+};
+
+static void gdn_conv_masks_init(struct gdn_conv_masks * mk) {
+    int32_t buf[VLEN_FP32] __attribute__((aligned(VLEN)));
+
+    for (uint32_t k = 0; k < 8; k++) {
+        for (uint32_t j = 0; j < VLEN_FP32; j++) {
+            buf[j] = (j >= 4 * k && j < 4 * k + 3) ? -1 : 0;
+        }
+        mk->ms[k] = hvx_vmem(buf);
+    }
+    for (uint32_t k = 0; k < 8; k++) {
+        for (uint32_t j = 0; j < VLEN_FP32; j++) {
+            buf[j] = (j >= 3 * k && j < 3 * k + 3) ? -1 : 0;
+        }
+        mk->mn[k] = hvx_vmem(buf);
+    }
+    for (uint32_t j = 0; j < VLEN_FP32; j++) {
+        buf[j] = (j % 4 == 3) ? -1 : 0;
+    }
+    mk->mx = hvx_vmem(buf);
+    for (uint32_t j = 0; j < VLEN_FP32; j++) {
+        buf[j] = (j < 8) ? -1 : 0;
+    }
+    mk->lt8 = hvx_vmem(buf);
+    for (uint32_t j = 0; j < VLEN_FP32; j++) {
+        buf[j] = (j < 16) ? -1 : 0;
+    }
+    mk->lt16 = hvx_vmem(buf);
+    for (uint32_t j = 0; j < VLEN_FP32; j++) {
+        buf[j] = (j < 24) ? -1 : 0;
+    }
+    mk->lt24 = hvx_vmem(buf);
+}
+
+// Lane i moves to lane i + n (wraps)
+static inline HVX_Vector gdn_lane_rot_up(HVX_Vector v, uint32_t n) {
+    return Q6_V_vlalign_VVR(v, v, 4 * n);
+}
+
+// Lane i moves to lane i - n (wraps)
+static inline HVX_Vector gdn_lane_rot_down(HVX_Vector v, uint32_t n) {
+    return Q6_V_vror_VR(v, 4 * n);
+}
+
+// Selects the lanes of a where the mask is set, and the lanes of b elsewhere
+static inline HVX_Vector gdn_lane_select(HVX_Vector mask, HVX_Vector a, HVX_Vector b) {
+    return Q6_V_vor_VV(Q6_V_vand_VV(a, mask), Q6_V_vand_VV(b, Q6_V_vnot_V(mask)));
+}
+
+// One block of 32 channels: s0, s1, s2 hold the 96 slot lanes, x the 32 column lanes, w0..w3 the 128
+// weight lanes. The block gives the 32 outputs and the 96 new slot lanes.
+static inline void gdn_conv_block(const struct gdn_conv_masks * mk,
+                                  HVX_Vector s0, HVX_Vector s1, HVX_Vector s2, HVX_Vector x,
+                                  HVX_Vector w0, HVX_Vector w1, HVX_Vector w2, HVX_Vector w3,
+                                  HVX_Vector * y, HVX_Vector * n0, HVX_Vector * n1, HVX_Vector * n2) {
+    // windows of 8 channels: lanes 0..23 hold the 3 taps of the 8 channels, 3 lanes per channel
+    HVX_Vector sw[4];
+    sw[0] = s0;
+    sw[1] = gdn_lane_select(mk->lt8,  gdn_lane_rot_down(s0, 24), gdn_lane_rot_down(s1, 24));
+    sw[2] = gdn_lane_select(mk->lt16, gdn_lane_rot_down(s1, 16), gdn_lane_rot_down(s2, 16));
+    sw[3] = gdn_lane_rot_down(s2, 8);
+
+    // the new column in the 4-lane layout: xs[g] lane 4k + 3 = x[8g + k]
+    HVX_VectorPair p  = Q6_W_vshuff_VVR(Q6_V_vzero(), x, -4);
+    HVX_VectorPair q0 = Q6_W_vshuff_VVR(Q6_V_vzero(), Q6_V_lo_W(p), -4);
+    HVX_VectorPair q1 = Q6_W_vshuff_VVR(Q6_V_vzero(), Q6_V_hi_W(p), -4);
+    HVX_Vector xs[4];
+    xs[0] = gdn_lane_rot_up(Q6_V_lo_W(q0), 3);
+    xs[1] = gdn_lane_rot_up(Q6_V_hi_W(q0), 3);
+    xs[2] = gdn_lane_rot_up(Q6_V_lo_W(q1), 3);
+    xs[3] = gdn_lane_rot_up(Q6_V_hi_W(q1), 3);
+
+    // the 4-lane layout: c[g] lane 4k + t = tap t of channel 8g + k
+    HVX_Vector c[4];
+    for (uint32_t g = 0; g < 4; g++) {
+        HVX_Vector v = Q6_V_vand_VV(sw[g], mk->ms[0]);
+        for (uint32_t k = 1; k < 8; k++) {
+            v = Q6_V_vor_VV(v, Q6_V_vand_VV(gdn_lane_rot_up(sw[g], k), mk->ms[k]));
+        }
+        c[g] = Q6_V_vor_VV(v, Q6_V_vand_VV(xs[g], mk->mx));
+    }
+
+    // the tap planes: lane = channel
+    HVX_VectorPair d01 = Q6_W_vdeal_VVR(c[1], c[0], -4);
+    HVX_VectorPair d23 = Q6_W_vdeal_VVR(c[3], c[2], -4);
+    HVX_VectorPair e02 = Q6_W_vdeal_VVR(Q6_V_lo_W(d23), Q6_V_lo_W(d01), -4);
+    HVX_VectorPair e13 = Q6_W_vdeal_VVR(Q6_V_hi_W(d23), Q6_V_hi_W(d01), -4);
+    HVX_Vector t0 = Q6_V_lo_W(e02);
+    HVX_Vector t1 = Q6_V_lo_W(e13);
+    HVX_Vector t2 = Q6_V_hi_W(e02);
+    HVX_Vector t3 = Q6_V_hi_W(e13);
+
+    HVX_VectorPair f01 = Q6_W_vdeal_VVR(w1, w0, -4);
+    HVX_VectorPair f23 = Q6_W_vdeal_VVR(w3, w2, -4);
+    HVX_VectorPair g02 = Q6_W_vdeal_VVR(Q6_V_lo_W(f23), Q6_V_lo_W(f01), -4);
+    HVX_VectorPair g13 = Q6_W_vdeal_VVR(Q6_V_hi_W(f23), Q6_V_hi_W(f01), -4);
+    HVX_Vector wt0 = Q6_V_lo_W(g02);
+    HVX_Vector wt1 = Q6_V_lo_W(g13);
+    HVX_Vector wt2 = Q6_V_hi_W(g02);
+    HVX_Vector wt3 = Q6_V_hi_W(g13);
+
+    // the convolution, in the order of the CPU reference. The two functions are the arithmetic of
+    // the ADD and MUL ops of this backend (hvx-base.h, per architecture).
+    HVX_Vector acc = hvx_vec_mul_f32_f32(t0, wt0);
+    acc = hvx_vec_add_f32_f32(acc, hvx_vec_mul_f32_f32(t1, wt1));
+    acc = hvx_vec_add_f32_f32(acc, hvx_vec_mul_f32_f32(t2, wt2));
+    acc = hvx_vec_add_f32_f32(acc, hvx_vec_mul_f32_f32(t3, wt3));
+
+    // the SiLU of the SILU op: x * sigmoid(x)
+    const HVX_Vector one     = hvx_vec_splat_f32(1.f);
+    const HVX_Vector max_exp = hvx_vec_splat_f32(87.f);
+    const HVX_Vector min_exp = hvx_vec_splat_f32(-87.f);
+    HVX_Vector sig = hvx_vec_fast_sigmoid_f32_guard(acc, one, max_exp, min_exp);
+    *y = hvx_vec_mul_f32_f32(acc, sig);
+
+    // the new slot windows: nw[g] lane 3k + t = c[g] lane 4k + 1 + t
+    HVX_Vector nw[4];
+    for (uint32_t g = 0; g < 4; g++) {
+        HVX_Vector v = Q6_V_vand_VV(gdn_lane_rot_down(c[g], 1), mk->mn[0]);
+        for (uint32_t k = 1; k < 8; k++) {
+            v = Q6_V_vor_VV(v, Q6_V_vand_VV(gdn_lane_rot_down(c[g], k + 1), mk->mn[k]));
+        }
+        nw[g] = v;
+    }
+
+    // the 96 new slot lanes: window g goes to lanes 24g .. 24g + 23
+    HVX_Vector r1 = gdn_lane_rot_up(nw[1], 24);
+    HVX_Vector r2 = gdn_lane_rot_up(nw[2], 16);
+    HVX_Vector r3 = gdn_lane_rot_up(nw[3], 8);
+    *n0 = gdn_lane_select(mk->lt24, nw[0], r1);
+    *n1 = gdn_lane_select(mk->lt16, r1, r2);
+    *n2 = gdn_lane_select(mk->lt8,  r2, r3);
+}
+
+static void gdn_conv_step_thread(unsigned int nth, unsigned int ith, void * data) {
+    (void) nth;
+    struct htp_gdn_conv_context * cctx = (struct htp_gdn_conv_context *) data;
+    struct htp_ops_context *      octx = cctx->octx;
+
+    const uint32_t c0 = ith * cctx->chunk;
+    if (c0 >= cctx->n_ch) {
+        return;
+    }
+    const uint32_t n = MIN(cctx->chunk, cctx->n_ch - c0);
+
+    struct gdn_conv_masks mk __attribute__((aligned(VLEN)));
+    gdn_conv_masks_init(&mk);
+
+    const float * s_ptr = cctx->src_slot + (size_t) c0 * 3;
+    const float * x_ptr = cctx->x + c0;
+    const float * w_ptr = cctx->w + (size_t) c0 * GDN_CONV_D_CONV;
+    float *       n_ptr = cctx->dst_slot + (size_t) c0 * 3;
+    float *       y_ptr = cctx->y + c0;
+
+    struct htp_thread_trace * tr = &octx->ctx->trace[ith];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) c0);
+
+    uint32_t m = 0;
+    for (; m + VLEN_FP32 <= n; m += VLEN_FP32) {
+        HVX_Vector y, n0, n1, n2;
+        gdn_conv_block(&mk,
+                       hvx_vmemu(s_ptr + 3 * m), hvx_vmemu(s_ptr + 3 * m + 32), hvx_vmemu(s_ptr + 3 * m + 64),
+                       hvx_vmemu(x_ptr + m),
+                       hvx_vmemu(w_ptr + 4 * m), hvx_vmemu(w_ptr + 4 * m + 32), hvx_vmemu(w_ptr + 4 * m + 64), hvx_vmemu(w_ptr + 4 * m + 96),
+                       &y, &n0, &n1, &n2);
+        hvx_vmemu(y_ptr + m)          = y;
+        hvx_vmemu(n_ptr + 3 * m)      = n0;
+        hvx_vmemu(n_ptr + 3 * m + 32) = n1;
+        hvx_vmemu(n_ptr + 3 * m + 64) = n2;
+    }
+
+    // the last block of a chunk that is not a multiple of 32 channels goes through local buffers
+    const uint32_t rem = n - m;
+    if (rem > 0) {
+        float sb[3 * VLEN_FP32] __attribute__((aligned(VLEN)));
+        float xb[VLEN_FP32]     __attribute__((aligned(VLEN)));
+        float wb[4 * VLEN_FP32] __attribute__((aligned(VLEN)));
+        float nb[3 * VLEN_FP32] __attribute__((aligned(VLEN)));
+        float yb[VLEN_FP32]     __attribute__((aligned(VLEN)));
+
+        memset(sb, 0, sizeof(sb));
+        memset(xb, 0, sizeof(xb));
+        memset(wb, 0, sizeof(wb));
+        memcpy(sb, s_ptr + 3 * m, (size_t) rem * 3 * sizeof(float));
+        memcpy(xb, x_ptr + m,     (size_t) rem * sizeof(float));
+        memcpy(wb, w_ptr + 4 * m, (size_t) rem * 4 * sizeof(float));
+
+        HVX_Vector y, n0, n1, n2;
+        gdn_conv_block(&mk,
+                       hvx_vmem(sb), hvx_vmem(sb + 32), hvx_vmem(sb + 64),
+                       hvx_vmem(xb),
+                       hvx_vmem(wb), hvx_vmem(wb + 32), hvx_vmem(wb + 64), hvx_vmem(wb + 96),
+                       &y, &n0, &n1, &n2);
+        hvx_vmem(yb)      = y;
+        hvx_vmem(nb)      = n0;
+        hvx_vmem(nb + 32) = n1;
+        hvx_vmem(nb + 64) = n2;
+
+        memcpy(y_ptr + m,     yb, (size_t) rem * sizeof(float));
+        memcpy(n_ptr + 3 * m, nb, (size_t) rem * 3 * sizeof(float));
+    }
+
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) (c0 + n));
+}
+
+int op_gdn_conv_step(struct htp_ops_context * octx) {
+    const struct htp_tensor * states = octx->src[0];
+    const struct htp_tensor * s_copy = octx->src[1];
+    const struct htp_tensor * x      = octx->src[2];
+    const struct htp_tensor * w      = octx->src[3];
+    const struct htp_tensor * slot   = octx->src[4];
+    const struct htp_tensor * y      = octx->dst;
+
+    if (!states || !s_copy || !x || !w || !slot || !y) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (states->type != HTP_TYPE_F32 || x->type != HTP_TYPE_F32 || w->type != HTP_TYPE_F32 ||
+        slot->type != HTP_TYPE_F32 || y->type != HTP_TYPE_F32 || s_copy->type != HTP_TYPE_I32) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if (octx->ctx->mdev.count > 1) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+
+    const uint32_t d_conv = w->ne[0];
+    const uint32_t n_ch   = w->ne[1];
+    if (d_conv != GDN_CONV_D_CONV) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if (n_ch == 0) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    const uint32_t row = (d_conv - 1) * n_ch;
+
+    if (states->ne[0] != row || states->nb[0] != sizeof(float) || states->nb[1] != row * sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (x->ne[0] != 1 || x->ne[1] != n_ch || x->nb[1] != sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (w->nb[0] != sizeof(float) || w->nb[1] != d_conv * sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (slot->ne[0] != row || slot->nb[0] != sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (y->ne[0] != n_ch || y->nb[0] != sizeof(float)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+
+    const int32_t src_idx = *(const int32_t *) (uintptr_t) s_copy->data;
+    if (src_idx < 0 || (uint32_t) src_idx >= states->ne[1]) {
+        FARF(ERROR, "gdn-conv-step: slot index %d is out of range (%u slots)\n", src_idx, states->ne[1]);
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+
+    if (octx->flags & HTP_OPFLAGS_SKIP_COMPUTE) {
+        return HTP_STATUS_OK;
+    }
+
+    const uint32_t n_threads = octx->n_threads;
+    const uint32_t chunk     = hex_round_up(fastdiv(n_ch + n_threads - 1, &octx->n_threads_div), VLEN_FP32);
+
+    struct htp_gdn_conv_context cctx;
+    memset(&cctx, 0, sizeof(cctx));
+    cctx.octx     = octx;
+    cctx.src_slot = (const float *) ((const uint8_t *) (uintptr_t) states->data + (size_t) src_idx * states->nb[1]);
+    cctx.dst_slot = (float *) (uintptr_t) slot->data;
+    cctx.x        = (const float *) (uintptr_t) x->data;
+    cctx.w        = (const float *) (uintptr_t) w->data;
+    cctx.y        = (float *) (uintptr_t) y->data;
+    cctx.n_ch     = n_ch;
+    cctx.chunk    = chunk;
+
+    FARF(HIGH, "gdn-conv-step: n_ch %u slot %d -> %p chunk %u n_threads %u\n",
+         n_ch, src_idx, (void *) cctx.dst_slot, chunk, n_threads);
+
+    work_queue_run(octx->ctx->work_queue, gdn_conv_step_thread, &cctx, n_threads);
+
+    return HTP_STATUS_OK;
+}
