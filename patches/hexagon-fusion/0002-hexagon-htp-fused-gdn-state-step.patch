+// ** fused recurrent state step of a gated delta net layer at one token
+//
+// The checks are in htp-gdn-match.h (ggml only, thus a host program can run them on a graph). This part
+// builds the fused ops and logs the first failed condition of each candidate chain.
+
+struct ggml_hexagon_gdn_fusion {
+    std::vector<uint8_t>                skip; // graph index -> the node is replaced by a fused op
+    std::unordered_map<int, htp_opnode> at;   // graph index -> the fused op emitted at that index
+};
+
+static void ggml_hexagon_match_gdn_fusions(const ggml_hexagon_session * sess, const ggml_cgraph * gf,
+                                           ggml_hexagon_gdn_fusion & fu) {
+    const auto index = ggml_hexagon_gdn_index(gf);
+
+    auto skip_members = [&](const std::vector<ggml_tensor *> & members) {
+        for (auto * t : members) {
+            auto it = index.find(t);
+            if (it != index.end()) {
+                fu.skip[it->second] = 1;
+            }
+        }
+    };
+
+    for (int i = 0; i < gf->n_nodes; i++) {
+        if (fu.skip[i]) {
+            continue;
+        }
+        ggml_tensor * n = gf->nodes[i];
+
+        if (ggml_hexagon_gdn_is_conv_candidate(n)) {
+            ggml_hexagon_gdn_conv_match m;
+            const char * reason = ggml_hexagon_gdn_conv_chain_check(gf, index, i, m);
+            if (reason) {
+                HEX_VERBOSE("ggml-hex: %s GDN_CONV_STEP candidate %s (node %d): %s\n", sess->name.c_str(), n->name, i, reason);
+                continue;
+            }
+
+            htp_opnode node(HTP_OP_GDN_CONV_STEP, m.S);
+            node.name    = "GDN_CONV_STEP";
+            node.inputs  = { m.states, m.idx, m.xt, m.W, m.slot };
+            node.outputs = { m.S, m.slot };
+            node.fused   = { m.R, m.CI, m.C, m.P };
+
+            fu.at.emplace(m.emit, std::move(node));
+            skip_members(m.members);
+
+            HEX_VERBOSE("ggml-hex: %s fused GDN_CONV_STEP %s (n_ch %d d_conv %d) at node %d\n",
+                        sess->name.c_str(), m.S->name, (int) m.n_ch, (int) m.d_conv, m.emit);
+        } else if (n->op == GGML_OP_GATED_DELTA_NET) {
+            ggml_hexagon_gdn_state_match m;
+            const char * reason = ggml_hexagon_gdn_state_chain_check(gf, index, i, m);
+            if (reason) {
+                HEX_VERBOSE("ggml-hex: %s GDN_STATE_STEP candidate %s (node %d): %s\n", sess->name.c_str(), n->name, i, reason);
+                continue;
+            }
+
+            htp_opnode node(HTP_OP_GDN_STATE_STEP, m.G);
+            node.name    = "GDN_STATE_STEP";
+            node.inputs  = { m.q, m.k, m.v, m.g, m.beta, m.states, m.idx, m.slot };
+            node.outputs = { m.G, m.slot };
+            node.fused   = { m.R, m.P };
+
+            fu.at.emplace(m.emit, std::move(node));
+            skip_members(m.members);
+
+            HEX_VERBOSE("ggml-hex: %s fused GDN_STATE_STEP %s (S_v %d H %d) at node %d\n",
+                        sess->name.c_str(), m.G->name, (int) m.S_v, (int) m.H, m.emit);
+        }
+    }
+}
