index be1dca2..eeca0c8 100644
--- a/ggml/src/ggml-hexagon/htp-gdn-match.h
+++ b/ggml/src/ggml-hexagon/htp-gdn-match.h
@@ -181,6 +181,23 @@ static inline ggml_tensor * ggml_hexagon_gdn_find_cpy(const ggml_cgraph * gf, co
     return n_found == 1 ? P : nullptr;
 }
 
+// The slot index of the state read: the one value of the s_copy input. The host reads it at enqueue
+// time, once per token, and gives it to the DSP in the kernel params. When the value is not a valid
+// row of the state table, the fused op must not run, and the unfused chain runs in its place.
+static inline const char * ggml_hexagon_gdn_slot_index_check(const ggml_tensor * idx, const ggml_tensor * states,
+                                                             int32_t * slot) {
+    *slot = -1;
+    if (!idx->data) {
+        return "s_copy has no data at enqueue time";
+    }
+    const int32_t v = *(const int32_t *) idx->data;
+    *slot = v;
+    if (v < 0 || v >= states->ne[1]) {
+        return "the s_copy index is not a row of the state table";
+    }
+    return nullptr;
+}
