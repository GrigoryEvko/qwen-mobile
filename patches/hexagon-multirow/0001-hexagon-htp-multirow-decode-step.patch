+// The compact multi-row dots of Q4_0 and Q8_0. One weight stream serves 1 to 4 activation rows:
+// the kernel prepares the weights of a k-tile once, and each row keeps its own accumulator. The
+// scale arithmetic of a row is the one of the 32x1 dot, thus a row gives the result of a 32x1 call.
+//
+// ya[r] is the compact activation of row r as 32-bit words, yb[r] the sum of each of its k-tiles,
+// and vy[r] its tiled row, from which the kernel reads the scale of each 128-block only.
+//
+// The decode step of speculative decoding uses these dots. Without them the operator calls the
+// 32x2 dot per row pair and the 32x1 dot for the last row, thus 3 and 4 rows read and prepare
+// every weight tile twice.
+#define HTP_MM_HAVE_MULTIROW 1
+
+// The body of a compact dot. TILE is the stride of a weight tile, SHIFT the log2 of the offset of
+// the weight format, and PREP the block that gives the weight vectors of one k-tile.
+#define TILED_VEC_DOT_COMPACT_BODY(NR, TILE, SHIFT, PREP_BLOCK)                                    \
+    const uint8_t * restrict tile_ptr = vx;                                                        \
+    const HVX_Vector mask_h4  = Q6_Vb_vsplat_R(0x0F);                                              \
+    const HVX_Vector v_bias_b = Q6_Vb_vsplat_R(0x80);                                              \
+    HVX_Vector v_sum_float[NR];                                                                    \
+    _Pragma("unroll")                                                                              \
+    for (int r = 0; r < NR; r++) {                                                                 \
+        v_sum_float[r] = Q6_V_vzero();                                                             \
+    }                                                                                              \
+    (void) mask_h4;                                                                                \
+    (void) v_bias_b;                                                                               \
+    const uint32_t n_k_tiles = n / 32;                                                             \
+    for (uint32_t kt = 0; kt < n_k_tiles; kt++) {                                                  \
+        const HVX_Vector * restrict vptr = (const HVX_Vector *) (tile_ptr + kt * (TILE));          \
+        HVX_Vector acc[NR];                                                                        \
+        _Pragma("unroll")                                                                          \
+        for (int r = 0; r < NR; r++) {                                                             \
+            acc[r] = Q6_V_vzero();                                                                 \
+        }                                                                                          \
+        PREP_BLOCK                                                                                 \
+        _Pragma("unroll")                                                                          \
+        for (int r = 0; r < NR; r++) {                                                             \
+            HVX_Vector v_sum = Q6_Vw_vsub_VwVw(acc[r], Q6_V_vsplat_R(yb[r][kt] << (SHIFT)));       \
+            HVX_Vector v_act_scale = ((const HVX_Vector *) ((const uint8_t *) vy[r] + kt * 1152))[8]; \
+            HVX_Vector v_scale_comb = hvx_vec_mul_f16_f16_to_f32_lower32(v_scale_w, v_act_scale);  \
+            HVX_Vector v_sum_scaled = hvx_vec_mul_f32_f32(Q6_Vsf_equals_Vw(v_sum), v_scale_comb);  \
+            v_sum_float[r] = hvx_vec_add_f32_f32(v_sum_float[r], v_sum_scaled);                    \
+        }                                                                                          \
+    }                                                                                              \
+    _Pragma("unroll")                                                                              \
+    for (int r = 0; r < NR; r++) {                                                                 \
+        if (sz[r]) {                                                                               \
+            hvx_vec_store_u(s[r], valid_rows * sizeof(float), hvx_vec_add_f32_f32(v_sum_float[r], hvx_vmemu(sz[r]))); \
+        } else {                                                                                   \
+            hvx_vec_store_u(s[r], valid_rows * sizeof(float), v_sum_float[r]);                     \
+        }                                                                                          \
+    }
+
+// The four nibble pairs of a Q4_0 k-tile, and the scales of the tile at vector 4
+#define MULTIROW_Q4_0_TILE(NR)                                                                     \
+    _Pragma("unroll")                                                                              \
+    for (int i = 0; i < 4; i++) {                                                                  \
+        HVX_VectorPair v_W_pair = unpack_and_interleave_4bit_x2(vptr[i], mask_h4);                 \
+        HVX_Vector v_W0 = Q6_V_lo_W(v_W_pair);                                                     \
+        HVX_Vector v_W1 = Q6_V_hi_W(v_W_pair);                                                     \
+        _Pragma("unroll")                                                                          \
+        for (int r = 0; r < NR; r++) {                                                             \
+            acc[r] = Q6_Vw_vrmpyacc_VwVubRb(acc[r], v_W0, (int32_t) ya[r][kt * 8 + 2 * i + 0]);    \
+            acc[r] = Q6_Vw_vrmpyacc_VwVubRb(acc[r], v_W1, (int32_t) ya[r][kt * 8 + 2 * i + 1]);    \
+        }                                                                                          \
+    }                                                                                              \
+    const HVX_Vector v_scale_w = vptr[4];
+
+// The eight byte groups of a Q8_0 k-tile, and the scales of the tile at vector 8
+#define MULTIROW_Q8_0_TILE(NR)                                                                     \
+    _Pragma("unroll")                                                                              \
+    for (int g = 0; g < 8; g++) {                                                                  \
+        HVX_Vector v_rot = Q6_V_vror_VR(vptr[g], 64);                                              \
+        HVX_Vector v_W   = Q6_V_vxor_VV(Q6_V_lo_W(Q6_W_vshuff_VVR(v_rot, vptr[g], -2)), v_bias_b); \
+        _Pragma("unroll")                                                                          \
+        for (int r = 0; r < NR; r++) {                                                             \
+            acc[r] = Q6_Vw_vrmpyacc_VwVubRb(acc[r], v_W, (int32_t) ya[r][kt * 8 + g]);             \
+        }                                                                                          \
+    }                                                                                              \
+    const HVX_Vector v_scale_w = vptr[8];
