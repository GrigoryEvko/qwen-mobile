     const HVX_Vector zero  = Q6_V_vzero();
-    const HVX_Vector one   = hvx_vec_splat_f16(1.0f);
     // h arrives as an integer of the scale 2^16. The f16 of that integer minus 16 exponent steps
     // is h itself, and the unsigned saturating subtract gives 0 for the values that underflow.
     const HVX_Vector e16   = Q6_Vh_vsplat_R(0x4000);
@@ -640,12 +639,13 @@ static inline __attribute__((always_inline)) void gdn_conv_band_packed(const flo
 
         hvx_silu_h_i16(a, h16, G);
 
-        // y = relu(x) - h(|x|), in f16, then one widening multiply by 1.0 gives the two f32 halves
+        // y = relu(x) - h(|x|), in f16, then the widen to f32 gives the two halves. The helper is the
+        // IEEE widening multiply on v79 and the qf pair before it, thus the file builds for v73 and v75.
         for (int r = 0; r < G; r++) {
             const HVX_Vector rel = Q6_Vhf_vmax_VhfVhf(a[r], zero);
             const HVX_Vector hf  = Q6_Vuh_vsub_VuhVuh_sat(Q6_Vhf_equals_Vh(h16[r]), e16);
             const HVX_Vector yh  = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vsub_VhfVhf(rel, hf));
-            const HVX_VectorPair y32 = Q6_Wsf_vmpy_VhfVhf(yh, one);
+            const HVX_VectorPair y32 = hvx_vec_f16_to_f32_shuff(yh);
             hvx_vmemu(yp[r])             = Q6_V_lo_W(y32);
             hvx_vmemu(yp[r] + VLEN_FP32) = Q6_V_hi_W(y32);
         }
