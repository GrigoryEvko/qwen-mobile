diff --git a/ggml/src/ggml-hexagon/htp/matmul-ops.h b/ggml/src/ggml-hexagon/htp/matmul-ops.h
index 56b1de3..06e653c 100644
--- a/ggml/src/ggml-hexagon/htp/matmul-ops.h
+++ b/ggml/src/ggml-hexagon/htp/matmul-ops.h
@@ -49,6 +49,21 @@ extern "C" {
 #define HTP_MM_HMX_COST_W_DEQUANT 3 // cost penalty for quantized weight loading/dequantization
 #define HTP_MM_HMX_COST_A_CONVERT 2 // cost penalty for activation loading/conversion
 
+// --- The cost model of the chunks of the HMX 2D kernel (htp_mm_hmx_solve_2d_cost) ---
+// The rate of the weight DMA of the HMX 2D kernel, in bytes for each us. The DMA reads the tiles of a chunk
+// as one continuous range and writes them to the pitch aligned_tile_size in the VTCM. At 5 to 32 tokens the
+// DMA sets the time of the kernel, and the phone stage sweep measured 59 to 62 GB/s there.
+#define HTP_MM_HMX_DMA_BYTES_PER_US      61000
+// The weights that one HVX thread dequantizes to f16 tiles in one us. The phase trace of the phone stage
+// sweep gives 18900 at k 2560 and 28000 at k 9216 for Q8_0 weights.
+#define HTP_MM_HMX_DEQUANT_PER_THREAD_US 23000
+// The fixed time of one chunk in ns: two dispatches of the HVX threads, one DMA descriptor and one HMX job.
+// The phase trace of the phone stage sweep gives less than 0.2 us for each chunk outside the phases of thread
+// 0. A job for an HMX thread that waits on an empty queue also waits for a futex wake (HMX_QUEUE_POLL_COUNT is
+// 1 on v79). The selections of the 4B shapes at 5 to 1024 tokens are the same for each value from 0 to 5 us
+// (tools/stages/mmsolve/plan.cpp sensitivity).
+#define HTP_MM_HMX_CHUNK_NS              2000
+
 // --- DMA Activation Transfer Configuration ---
 #define HTP_MM_DMA_ACT_ROWS_PER_STEP 2
 #define HTP_MM_DMA_ACT_MULTIPLIER    (2 * HTP_MM_DMA_ACT_ROWS_PER_STEP)
@@ -820,6 +835,253 @@ static inline bool htp_mm_hmx_solve_2d_params(
     return false;
 }
 
+// --- The chunks of the HMX 2D kernel from the cost of the kernel ---
+//
+// hmx_mm_2d_f32 and hmx_mm_nx_2d_f32 (matmul-ops.c) have two loops. The outer loop gets m_chunk token rows
+// and converts their activation rows to f16 tiles one time. The inner loop gets each chunk of n_chunk weight
+// rows: the DMA moves it to the VTCM, the HVX threads dequantize it, the HMX multiplies it with the tiles of
+// the token rows, and the HVX threads store the output. Thus, for m token rows and n weight rows:
+//   - The weights go through the DMA and the dequantization one time for each token chunk. These are the
+//     passes, ceil(m / m_chunk).
+//   - Each activation row is converted one time, for each selection of the chunks.
+//   - Each pair of a token chunk and a weight chunk (a chunk) has a fixed time: two dispatches of the HVX
+//     threads, one DMA descriptor and one HMX job.
+// Each output tile is one accumulator chain over all of k for each selection of the chunks. Thus the chunks
+// do not change the output.
+//
+// htp_mm_hmx_solve_2d_params adds the cost of the activation conversion for each weight chunk, but the
+// kernel converts the activation one time for each token chunk. Thus that model selects small token chunks
+// and many passes: at 1024 tokens, k 9216 n 2560 gets m_chunk 128 and 8 passes.
+//
+// The cost of the kernel, in ns:
+//   passes x n x (the DMA time + the dequantization time of one weight row)
+//   + passes x ceil(n / n_chunk) x HTP_MM_HMX_CHUNK_NS
+// The activation conversion is the same for each selection, thus it is not a term.
+//
+// The host calls these functions. The sizes are in 64 bits there.
+
+static inline uint64_t htp_mm_mul_sat64(uint64_t a, uint64_t b) {
+    return (b != 0 && a > UINT64_MAX / b) ? UINT64_MAX : a * b;
+}
+
+static inline uint64_t htp_mm_add_sat64(uint64_t a, uint64_t b) {
+    return a > UINT64_MAX - b ? UINT64_MAX : a + b;
+}
+
+// The DMA time and the dequantization time of one weight row of the HMX 2D kernel, in ns. For a quantized
+// weight, the DMA moves k / 32 tiles of tile_size bytes for each 32 weight rows. For an F16 or F32 weight, it
+// moves the row.
+static inline uint64_t htp_mm_hmx_row_ns(int wtype, uint32_t k, int n_threads) {
+    const bool     is_quant = (wtype != HTP_TYPE_F16 && wtype != HTP_TYPE_F32);
+    const uint64_t bytes    = is_quant ? (uint64_t) (k / HTP_MM_HMX_TILE_N_COLS) * htp_mm_get_weight_tile_size(wtype) /
+                                             HTP_MM_HMX_TILE_N_ROWS
+                                       : (uint64_t) htp_mm_get_tiled_row_stride(wtype, k);
+    const uint64_t deq_rate = (uint64_t) HTP_MM_HMX_DEQUANT_PER_THREAD_US * (uint64_t) (n_threads > 0 ? n_threads : 1);
+    return (bytes * 1000 + HTP_MM_HMX_DMA_BYTES_PER_US - 1) / HTP_MM_HMX_DMA_BYTES_PER_US +
+           ((uint64_t) k * 1000 + deq_rate - 1) / deq_rate;
+}
+
+// The largest m chunk (a multiple of 32, at most m_pad) with an HMX 2D layout that is not larger than the
+// budget, for the n chunk nc. 0 when no m chunk gives such a layout. The bytes of the layout increase with the m
+// chunk, thus a binary search finds it in O(log(m_pad / 32)) layout builds.
+static inline size_t htp_mm_hmx_max_m_chunk(int wtype, uint32_t k, size_t nc, size_t m_pad, bool pipeline,
+                                            uint32_t act_threads, uint32_t aligned_tile_size, size_t budget) {
+    size_t lo = 0;
+    size_t hi = m_pad / HTP_MM_HMX_TILE_N_ROWS;
+    while (lo < hi) {
+        const size_t mid = lo + (hi - lo + 1) / 2;
+        const size_t mc  = mid * HTP_MM_HMX_TILE_N_ROWS;
+        if (htp_mm_hmx_get_2d_vtcm_size(wtype, k, mc, nc, pipeline, act_threads, aligned_tile_size) <= budget) {
+            lo = mid;
+        } else {
+            hi = mid - 1;
+        }
+    }
+    return lo * HTP_MM_HMX_TILE_N_ROWS;
+}
+
+// The largest n chunk (a multiple of 32, at most n_pad) for the m chunk mc, as htp_mm_hmx_max_m_chunk gives
+// the m chunk. O(log(n_pad / 32)) layout builds.
+static inline size_t htp_mm_hmx_max_n_chunk(int wtype, uint32_t k, size_t mc, size_t n_pad, bool pipeline,
+                                            uint32_t act_threads, uint32_t aligned_tile_size, size_t budget) {
+    size_t lo = 0;
+    size_t hi = n_pad / HTP_MM_HMX_TILE_N_COLS;
+    while (lo < hi) {
+        const size_t mid = lo + (hi - lo + 1) / 2;
+        const size_t nc  = mid * HTP_MM_HMX_TILE_N_COLS;
+        if (htp_mm_hmx_get_2d_vtcm_size(wtype, k, mc, nc, pipeline, act_threads, aligned_tile_size) <= budget) {
+            lo = mid;
+        } else {
+            hi = mid - 1;
+        }
+    }
+    return lo * HTP_MM_HMX_TILE_N_COLS;
+}
+
+// The chunks of the HMX 2D kernel of MUL_MAT, MUL_MAT_ADD and MUL_MAT_NX with the cost of the kernel (refer
+// to the comment before htp_mm_mul_sat64). MUL_MAT_ID and the batched F16 kernel have different loops, thus
+// they keep htp_mm_hmx_solve_2d_params.
+//
+// The function first gets the selection of htp_mm_hmx_solve_2d_params. When that selection moves the weights
+// through the DMA one time, the function returns it: no selection has less passes, and that selection has the
+// widest n chunk, thus the smallest number of chunks. If not, the function examines each n chunk (a multiple
+// of 32) with the largest m chunk of an accurate layout, for each count of activation threads of the old
+// solver. It keeps the smallest cost, then the larger area mc x nc, then the larger count of threads. It does
+// not give more passes than the old selection.
+//
+// ne11_padded is the token count m aligned up to 32. chunk_ns is the fixed time of one chunk
+// (HTP_MM_HMX_CHUNK_NS in htp_mm_hmx_solve_2d_cost, other values in a measurement of the model). Time:
+// O(threads x n_pad / 32 x log(m_pad / 32)) layout builds when the old selection has more than one pass. An n
+// chunk with one pass stops the loop over the n chunks, because a narrower n chunk only adds chunks.
+static inline bool htp_mm_hmx_solve_2d_cost_ns(int      wtype,
+                                               uint32_t k,
+                                               uint32_t ne01_padded,
+                                               uint32_t ne11_padded,
+                                               uint32_t m,
+                                               int      n_threads,
+                                               bool     pipeline,
+                                               uint32_t aligned_tile_size,
+                                               size_t   vtcm_budget,
+                                               uint64_t chunk_ns,
+                                               size_t * m_chunk_out,
+                                               size_t * n_chunk_out,
+                                               int *    act_threads_out,
+                                               size_t * vtcm_size_out) {
+    size_t old_mc = 0, old_nc = 0, old_vtcm = 0;
+    int    old_threads = 0;
+    if (!htp_mm_hmx_solve_2d_params(wtype, k, 0, ne01_padded, ne11_padded, m, n_threads, pipeline, false,
+                                    aligned_tile_size, vtcm_budget, &old_mc, &old_nc, &old_threads, &old_vtcm)) {
+        return false;
+    }
+    *m_chunk_out     = old_mc;
+    *n_chunk_out     = old_nc;
+    *act_threads_out = old_threads;
+    *vtcm_size_out   = old_vtcm;
+
+    const uint64_t old_passes = ((uint64_t) m + old_mc - 1) / old_mc;
+    if (old_passes <= 1) {
+        return true;
+    }
+
+    size_t per_n = 0, per_m = 0, per_mn = 0;
+    htp_mm_hmx_get_2d_chunk_costs(wtype, k, pipeline, aligned_tile_size, &per_n, &per_m, &per_mn);
+    if (per_n == 0) {
+        return true;
+    }
+    const size_t   nc_max = hex_align_down(hex_smin((size_t) ne01_padded, vtcm_budget / per_n), HTP_MM_HMX_TILE_N_COLS);
+    const uint64_t row_ns = htp_mm_hmx_row_ns(wtype, k, n_threads);
+
+    uint64_t best_cost = UINT64_MAX;
+    uint64_t best_area = 0;
+    size_t   best_mc = 0, best_nc = 0;
+    int      best_threads = 0;
+
+    for (int act_threads = n_threads; act_threads >= 1; act_threads = (act_threads == 1) ? 0 : act_threads / 2) {
+        for (size_t nc = nc_max; nc >= HTP_MM_HMX_TILE_N_COLS; nc -= HTP_MM_HMX_TILE_N_COLS) {
+            const size_t mc = htp_mm_hmx_max_m_chunk(wtype, k, nc, ne11_padded, pipeline, (uint32_t) act_threads,
+                                                     aligned_tile_size, vtcm_budget);
+            if (mc == 0) {
+                continue;
+            }
+            const uint64_t passes = ((uint64_t) m + mc - 1) / mc;
+            const uint64_t chunks = htp_mm_mul_sat64(passes, ((uint64_t) ne01_padded + nc - 1) / nc);
+            const uint64_t cost   = htp_mm_add_sat64(htp_mm_mul_sat64(htp_mm_mul_sat64(passes, ne01_padded), row_ns),
+                                                     htp_mm_mul_sat64(chunks, chunk_ns));
+            const uint64_t area   = (uint64_t) mc * nc;
+            if (cost < best_cost || (cost == best_cost && area > best_area)) {
+                best_cost    = cost;
+                best_area    = area;
+                best_mc      = mc;
+                best_nc      = nc;
+                best_threads = act_threads;
+            }
+            if (passes == 1) {
+                break;
+            }
+        }
+    }
+
+    if (best_mc == 0 || ((uint64_t) m + best_mc - 1) / best_mc > old_passes) {
+        return true;
+    }
+    *m_chunk_out     = best_mc;
+    *n_chunk_out     = best_nc;
+    *act_threads_out = best_threads;
+    *vtcm_size_out   = htp_mm_hmx_get_2d_vtcm_size(wtype, k, best_mc, best_nc, pipeline, (uint32_t) best_threads,
+                                                   aligned_tile_size);
+    return true;
+}
+
+// htp_mm_hmx_solve_2d_cost_ns with the chunk time HTP_MM_HMX_CHUNK_NS
+static inline bool htp_mm_hmx_solve_2d_cost(int      wtype,
+                                            uint32_t k,
+                                            uint32_t ne01_padded,
+                                            uint32_t ne11_padded,
+                                            uint32_t m,
+                                            int      n_threads,
+                                            bool     pipeline,
+                                            uint32_t aligned_tile_size,
+                                            size_t   vtcm_budget,
+                                            size_t * m_chunk_out,
+                                            size_t * n_chunk_out,
+                                            int *    act_threads_out,
+                                            size_t * vtcm_size_out) {
+    return htp_mm_hmx_solve_2d_cost_ns(wtype, k, ne01_padded, ne11_padded, m, n_threads, pipeline, aligned_tile_size,
+                                       vtcm_budget, HTP_MM_HMX_CHUNK_NS, m_chunk_out, n_chunk_out, act_threads_out,
+                                       vtcm_size_out);
+}
+
+// The chunks of a request (GGML_HEXAGON_MM_CHUNKS of the host) for the HMX 2D kernel. The function aligns each
+// value down to a multiple of 32 and limits it to ne11_padded or ne01_padded. A value of 0 gets the largest
+// value with a layout in the budget for the other value. For each count of activation threads of the old
+// solver, the function examines the layout of the request. It returns false when no such layout is in the
+// budget, and the caller then keeps the chunks of the solver.
+static inline bool htp_mm_hmx_fit_2d_chunks(int      wtype,
+                                            uint32_t k,
+                                            uint32_t ne01_padded,
+                                            uint32_t ne11_padded,
+                                            int      n_threads,
+                                            bool     pipeline,
+                                            uint32_t aligned_tile_size,
+                                            size_t   vtcm_budget,
+                                            size_t   mc_request,
+                                            size_t   nc_request,
+                                            size_t * m_chunk_out,
+                                            size_t * n_chunk_out,
+                                            int *    act_threads_out,
+                                            size_t * vtcm_size_out) {
+    const size_t mc_req = hex_smin(hex_align_down(mc_request, HTP_MM_HMX_TILE_N_ROWS), (size_t) ne11_padded);
+    const size_t nc_req = hex_smin(hex_align_down(nc_request, HTP_MM_HMX_TILE_N_COLS), (size_t) ne01_padded);
+    if (mc_req == 0 && nc_req == 0) {
+        return false;
+    }
+    for (int act_threads = n_threads; act_threads >= 1; act_threads = (act_threads == 1) ? 0 : act_threads / 2) {
+        size_t mc = mc_req;
+        size_t nc = nc_req;
+        if (nc == 0) {
+            nc = htp_mm_hmx_max_n_chunk(wtype, k, mc, ne01_padded, pipeline, (uint32_t) act_threads, aligned_tile_size,
+                                        vtcm_budget);
+        }
+        if (mc == 0 && nc != 0) {
+            mc = htp_mm_hmx_max_m_chunk(wtype, k, nc, ne11_padded, pipeline, (uint32_t) act_threads, aligned_tile_size,
+                                        vtcm_budget);
+        }
+        if (mc == 0 || nc == 0) {
+            continue;
+        }
+        const size_t size = htp_mm_hmx_get_2d_vtcm_size(wtype, k, mc, nc, pipeline, (uint32_t) act_threads,
+                                                        aligned_tile_size);
+        if (size <= vtcm_budget) {
+            *m_chunk_out     = mc;
+            *n_chunk_out     = nc;
+            *act_threads_out = act_threads;
+            *vtcm_size_out   = size;
+            return true;
+        }
+    }
+    return false;
+}
