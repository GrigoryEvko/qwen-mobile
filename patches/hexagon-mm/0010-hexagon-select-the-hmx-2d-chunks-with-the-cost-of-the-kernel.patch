    pp1024 d0       842.0    875.7    +1.3 %      +1.3 %, +4.0 %, +1.3 %
    pp512 d3072     741.4    769.3    +3.8 %      +1.6 %, +3.8 %, +4.5 %
    pp1024 d3072    740.0    765.3    +2.4 %      +1.1 %, +3.4 %, +2.4 %
    tg32 d0         10.38    10.43    +0.1 %

