+// The packed layout of the Q8_0 weight tiles in VTCM. The operator moves the n_k weight tiles of
+// one column tile (32 weight rows) with one DMA descriptor row, thus the tiles lie back to back at
+// a pitch of 1088 bytes, the tile size. 1088 bytes are 8.5 vectors, thus tile kt starts on a
+// vector edge when kt is even, and 64 bytes after a vector edge when kt is odd. The dots load only
+// full vectors from vector edges: for tile kt they read from the edge kt * 1088 - odd * 64, where
+// odd = kt % 2.
+//
+// Why one row for each column tile: the DMA engine divides a row of 1088 bytes into five bus
+// requests, the last one of 64 bytes. On HTP0 v79 with 6 threads, rows of 1088 bytes read at
+// 54 GB/s, and one row of the same 87040 bytes reads at 62 GB/s, the DDR ceiling.
+#define HTP_MM_HAVE_PACKED_Q8_0 1
+
+// The vector edge at or before the start of tile kt of a packed column tile of tiles of pitch
+// bytes, with pitch equal to 64 plus a multiple of 128. odd must be kt % 2.
+static inline const HVX_Vector * packed_tile_edge(const uint8_t * restrict col, uint32_t kt, uint32_t pitch, const int odd) {
+    return (const HVX_Vector *) (col + kt * pitch - (odd ? 64 : 0));
+}
+
+// The weights of the groups g and g + 1 (g even, group g holds k = 4g thru 4g+3) of a Q8_0 tile,
+// with the four values of row r in the bytes 4r thru 4r+3. The lower vector of the pair is group g,
+// the upper vector group g + 1. Group g has 128 bytes: k 4g and 4g+1 of row r in the bytes 2r and
+// 2r+1 (the lower half), and k 4g+2 and 4g+3 in the bytes 64+2r and 65+2r (the upper half).
+//
+// The shuffle of 64-byte elements puts the lower halves of the two groups into one vector and their
+// upper halves into a second vector. The shuffle of 2-byte elements of these two vectors then gives
+// the two groups. Thus two groups cost two permutes (a rotation and a shuffle for each group cost
+// four).
+//   odd = 0: vp is the start of the tile, thus vector g of vp is group g.
+//   odd = 1: vp is 64 bytes before the start of the tile. Vector g of vp holds the upper half of
+//            group g - 1 and the lower half of group g, thus the halves come from two 64-byte
+//            shuffles: three permutes for two groups.
+static inline HVX_VectorPair q8_0_group_pair(const HVX_Vector * restrict vp, int g, const int odd) {
+    HVX_Vector lower;  // the lower half of group g, then the lower half of group g + 1
+    HVX_Vector upper;  // the upper half of group g, then the upper half of group g + 1
+    if (odd) {
+        lower = Q6_V_hi_W(Q6_W_vshuff_VVR(vp[g + 1], vp[g], -64));
+        upper = Q6_V_lo_W(Q6_W_vshuff_VVR(vp[g + 2], vp[g + 1], -64));
+    } else {
+        const HVX_VectorPair halves = Q6_W_vshuff_VVR(vp[g + 1], vp[g], -64);
+        lower = Q6_V_lo_W(halves);
+        upper = Q6_V_hi_W(halves);
+    }
+    return Q6_W_vshuff_VVR(upper, lower, -2);
+}
+
+// The 32 f16 row scales of a Q8_0 tile in the lower 64 bytes of a vector. vp and odd are those of
+// q8_0_group_pair. The upper 64 bytes hold other bytes of the column tile: the scale product reads
+// only the lower 64 bytes.
+static inline HVX_Vector q8_0_scales(const HVX_Vector * restrict vp, const int odd) {
+    return odd ? Q6_V_vror_VR(vp[8], 64) : vp[8];
+}
+
+// The weights of the groups g and g + 1 of a Q8_0 tile of either parity, as q8_0_group_pair gives
+// them. u is the vector edge at or before the start of the tile, and shift is the distance from u
+// to the start: 0 or 64. A valign by the shift gives the 128 bytes of each group, then the two
+// shuffles of q8_0_group_pair: four permutes for two groups, and no branch on the parity.
+static inline HVX_VectorPair q8_0_group_pair_at(const HVX_Vector * restrict u, int g, uint32_t shift) {
+    const HVX_Vector g0 = Q6_V_valign_VVR(u[g + 1], u[g], shift);
+    const HVX_Vector g1 = Q6_V_valign_VVR(u[g + 2], u[g + 1], shift);
+    const HVX_VectorPair halves = Q6_W_vshuff_VVR(g1, g0, -64);
+    return Q6_W_vshuff_VVR(Q6_V_hi_W(halves), Q6_V_lo_W(halves), -2);
+}
+
+// The step from the vector edge of tile kt to the vector edge of tile kt + 1 of a packed column
+// tile, and the shift of tile kt + 1. An even tile starts on its edge, and the next tile starts
+// 64 bytes after the edge 1024 bytes later. An odd tile starts 64 bytes after its edge, and the
+// next tile starts on the edge 1152 bytes later.
+#define Q8_0_PACKED_NEXT_TILE(edge, shift)                                                         \
+    do {                                                                                           \
+        (edge) += (shift) ? HTP_MM_WEIGHT_TILE_SIZE_Q8_0 + 64 : HTP_MM_WEIGHT_TILE_SIZE_Q8_0 - 64; \
+        (shift) ^= 64;                                                                             \
+    } while (0)
