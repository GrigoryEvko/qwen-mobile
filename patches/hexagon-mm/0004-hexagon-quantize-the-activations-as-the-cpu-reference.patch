@@ -0,0 +1,246 @@
+// The Q8_0 activation quantizer of the CPU reference, bit for bit.
+//
+// quantize_row_q8_0_ref (ggml-quants.c) computes for each block of 32 values:
+//   amax = max |x|,  d = amax / 127,  id = d ? 1 / d : 0,  q = roundf(x * id),  y.d = fp16(d)
+// The division and the product are IEEE f32 with round to nearest even, roundf rounds a tie away
+// from zero, and the f16 conversion rounds to nearest even. These routines compute the same bits
+// with integer instructions only, thus each Hexagon version gives the reference result. The lab
+// verifies them (tools/htp-lab: target q8oracle, exact/check_q8.py) on v73, v75, v79 and v81.
+//
+// Limits, which apply only to a block with amax below 2^-117:
+//   - A block with amax < 127 * 2^-126 gives d = 0 and q = 0. The reference keeps a subnormal d.
+//   - A subnormal x gives q = 0. The reference gives 0 too, unless amax is below 2^-117.
+// An Inf or NaN input gives an undefined result.
+//
+// Cost: about 30 integer operations for each vector of 32 values, and less than 7 for the scales
+// of each block. On v79 a row of 2560 values takes 9.1k cycles against 6.5k for the f16 quantizer
+// that this one replaces, which shared one scale over 128 values.
+
+#ifndef HVX_Q8_REF_H
+#define HVX_Q8_REF_H
+
+#include <stdint.h>
+
+#include "hvx-exact.h"
+#include "hvx-repl.h"
+
+#define Q8R_SPLAT(x) Q6_V_vsplat_R((int32_t) (x))
+
+// The inverse of 127 modulo 2^32: 127 * 0xefdfbf7f = 1 (mod 2^32).
+#define Q8R_INV127 0xefdfbf7fu
+
+// The low 32 bits of a * b in each lane. vmpyieo adds (a.h[0] * b.h[1]) << 16 and vmpyie adds
+// a * b.uh[0]. The term a.h[1] * b.h[1] << 32 and the sign errors of the halfwords are multiples
+// of 2^32, thus the sum is exact modulo 2^32.
+static inline HVX_Vector q8r_mul_lo(HVX_Vector a, HVX_Vector b) {
+    return Q6_Vw_vmpyieacc_VwVwVuh(Q6_Vw_vmpyieo_VhVh(a, b), a, b);
+}
+
+// The pairwise maximum of adjacent lanes. Lanes 0..15 hold the pairs of a, and lanes 16..31 the
+// pairs of b. Five levels of this step over 32 vectors give one vector with the maximum of vector
+// j in lane j. The inputs are the bits of |x|, which have the order of the values.
+static inline HVX_Vector q8r_max_pair(HVX_Vector a, HVX_Vector b) {
+    const HVX_VectorPair p = Q6_W_vdeal_VVR(b, a, -4);
+    return Q6_Vw_vmax_VwVw(Q6_V_lo_W(p), Q6_V_hi_W(p));
+}
+
+// The bits of amax for each of n_blk blocks of 32 values (n_blk <= 32), in lanes 0..n_blk-1. The
+// other lanes are zero. x must be 128-byte aligned. O(32) vector operations.
+static inline HVX_Vector q8r_amax32(const float * restrict x, uint32_t n_blk) {
+    const HVX_Vector k_abs = Q8R_SPLAT(0x7fffffff);
+    HVX_Vector       l[16];
+
+    for (uint32_t i = 0; i < 16; i++) {
+        const HVX_Vector a = (2 * i < n_blk) ? Q6_V_vand_VV(hvx_vmem(x + 64 * i), k_abs) : Q6_V_vzero();
+        const HVX_Vector b = (2 * i + 1 < n_blk) ? Q6_V_vand_VV(hvx_vmem(x + 64 * i + 32), k_abs) : Q6_V_vzero();
+        l[i] = q8r_max_pair(a, b);
+    }
+    for (uint32_t w = 8; w >= 1; w /= 2) {
+        for (uint32_t i = 0; i < w; i++) {
+            l[i] = q8r_max_pair(l[2 * i], l[2 * i + 1]);
+        }
+    }
+    return l[0];
+}
+
+// d = amax / 127 and id = 1 / d for 32 blocks, as the bits of IEEE f32 values.
+//
+// d: the significand M of amax times 2^s, with s = 6 or 7, lies in [2^23 * 127, 2^24 * 127), thus
+// N / 127 has 24 bits. N mod 127 is the sum of the base-128 digits of N modulo 127, because
+// 128 = 1 (mod 127), and (N - r) / 127 is exact with the inverse of 127. The remainder decides the
+// rounding: r >= 64 rounds up, and 127 is odd, thus no tie occurs. A carry to 2^24 cannot occur.
+//
+// id: the long division of 2^47 by the significand m of d gives 25 quotient bits and the
+// remainder. The quotient is 2^24 only for m = 2^23. The rounding goes up when twice the
+// remainder is more than m, and 2^48 has no odd divisor, thus no tie occurs.
+static inline void q8r_scales(HVX_Vector am, HVX_Vector * restrict vd, HVX_Vector * restrict vid) {
+    const HVX_Vector zero = Q6_V_vzero();
+    const HVX_Vector one  = Q8R_SPLAT(1);
+    const HVX_Vector k7f  = Q8R_SPLAT(127);
+
+    const HVX_Vector     E    = Q6_Vuw_vlsr_VuwR(am, 23);
+    const HVX_Vector     M    = Q6_V_vor_VV(Q6_V_vand_VV(am, Q8R_SPLAT(0x007fffff)), Q8R_SPLAT(0x00800000));
+    const HVX_VectorPred q_s6 = Q6_Q_vcmp_gt_VwVw(M, Q8R_SPLAT(127 * (1 << 17) - 1));
+    const HVX_Vector     s    = Q6_V_vmux_QVV(q_s6, Q8R_SPLAT(6), Q8R_SPLAT(7));
+    const HVX_Vector     N    = Q6_Vw_vasl_VwVw(M, s);
+
+    HVX_Vector r = Q6_Vw_vadd_VwVw(Q6_V_vand_VV(N, k7f), Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(N, 7), k7f));
+    r = Q6_Vw_vadd_VwVw(r, Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(N, 14), k7f));
+    r = Q6_Vw_vadd_VwVw(r, Q6_V_vand_VV(Q6_Vuw_vlsr_VuwR(N, 21), k7f));
+    r = Q6_Vw_vadd_VwVw(r, Q6_Vuw_vlsr_VuwR(N, 28));
+    r = Q6_Vw_vadd_VwVw(Q6_V_vand_VV(r, k7f), Q6_Vuw_vlsr_VuwR(r, 7));
+    r = Q6_Vw_condnac_QVwVw(Q6_Q_vcmp_gt_VwVw(r, Q8R_SPLAT(126)), r, k7f);
+
+    HVX_Vector m = q8r_mul_lo(Q6_Vw_vsub_VwVw(N, r), Q8R_SPLAT(Q8R_INV127));
+    m = Q6_Vw_condacc_QVwVw(Q6_Q_vcmp_gt_VwVw(r, Q8R_SPLAT(63)), m, one);
+
+    // The biased exponent of d is E - s. Zero or less is a block below the limit.
+    const HVX_Vector     ed   = Q6_Vw_vsub_VwVw(E, s);
+    const HVX_VectorPred q_nz = Q6_Q_vcmp_gt_VwVw(ed, zero);
+    *vd = Q6_V_vmux_QVV(q_nz, Q6_Vw_vadd_VwVw(Q6_Vw_vasl_VwR(Q6_Vw_vsub_VwVw(ed, one), 23), m), zero);
+
+    // The partial remainder starts at 2^47 >> 24 and doubles after each step, thus at the end it
+    // holds twice the remainder.
+    HVX_Vector rem = Q8R_SPLAT(1 << 23);
+    HVX_Vector q   = zero;
+    for (int i = 0; i < 25; i++) {
+        const HVX_VectorPred q_lt = Q6_Q_vcmp_gt_VuwVuw(m, rem);
+        rem = Q6_Vw_condnac_QnVwVw(q_lt, rem, m);
+        q   = Q6_Vw_condacc_QnVwVw(q_lt, Q6_Vw_vasl_VwR(q, 1), one);
+        rem = Q6_Vw_vasl_VwR(rem, 1);
+    }
+    q = Q6_Vw_condacc_QVwVw(Q6_Q_vcmp_gt_VuwVuw(rem, m), q, one);
+
+    // 1 / d = (2^47 / m) * 2^(103 - ed), thus the biased exponent of id is 253 - ed. A quotient of
+    // 2^24 adds one to the exponent through the addition.
+    *vid = Q6_V_vmux_QVV(q_nz, Q6_Vw_vadd_VwVw(Q6_Vw_vasl_VwR(Q6_Vw_vsub_VwVw(Q8R_SPLAT(252), ed), 23), q), zero);
+}
+
+// q = roundf(x * id) for 32 values of one block, as int32 lanes.
+//
+// mid is the significand of id with the hidden one, and e277 is 277 minus the biased exponent of
+// id. The product of the significands is exact in 48 bits. It rounds to 24 bits (round to nearest
+// even, the f32 product), and then the magnitude rounds to an integer with a tie up, which is
+// roundf. x * id is at most 127.0001, thus the shift sh is at least 17. A zero or subnormal x
+// gives 0.
+static inline HVX_Vector q8r_quant(HVX_Vector x, HVX_Vector mid, HVX_Vector e277) {
+    const HVX_Vector zero = Q6_V_vzero();
+    const HVX_Vector one  = Q8R_SPLAT(1);
+
+    const HVX_Vector ax = Q6_V_vand_VV(x, Q8R_SPLAT(0x7fffffff));
+    const HVX_Vector ex = Q6_Vuw_vlsr_VuwR(ax, 23);
+    const HVX_Vector mx = Q6_V_vor_VV(Q6_V_vand_VV(ax, Q8R_SPLAT(0x007fffff)), Q8R_SPLAT(0x00800000));
+
+    HVX_VectorPair   p  = Q6_W_vmpye_VwVuh(mx, mid);
+    p                   = Q6_W_vmpyoacc_WVwVh(p, mx, mid);
+    const HVX_Vector hi = Q6_V_hi_W(p);
+    const HVX_Vector lo = Q6_V_lo_W(p);
+
+    // t is 1 when the product is in [2^47, 2^48): the 24 bits are then bits 47..24, else 46..23.
+    const HVX_Vector     t    = Q6_Vuw_vlsr_VuwR(hi, 15);
+    const HVX_Vector     s9   = Q6_Vw_vsub_VwVw(Q8R_SPLAT(9), t);
+    HVX_Vector           m    = Q6_V_vor_VV(Q6_Vw_vasl_VwVw(hi, s9), Q6_Vw_vlsr_VwVw(lo, Q6_Vw_vadd_VwVw(t, Q8R_SPLAT(23))));
+    const HVX_Vector     rest = Q6_Vw_vasl_VwVw(lo, s9);
+    const HVX_VectorPred q_up = Q6_Q_vcmp_gt_VuwVuw(Q6_V_vor_VV(rest, Q6_V_vand_VV(m, one)), Q8R_SPLAT(0x80000000));
+    m = Q6_Vw_condacc_QVwVw(q_up, m, one);
+
+    // x * id = m * 2^(ex + eid - 277 + t). A shift of 31 leaves zero, because m + 2^30 < 2^31.
+    HVX_Vector sh = Q6_Vw_vsub_VwVw(Q6_Vw_vsub_VwVw(e277, ex), t);
+    sh = Q6_Vw_vmin_VwVw(sh, Q8R_SPLAT(31));
+    const HVX_Vector half = Q6_Vw_vasl_VwVw(one, Q6_Vw_vsub_VwVw(sh, one));
+    HVX_Vector       qm   = Q6_Vw_vlsr_VwVw(Q6_Vw_vadd_VwVw(m, half), sh);
+    qm = Q6_V_vmux_QVV(Q6_Q_vcmp_eq_VwVw(ex, zero), zero, qm);
+
+    const HVX_Vector sg = Q6_Vw_vasr_VwR(x, 31);
+    return Q6_Vw_vsub_VwVw(Q6_V_vxor_VV(qm, sg), sg);
+}
+
+// Quantize n_groups groups of 128 values as quantize_row_q8_0_ref does, into the layouts that are
+// not NULL. Group g gives:
+//   y_tiles   4 tiles of 1152 bytes at g * 4608, one for each block of 32. Vectors 0..7 of a tile
+//             hold 4 quants each, repeated over the vector, and vector 8 holds the f16 scale of
+//             the block, repeated. The tiled dots read the scale of each tile from vector 8.
+//   y_quants  the 128 quants at g * 128, in the order of the input (compact and flat layouts)
+//   y_sum     the sum of the 32 quants of each block at 4 * g (the compact dots)
+//   y_scales  the 4 f16 scales of the blocks at 4 * g (the flat layout)
+// x must be 128-byte aligned. y_tiles and y_quants must be 128-byte aligned. O(n_groups * 128).
+static inline void quantize_groups_f32_q8_0_ref(const float * restrict x,
+                                                uint8_t * restrict y_tiles,
+                                                uint8_t * restrict y_quants,
+                                                int32_t * restrict y_sum,
+                                                __fp16 * restrict y_scales,
+                                                uint32_t n_groups) {
+    static const uint8_t __attribute__((aligned(128))) repl[128] = {
+        0x00, 0x00, 0x00, 0x00, 0x04, 0x04, 0x04, 0x04, 0x08, 0x08, 0x08, 0x08, 0x04, 0x04, 0x04, 0x04,
+        0x10, 0x10, 0x10, 0x10, 0x04, 0x04, 0x04, 0x04, 0x08, 0x08, 0x08, 0x08, 0x04, 0x04, 0x04, 0x04,
+        0x20, 0x20, 0x20, 0x20, 0x04, 0x04, 0x04, 0x04, 0x08, 0x08, 0x08, 0x08, 0x04, 0x04, 0x04, 0x04,
+        0x10, 0x10, 0x10, 0x10, 0x04, 0x04, 0x04, 0x04, 0x08, 0x08, 0x08, 0x08, 0x04, 0x04, 0x04, 0x04,
+        0x40, 0x40, 0x40, 0x40, 0x04, 0x04, 0x04, 0x04, 0x08, 0x08, 0x08, 0x08, 0x04, 0x04, 0x04, 0x04,
+        0x10, 0x10, 0x10, 0x10, 0x04, 0x04, 0x04, 0x04, 0x08, 0x08, 0x08, 0x08, 0x04, 0x04, 0x04, 0x04,
+        0x20, 0x20, 0x20, 0x20, 0x04, 0x04, 0x04, 0x04, 0x08, 0x08, 0x08, 0x08, 0x04, 0x04, 0x04, 0x04,
+        0x10, 0x10, 0x10, 0x10, 0x04, 0x04, 0x04, 0x04, 0x08, 0x08, 0x08, 0x08, 0x04, 0x04, 0x04, 0x04,
+    };
+    const HVX_Vector v_repl = hvx_vmem(repl);
+
+    for (uint32_t g0 = 0; g0 < n_groups; g0 += 8) {
+        const uint32_t      ng = (n_groups - g0 < 8) ? n_groups - g0 : 8;
+        const float * const xg = x + (size_t) g0 * 128;
+
+        HVX_Vector vd, vid;
+        q8r_scales(q8r_amax32(xg, 4 * ng), &vd, &vid);
+        const HVX_Vector vdh = hvx_exact_sf_to_hf(vd);
+
+        // The f16 scales in the low halfwords, packed: halfword j is the scale of block j.
+        if (y_scales) {
+            const HVX_Vector vdh_packed = Q6_Vh_vpacke_VwVw(vdh, vdh);
+            for (uint32_t g = 0; g < ng; g++) {
+                hvx_vec_store_u(y_scales + 4 * (size_t) (g0 + g), 8, Q6_V_vror_VR(vdh_packed, 8 * g));
+            }
+        }
+
+        for (uint32_t g = 0; g < ng; g++) {
+            HVX_Vector q[4];
+            for (uint32_t b = 0; b < 4; b++) {
+                const HVX_Vector idb  = hvx_vec_repl_u32(Q6_V_vror_VR(vid, 4 * (4 * g + b)));
+                const HVX_Vector mid  = Q6_V_vor_VV(Q6_V_vand_VV(idb, Q8R_SPLAT(0x007fffff)), Q8R_SPLAT(0x00800000));
+                const HVX_Vector e277 = Q6_Vw_vsub_VwVw(Q8R_SPLAT(277), Q6_Vuw_vlsr_VuwR(idb, 23));
+                q[b] = q8r_quant(hvx_vmem(xg + 128 * g + 32 * b), mid, e277);
+            }
+            const HVX_Vector h01   = Q6_Vh_vpack_VwVw_sat(q[1], q[0]);
+            const HVX_Vector h23   = Q6_Vh_vpack_VwVw_sat(q[3], q[2]);
+            const HVX_Vector vx_i8 = Q6_Vb_vpack_VhVh_sat(h23, h01);
+            const uint32_t   gi    = g0 + g;
+
+            if (y_quants) {
+                hvx_vmem(y_quants + (size_t) gi * 128) = vx_i8;
+            }
+            if (y_sum) {
+                // vrmpy with ones sums the 4 bytes of a lane, then three rotate and add steps sum
+                // the 8 lanes of a block. Lane 8b holds block b.
+                HVX_Vector v_sums = Q6_Vw_vrmpy_VbVb(vx_i8, Q6_Vb_vsplat_R(1));
+                v_sums = Q6_Vw_vadd_VwVw(v_sums, Q6_V_vror_VR(v_sums, 4));
+                v_sums = Q6_Vw_vadd_VwVw(v_sums, Q6_V_vror_VR(v_sums, 8));
+                v_sums = Q6_Vw_vadd_VwVw(v_sums, Q6_V_vror_VR(v_sums, 16));
+
+                int32_t sums[32] __attribute__((aligned(128)));
+                hvx_vmem(sums) = v_sums;
+                y_sum[4 * gi + 0] = sums[0];
+                y_sum[4 * gi + 1] = sums[8];
+                y_sum[4 * gi + 2] = sums[16];
+                y_sum[4 * gi + 3] = sums[24];
+            }
+            if (y_tiles) {
+                for (uint32_t b = 0; b < 4; b++) {
+                    const HVX_Vector      v_act = Q6_V_vror_VR(vx_i8, b * 32);
+                    HVX_Vector * restrict dst   = (HVX_Vector *) (y_tiles + ((size_t) gi * 4 + b) * 1152);
+                    for (uint32_t i = 0; i < 8; i++) {
+                        dst[i] = Q6_V_vdelta_VV(Q6_V_vror_VR(v_act, 4 * i), v_repl);
+                    }
+                    dst[8] = hvx_vec_repl_f16(Q6_V_vror_VR(vdh, 4 * (4 * g + b)));
+                }
+            }
+        }
+    }
+}
+
+#endif /* HVX_Q8_REF_H */
