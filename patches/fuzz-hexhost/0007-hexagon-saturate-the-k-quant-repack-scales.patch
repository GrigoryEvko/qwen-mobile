+// A product of block scales as the FP16 scale of a tile. A product outside the FP16 range
+// saturates to +-65504 (else the tile holds Inf and the DSP multiplies with it), and NaN gives 0.
+static inline ggml_half repack_scale_to_fp16(float x) {
+    if (std::isnan(x)) {
+        return GGML_FP32_TO_FP16(0.0f);
+    }
+    return GGML_FP32_TO_FP16(std::min(std::max(x, -65504.0f), 65504.0f));
+}
+
+// Rounds a scale ratio of the read back to an integer in [lo, hi]. A value that is not finite gives 0.
+static inline int repack_round_clamp(float x, int lo, int hi) {
+    if (!std::isfinite(x)) {
+        return 0;
+    }
+    return (int) roundf(std::min(std::max(x, (float) lo), (float) hi));
+}
