+// The error callback of the queue of a session. The dspqueue library calls it on a different thread
+// after a permanent failure of the queue, and also when the process exits (the destructor of the
+// FastRPC library stops the DSP process). Thus it writes no log line, and it only keeps the code.
+// The abort message of a read or a write after the callback gives the code.
+static void ggml_hexagon_queue_error(dspqueue_t queue, AEEResult error, void * context) {
+    GGML_UNUSED(queue);
+    auto * sess = static_cast<ggml_hexagon_session *>(context);
+    sess->queue_error.store(error != 0 ? (int32_t) error : (int32_t) AEE_EFAILED, std::memory_order_release);
+}
