     float * state_out_base = dst_base + (uint64_t) S_v * H * n_tokens * n_seqs;
     const float * state_in_base = (const float *) (uintptr_t) state->data;
+    // Each state is S_v * S_v floats (a multiple of the line), thus every state is line aligned
+    // when the first one is
+    const bool state_dma = ((uintptr_t) state_out_base & (HEX_L2_LINE_SIZE - 1)) == 0;
 
     const bool kda = (g->ne[0] == S_v);
 
@@ -833,10 +836,19 @@ static void gated_delta_net_f32_pp_thread(unsigned int nth, unsigned int ith, vo
             attn_data += (uint64_t) S_v * H;
