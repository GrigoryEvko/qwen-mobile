@@ -3780,6 +3786,23 @@ void ggml_hexagon_session::hostprof_print() {
     hp.reset();
 }
 
+// Reads the slot index of each fused recurrent op of a node list from its s_copy input. Call it
+// before the first op of the list goes to the DSP: the scheduler wrote s_copy, and no op of this
+// graph wrote its bytes yet. O(number of nodes).
+void ggml_hexagon_session::latch_gdn_slots(const std::vector<htp_opnode> & nodes) {
+    gdn_slots.clear();
+    for (const auto & node : nodes) {
+        if (node.opcode != HTP_OP_GDN_CONV_STEP && node.opcode != HTP_OP_GDN_CONV_CHUNK &&
+            node.opcode != HTP_OP_GDN_STATE_STEP) {
+            continue;
+        }
+        const ggml_tensor * idx = node.inputs[node.opcode != HTP_OP_GDN_STATE_STEP ? 1 : 6];
+        if (idx->data) {
+            gdn_slots[idx] = *(const int32_t *) idx->data;
+        }
+    }
+}
