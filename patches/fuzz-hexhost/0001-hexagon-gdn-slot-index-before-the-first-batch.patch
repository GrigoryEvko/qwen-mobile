+// The check of a slot index value against the state table. When the value is not a valid row of the
+// state table, the fused op must not run, and the unfused chain runs in its place.
+static inline const char * ggml_hexagon_gdn_slot_value_check(int32_t v, const ggml_tensor * states, int32_t * slot) {
+    *slot = v;
+    if (v < 0 || v >= states->ne[1]) {
+        return "the s_copy index is not a row of the state table";
+    }
+    return nullptr;
