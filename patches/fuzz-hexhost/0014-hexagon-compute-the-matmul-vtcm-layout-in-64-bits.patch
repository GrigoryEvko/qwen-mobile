+// The VTCM size of a matmul layout in the int32 field of the kernel params. A size above INT32_MAX
+// gives INT32_MAX, which is more than the VTCM budget, thus the checks against the budget refuse the
+// layout. A truncation to int32 could give a small size that fits.
+static inline int32_t ggml_hexagon_vtcm_i32(size_t v) {
+    return v > (size_t) INT32_MAX ? INT32_MAX : (int32_t) v;
+}
