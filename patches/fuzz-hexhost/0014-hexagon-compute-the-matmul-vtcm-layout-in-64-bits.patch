+// The round up of a size in 64 bits: a layout size can be 4 GB or more, and size_t has 32 bits on
+// the DSP.
+static inline uint64_t htp_mm_round_up64(uint64_t n, uint64_t m) {
+    return ((n + m - 1) / m) * m;
+}
+
+// A layout size in size_t. A size that does not fit (4 GB or more on the DSP) gives the maximum,
+// which is more than the VTCM, thus the op refuses the layout.
+static inline size_t htp_mm_size_sat(uint64_t n) {
+    return n > (uint64_t) SIZE_MAX ? SIZE_MAX : (size_t) n;
+}
