+    // The VTCM rows of the DSP (htp/binary-ops.c:782-843): each thread holds two rows of src0 and
+    // of dst (and of src1 when the shapes are the same), each row rounded up to 128 bytes, and a
+    // broadcast row of src1 stays in VTCM once. An empty op (a view of size 0) needs no VTCM.
+    if (ggml_nelements(src0) > 0 && ggml_nelements(src1) > 0) {
+        const size_t es = ggml_type_size(src0->type);
+        const size_t r0 = src0->ne[0] * es, r1 = src1->ne[0] * es, rd = dst->ne[0] * es;
+        const size_t a0 = hex_round_up(r0, 128), a1 = hex_round_up(r1, 128), ad = hex_round_up(rd, 128);
+        const bool   scalar     = src1->ne[0] == 1;
+        const bool   transposed = src0->nb[1] < r0 || src1->nb[1] < r1 || dst->nb[1] < rd;
+        const bool   same_shape = !scalar && !transposed && src1->ne[0] == src0->ne[0] && src0->ne[0] % 128 == 0 &&
+                                  (src1->ne[1] == src0->ne[1] || src1->ne[1] == 1) &&
+                                  (src1->ne[2] == src0->ne[2] || src1->ne[2] == 1) &&
+                                  (src1->ne[3] == src0->ne[3] || src1->ne[3] == 1);
+        const bool   row_bcast  = same_shape && ggml_nrows(src1) == 1;
+        const size_t per_row    = same_shape ? 2 * (a0 + a1 + ad) : 2 * (a0 + ad);
+        size_t       vtcm       = sess->vtcm_size;
+        if (row_bcast) {
+            if (vtcm < a1) {
