hexagon: store the rows of dst in the tiled HVX matmul, not the padded weight rows
Fold-into: upstream/hexagon-host

Base: llama.cpp commit c6824a9 plus every patch of the series before this one.

The tiled kernels of htp/matmul-ops.c took the count of rows to store for
each tile of 32 weight rows from ne01 of the weight (src_w->ne[1] in the two
MUL_MAT_ID forms). For a repacked weight the host sends ne[1] rounded up to
a multiple of 32. When the real row count is not a multiple of 32, the last
tile stored up to 31 values past the end of each row of dst, thus the kernel
wrote past its output.

This patch takes the count of rows to store from ne[0] of dst in the five
tiled kernels. The weights of the Qwen3.5 models have row counts that are
multiples of 32, thus their results do not change.

diff --git a/ggml/src/ggml-hexagon/htp/matmul-ops.c b/ggml/src/ggml-hexagon/htp/matmul-ops.c
index f7f2cd0..47f93ca 100644
--- a/ggml/src/ggml-hexagon/htp/matmul-ops.c
+++ b/ggml/src/ggml-hexagon/htp/matmul-ops.c
@@ -693,7 +693,7 @@ static void hvx_mm_nx_2d_repacked_##SUFFIX(unsigned int nth, unsigned int ith, v
                                                                                                                                   \
         for (uint32_t ct = ct_start; ct < ct_end; ct++) {                                                                         \
             const uint8_t * w_tile = dma_queue_pop(dma_queue).dst;                                                                \
-            int valid_rows = (int)ne01 - (int)(ct * 32);                                                                          \
+            int valid_rows = (int)dst->ne[0] - (int)(ct * 32); /* the real rows: ne01 is padded to 32 */                          \
             valid_rows = MIN(32, MAX(0, valid_rows));                                                                             \
                                                                                                                                   \
             htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, ct);                                                                \
@@ -1169,7 +1169,8 @@ static void hvx_mm_id(unsigned int nth, unsigned int ith, void * data) {
         for (uint32_t ct = ct_start; ct < ct_end; ct++) {
             const uint8_t * w_tile = dma_queue_pop(dma_queue).dst;
 
-            int valid_rows = (int)ne01 - (int)(ct * 32);
+            // The weight of a repacked tensor has its rows padded to a multiple of 32 (the host sends ne[1] rounded up). The destination has the real rows, thus the count of stored rows comes from dst.
+            int valid_rows = (int)ne0 - (int)(ct * 32);
             valid_rows = MIN(32, MAX(0, valid_rows));
 
             htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, ct);
@@ -1258,7 +1259,8 @@ static void hvx_mv_id(unsigned int nth, unsigned int ith, void * data) {
         for (uint32_t ct = ct_start; ct < ct_end; ct++) {
             const uint8_t * w_tile = dma_queue_pop(dma_queue).dst;
 
-            int valid_rows = (int)ne01 - (int)(ct * 32);
+            // The weight of a repacked tensor has its rows padded to a multiple of 32 (the host sends ne[1] rounded up). The destination has the real rows, thus the count of stored rows comes from dst.
+            int valid_rows = (int)ne0 - (int)(ct * 32);
             valid_rows = MIN(32, MAX(0, valid_rows));
 
             htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, ct);
@@ -1348,7 +1350,8 @@ static void hvx_mv_id_nx(unsigned int nth, unsigned int ith, void * data) {
             for (uint32_t ct = ct_start; ct < ct_end; ct++) {
                 const uint8_t * w_tile = dma_queue_pop(dma_queue).dst;
 
-                int valid_rows = (int)src_w->ne[1] - (int)(ct * 32);
+                // The weight of a repacked tensor has its rows padded to a multiple of 32 (the host sends ne[1] rounded up). The destination has the real rows, thus the count of stored rows comes from dst.
+                int valid_rows = (int)dst->ne[0] - (int)(ct * 32);
                 valid_rows = MIN(32, MAX(0, valid_rows));
 
                 htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, ct);
@@ -1440,7 +1443,8 @@ static void hvx_mm_id_nx(unsigned int nth, unsigned int ith, void * data) {
             for (uint32_t ct = ct_start; ct < ct_end; ct++) {
                 const uint8_t * w_tile = dma_queue_pop(dma_queue).dst;
 
-                int valid_rows = (int)src_w->ne[1] - (int)(ct * 32);
+                // The weight of a repacked tensor has its rows padded to a multiple of 32 (the host sends ne[1] rounded up). The destination has the real rows, thus the count of stored rows comes from dst.
+                int valid_rows = (int)dst->ne[0] - (int)(ct * 32);
                 valid_rows = MIN(32, MAX(0, valid_rows));
 
                 htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, ct);
