+++ b/ggml/src/ggml-hexagon/htp-gdn-match.h
@@ -176,6 +176,41 @@ static inline bool ggml_hexagon_gdn_chain_span_is_clean(const ggml_cgraph * gf,
     return true;
 }
 
+// True when the bytes of the two tensors share a byte. A tensor with no data shares no byte.
+static inline bool ggml_hexagon_gdn_bytes_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    if (!a->data || !b->data) {
+        return false;
+    }
+    const char * ad = (const char *) a->data;
+    const char * bd = (const char *) b->data;
+    return ad < bd + ggml_nbytes(b) && bd < ad + ggml_nbytes(a);
+}
+
+// The fused op reads an input or writes an output at its emit index. The replaced node did that at the
+// index `at`. This change of position is safe when no node between the two indexes writes a byte of
+// the tensor. For an output, no node there can read a byte of it either. The allocator can give the
+// bytes of a tensor with no more readers to a different tensor, thus the check compares bytes and not
+// tensors. The check ignores views, empty nodes and the members of the chain.
+// O(|emit - at| * (GGML_MAX_SRC + members)).
+static inline bool ggml_hexagon_gdn_move_is_safe(const ggml_cgraph * gf, int emit, int at, const ggml_tensor * t,
+                                                 bool is_output, const std::vector<ggml_tensor *> & members) {
+    for (int i = std::min(emit, at) + 1; i < std::max(emit, at); i++) {
+        ggml_tensor * n = gf->nodes[i];
+        if (ggml_is_empty(n) || ggml_hexagon_gdn_is_view_op(n) || ggml_hexagon_gdn_contains(members, n)) {
+            continue;
+        }
+        if (ggml_hexagon_gdn_bytes_overlap(n, t)) {
+            return false;
+        }
+        for (int s = 0; is_output && s < GGML_MAX_SRC; s++) {
+            if (n->src[s] && ggml_hexagon_gdn_bytes_overlap(n->src[s], t)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
