--- a/ggml/src/ggml-hexagon/ggml-hexagon.cpp
+++ b/ggml/src/ggml-hexagon/ggml-hexagon.cpp
@@ -22,6 +22,7 @@
 #include <deque>
 #include <algorithm>
 #include <cmath>
+#include <filesystem>
 
 #ifdef _WIN32
 #    define WIN32_LEAN_AND_MEAN
@@ -7874,6 +7875,34 @@ static void ggml_hexagon_discover_devices() {
     }
 }
 
+// The DSP versions that have a library. A library for a newer DSP than the chip gives
+// incorrect values with no error (a v81 library on v79 silicon returns inf and NaN from
+// every f32 to f16 conversion), thus a chip below the range gets no device. A chip above
+// the range runs the newest library, which is not verified on that chip.
+static constexpr int GGML_HEXAGON_ARCH_MIN = 73;
+static constexpr int GGML_HEXAGON_ARCH_MAX = 81;
+
+// Tell if a directory of ADSP_LIBRARY_PATH holds libggml-htp-v<arch>.so. A missing library
+// fails the session open with an exception, thus the caller registers no device instead.
+// An unset path gives true, because FastRPC then searches its own directories.
+static bool ggml_hexagon_htp_lib_found(int arch) {
+    const char * paths = getenv("ADSP_LIBRARY_PATH");
+    if (paths == nullptr || paths[0] == '\0') {
+        return true;
+    }
+
+    const std::string name = "libggml-htp-v" + std::to_string(arch) + ".so";
+    std::stringstream ss(paths);
+    std::string       dir;
+    while (std::getline(ss, dir, ';')) {
+        std::error_code ec;
+        if (!dir.empty() && std::filesystem::exists(std::filesystem::path(dir) / name, ec)) {
+            return true;
+        }
+    }
+    return false;
+}
