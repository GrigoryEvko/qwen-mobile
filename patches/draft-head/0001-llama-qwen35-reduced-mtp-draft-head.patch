diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 91bb5e7..35ed3e5 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -943,6 +943,18 @@ static bool weight_buft_supported(const llama_hparams & hparams, ggml_tensor * w
                 ggml_tensor * b = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 512);
                 op_tensor = ggml_get_rows(ctx, w, b);
             } break;
+        case GGML_OP_SET_ROWS:
+            {
+                // w is the index tensor, thus it gives the number of rows that the op writes
+                ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, w->ne[0]);
+                ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, w->ne[0]);
+                op_tensor = ggml_set_rows(ctx, a, b, w);
+            } break;
+        case GGML_OP_REPEAT:
+            {
+                // w is the source that the op broadcasts, thus the destination is a multiple of it
+                op_tensor = ggml_repeat_4d(ctx, w, w->ne[0], w->ne[1]*512, w->ne[2], w->ne[3]);
+            } break;
         case GGML_OP_MUL_MAT:
             {
                 ggml_tensor * b = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, w->ne[0], 512, w->ne[2], w->ne[3]);
diff --git a/src/llama-model.h b/src/llama-model.h
index 5b6294f..240cfc4 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -236,6 +236,13 @@ struct llama_layer_nextn {
     // the block into the convention of the h_nextn of the main graph
     struct ggml_tensor * hnorm_rot             = nullptr;
     struct ggml_tensor * shared_head_rot       = nullptr;
+    // The reduced head of the drafter: a frequency-ranked subset of the rows of the shared head.
+    // draft_ids gives the vocabulary index of each row, and draft_fill gives the logit of every
+    // token that the subset leaves out. The three arrive together or not at all. The scale of the
+    // head is one value for the whole tensor, thus the subset reads the scale of the full head.
+    struct ggml_tensor * draft_head            = nullptr;
+    struct ggml_tensor * draft_ids             = nullptr;
+    struct ggml_tensor * draft_fill            = nullptr;
 };
 
 struct llama_layer_switch_lora {
