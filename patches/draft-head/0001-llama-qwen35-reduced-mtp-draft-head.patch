+                ggml_reshape_2d(ctx0, small, 1, n_draft),
+                layer.nextn.draft_ids);
+        cur = ggml_reshape_2d(ctx0, cur, n_vocab_full, 1);
+    } else {
+        cur = build_lora_mm(head_w, cur, head_s);
+    }
     cb(cur, "result_output", -1);
 
     res->t_logits = cur;
