--- a/src/models/qwen35.cpp
+++ b/src/models/qwen35.cpp
@@ -120,6 +120,17 @@ void llama_model_qwen35::load_arch_tensors(llama_model_loader & ml) {
         // the two dense maps of a rotated checkpoint, which a plain conversion does not have
