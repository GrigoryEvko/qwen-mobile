         layer.nextn.shared_head_rot  = create_tensor(tn(LLM_TENSOR_NEXTN_SHARED_HEAD_ROT,  "weight", il), { n_embd, n_embd },      mtp_flags|TENSOR_NOT_REQUIRED);
+
+        // The reduced head of the drafter, which quant/draftset.py writes. The row count comes
