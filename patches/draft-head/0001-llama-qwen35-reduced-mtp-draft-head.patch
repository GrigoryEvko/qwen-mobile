+        // The three tensors arrive together, thus one missing tensor turns the feature off.
+        const struct ggml_tensor * draft_meta = ml.get_tensor_meta(tn(LLM_TENSOR_NEXTN_DRAFT_HEAD, "weight", il).str().c_str());
+        if (draft_meta) {
+            const int64_t n_draft = draft_meta->ne[1];
+            layer.nextn.draft_head = create_tensor(tn(LLM_TENSOR_NEXTN_DRAFT_HEAD, "weight", il), { n_embd, n_draft }, mtp_flags|TENSOR_NOT_REQUIRED);
+            layer.nextn.draft_ids  = create_tensor(tn(LLM_TENSOR_NEXTN_DRAFT_IDS,            il), { n_draft },         mtp_flags|TENSOR_NOT_REQUIRED);
+            layer.nextn.draft_fill = create_tensor(tn(LLM_TENSOR_NEXTN_DRAFT_FILL,           il), { 1 },               mtp_flags|TENSOR_NOT_REQUIRED);
+        }
     };
 
     for (int i = 0; i < n_layer; ++i) {
@@ -668,7 +679,31 @@ llama_model_qwen35::graph_mtp::graph_mtp(const llama_model & model, const llm_gr
         cur = ggml_mul_mat(ctx0, model.output_rot, cur);
         cb(cur, "mtp_output_rot", -1);
     }
-    cur = build_lora_mm(head_w, cur, head_s);
+    // The drafter reads a reduced head when the pipeline put one in the file (quant/draftset.py).
+    // The subset decides only what the drafter proposes. The target model verifies each proposed
+    // token against the full head, thus a token outside the subset is never accepted wrongly and
+    // the answer of the model does not change. One output row keeps the two reshapes of the
+    // scatter as views, thus an MTP pass with more rows reads the full head.
+    const bool use_draft_head = layer.nextn.draft_head && layer.nextn.draft_ids
+            && layer.nextn.draft_fill && cur->ne[1] == 1;
+    if (use_draft_head) {
+        const int64_t n_vocab_full = head_w->ne[1];
+        const int64_t n_draft      = layer.nextn.draft_head->ne[1];
+
+        ggml_tensor * small = build_lora_mm(layer.nextn.draft_head, cur, head_s);
+        cb(small, "mtp_draft_logits", -1);
+
+        // ggml_set_rows writes whole rows, thus the scatter holds one logit per row. The
+        // background gives every token outside the subset the logit of draft_fill.
+        ggml_tensor * bg = ggml_repeat_4d(ctx0, layer.nextn.draft_fill, n_vocab_full, 1, 1, 1);
+        cur = ggml_set_rows(ctx0,
