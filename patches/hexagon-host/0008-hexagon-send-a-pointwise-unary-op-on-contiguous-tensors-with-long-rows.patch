     const char * str_hostprof   = getenv("LLAMA_HOSTPROF");
 
     ggml_hexagon_mm_fusion_read_env();
@@ -8639,6 +8754,7 @@ static void ggml_hexagon_init(ggml_backend_reg * reg) {
     opt_batchcache_multi = str_batchcache_multi ? atoi(str_batchcache_multi) : opt_batchcache_multi;
     opt_graphcache = str_graphcache ? atoi(str_graphcache)                : opt_graphcache;
     opt_mmap_lru   = str_mmap_lru   ? atoi(str_mmap_lru)                  : opt_mmap_lru;
+    opt_unary_flat = str_unary_flat ? atoi(str_unary_flat)                : opt_unary_flat;
     opt_hostprof   = str_hostprof   ? atoi(str_hostprof)                  : opt_hostprof;
 
     if (opt_batchcache) {
