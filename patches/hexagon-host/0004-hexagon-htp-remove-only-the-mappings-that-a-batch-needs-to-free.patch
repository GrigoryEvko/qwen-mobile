-static void prep_op_bufs(struct htp_context *ctx, struct htp_buf_desc *bufs, uint32_t n_bufs) {
+// Removes mappings that the batch does not use, thus e_vmem more bytes fit in max_vmem. The bit i of
+// m_reuse is set when the batch uses the mapping i.
+//
+// Without lru, the function removes each mapping that the batch does not use, if e_vmem more bytes do not
+// fit. With lru, it removes one mapping at a time, and it stops when e_vmem more bytes and n_new more
+// mappings fit. It removes a mapping with the lowest batch number of its last use. Among such mappings it
+// removes the smallest one that frees sufficient bytes, else the largest one. The smallest sufficient
+// mapping keeps the most bytes mapped for the batches that follow, and the largest mapping needs the
+// fewest removals. On the phone one HAP_mmap2 of 1 GiB takes about 17 us and one HAP_munmap2 about
+// 35 us (tools/ddrbw mapcost). O(HTP_MAX_MMAPS^2).
+static void evict_mmaps(struct htp_context *ctx, uint32_t m_reuse, uint64_t e_vmem, uint32_t n_new, uint32_t seq,
+                        bool lru) {
+    uint64_t m_vmem = 0;
+    uint32_t n_maps = 0;
+    for (uint32_t i = 0; i < HTP_MAX_MMAPS; i++) {
+        if (ctx->mmap[i].size) {
+            m_vmem += ctx->mmap[i].size;
+            n_maps++;
+        }
+    }
+
+    FARF(HIGH, "prep-bufs : mmap-vmem %zu extra-vmem %zu max-vmem %zu : n-maps %u n-new %u lru %d",
+            (size_t) m_vmem, (size_t) e_vmem, (size_t) ctx->max_vmem, n_maps, n_new, (int) lru);
+
+    if (!lru) {
+        if ((m_vmem + e_vmem) > ctx->max_vmem) {
+            for (uint32_t i = 0; i < HTP_MAX_MMAPS; i++) {
+                if (!(m_reuse & (1u << i))) { drop_mmap(ctx, ctx->mmap + i); }
+            }
+        }
+        return;
+    }
+
+    while ((m_vmem + e_vmem) > ctx->max_vmem || (n_maps + n_new) > HTP_MAX_MMAPS) {
+        const uint64_t need = (m_vmem + e_vmem) > ctx->max_vmem ? (m_vmem + e_vmem) - ctx->max_vmem : 0;
+
+        uint32_t age = 0;
+        for (uint32_t i = 0; i < HTP_MAX_MMAPS; i++) {
+            const struct htp_mmap * m = ctx->mmap + i;
+            if (m->size && !(m_reuse & (1u << i)) && (uint32_t) (seq - m->last_use) > age) {
+                age = (uint32_t) (seq - m->last_use);
+            }
+        }
+
+        int fit = -1;  // the smallest mapping of that age that frees need bytes
+        int big = -1;  // the largest mapping of that age
+        for (uint32_t i = 0; i < HTP_MAX_MMAPS; i++) {
+            const struct htp_mmap * m = ctx->mmap + i;
+            if (!m->size || (m_reuse & (1u << i)) || (uint32_t) (seq - m->last_use) != age) {
+                continue;
+            }
+            if (m->size >= need && (fit < 0 || m->size < ctx->mmap[fit].size)) {
+                fit = (int) i;
+            }
+            if (big < 0 || m->size > ctx->mmap[big].size) {
+                big = (int) i;
+            }
+        }
+
+        const int victim = fit >= 0 ? fit : big;
+        if (victim < 0) {
+            break;  // each mapping is used by the batch: the second pass of prep_op_bufs removes them all
+        }
+        m_vmem -= ctx->mmap[victim].size;
+        n_maps--;
+        drop_mmap(ctx, ctx->mmap + victim);
+    }
+}
