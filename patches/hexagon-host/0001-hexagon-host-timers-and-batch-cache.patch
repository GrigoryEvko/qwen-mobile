+// The host-side times of one token, in microseconds (LLAMA_HOSTPROF)
+struct ggml_hexagon_hostprof {
+    int64_t  pack_us       = 0;  // graph_compute: the op packing, or the replay check of the cached batch
+    int64_t  submit_us     = 0;  // flush_batch: the copy of the descriptors into the queue block and the queue write
+    int64_t  wait_us       = 0;  // flush_pending: the wait for the responses of the DSP
+    int64_t  pop_us        = 0;  // flush_pending: the profile dump of the responses
+    int64_t  get_us        = 0;  // get-tensor: the copy of the outputs after the wait
+    int64_t  set_us        = 0;  // set-tensor: the copy of the inputs
+    int64_t  turnaround_us = 0;  // the time from the last response of the previous token to the first submit
+    uint64_t get_bytes     = 0;
+    uint64_t set_bytes     = 0;
+    uint32_t n_graphs      = 0;
+    uint32_t n_ops         = 0;
+    uint32_t n_hits        = 0;  // graph_compute calls that found the op nodes of the graph in the cache
+    uint32_t n_replays     = 0;  // graph_compute calls that replayed the packed batch
+    uint32_t n_verified    = 0;  // replays that a fresh packing confirmed
+    uint32_t n_batches     = 0;
+    int64_t  t_rsp         = 0;  // the time of the last response
+
+    void reset() {
+        const int64_t keep = t_rsp;
+        *this = ggml_hexagon_hostprof();
+        t_rsp = keep;
+    }
+};
+
+// The packed batch of one graph_compute call, kept for a replay when the same graph runs again
+// (GGML_HEXAGON_BATCHCACHE). The descriptors depend on the graph (its uid), on the data pointers
+// of the tensors, on the op params, and on the slot index of the fused state ops. The replay checks
+// the last three and reads the slot index again.
+struct ggml_hexagon_batch_snapshot {
+    uint64_t uid = 0;
+
+    std::vector<htp_buf_desc> bufs;
+    std::vector<htp_tensor>   tens;
+    std::vector<htp_op_desc>  ops;
+    size_t                    b_vmem = 0;
+
+    std::shared_ptr<const std::vector<htp_opnode>> nodes;  // the op nodes for the profile dump, null without profiling
+
+    std::vector<std::pair<const ggml_tensor *, uint16_t>> t_refs;   // each add_tensor call: the tensor and its index
+    std::vector<const ggml_tensor *>                      o_nodes;  // each op: the ggml node whose op params it copied
+
+    struct gdn_ref {
+        uint32_t            oi;      // the op index
+        const ggml_tensor * states;  // the state table
+        const ggml_tensor * idx;     // the s_copy input with the slot index
+    };
+    std::vector<gdn_ref> gdn;        // the fused state ops of the gated delta net layers
+
+    bool valid = false;
+};
+
+// The op nodes and the packed batch of one graph, keyed by the graph uid. A session keeps the last
+// GGML_HEXAGON_GRAPHCACHE graphs, thus the graphs of two contexts (a draft and a target) alternate
+// without a rebuild.
+struct ggml_hexagon_graph_cache_entry {
+    std::vector<htp_opnode>     nodes;
+    ggml_hexagon_batch_snapshot snap;
+    uint64_t                    last_use = 0;
+};
+
+// The descriptors of one batch, as the queue sends them
+struct ggml_hexagon_batch_view {
+    const htp_buf_desc * bufs   = nullptr;
+    const htp_tensor *   tens   = nullptr;
+    const htp_op_desc *  ops    = nullptr;
+    uint32_t             n_bufs = 0;
+    uint32_t             n_tens = 0;
+    uint32_t             n_ops  = 0;
+    size_t               b_vmem = 0;
+
+    std::shared_ptr<const std::vector<htp_opnode>> nodes;  // for the profile dump, null without profiling
+};
+
