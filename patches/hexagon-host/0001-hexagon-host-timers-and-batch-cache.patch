+ggml_hexagon_graph_cache_entry * ggml_hexagon_session::graph_cache_find(uint64_t uid) {
+    auto it = graph_cache.find(uid);
+    if (it == graph_cache.end()) {
+        return nullptr;
+    }
+    it->second.last_use = ++graph_cache_clock;
+    return &it->second;
+}
+
+// Adds the op nodes of a graph. When the cache is full, the graph that ran the longest time ago goes.
+ggml_hexagon_graph_cache_entry & ggml_hexagon_session::graph_cache_insert(uint64_t uid, std::vector<htp_opnode> && nodes) {
+    const size_t cap = opt_graphcache > 0 ? (size_t) opt_graphcache : 1;
+    while (graph_cache.size() >= cap) {
+        auto oldest = graph_cache.begin();
+        for (auto it = graph_cache.begin(); it != graph_cache.end(); ++it) {
+            if (it->second.last_use < oldest->second.last_use) {
+                oldest = it;
+            }
+        }
+        if (op_batch->arrays_uid == oldest->first) {
+            op_batch->arrays_uid = 0;
+        }
+        graph_cache.erase(oldest);
+    }
+
+    auto & entry    = graph_cache[uid];
+    entry.nodes     = std::move(nodes);
+    entry.snap      = ggml_hexagon_batch_snapshot();
+    entry.last_use  = ++graph_cache_clock;
+    return entry;
+}
+
+// Keeps the packed batch of one graph for a replay. The caller made sure that the batch holds this
+// graph and nothing else, and that no flush happened while the graph was packed.
+void ggml_hexagon_session::batch_snapshot(ggml_hexagon_graph_cache_entry & entry, uint64_t uid) {
+    auto &       s = entry.snap;
+    const auto & b = *op_batch;
+
+    s.uid    = uid;
+    s.bufs.assign(b.h_bufs.begin(), b.h_bufs.begin() + b.n_bufs);
+    s.tens.assign(b.h_tens.begin(), b.h_tens.begin() + b.n_tens);
+    s.ops.assign(b.h_ops.begin(),   b.h_ops.begin()  + b.n_ops);
+    s.b_vmem = b.b_vmem;
+    s.nodes  = opt_profile ? std::make_shared<const std::vector<htp_opnode>>(b.ops.begin(), b.ops.begin() + b.n_ops) : nullptr;
+    s.t_refs  = b.t_refs;
+    s.o_nodes = b.o_nodes;
+    s.gdn     = b.gdn_refs;
+    s.valid   = true;
+
+    op_batch->arrays_uid = uid;
+
+    HEX_VERBOSE("ggml-hex: %s batch-cache: kept graph %llu : n-bufs %u n-tensors %u n-ops %u refs %zu gdn %zu\n", c_name(),
+                (unsigned long long) uid, b.n_bufs, b.n_tens, b.n_ops, s.t_refs.size(), s.gdn.size());
+}
+
+// Loads the packed batch of the graph into the empty op batch, when the batch is still correct:
+// the same data pointer for each tensor, the same op params, and a valid slot index for each fused
+// state op. The descriptors then equal a fresh packing byte for byte (GGML_HEXAGON_BATCHCACHE=2 checks).
+bool ggml_hexagon_session::batch_replay(ggml_hexagon_graph_cache_entry & entry, uint64_t uid) {
+    auto & s = entry.snap;
+    if (!s.valid || s.uid != uid) {
+        return false;
+    }
+
+    for (const auto & ref : s.t_refs) {
+        const ggml_tensor * t = ref.first;
+        const htp_tensor &  h = s.tens[ref.second];
+        if (!t->buffer) {
+            return false;
+        }
+        auto sbuf = static_cast<const ggml_hexagon_shared_buffer *>(t->buffer->context);
+        if ((uint64_t) ((const uint8_t *) t->data - sbuf->base()) != h.data) {
+            return false;
+        }
+        if (s.bufs[h.bi].fd != (uint32_t) sbuf->fd()) {
+            return false;
+        }
+    }
+
+    for (size_t i = 0; i < s.o_nodes.size(); i++) {
+        if (s.o_nodes[i] && memcmp(s.o_nodes[i]->op_params, s.ops[i].params, sizeof(s.ops[i].params)) != 0) {
+            return false;
+        }
+    }
+
+    // The slot index of a fused state op is a value of the token. When it is not valid, the unfused
+    // chain must run, thus the graph is packed again.
+    for (const auto & g : s.gdn) {
+        int32_t slot = -1;
+        if (ggml_hexagon_gdn_slot_index_check(g.idx, g.states, &slot)) {
+            return false;
+        }
+        s.ops[g.oi].kernel_params[0] = slot;
+    }
+
+    auto & b = *op_batch;
+    if (b.arrays_uid != uid) {
+        std::copy(s.bufs.begin(), s.bufs.end(), b.h_bufs.begin());
+        std::copy(s.tens.begin(), s.tens.end(), b.h_tens.begin());
+        std::copy(s.ops.begin(),  s.ops.end(),  b.h_ops.begin());
+        if (s.nodes) {
+            std::copy(s.nodes->begin(), s.nodes->end(), b.ops.begin());  // the profile dump of ops added after the replay
+        }
+        b.arrays_uid = uid;
+    } else {
+        // The arrays still hold this batch (sorted by the last flush). Only the slots can differ.
+        for (const auto & g : s.gdn) {
+            b.h_ops[g.oi].kernel_params[0] = s.ops[g.oi].kernel_params[0];
+        }
+    }
+
+    b.n_bufs = (unsigned int) s.bufs.size();
+    b.n_tens = (unsigned int) s.tens.size();
+    b.n_ops  = (unsigned int) s.ops.size();
+    b.b_vmem = s.b_vmem;
+
+    // Later ops in the same batch find the buffers. The tensor maps stay empty: such ops add their
+    // tensors again, which costs descriptor entries only.
+    b.b_map.clear();
+    for (unsigned int bi = 0; bi < b.n_bufs; bi++) {
+        b.b_map.insert({(int) b.h_bufs[bi].fd, (int) bi});
+    }
+
+    return true;
+}
+
+// Packs the graph again into a second batch and compares the result with the replay
+// (GGML_HEXAGON_BATCHCACHE=2). When the two differ, the fresh packing runs.
+void ggml_hexagon_session::batch_verify(ggml_hexagon_graph_cache_entry & entry, uint64_t uid) {
+    if (!verify_batch) {
+        verify_batch = new ggml_hexagon_opbatch(this, opt_opbatch, this->max_vmem);
+    }
+
+    const uint64_t seq_before = batch_req_seq;
+
+    std::swap(op_batch, verify_batch);
+    for (const auto & node : entry.nodes) {
+        enqueue_op(node);
+    }
+    std::swap(op_batch, verify_batch);
+
+    auto & r = *op_batch;      // the replay
+    auto & v = *verify_batch;  // the fresh packing
+
+    const char * diff = nullptr;
+    size_t       at   = 0;
+
+    if (batch_req_seq != seq_before) {
+        diff = "the fresh packing did not fit in one batch";
+    } else if (r.n_bufs != v.n_bufs || r.n_tens != v.n_tens || r.n_ops != v.n_ops) {
+        diff = "the counts";
+    } else {
+        r.sort_buffers();
+        v.sort_buffers();
+        for (unsigned int i = 0; i < r.n_bufs && !diff; i++) {
+            if (memcmp(&r.h_bufs[i], &v.h_bufs[i], sizeof(htp_buf_desc)) != 0) { diff = "buffer"; at = i; }
+        }
+        for (unsigned int i = 0; i < r.n_tens && !diff; i++) {
+            if (memcmp(&r.h_tens[i], &v.h_tens[i], sizeof(htp_tensor)) != 0) { diff = "tensor"; at = i; }
+        }
+        for (unsigned int i = 0; i < r.n_ops && !diff; i++) {
+            if (memcmp(&r.h_ops[i], &v.h_ops[i], sizeof(htp_op_desc)) != 0) { diff = "op"; at = i; }
+        }
+    }
+
+    if (!diff) {
+        hp.n_verified++;
+        HEX_VERBOSE("ggml-hex: %s batch-cache verify: graph %llu : the replay equals the fresh packing (%u ops)\n",
+                    c_name(), (unsigned long long) uid, r.n_ops);
+        v.reset();
+        return;
+    }
+
+    GGML_LOG_ERROR("ggml-hex: %s batch-cache verify: graph %llu : the replay differs from the fresh packing at %s #%zu, the fresh packing runs\n",
+                   c_name(), (unsigned long long) uid, diff, at);
+
+    if (batch_req_seq == seq_before) {
+        std::swap(op_batch, verify_batch);
+    }
+    verify_batch->reset();
+    entry.snap.valid = false;
+}
+
+void ggml_hexagon_session::hostprof_print() {
+    if (!opt_hostprof || hp.n_batches == 0) {
+        return;
+    }
+
+    GGML_LOG_INFO("hostprof: %s graphs %u ops %u hits %u replays %u verified %u batches %u | pack %lld submit %lld wait %lld pop %lld get %lld (%llu B) set %lld (%llu B) | turnaround %lld us\n",
+                  c_name(), hp.n_graphs, hp.n_ops, hp.n_hits, hp.n_replays, hp.n_verified, hp.n_batches,
+                  (long long) hp.pack_us, (long long) hp.submit_us, (long long) hp.wait_us, (long long) hp.pop_us,
+                  (long long) hp.get_us, (unsigned long long) hp.get_bytes, (long long) hp.set_us, (unsigned long long) hp.set_bytes,
+                  (long long) hp.turnaround_us);
+
+    hp.reset();
+}
