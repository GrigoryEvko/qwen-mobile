     int prev_backend_id = -1;
 
+    // LLAMA_HOSTPROF: the time of the input copies and of the compute call of each split
+    static const int hostprof = [] { const char * s = getenv("LLAMA_HOSTPROF"); return s ? atoi(s) : 0; }();
+    char   hp_line[1024];
+    size_t hp_len = 0;
+    hp_line[0] = '\0';
+
+    // GGML_SCHED_SKIP_NOCOMPUTE_SPLITS: skip a split whose nodes all carry no GGML_TENSOR_FLAG_COMPUTE.
+    // ggml_build_forward_select puts the nodes of the branch that it does not select in the graph without
+    // that flag. A backend must not compute such a node, thus the copies of the inputs of the split are
+    // not necessary either.
+    static const int skip_nocompute = [] { const char * s = getenv("GGML_SCHED_SKIP_NOCOMPUTE_SPLITS"); return s ? atoi(s) : 1; }();
+
     for (int split_id = 0; split_id < sched->n_splits; split_id++) {
         struct ggml_backend_sched_split * split = &splits[split_id];
         int split_backend_id = split->backend_id;
         ggml_backend_t split_backend = sched->backends[split_backend_id];
 
+        if (skip_nocompute) {
+            bool has_compute = false;
+            for (int i = 0; i < split->graph.n_nodes && !has_compute; i++) {
+                const struct ggml_tensor * node = split->graph.nodes[i];
+                has_compute = !ggml_op_is_empty(node->op) && (node->flags & GGML_TENSOR_FLAG_COMPUTE);
+            }
+            if (!has_compute) {
+                if (hostprof && hp_len < sizeof(hp_line)) {
+                    const int n = snprintf(hp_line + hp_len, sizeof(hp_line) - hp_len, " [%s nodes %d inputs %d skipped]",
+                                           ggml_backend_name(split_backend), split->graph.n_nodes, split->n_inputs);
+                    hp_len = n > 0 ? hp_len + (size_t) n : sizeof(hp_line);
+                }
+                continue;
+            }
+        }
+
+        const int64_t hp_t0 = hostprof ? ggml_time_us() : 0;
+        int64_t       hp_t1 = 0;
+
         // ensure the previous split's async work has completed before we start
         // this split, the allocator may have reused buffer regions across splits
         if (split->n_inputs == 0 && prev_backend_id >= 0 && prev_backend_id != split_backend_id) {
@@ -1792,6 +1823,8 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
             }
         }
 
+        hp_t1 = hostprof ? ggml_time_us() : 0;
+
         if (!sched->callback_eval) {
             enum ggml_status ec = ggml_backend_graph_compute_async(split_backend, &split->graph);
             if (ec != GGML_STATUS_SUCCESS) {
@@ -1836,9 +1869,21 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
             ggml_backend_event_record(sched->events[split_backend_id][sched->cur_copy], split_backend);
         }
 
+        if (hostprof && hp_len < sizeof(hp_line)) {
+            const int64_t hp_t2 = ggml_time_us();
+            const int n = snprintf(hp_line + hp_len, sizeof(hp_line) - hp_len, " [%s nodes %d inputs %d copy %lld compute %lld]",
+                                   ggml_backend_name(split_backend), split->graph.n_nodes, split->n_inputs,
+                                   (long long) (hp_t1 - hp_t0), (long long) (hp_t2 - hp_t1));
+            hp_len = n > 0 ? hp_len + (size_t) n : sizeof(hp_line);
+        }
+
         prev_backend_id = split_backend_id;
     }
 
+    if (hostprof) {
+        GGML_LOG_INFO("hostprof: sched splits %d%s us\n", sched->n_splits, hp_line);
+    }
+
     return GGML_STATUS_SUCCESS;
 }
 
