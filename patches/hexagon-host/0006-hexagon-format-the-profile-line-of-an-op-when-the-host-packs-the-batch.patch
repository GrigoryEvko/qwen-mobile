+// The text of the profile line of an op before its times: the op, the names, the dims, the types, the
+// strides and the kernel params. The op batch makes this text when it adds the op (add_op, try_fuse).
+// The response of the DSP comes later. Before the response, llama.cpp can build the next graph in the
+// same memory. A text made at the response can thus show the names and the dims of the next graph.
+static std::string ggml_hexagon_prof_line(const htp_opnode & node) {
+    htp_opformat fmt(node);
+    std::string  s = node.op_name();
+    for (const char * f : { fmt.names, fmt.dims, fmt.types, fmt.strides, fmt.kparams }) {
+        s += '|';
+        s += f;
+    }
+    return s;
+}
+
