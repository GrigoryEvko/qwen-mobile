+    llama_token_data_array top_p = { top.data(), n_top, -1, false };
+    llama_sampler_apply(part, &top_p);
+    GGML_ASSERT(top_p.selected >= 0);
+
+    const llama_token id_full = sample_dist(full, logits);
+    const llama_token id_top  = top_p.data[top_p.selected].id;
+    GGML_ASSERT(id_full == id_top);
+
+    llama_sampler_free(full);
+    llama_sampler_free(part);
+}
