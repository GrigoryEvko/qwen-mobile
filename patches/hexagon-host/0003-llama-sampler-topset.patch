+
+//
+// top set (LLAMA_SAMPLER_TOPSET)
+//
+// A chain that cuts the candidates with top-k (or greedy) reads only the k best logits after the samplers
+// before the cut. Those samplers move a bounded set of tokens by id: the penalties move the tokens of the
+// last-n window, the logit bias moves its tokens. A token outside the m = k + n_moved highest logits is
+// not moved, and at least k tokens that are not moved have a higher logit. Thus the top-k after the cut
+// is a subset of the m highest logits plus the moved tokens, and the samplers after the cut see the same
+// k candidates. The one exception is a tie of the k-th and the (k+1)-th logit: the two partial sorts can
+// then keep a different token.
+//
+
+// The bound m for the chain, and the tokens that the samplers before the cut move. 0 when the chain
+// needs all the logits.
+static int32_t llama_sampler_chain_topset_bound(const llama_sampler_chain * chain, std::vector<llama_token> & moved) {
+    int32_t slack = 0;
+
+    for (const auto & info : chain->samplers) {
+        const llama_sampler * s = info.ptr;
+
+        if (s->iface == &llama_sampler_logit_bias_i) {
+            const auto * ctx = (const llama_sampler_logit_bias *) s->ctx;
+            for (const auto & lb : ctx->logit_bias) {
+                moved.push_back(lb.token);
+            }
+            slack += (int32_t) ctx->logit_bias.size();
+        } else if (s->iface == &llama_sampler_penalties_i) {
+            const auto * ctx = (const llama_sampler_penalties *) s->ctx;
+            if (ctx->is_disabled()) {
+                continue;
+            }
+            for (const auto & kv : ctx->token_count) {
+                moved.push_back(kv.first);
+            }
+            slack += (int32_t) ctx->token_count.size();
+        } else if (s->iface == &llama_sampler_dry_i) {
+            const auto * ctx = (const llama_sampler_dry *) s->ctx;
+            if (ctx->dry_multiplier == 0.0f || ctx->dry_base < 1.0f || ctx->dry_penalty_last_n == 0) {
+                continue;
+            }
+            return 0;
+        } else if (s->iface == &llama_sampler_top_n_sigma_i) {
+            const auto * ctx = (const llama_sampler_top_n_sigma *) s->ctx;
+            if (ctx->n <= 0.0f) {
+                continue;
+            }
+            return 0;
+        } else if (s->iface == &llama_sampler_temp_i) {
+            const auto * ctx = (const llama_sampler_temp *) s->ctx;
+            if (ctx->temp <= 0.0f) {
+                return 0;
+            }
+            continue;  // a uniform scale keeps the order
+        } else if (s->iface == &llama_sampler_temp_ext_i) {
+            const auto * ctx = (const llama_sampler_temp_ext *) s->ctx;
+            if (ctx->delta > 0.0f || ctx->temp <= 0.0f) {
+                return 0;  // the dynamic temperature reads the entropy of all the candidates
+            }
+            continue;
+        } else if (s->iface == &llama_sampler_top_k_i) {
+            const auto * ctx = (const llama_sampler_top_k *) s->ctx;
+            if (ctx->k <= 0) {
+                return 0;
+            }
+            return ctx->k + slack;
+        } else if (s->iface == &llama_sampler_greedy_i) {
+            return 1 + slack;
+        } else {
+            return 0;
+        }
+    }
+
+    return 0;
+}
+
+size_t llama_sampler_topset(struct llama_sampler * smpl, const float * logits, int32_t n_vocab, llama_token_data * dst) {
+    if (!smpl || smpl->iface != &llama_sampler_chain_i || !logits || !dst || n_vocab <= 0) {
+        return 0;
+    }
+
+    const auto * chain = (const llama_sampler_chain *) smpl->ctx;
+
+    std::vector<llama_token> moved;
+    const int32_t m = llama_sampler_chain_topset_bound(chain, moved);
+    if (m <= 0 || m + (int32_t) moved.size() >= n_vocab / 2) {
+        return 0;
+    }
+
+    // a min-heap of the m highest logits
+    static const auto by_logit_desc = [](const llama_token_data & a, const llama_token_data & b) {
+        return a.logit > b.logit;
+    };
+
+    std::vector<llama_token_data> heap;
+    heap.reserve(m);
+
+    llama_token id = 0;
+    for (; id < n_vocab && (int32_t) heap.size() < m; id++) {
+        heap.push_back(llama_token_data{id, logits[id], 0.0f});
+    }
+    std::make_heap(heap.begin(), heap.end(), by_logit_desc);
+
+    float threshold = heap.front().logit;
+    for (; id < n_vocab; id++) {
+        const float l = logits[id];
+        if (l > threshold) {
+            std::pop_heap(heap.begin(), heap.end(), by_logit_desc);
+            heap.back() = llama_token_data{id, l, 0.0f};
+            std::push_heap(heap.begin(), heap.end(), by_logit_desc);
+            threshold = heap.front().logit;
+        }
+    }
+
+    // token order, as in the full array
+    std::sort(heap.begin(), heap.end(), [](const llama_token_data & a, const llama_token_data & b) {
+        return a.id < b.id;
+    });
+
+    std::sort(moved.begin(), moved.end());
+    moved.erase(std::unique(moved.begin(), moved.end()), moved.end());
+
+    // merge the two ordered lists into dst
+    size_t n  = 0;
+    size_t ih = 0;
+    size_t im = 0;
+    while (ih < heap.size() || im < moved.size()) {
+        if (im < moved.size() && (moved[im] < 0 || moved[im] >= n_vocab)) {
+            im++;
+            continue;
+        }
+        if (im >= moved.size() || (ih < heap.size() && heap[ih].id <= moved[im])) {
+            if (im < moved.size() && heap[ih].id == moved[im]) {
+                im++;
+            }
+            dst[n++] = heap[ih++];
+        } else {
+            dst[n++] = llama_token_data{moved[im], logits[moved[im]], 0.0f};
+            im++;
+        }
+    }
+
+    return n;
+}
+
+// Runs a clone of the chain on all the logits and a clone on the top set, and compares the two selected
+// tokens. The clones keep the random state of the chain, thus the chain itself is not changed.
+static void llama_sampler_topset_verify(struct llama_sampler * smpl, const float * logits, int32_t n_vocab, const std::vector<llama_token_data> & top) {
+    static int64_t n_same = 0;
+    static int64_t n_diff = 0;
+
+    struct llama_sampler * chain_full = llama_sampler_clone(smpl);
+    struct llama_sampler * chain_top  = llama_sampler_clone(smpl);
+
+    std::vector<llama_token_data> full(n_vocab);
+    for (llama_token id = 0; id < n_vocab; id++) {
+        full[id] = llama_token_data{id, logits[id], 0.0f};
+    }
+    std::vector<llama_token_data> part = top;
+
+    llama_token_data_array full_p = { full.data(), full.size(), -1, false };
+    llama_token_data_array part_p = { part.data(), part.size(), -1, false };
+
+    llama_sampler_apply(chain_full, &full_p);
+    llama_sampler_apply(chain_top,  &part_p);
+
+    const llama_token id_full = full_p.selected >= 0 ? full_p.data[full_p.selected].id : LLAMA_TOKEN_NULL;
+    const llama_token id_top  = part_p.selected >= 0 ? part_p.data[part_p.selected].id : LLAMA_TOKEN_NULL;
+
+    if (id_full == id_top) {
+        n_same++;
+    } else {
+        n_diff++;
+        LLAMA_LOG_WARN("topset verify: the top set of %zu candidates selects token %d, all the logits select token %d\n",
+                       top.size(), id_top, id_full);
+    }
+
+    if ((n_same + n_diff) % 64 == 0) {
+        LLAMA_LOG_INFO("topset verify: %lld same, %lld different\n", (long long) n_same, (long long) n_diff);
+    }
+
+    llama_sampler_free(chain_full);
+    llama_sampler_free(chain_top);
+}
