+// The top set of a chain selects the same token as all the logits. The logits take 16 values, thus
+// most draws have ties at the cut, and the penalties and the logit bias move tokens from below it.
+static void test_topset(size_t n_vocab, int top_k, int n_last, bool greedy, uint32_t seed) {
+    std::mt19937 rng(seed);
+    std::uniform_int_distribution<int> level(0, 15);
+    std::uniform_int_distribution<int> token(0, (int) n_vocab - 1);
+
+    std::vector<float> logits(n_vocab);
+    for (auto & l : logits) {
+        l = 0.5f * (float) level(rng);
+    }
+    std::vector<llama_logit_bias> bias = { { token(rng), 4.0f }, { token(rng), -4.0f } };
+
+    auto make_chain = [&]() {
+        llama_sampler * chain = llama_sampler_chain_init(llama_sampler_chain_default_params());
+        llama_sampler_chain_add(chain, llama_sampler_init_logit_bias((int32_t) n_vocab, (int32_t) bias.size(), bias.data()));
+        llama_sampler_chain_add(chain, llama_sampler_init_penalties((int32_t) n_vocab, n_last, 1.5f, 0.2f, 0.1f));
+        if (greedy) {
+            llama_sampler_chain_add(chain, llama_sampler_init_greedy());
