+    // env: LLAMA_HOSTPROF - print the host-side times of each decode call
+    bool hostprof = false;
+
+    struct llama_hostprof_data {
+        int64_t t_apply   = 0;  // the memory context apply
+        int64_t t_reuse   = 0;  // the graph reuse check
