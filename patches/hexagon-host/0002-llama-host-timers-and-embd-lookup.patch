+        int64_t t_alloc   = 0;  // the scheduler split and allocation
+        int64_t t_inputs  = 0;  // set_inputs
+        int64_t t_compute = 0;  // the scheduler compute (the backends queue their work here)
+        int64_t t_logits  = 0;  // the copy of the logits to the host (the wait for the device is in here)
+        int32_t n_reused  = 0;
+        int32_t n_ubatch  = 0;
+    };
+    llama_hostprof_data hp;
+    int64_t hp_t_return = 0;  // the time the last decode call returned
+    int32_t hp_n_decode = 0;
