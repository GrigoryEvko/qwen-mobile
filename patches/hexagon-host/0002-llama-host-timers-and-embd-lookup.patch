+// Fills embd_lookup_buf with the embedding rows of the tokens of the batch, with the same dequantization
+// function that the CPU GET_ROWS op uses. Returns false when the batch must keep its tokens.
+bool llama_context::embd_lookup(const llama_batch & batch) {
+    if (!batch.token || batch.embd) {
+        return false;
+    }
+    if (cparams.ctx_type == LLAMA_CONTEXT_TYPE_MTP || model.arch == LLM_ARCH_DFLASH) {
+        return false;
+    }
+    if (loras && !loras->empty()) {
+        return false;  // the token path applies the adapter on the embedding
+    }
+
+    const ggml_tensor * tok_embd = model.tok_embd;
+    if (!tok_embd || !tok_embd->buffer || !ggml_backend_buffer_is_host(tok_embd->buffer)) {
+        return false;
+    }
+
+    const auto & hparams = model.hparams;
+
+    const int64_t n_embd     = hparams.n_embd;
+    const int64_t n_embd_inp = hparams.n_embd_inp();
+    if (tok_embd->ne[0] != n_embd || n_embd_inp < n_embd) {
+        return false;
+    }
+
+    // build_inp_embd applies the embedding scale to the token path only when the model has no deepstack layer
+    if (hparams.n_deepstack_layers > 0) {
+        return false;
+    }
+
+    const ggml_type_traits * traits = ggml_get_type_traits(tok_embd->type);
+    if (tok_embd->type != GGML_TYPE_F32 && (!traits || !traits->to_float)) {
+        return false;
+    }
+
+    embd_lookup_buf.resize((size_t) batch.n_tokens * n_embd_inp);
+
+    for (int32_t i = 0; i < batch.n_tokens; i++) {
+        const llama_token token = batch.token[i];
+        if (token < 0 || token >= tok_embd->ne[1]) {
+            return false;  // the batch validation reports it
+        }
+
+        const char * src = (const char *) tok_embd->data + (size_t) token * tok_embd->nb[1];
+        float *      dst = embd_lookup_buf.data() + (size_t) i * n_embd_inp;
+
+        if (tok_embd->type == GGML_TYPE_F32) {
+            memcpy(dst, src, n_embd * sizeof(float));
+        } else {
+            traits->to_float(src, dst, n_embd);
+        }
+        if (n_embd_inp > n_embd) {
+            memset(dst + n_embd, 0, (n_embd_inp - n_embd) * sizeof(float));  // the token path pads with zeros
+        }
+    }
+
+    return true;
+}
