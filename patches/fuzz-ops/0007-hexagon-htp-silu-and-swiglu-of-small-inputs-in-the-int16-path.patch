diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 78a06ed..aa000f3 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -2211,6 +2211,73 @@ struct test_glu_split : public test_case {
     }
 };
 
+// SILU and SWIGLU (split) on small inputs. Row r of the input holds values in [-s, s] with
+// s = 2^-4 * 10^-(r % 8), thus the rows reach from 6.25e-2 down to 6.25e-9. The up input of SWIGLU
+// is in [0.5, 2]. The error is the largest relative error of one element, not the NMSE: the NMSE
+// of a tensor follows its largest rows, thus it does not see an error of 100 % in a row of small
+// values.
+struct test_silu_small : public test_case {
+    const bool swiglu;
+    const std::array<int64_t, 4> ne;
+
+    std::string vars() override {
+        return VARS_TO_STR2(swiglu, ne);
+    }
+
+    // The limit of the relative error of one element. A result of x in place of x/2 has the error 1.
+    // The int16 path of the Hexagon backend has a designed error of about 1e-5 in these rows, and an
+    // f16 path about 3e-7, thus the limit is 1e-3 and not the NMSE limit of 1e-7.
+    double max_nmse_err() override {
+        return 1e-3;
+    }
+
+    double err(const float * a, const float * b, size_t n) override {
+        double worst = 0.0;
+        for (size_t i = 0; i < n; i++) {
+            const double m = std::max(std::fabs((double) a[i]), std::fabs((double) b[i]));
+            if (m > 0.0) {
+                worst = std::max(worst, std::fabs((double) a[i] - (double) b[i]) / m);
+            }
+        }
+        return worst;
+    }
+
+    test_silu_small(bool swiglu = false, std::array<int64_t, 4> ne = {128, 16, 1, 1})
+        : swiglu(swiglu), ne(ne) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne.data());
+        ggml_set_name(a, "a");
+
+        ggml_tensor * out;
+        if (swiglu) {
+            ggml_tensor * b = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne.data());
+            ggml_set_name(b, "b");
+            out = ggml_swiglu_split(ctx, a, b);
+        } else {
+            out = ggml_silu(ctx, a);
+        }
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        std::mt19937 gen(0x51107);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            std::vector<float> v(ggml_nelements(t));
+            for (int64_t r = 0; r < ggml_nrows(t); r++) {
+                const float s = strcmp(t->name, "b") == 0 ? 0.0f : 0.0625f * std::pow(10.0f, (float) -(r % 8));
+                std::uniform_real_distribution<float> dis(s > 0.0f ? -s : 0.5f, s > 0.0f ? s : 2.0f);
+                for (int64_t j = 0; j < t->ne[0]; j++) {
+                    v[r * t->ne[0] + j] = dis(gen);
+                }
+            }
+            ggml_backend_tensor_set(t, v.data(), 0, v.size() * sizeof(float));
+        }
+    }
+};
