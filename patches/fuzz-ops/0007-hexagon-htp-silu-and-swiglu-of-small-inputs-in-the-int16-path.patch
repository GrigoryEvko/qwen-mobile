+struct hvx_act_i16_small {
+    HVX_Vector abs_mask;  // 0x7fffffff in each word
+    HVX_Vector bits;      // the f32 bits of 2^-4
+    HVX_Vector half;      // 0.5f
+    HVX_Vector quarter;   // 0.25f
