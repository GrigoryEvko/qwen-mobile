+// A check of a data value in a debug build (NaN, Inf, a zero sum). The value comes from the input
+// data and not from the code, thus a model or a test with a NaN or an Inf stops a debug build
+// that is otherwise correct. The checks are on only with GGML_CPU_VALUE_ASSERTS.
+#if defined(GGML_CPU_VALUE_ASSERTS)
+#define GGML_CPU_VALUE_ASSERT(x) assert(x)
+#else
+#define GGML_CPU_VALUE_ASSERT(x) ((void) 0)
+#endif
+
