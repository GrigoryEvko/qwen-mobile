diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index dc529a3..bb72e1c 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -5697,6 +5697,69 @@ struct test_soft_max : public test_case {
     }
 };
 
+// GGML_OP_SOFT_MAX with fully masked rows: the mask is -INFINITY in every column of the first and
+// the last row of each matrix, and 0 in the other rows. The result of a fully masked row is 0 in
+// every column (with a sink too), and the comparison fails on a NaN of either backend.
+struct test_soft_max_masked_row : public test_case {
+    const std::array<int64_t, 4> ne;
+    const ggml_type m_prec;
+    const bool sinks;
+
+    std::string vars() override {
+        return VARS_TO_STR3(ne, m_prec, sinks);
+    }
+
+    double max_nmse_err() override {
+        return 1e-6;
+    }
+
+    test_soft_max_masked_row(std::array<int64_t, 4> ne = {32, 4, 2, 1},
+            ggml_type m_prec = GGML_TYPE_F32,
+            bool sinks = false)
+        : ne(ne), m_prec(m_prec), sinks(sinks) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne.data());
+        ggml_set_name(a, "a");
+
+        ggml_tensor * mask = ggml_new_tensor(ctx, m_prec, 4, ne.data());
+        ggml_set_name(mask, "mask");
+
+        ggml_tensor * out = ggml_soft_max_ext(ctx, a, mask, 1.0f, 0.0f);
+        if (sinks) {
+            ggml_tensor * s = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ne[2]);
+            ggml_set_name(s, "sinks");
+            ggml_soft_max_add_sinks(out, s);
+        }
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "mask") != 0) {
+                init_tensor_uniform(t);
+                continue;
+            }
+            std::vector<float> m(ggml_nelements(t), 0.0f);
+            for (int64_t r = 0; r < ggml_nrows(t); r++) {
+                const int64_t i1 = r % t->ne[1];
+                if (i1 == 0 || i1 == t->ne[1] - 1) {
+                    std::fill(m.begin() + r*t->ne[0], m.begin() + (r + 1)*t->ne[0], -INFINITY);
+                }
+            }
+            if (t->type == GGML_TYPE_F16) {
+                std::vector<ggml_fp16_t> m16(m.size());
+                ggml_fp32_to_fp16_row(m.data(), m16.data(), (int64_t) m.size());
+                ggml_backend_tensor_set(t, m16.data(), 0, m16.size()*sizeof(ggml_fp16_t));
+            } else {
+                ggml_backend_tensor_set(t, m.data(), 0, m.size()*sizeof(float));
+            }
+        }
+    }
+};
