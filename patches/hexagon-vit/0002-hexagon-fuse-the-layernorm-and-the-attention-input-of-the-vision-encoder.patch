+// The op chains of a layer of the vision encoder of Qwen3-VL and Qwen3.5 (tools/mtmd/models/qwen3vl.cpp), on a
+// whole graph, thus a backend can fuse each chain:
+//   ln    the LayerNorm (NORM, MUL by the weight, ADD of the bias), then the QKV MUL_MAT and its bias ADD
+//   gelu  the MLP: the up MUL_MAT and its bias ADD, GELU, the down MUL_MAT and its bias ADD
+//   res   the second half of a layer: the residual ADD, the LayerNorm, the MLP of gelu and the residual ADD. Some
+//         channels of the residual have values of approximately 1e5, as the residual of the last layers of the 4B
+//         projector: a path that puts such a value into F16 (maximum 65504) gives inf and fails
+//   attn  the attention input: one M-RoPE of the vision mode over the Q and K heads of the QKV product, the F16
+//         casts of the permuted K and V views, and the flash attention with no mask
+//   qkv   the QKV MUL_MAT and its bias ADD, then the chain of attn. The MUL_MAT writes the QKV product just before
+//         the attention input reads it, as in the model: the bytes that the MUL_MAT leaves in the caches of the
+//         DSP are part of the test
+// The random values of each case are different in each run, and `rep` makes the same shape again with different
+// values. The test writes the error of each compared tensor.
+struct test_vit_block : public test_case {
+    const std::string mode;
+    const int64_t     d;     // the head size (attn, qkv) or the width of a token (ln, gelu, res)
+    const int64_t     h;     // the heads (attn, qkv) or the rows of the first weight (ln, gelu, res)
+    const int64_t     n;     // the tokens
+    const int64_t     grid;  // attn, qkv: the width of the patch grid of the positions
+    const int         rep;   // the index of a case with the same shape
+
+    ggml_tensor * ln_out   = nullptr;  // res: the tensors that the test compares
+    ggml_tensor * mlp_out  = nullptr;
+    ggml_tensor * res_out  = nullptr;
+
+    // res: the largest value of the residual
+    static constexpr float kResMax = 1e5f;
+
+    test_vit_block(std::string mode, int64_t d, int64_t h, int64_t n, int64_t grid = 16, int rep = 0)
+        : mode(std::move(mode)), d(d), h(h), n(n), grid(grid), rep(rep) {}
+
+    std::string vars() override {
+        return VARS_TO_STR6(mode, d, h, n, grid, rep);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "VIT_BLOCK";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    bool print_err() override { return true; }
+
+    std::vector<ggml_tensor *> fusion_test_nodes() override {
+        if (mode == "res") {
+            return { ln_out, mlp_out, res_out };
+        }
+        return {};
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        if (mode == "res") {
+            ggml_tensor * x  = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d, n);
+            ggml_tensor * a  = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d, n);
+            ggml_tensor * w  = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, d);
+            ggml_tensor * b  = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, d);
+            ggml_tensor * W1 = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, d, h);
+            ggml_tensor * B1 = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, h);
+            ggml_tensor * W2 = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, h, d);
+            ggml_tensor * B2 = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, d);
+            ggml_set_name(x, "resid");
+            ggml_set_name(a, "attn");
+            ggml_set_name(w, "ln_w");
+            ggml_set_name(b, "ln_b");
+            ggml_set_name(W1, "W1");
+            ggml_set_name(B1, "B1");
+            ggml_set_name(W2, "W2");
+            ggml_set_name(B2, "B2");
+            ggml_tensor * r = ggml_add(ctx, x, a);
+            ggml_set_name(r, "ffn_inp");
+            ln_out = ggml_add(ctx, ggml_mul(ctx, ggml_norm(ctx, r, 1e-6f), w), b);
+            ggml_set_name(ln_out, "ln");
+            ggml_tensor * up = ggml_add(ctx, ggml_mul_mat(ctx, W1, ln_out), B1);
+            mlp_out = ggml_add(ctx, ggml_mul_mat(ctx, W2, ggml_gelu(ctx, up)), B2);
+            ggml_set_name(mlp_out, "ffn_out");
+            res_out = ggml_add(ctx, r, mlp_out);
+            ggml_set_name(res_out, "out");
+            return res_out;
+        }
+        if (mode == "ln") {
+            ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d, n);
+            ggml_tensor * w = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, d);
+            ggml_tensor * b = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, d);
+            ggml_tensor * W = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, d, h);
+            ggml_tensor * B = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, h);
+            ggml_set_name(x, "x");
+            ggml_set_name(w, "ln_w");
+            ggml_set_name(b, "ln_b");
+            ggml_set_name(W, "W");
+            ggml_set_name(B, "B");
+            ggml_tensor * cur = ggml_add(ctx, ggml_mul(ctx, ggml_norm(ctx, x, 1e-6f), w), b);
+            ggml_set_name(cur, "ln");
+            ggml_tensor * out = ggml_add(ctx, ggml_mul_mat(ctx, W, cur), B);
+            ggml_set_name(out, "out");
+            return out;
+        }
+        if (mode == "gelu") {
+            ggml_tensor * x  = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d, n);
+            ggml_tensor * W1 = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, d, h);
+            ggml_tensor * B1 = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, h);
+            ggml_tensor * W2 = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, h, d);
+            ggml_tensor * B2 = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, d);
+            ggml_set_name(x, "x");
+            ggml_set_name(W1, "W1");
+            ggml_set_name(B1, "B1");
+            ggml_set_name(W2, "W2");
+            ggml_set_name(B2, "B2");
+            ggml_tensor * up = ggml_add(ctx, ggml_mul_mat(ctx, W1, x), B1);
+            ggml_tensor * g  = ggml_gelu(ctx, up);
+            ggml_set_name(g, "gelu");
+            ggml_tensor * out = ggml_add(ctx, ggml_mul_mat(ctx, W2, g), B2);
+            ggml_set_name(out, "out");
+            return out;
+        }
+        // attn and qkv: the views of qwen3vl.cpp over the QKV product [3 * h * d, n]
+        const int64_t embd = h * d;
+        ggml_tensor * qkv  = nullptr;
+        if (mode == "qkv") {
+            ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, embd, n);
+            ggml_tensor * W = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, embd, 3 * embd);
+            ggml_tensor * B = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 3 * embd);
+            ggml_set_name(x, "x");
+            ggml_set_name(W, "Wqkv");
+            ggml_set_name(B, "B");
+            qkv = ggml_add(ctx, ggml_mul_mat(ctx, W, x), B);
+        } else {
+            qkv = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 3 * embd, n);
+        }
+        ggml_tensor * pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 4 * n);
+        ggml_set_name(qkv, "qkv");
+        ggml_set_name(pos, "pos");
+        ggml_tensor * QK = ggml_view_3d(ctx, qkv, d, 2 * h, n, ggml_row_size(qkv->type, d), qkv->nb[1], 0);
+        ggml_tensor * V  = ggml_view_3d(ctx, qkv, d, h, n, ggml_row_size(qkv->type, d), qkv->nb[1],
+                                        ggml_row_size(qkv->type, 2 * embd));
+        int sections[4] = { (int) d / 4, (int) d / 4, (int) d / 4, (int) d / 4 };
+        QK = ggml_rope_multi(ctx, QK, pos, nullptr, (int) d / 2, sections, GGML_ROPE_TYPE_VISION, 32768, 10000, 1, 0, 1,
+                             32, 1);
+        ggml_set_name(QK, "qk_rope");
+        ggml_tensor * Q = ggml_view_3d(ctx, QK, d, h, n, QK->nb[1], QK->nb[2], 0);
+        ggml_tensor * K = ggml_view_3d(ctx, QK, d, h, n, QK->nb[1], QK->nb[2], (size_t) h * QK->nb[1]);
+        ggml_tensor * q = ggml_permute(ctx, Q, 0, 2, 1, 3);
+        ggml_tensor * k = ggml_cast(ctx, ggml_permute(ctx, K, 0, 2, 1, 3), GGML_TYPE_F16);
+        ggml_tensor * v = ggml_cast(ctx, ggml_permute(ctx, V, 0, 2, 1, 3), GGML_TYPE_F16);
+        ggml_tensor * out = ggml_flash_attn_ext(ctx, q, k, v, nullptr, 1.0f / std::sqrt((float) d), 0.0f, 0.0f);
+        ggml_prec_set_acc(out, GGML_PREC_F32);
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    // The weights have the range sqrt(3 / their input width), thus a product has about the range of its input.
+    // The positions are the rows and the columns of a patch grid, as the vision positions of mtmd.
+    // The input of qkv has the range 4: the logits then have a standard deviation of approximately 6, thus each
+    // query has a few large probabilities, as in the model. With the range 2 the softmax is almost flat, the output
+    // of a token is the mean of many V rows and is small, and the F16 rounding of K, V and the probabilities gives
+    // an NMSE of approximately 1e-3 at 2976 tokens.
+    // The residual of res: the range 2, and in three channels of each token a value of 2.5e4 to 1e5 (two positive
+    // channels, one negative channel), as the large channels of the residual of the model.
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            const std::string name = ggml_get_name(t);
+            if (name == "pos") {
+                std::vector<int32_t> p((size_t) 4 * n);
+                for (int64_t i = 0; i < n; i++) {
+                    p[i]         = (int32_t) (i / grid);
+                    p[i + n]     = (int32_t) (i % grid);
+                    p[i + 2 * n] = (int32_t) (i / grid);
+                    p[i + 3 * n] = (int32_t) (i % grid);
+                }
+                ggml_backend_tensor_set(t, p.data(), 0, p.size() * sizeof(int32_t));
+            } else if (name == "W" || name == "W1") {
+                const float a = std::sqrt(3.0f / (float) d);
+                init_tensor_uniform(t, -a, a);
+            } else if (name == "Wqkv") {
+                const float a = std::sqrt(3.0f / (float) (h * d));
+                init_tensor_uniform(t, -a, a);
+            } else if (name == "W2") {
+                const float a = std::sqrt(3.0f / (float) h);
+                init_tensor_uniform(t, -a, a);
+            } else if (name == "x" || name == "qkv") {
+                const float r = mode == "qkv" ? 4.0f : 2.0f;
+                init_tensor_uniform(t, -r, r);
+            } else if (name == "attn") {
+                init_tensor_uniform(t, -2.0f, 2.0f);
+            } else if (name == "resid") {
+                init_tensor_uniform(t, -2.0f, 2.0f);
+                std::vector<float> v((size_t) d * n);
+                ggml_backend_tensor_get(t, v.data(), 0, v.size() * sizeof(float));
+                std::mt19937                          gen(std::random_device{}());
+                std::uniform_real_distribution<float> u(0.25f, 1.0f);
+                const int64_t ch[3]  = { d / 7, d / 3, d - 5 };
+                const float   sgn[3] = { 1.0f, -1.0f, 1.0f };
+                for (int64_t i = 0; i < n; i++) {
+                    for (int c = 0; c < 3; c++) {
+                        v[(size_t) i * d + ch[c]] = sgn[c] * kResMax * u(gen);
+                    }
+                }
+                ggml_backend_tensor_set(t, v.data(), 0, v.size() * sizeof(float));
+            } else {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+
+    double max_nmse_err() override {
+        return 1e-3;
+    }
+};
