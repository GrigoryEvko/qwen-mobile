+// ---- HTP_OP_ROPE_QKV: the ROPE of Q and K and the F16 casts of K and V (refer to rope-ops.h) ----
+//
+// The unfused graph runs ROPE on the Q and K rows, then CPY of the permuted key view of the ROPE output to F16,
+// then CPY of the permuted V view to F16. This op reads the Q and K rows of a block of tokens with one DMA
+// transfer, rotates them in VTCM with the functions of the ROPE op (the same theta cache and
+// hvx_rope_neox_f32_aa), writes the ROPE output with one DMA transfer, and converts the key rows and the V rows
+// with hvx_vec_f32_to_f16 (the conversion of the CPY op). Thus the outputs have the bits of the three unfused ops.
+//
+// The bits of kp->io (rope-ops.h) select the path of V and of the F16 outputs. The ROPE op reads and writes with
+// DMA, and the CPY op reads and writes with HVX loads and stores through the caches. A DMA transfer bypasses L2,
+// and the range flush of the batch does not reach L2 on v79 (htp-tensor.c). Thus the path of a tensor decides
+// whether the op reads the bytes that the op before it left in L2. The preset value of the host (3) moves each
+// tensor with DMA, as the ROPE op moves its rows, and the flash attention reads K and V with DMA.
+//
+// The DMA queue of a thread runs its transfers in the order of the pushes. Block b uses the buffer set
+// b % n_sets. The inputs of block b + 2 go into the set (b + 2) % n_sets after the pushes of the outputs of b.
+// The pops follow the order of the pushes:
+//   in(0), in(1), out(0), in(2), out(1), in(3), ...
+// With 4 sets, the outputs of the block that last used a set are popped (done) before its new inputs go in.
+// Time: O(tokens * H * d) for each thread.
+
+struct htp_rope_qkv_context {
+    struct htp_rope_context                   rope;
+    const struct htp_rope_qkv_kernel_params * kp;
+    uint32_t                                  n_tok;   // N
+    uint32_t                                  n_head;  // H
+    uint32_t                                  d;       // the head size
+};
+
+// Push the Q and K rows (and with HTP_ROPE_QKV_IO_V_DMA the V rows) of the tokens [tb, tb + nt) into the buffer
+// set s.
+static inline void rope_qkv_push_in(dma_queue * q, uint8_t * base, const struct htp_rope_qkv_kernel_params * kp,
+                                    uint32_t s, const struct htp_tensor * qk, const struct htp_tensor * v, uint32_t tb,
+                                    uint32_t nt, size_t qk_bytes, size_t v_bytes) {
+    dma_queue_push(q, dma_make_ptr(base + kp->off_qk[s], (const uint8_t *) qk->data + (size_t) tb * qk->nb[2]), qk_bytes,
+                   qk->nb[2], qk_bytes, nt);
+    if (kp->io & HTP_ROPE_QKV_IO_V_DMA) {
+        dma_queue_push(q, dma_make_ptr(base + kp->off_v[s], (const uint8_t *) v->data + (size_t) tb * v->nb[1]), v_bytes,
+                       v->nb[1], v_bytes, nt);
+    }
+}
+
+static void rope_qkv_job(unsigned int nth, unsigned int ith, void * data) {
+    const struct htp_rope_qkv_context *       qc   = (const struct htp_rope_qkv_context *) data;
+    const struct htp_rope_context *           rctx = &qc->rope;
+    const struct htp_rope_qkv_kernel_params * kp   = qc->kp;
+    struct htp_ops_context *                  octx = rctx->octx;
+
+    const struct htp_tensor * qk   = octx->src[0];
+    const struct htp_tensor * psrc = octx->src[1];
+    const struct htp_tensor * v    = octx->src[3];
+    const struct htp_tensor * dqk  = octx->dsts[0];
+    const struct htp_tensor * dk   = octx->dsts[1];
+    const struct htp_tensor * dv   = octx->dsts[2];
+
+    const uint32_t N  = qc->n_tok;
+    const uint32_t H  = qc->n_head;
+    const uint32_t d  = qc->d;
+    const uint32_t t0 = ith * kp->tokens_per_thread;
+    const uint32_t t1 = MIN(t0 + kp->tokens_per_thread, N);
+    if (t0 >= t1) {
+        return;
+    }
+
+    const size_t   row_f32  = (size_t) d * sizeof(float);
+    const size_t   row_f16  = (size_t) d * sizeof(__fp16);
+    const size_t   qk_bytes = 2 * H * row_f32;
+    const size_t   v_bytes  = H * row_f32;
+    const uint32_t T        = kp->block;
+    const uint32_t n_blocks = (t1 - t0 + T - 1) / T;
+
+    uint8_t * const base  = octx->ctx->vtcm_base + (size_t) ith * kp->bytes_per_thread;
+    float * const   theta = (float *) (base + kp->off_theta);
+    dma_queue *     q     = octx->ctx->dma[ith];
+
+    struct htp_thread_trace * tr = &octx->ctx->trace[ith];
+    const int32_t *           pos = (const int32_t *) psrc->data;
+    const bool is_imrope = rctx->mode == HTP_ROPE_TYPE_IMROPE;
+    const bool is_vision = rctx->mode == HTP_ROPE_TYPE_VISION;
+    // VISION rotates the full row, the other modes the first n_dims values (as rope_job_f32)
+    const uint32_t ne = is_vision ? d : (uint32_t) rctx->n_dims;
+
+    const bool     v_dma   = (kp->io & HTP_ROPE_QKV_IO_V_DMA) != 0;
+    const bool     out_dma = (kp->io & HTP_ROPE_QKV_IO_OUT_DMA) != 0;
+    const uint32_t n_sets  = kp->n_sets;
+    const uint32_t n_out   = out_dma ? 3 : 1;  // the output transfers of one block
+
+    // The V rows of the block of a thread for the HVX loads: one prefetch of nt rows of H * d values
+    const uint32_t v_row = (uint32_t) (H * row_f32);
+
+    for (uint32_t b = 0; b < 2 && b < n_blocks; b++) {
+        const uint32_t tb = t0 + b * T;
+        rope_qkv_push_in(q, base, kp, b % n_sets, qk, v, tb, MIN(T, t1 - tb), qk_bytes, v_bytes);
+    }
+    if (!v_dma) {
+        hex_l2fetch((const uint8_t *) v->data + (size_t) t0 * v->nb[1], v_row, (uint32_t) v->nb[1], MIN(T, t1 - t0));
+    }
+
+    for (uint32_t b = 0; b < n_blocks; b++) {
+        const uint32_t s  = b % n_sets;
+        const uint32_t tb = t0 + b * T;
+        const uint32_t nt = MIN(T, t1 - tb);
+        if (b >= 2) {
+            for (uint32_t i = 0; i < n_out; i++) {
+                dma_queue_pop(q);  // the outputs of block b - 2
+            }
+        }
+        uint8_t * qk_buf = (uint8_t *) dma_queue_pop(q).dst;
+        uint8_t * v_buf  = v_dma ? (uint8_t *) dma_queue_pop(q).dst : NULL;
+        uint8_t * k16    = base + kp->off_k16[s];
+        uint8_t * v16    = base + kp->off_v16[s];
+        if (!v_dma && b + 1 < n_blocks) {
+            const uint32_t tn = tb + T;
+            hex_l2fetch((const uint8_t *) v->data + (size_t) tn * v->nb[1], v_row, (uint32_t) v->nb[1], MIN(T, t1 - tn));
+        }
+
+        htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, tb);
+        for (uint32_t j = 0; j < nt; j++) {
+            const uint32_t t = tb + j;
+            mrope_cache_init((float) pos[t], (float) pos[t + N], (float) pos[t + N * 2], (float) pos[t + N * 3],
+                             rctx->sections, is_imrope, is_vision, rctx->freq_scale, NULL, (float *) rctx->corr_dims, ne,
+                             rctx->ext_factor, rctx->attn_factor, theta, rctx->theta_scale, rctx->theta_powers,
+                             rctx->theta_scale_32);
+
+            float * rows = (float *) (qk_buf + (size_t) j * qk_bytes);
+            for (uint32_t r = 0; r < 2 * H; r++) {
+                float * row = rows + (size_t) r * d + rctx->n_offs;
+                hvx_rope_neox_f32_aa(row, row, ne, theta);
+            }
+            const uint8_t * v_tok = v_dma ? v_buf + (size_t) j * v_bytes : (const uint8_t *) v->data + (size_t) t * v->nb[1];
+            for (uint32_t h = 0; h < H; h++) {
+                const uint8_t * krow = (const uint8_t *) (rows + (size_t) (H + h) * d);
+                const uint8_t * vrow = v_tok + (size_t) h * row_f32;
+                if (out_dma) {
+                    hvx_copy_f16_f32_aa(k16 + ((size_t) h * T + j) * row_f16, krow, d);
+                    if (v_dma) {
+                        hvx_copy_f16_f32_aa(v16 + ((size_t) h * T + j) * row_f16, vrow, d);
+                    } else {
+                        hvx_copy_f16_f32_au(v16 + ((size_t) h * T + j) * row_f16, vrow, d);
+                    }
+                } else {
+                    uint8_t * kd = (uint8_t *) dk->data + (size_t) h * dk->nb[2] + (size_t) t * dk->nb[1];
+                    uint8_t * vd = (uint8_t *) dv->data + (size_t) h * dv->nb[2] + (size_t) t * dv->nb[1];
+                    hvx_copy_f16_f32_ua(kd, krow, d);
+                    hvx_copy_f16_f32_uu(vd, vrow, d);
+                }
+            }
+        }
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_COMP, tb);
+
+        dma_queue_push(q, dma_make_ptr((uint8_t *) dqk->data + (size_t) tb * dqk->nb[2], qk_buf), dqk->nb[2], qk_bytes,
+                       qk_bytes, nt);
+        if (out_dma) {
+            dma_queue_push(q, dma_make_ptr((uint8_t *) dk->data + (size_t) tb * dk->nb[1], k16), dk->nb[2], T * row_f16,
+                           nt * row_f16, H);
+            dma_queue_push(q, dma_make_ptr((uint8_t *) dv->data + (size_t) tb * dv->nb[1], v16), dv->nb[2], T * row_f16,
+                           nt * row_f16, H);
+        }
+
+        if (b + 2 < n_blocks) {
+            const uint32_t tn = t0 + (b + 2) * T;
+            rope_qkv_push_in(q, base, kp, (b + 2) % n_sets, qk, v, tn, MIN(T, t1 - tn), qk_bytes, v_bytes);
+        }
+    }
+
+    dma_queue_flush(q);
+    (void) nth;
+}
+
+int op_rope_qkv(struct htp_ops_context * octx) {
+    const struct htp_tensor * qk  = octx->src[0];
+    const struct htp_tensor * pos = octx->src[1];
+    const struct htp_tensor * v   = octx->src[3];
+    const struct htp_tensor * dqk = octx->dsts[0];
+    const struct htp_tensor * dk  = octx->dsts[1];
+    const struct htp_tensor * dv  = octx->dsts[2];
+
+    const struct htp_rope_qkv_kernel_params * kp = (const struct htp_rope_qkv_kernel_params *) octx->kernel_params;
+
+    // The layout of rope-ops.h. The host checks the same rules before it fuses the three ops.
+    if (!qk || !pos || !v || !dqk || !dk || !dv || octx->src[2] || qk->type != HTP_TYPE_F32 || v->type != HTP_TYPE_F32 ||
+        pos->type != HTP_TYPE_I32 || dqk->type != HTP_TYPE_F32 || dk->type != HTP_TYPE_F16 || dv->type != HTP_TYPE_F16) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    const uint32_t d = qk->ne[0];
+    const uint32_t H = qk->ne[1] / 2;
+    const uint32_t N = qk->ne[2];
+    if (d % 64 != 0 || qk->ne[1] != 2 * H || qk->ne[3] != 1 || qk->nb[0] != sizeof(float) || qk->nb[1] != d * sizeof(float) ||
+        v->ne[0] != d || v->ne[1] != N || v->ne[2] != H || v->ne[3] != 1 || v->nb[0] != sizeof(float) ||
+        v->nb[2] != d * sizeof(float) || pos->ne[0] != 4 * N ||
+        dqk->ne[0] != d || dqk->ne[1] != 2 * H || dqk->ne[2] != N || dqk->nb[1] != d * sizeof(float) ||
+        dqk->nb[2] != 2 * H * d * sizeof(float) ||
+        dk->ne[0] != d || dk->ne[1] != N || dk->ne[2] != H || dk->nb[1] != d * sizeof(__fp16) ||
+        dk->nb[2] != (size_t) N * d * sizeof(__fp16) ||
+        dv->ne[0] != d || dv->ne[1] != N || dv->ne[2] != H || dv->nb[1] != d * sizeof(__fp16) ||
+        dv->nb[2] != (size_t) N * d * sizeof(__fp16)) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if (kp->block == 0 || kp->block > HTP_ROPE_QKV_MAX_BLOCK || kp->tokens_per_thread == 0 ||
+        (uint64_t) kp->tokens_per_thread * kp->n_threads < N ||
+        kp->n_sets != ((kp->io & HTP_ROPE_QKV_IO_2SETS) ? 2u : (uint32_t) HTP_ROPE_QKV_MAX_SETS)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (octx->ctx->vtcm_size < kp->vtcm_size) {
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+    if (!htp_ops_context_set_n_threads(octx, kp->n_threads)) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+    if (octx->ctx->mdev.count > 1) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+
+    struct htp_rope_qkv_context qc;
+    memset(&qc, 0, sizeof(qc));
+    qc.rope.octx = octx;
+    rope_ctx_init_params(&qc.rope, &octx->op_params[0]);
+    // The fused op has the path of rope_job_f32 for the M-RoPE modes (MROPE, VISION, IMROPE): the cache of
+    // mrope_cache_init with the four positions of a token, and the NEOX pairs.
+    if ((qc.rope.mode & HTP_ROPE_TYPE_MROPE) == 0 || qc.rope.n_offs < 0 ||
+        (uint32_t) qc.rope.n_offs + (qc.rope.mode == HTP_ROPE_TYPE_VISION ? d : (uint32_t) qc.rope.n_dims) > d) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    qc.kp     = kp;
+    qc.n_tok  = N;
+    qc.n_head = H;
+    qc.d      = d;
+
+    if (!(octx->flags & HTP_OPFLAGS_SKIP_COMPUTE)) {
+        work_queue_run(octx->ctx->work_queue, rope_qkv_job, &qc, kp->n_threads);
+    }
+    return HTP_STATUS_OK;
+}
