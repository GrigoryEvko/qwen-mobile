+// The parameters of a ROPE op from its op params, and the powers of theta that the caches use. HTP_OP_ROPE and
+// HTP_OP_ROPE_QKV both call it, thus the two give the same thetas.
+static void rope_ctx_init_params(struct htp_rope_context * rctx, const int32_t * op_params) {
+    rctx->n_dims     = op_params[1];
+    rctx->mode       = op_params[2];
+    rctx->n_ctx_orig = op_params[4];
+    rctx->n_offs     = op_params[15];
+
+    memcpy(&rctx->freq_base,   op_params + 5,  sizeof(float));
+    memcpy(&rctx->freq_scale,  op_params + 6,  sizeof(float));
+    memcpy(&rctx->ext_factor,  op_params + 7,  sizeof(float));
+    memcpy(&rctx->attn_factor, op_params + 8,  sizeof(float));
+    memcpy(&rctx->beta_fast,   op_params + 9,  sizeof(float));
+    memcpy(&rctx->beta_slow,   op_params + 10, sizeof(float));
+    memcpy(&rctx->sections,    op_params + 11, sizeof(int) * 4);
+
+    rctx->theta_scale = powf(rctx->freq_base, -2.0f / rctx->n_dims);
+    rctx->theta_powers[0] = 1.0f;
+    for (int j = 1; j < 32; j++) {
+        rctx->theta_powers[j] = rctx->theta_powers[j - 1] * rctx->theta_scale;
+    }
+    rctx->theta_scale_32 = rctx->theta_powers[31] * rctx->theta_scale;
+
+    rope_corr_dims(rctx->n_dims, rctx->n_ctx_orig, rctx->freq_base, rctx->beta_fast, rctx->beta_slow, rctx->corr_dims);
+}
