diff --git a/ggml/src/ggml-hexagon/htp-vit-fusion.h b/ggml/src/ggml-hexagon/htp-vit-fusion.h
new file mode 100644
index 0000000..9e4829c
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp-vit-fusion.h
@@ -0,0 +1,411 @@
+// The graph match of two op chains of the vision encoder of Qwen3-VL and Qwen3.5 (host side). Refer to
+// htp/unary-ops.c (norm_mul_add_f32) and htp/rope-ops.c (op_rope_qkv) for the DSP ops.
+//
+//   ADD(MUL(NORM(x), w), b)                                -> HTP_OP_NORM_MUL_ADD (x, w, b)
+//   ROPE(QK), CPY(K view of the ROPE output -> F16),
+//   CPY(V view -> F16)                                     -> HTP_OP_ROPE_QKV (QK, positions, V)
+//
+// The first chain is the LayerNorm of each layer. The second chain is the attention input of each layer:
+// clip_graph::build_attn casts the permuted K and V views to F16 for the flash attention, and the graph of
+// Qwen3-VL (tools/mtmd/models/qwen3vl.cpp) runs one ROPE over the Q and K rows of the QKV product. Each DSP op
+// calls the vector functions of its unfused ops in their order, thus it gives the bits of the unfused ops (the
+// embeddings of the 4B projector on HTP0 v79 have the bits of the unfused graph).
+//
+// The fused op goes to the index of the last node of its chain. Thus it reads the inputs of the earlier nodes
+// later, and HTP_OP_ROPE_QKV writes the ROPE output and K later. As in htp-gate-fusion.h:
+//   - ggml_hexagon_vit_keep_inputs (graph_optimize, before ggml-alloc) asks the scheduler to keep each input
+//     allocated until the last node.
+//   - ggml_hexagon_vit_match_all (graph_compute) checks the bytes of the allocated graph: no node between the
+//     two indexes writes a byte of a moved input, or reads or writes a byte of a moved output.
+// The LayerNorm op does not write the NORM and the MUL results, thus the match rejects a chain when a node
+// outside it reads one of them.
+//
+// The switch: GGML_HEXAGON_FUSE_VIT holds the bits of the vision encoder plans (3, all bits, is the preset
+// value):
+//   1  HTP_OP_NORM_MUL_ADD
+//   2  HTP_OP_ROPE_QKV
+// GGML_HEXAGON_OPFUSION=0 disables each of them.
+//
+// The residual stream of the vision encoder has values of more than the F16 maximum (65504): the output of the
+// last layer of the 4B projector has values of approximately 9e4. Thus the fused ops keep the F32 of their
+// unfused ops, and no output of a fused op is F16 other than the F16 casts of K and V.
+
+#ifndef HTP_VIT_FUSION_H
+#define HTP_VIT_FUSION_H
+
+#include "htp-gdn-match.h"
+#include "htp-opnode.h"
+#include "htp/rope-ops.h"
+#include "htp/unary-ops.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+enum ggml_hexagon_vit_bits {
+    GGML_HEXAGON_VIT_LN       = 1,
+    GGML_HEXAGON_VIT_ROPE_QKV = 2,
+};
+
+// The bits of GGML_HEXAGON_FUSE_VIT. The process reads the variable one time.
+static inline unsigned ggml_hexagon_vit_bits() {
+    static const unsigned bits = [] {
+        const char * v = getenv("GGML_HEXAGON_FUSE_VIT");
+        return v ? (unsigned) strtoul(v, nullptr, 0) & 3u : 3u;
+    }();
+    return opt_opfusion > 0 ? bits : 0u;
+}
+
+// GGML_HEXAGON_VIT_QKV_IO: the bits HTP_ROPE_QKV_IO_* of htp/rope-ops.h for HTP_OP_ROPE_QKV. The preset value 3
+// moves V in and the F16 K and V out with DMA, with a ring of 4 buffer sets, as the ROPE op moves its rows.
+// The other values are for the op tests. The process reads the variable one time.
+static inline uint32_t ggml_hexagon_vit_qkv_io() {
+    static const uint32_t io = [] {
+        const char * v = getenv("GGML_HEXAGON_VIT_QKV_IO");
+        return v ? (uint32_t) strtoul(v, nullptr, 0) & 7u : HTP_ROPE_QKV_IO_V_DMA | HTP_ROPE_QKV_IO_OUT_DMA;
+    }();
+    return io;
+}
+
+struct ggml_hexagon_vit_match {
+    htp_op_code                opcode = HTP_OP_INVALID;
+    ggml_tensor *              out    = nullptr;  // the last node of the chain: the emit index
+    std::vector<ggml_tensor *> members;           // the replaced nodes in graph order
+    std::vector<ggml_tensor *> inter;             // the replaced nodes that the fused op does not write
+    std::vector<std::pair<ggml_tensor *, ggml_tensor *>> reads;   // each input and the member that reads it
+    std::vector<ggml_tensor *> late;              // the outputs that the fused op writes after their node
+    // NORM_MUL_ADD
+    ggml_tensor * x = nullptr, * w = nullptr, * b = nullptr;
+    // ROPE_QKV
+    ggml_tensor * rope = nullptr, * k16 = nullptr, * v16 = nullptr, * qk = nullptr, * pos = nullptr, * v = nullptr;
+};
+
+// An F32 op result that is not a view
+static inline bool ggml_hexagon_vit_is_op(const ggml_tensor * t, ggml_op op) {
+    return t && t->op == op && t->view_src == nullptr && t->type == GGML_TYPE_F32;
+}
+
+// One contiguous F32 row of n values
+static inline bool ggml_hexagon_vit_is_row(const ggml_tensor * t, int64_t n) {
+    return t && ggml_hexagon_gdn_is_f32_row(t, n) && ggml_is_contiguous(t);
+}
+
+// The LayerNorm chain that ends at the ADD `e`: ADD(MUL(NORM(x), w), b) with the operands in the order of
+// build_norm (clip.cpp): the NORM result is src0 of the MUL, the MUL result is src0 of the ADD. Returns nullptr
+// when the chain matches, or a short text for the first failed condition.
+static inline const char * ggml_hexagon_vit_ln_chain(ggml_tensor * e, ggml_hexagon_vit_match & m) {
+    m = ggml_hexagon_vit_match();
+    if (!ggml_hexagon_vit_is_op(e, GGML_OP_ADD) || !e->src[0] || !e->src[1]) {
+        return "not an F32 ADD";
+    }
+    ggml_tensor * M = e->src[0];
+    ggml_tensor * b = e->src[1];
+    if (!ggml_hexagon_vit_is_op(M, GGML_OP_MUL) || !M->src[0] || !M->src[1]) {
+        return "src0 of the ADD is not a MUL";
+    }
+    ggml_tensor * N = M->src[0];
+    ggml_tensor * w = M->src[1];
+    if (!ggml_hexagon_vit_is_op(N, GGML_OP_NORM) || !N->src[0]) {
+        return "src0 of the MUL is not a NORM";
+    }
+    ggml_tensor * x = N->src[0];
+    const int64_t n = e->ne[0];
+    if (x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || !ggml_is_contiguous(e) || !ggml_are_same_shape(x, e) ||
+        !ggml_are_same_shape(N, e) || !ggml_are_same_shape(M, e)) {
+        return "the rows are not contiguous F32 rows of one shape";
+    }
+    if (!ggml_hexagon_vit_is_row(w, n) || !ggml_hexagon_vit_is_row(b, n)) {
+        return "the weight or the bias is not one F32 row of the norm width";
+    }
+    m.opcode  = HTP_OP_NORM_MUL_ADD;
+    m.out     = e;
+    m.x       = x;
+    m.w       = w;
+    m.b       = b;
+    m.members = { N, M, e };
+    m.inter   = { N, M };
+    m.reads   = { { x, N }, { w, M }, { b, e } };
+    return nullptr;
+}
+
+// A CPY of an F32 source to a contiguous F16 tensor [d, N, H] (the cast of build_attn)
+static inline bool ggml_hexagon_vit_is_f16_cast(const ggml_tensor * t) {
+    return t && t->op == GGML_OP_CPY && t->src[0] && t->src[0]->type == GGML_TYPE_F32 && t->type == GGML_TYPE_F16 &&
+           ggml_is_contiguous(t) && ggml_are_same_shape(t, t->src[0]);
+}
+
+// The attention input chain that ends at the CPY `cv` (the F16 cast of V). The chain needs the ROPE and the CPY
+// of its key rows before `cv` in the graph (the index map gives the positions). Returns nullptr when it matches.
+static inline const char * ggml_hexagon_vit_qkv_chain(const ggml_cgraph * gf, ggml_tensor * cv,
+                                                      ggml_hexagon_vit_match & m) {
+    m = ggml_hexagon_vit_match();
+    if (!ggml_hexagon_vit_is_f16_cast(cv)) {
+        return "not a CPY of F32 to a contiguous F16 tensor";
+    }
+    const ggml_tensor * vs = cv->src[0];
+    const int64_t       d  = vs->ne[0];
+    const int64_t       N  = vs->ne[1];
+    const int64_t       H  = vs->ne[2];
+    if (d % 64 != 0 || vs->ne[3] != 1 || vs->nb[0] != sizeof(float) || vs->nb[2] != (size_t) d * sizeof(float) ||
+        vs->nb[1] < (size_t) (H * d) * sizeof(float)) {
+        return "V is not the permuted view of the V rows of a token";
+    }
+    // The ROPE whose key rows another CPY casts: the ROPE output is the root of the source of that CPY, and the
+    // ROPE reads a view of the tensor whose view V is (the QKV product of the same layer)
+    const ggml_tensor * v_root = cv->src[0]->view_src;
+    if (!v_root) {
+        return "V is not a view";
+    }
+    ggml_tensor * ck = nullptr;
+    ggml_tensor * R  = nullptr;
+    for (int i = 0; i < gf->n_nodes && !ck; i++) {
+        ggml_tensor * c = gf->nodes[i];
+        if (c == cv || !ggml_hexagon_vit_is_f16_cast(c) || !c->src[0]->view_src) {
+            continue;
+        }
+        ggml_tensor * r = c->src[0]->view_src;
+        if (ggml_hexagon_vit_is_op(r, GGML_OP_ROPE) && r->src[0] && r->src[0]->view_src == v_root &&
+            ggml_are_same_shape(c, cv)) {
+            ck = c;
+            R  = r;
+        }
+    }
+    if (!ck) {
+        return "no F16 cast of the key rows of a ROPE output";
+    }
+    ggml_tensor * qk  = R->src[0];
+    ggml_tensor * pos = R->src[1];
+    if (!qk || !pos || R->src[2] || qk->type != GGML_TYPE_F32 || pos->type != GGML_TYPE_I32) {
+        return "the ROPE has frequency factors or other types";
+    }
+    int32_t mode = 0;
+    memcpy(&mode, (const int32_t *) R->op_params + 2, sizeof(int32_t));
+    if ((mode & GGML_ROPE_TYPE_MROPE) == 0) {
+        return "the ROPE is not an M-RoPE mode";
+    }
+    if (qk->ne[0] != d || qk->ne[1] != 2 * H || qk->ne[2] != N || qk->ne[3] != 1 || qk->nb[0] != sizeof(float) ||
+        qk->nb[1] != (size_t) d * sizeof(float) || qk->nb[2] < (size_t) (2 * H * d) * sizeof(float) ||
+        pos->ne[0] != 4 * N || !ggml_is_contiguous(pos)) {
+        return "the Q and K rows are not the rows of the tokens";
+    }
+    if (!ggml_is_contiguous(R) || !ggml_are_same_shape(R, qk)) {
+        return "the ROPE output is not contiguous";
+    }
+    // The source of the key cast: the permuted view of the key heads of the ROPE output. The check uses the view
+    // offset and not the data address, because graph_optimize runs before ggml-alloc gives the tensors their data.
+    const ggml_tensor * ks = ck->src[0];
+    if (ks->ne[0] != d || ks->ne[1] != N || ks->ne[2] != H || ks->nb[0] != sizeof(float) || ks->nb[1] != R->nb[2] ||
+        ks->nb[2] != R->nb[1] || ks->view_src != R || ks->view_offs != (size_t) H * R->nb[1]) {
+        return "the key cast does not read the key heads of the ROPE output";
+    }
+    // The DMA of v73 and older has 16-bit strides (htp/dma-queue.h); the op moves the heads of K and V as rows
+    // with the stride N * d * 2, thus it runs on v75 and later only.
+    if (opt_arch < 75) {
+        return "the DMA of this core has 16-bit strides";
+    }
+    m.opcode  = HTP_OP_ROPE_QKV;
+    m.out     = cv;
+    m.rope    = R;
+    m.k16     = ck;
+    m.v16     = cv;
+    m.qk      = qk;
+    m.pos     = pos;
+    m.v       = cv->src[0];
+    m.members = { R, ck, cv };
+    m.reads   = { { qk, R }, { pos, R }, { m.v, cv } };
+    m.late    = { R, ck };
+    return nullptr;
+}
+
+// The checks of a chain in the graph of one split. Needs the data of the allocated graph.
+// O(nodes * (GGML_MAX_SRC + members)) for each chain.
+static inline const char * ggml_hexagon_vit_placement(const ggml_cgraph * gf,
+                                                      const std::unordered_map<const ggml_tensor *, int> & index,
+                                                      const std::vector<uint8_t> & skip, const ggml_hexagon_vit_match & m,
+                                                      int * emit) {
+    for (auto * t : m.members) {
+        auto it = index.find(t);
+        if (it == index.end()) {
+            return "a member is not a node of this split";
+        }
+        if (skip[it->second]) {
+            return "a member is part of a different fused op";
+        }
+        if (it->second > index.at(m.out)) {
+            return "a member comes after the last node";
+        }
+    }
+    *emit = index.at(m.out);
+
+    const char * reason = ggml_hexagon_gdn_chain_is_private(gf, m.inter, m.members, nullptr, 0);
+    if (reason) {
+        return reason;
+    }
+    for (const auto & rd : m.reads) {
+        if (!ggml_hexagon_gdn_move_is_safe(gf, *emit, index.at(rd.second), rd.first, false, m.members)) {
+            return "a node between the read of an input and the last node writes a byte of the input";
+        }
+    }
+    for (ggml_tensor * t : m.late) {
+        if (!ggml_hexagon_gdn_move_is_safe(gf, *emit, index.at(t), t, true, m.members)) {
+            return "a node between an output and the last node reads or writes a byte of the output";
+        }
+    }
+    // The outputs and the inputs share no byte
+    std::vector<const ggml_tensor *> outs, ins;
+    if (m.opcode == HTP_OP_NORM_MUL_ADD) {
+        outs = { m.out };
+        ins  = { m.x, m.w, m.b };
+    } else {
+        outs = { m.rope, m.k16, m.v16 };
+        ins  = { m.qk, m.pos, m.v };
+    }
+    for (const ggml_tensor * o : outs) {
+        for (const ggml_tensor * i : ins) {
+            if (ggml_hexagon_gdn_bytes_overlap(o, i)) {
+                return "an output shares bytes with an input";
+            }
+        }
+    }
+    for (size_t a = 0; a < outs.size(); a++) {
+        for (size_t c = a + 1; c < outs.size(); c++) {
+            if (ggml_hexagon_gdn_bytes_overlap(outs[a], outs[c])) {
+                return "two outputs share bytes";
+            }
+        }
+    }
+    return nullptr;
+}
+
+// Builds the fused op of a matched chain. False when the op does not fit in the VTCM.
+static inline bool ggml_hexagon_vit_make_node(const struct ggml_hexagon_session * sess, const ggml_hexagon_vit_match & m,
+                                              htp_opnode & node) {
+    if (m.opcode == HTP_OP_NORM_MUL_ADD) {
+        struct htp_unary_kernel_params kp;
+        ggml_hexagon_precompute_unary_params(sess, HTP_OP_NORM_MUL_ADD, m.x, m.w, m.out, &kp);
+        if (!ggml_hexagon_unary_has_rows(kp) || kp.col_tile != 0 || (size_t) kp.vtcm_size > sess->vtcm_size) {
+            return false;
+        }
+        kp.has_bias = 1;
+        // node.node is the NORM, thus the op params of the fused op are the params of the NORM (its epsilon)
+        node         = htp_opnode(HTP_OP_NORM_MUL_ADD, m.members[0]);
+        node.name    = "NORM_MUL_ADD";
+        node.inputs  = { m.x, m.w, m.b };
+        node.outputs = { m.out };
+        node.fused.assign(m.members.begin() + 1, m.members.end());
+        memcpy(node.kernel_params, &kp, sizeof(kp));
+        return true;
+    }
+
+    struct htp_rope_qkv_kernel_params kp;
+    memset(&kp, 0, sizeof(kp));
+    const uint32_t d = (uint32_t) m.qk->ne[0];
+    const uint32_t H = (uint32_t) (m.qk->ne[1] / 2);
+    const uint32_t N = (uint32_t) m.qk->ne[2];
+    if (!htp_rope_qkv_plan(&kp, d, H, N, (uint32_t) sess->n_threads, ggml_hexagon_vit_qkv_io(), sess->vtcm_size)) {
+        return false;
+    }
+    // node.node is the ROPE, thus the op params of the fused op are the params of the ROPE
+    node         = htp_opnode(HTP_OP_ROPE_QKV, m.rope);
+    node.name    = "ROPE_QKV";
+    node.inputs  = { m.qk, m.pos, nullptr, m.v };
+    node.outputs = { m.rope, m.k16, m.v16 };
+    node.fused   = { m.k16, m.v16 };
+    memcpy(node.kernel_params, &kp, sizeof(kp));
+    return true;
+}
+
+// graph_optimize: asks the scheduler to keep the inputs of each chain allocated until its last node. A weight is
+// not a tensor of ggml-alloc, thus it needs no such request. O(nodes * members) with the check of each chain.
+static inline void ggml_hexagon_vit_keep_inputs(ggml_cgraph * gf, ggml_backend_graph_optimize_params * params) {
+    const unsigned bits = ggml_hexagon_vit_bits();
+    if (!params || !params->add_alloc_dep || !(bits & (GGML_HEXAGON_VIT_LN | GGML_HEXAGON_VIT_ROPE_QKV))) {
+        return;
+    }
+    for (int i = 0; i < gf->n_nodes; i++) {
+        ggml_tensor *          e = gf->nodes[i];
+        ggml_hexagon_vit_match m;
+        const char *           reason = "no chain";
+        if ((bits & GGML_HEXAGON_VIT_LN) && e->op == GGML_OP_ADD) {
+            reason = ggml_hexagon_vit_ln_chain(e, m);
+        } else if ((bits & GGML_HEXAGON_VIT_ROPE_QKV) && e->op == GGML_OP_CPY) {
+            reason = ggml_hexagon_vit_qkv_chain(gf, e, m);
+        }
+        if (reason || ggml_hexagon_gdn_chain_is_private(gf, m.inter, m.members, nullptr, 0)) {
+            continue;
+        }
+        for (const auto & rd : m.reads) {
+            ggml_tensor *       t    = rd.first;
+            const ggml_tensor * root = ggml_hexagon_gdn_root(t);
+            if (root->buffer && ggml_backend_buffer_get_usage(root->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+                continue;
+            }
+            params->add_alloc_dep(params->user_data, t, m.out);
+        }
+    }
+}
+
+// graph_compute: matches the chains of one split. A matched chain puts its fused op at the index of its last node
+// into `at`, and marks each member in `skip`. The entries that `skip` and `at` already hold keep their nodes.
+// `name` and `verbose` are for the log. O(nodes^2) in the worst case: the key cast search of each V cast.
+static inline void ggml_hexagon_vit_match_all(const struct ggml_hexagon_session * sess, const ggml_cgraph * gf,
+                                              std::vector<uint8_t> & skip, std::unordered_map<int, htp_opnode> & at,
+                                              const char * name, bool verbose) {
+    const unsigned bits = ggml_hexagon_vit_bits();
+    if (!(bits & (GGML_HEXAGON_VIT_LN | GGML_HEXAGON_VIT_ROPE_QKV))) {
+        return;
+    }
+    const auto index = ggml_hexagon_gdn_index(gf);
+
+    for (int i = 0; i < gf->n_nodes; i++) {
+        ggml_tensor * e = gf->nodes[i];
+        if (skip[i] || (e->op != GGML_OP_ADD && e->op != GGML_OP_CPY)) {
+            continue;
+        }
+        ggml_hexagon_vit_match m;
+        const char *           reason = nullptr;
+        if (e->op == GGML_OP_ADD) {
+            if (!(bits & GGML_HEXAGON_VIT_LN)) {
+                continue;
+            }
+            reason = ggml_hexagon_vit_ln_chain(e, m);
+            if (reason && (!e->src[0] || e->src[0]->op != GGML_OP_MUL)) {
+                continue;  // not a candidate, no log line
+            }
+        } else {
+            if (!(bits & GGML_HEXAGON_VIT_ROPE_QKV) || !ggml_hexagon_vit_is_f16_cast(e) || e->src[0]->view_src == nullptr ||
+                e->src[0]->view_src->op == GGML_OP_ROPE) {
+                continue;  // the V cast reads a view of the QKV product, not of a ROPE output
+            }
+            reason = ggml_hexagon_vit_qkv_chain(gf, e, m);
+        }
+        int        emit = -1;
+        htp_opnode node;
+        if (!reason) {
+            reason = ggml_hexagon_vit_placement(gf, index, skip, m, &emit);
+        }
+        if (!reason && at.count(emit)) {
+            reason = "a different fused op has the same index";
+        }
+        if (!reason && !ggml_hexagon_vit_make_node(sess, m, node)) {
+            reason = "the op does not fit in the VTCM";
+        }
+        if (reason) {
+            if (verbose) {
+                GGML_LOG_DEBUG("ggml-hex: %s vit candidate %s (node %d): %s\n", name, e->name, i, reason);
+            }
+            continue;
+        }
+        for (auto * t : m.members) {
+            skip[index.at(t)] = 1;
+        }
+        if (verbose) {
+            GGML_LOG_DEBUG("ggml-hex: %s fused %s %s at node %d\n", name, node.name.c_str(), m.out->name, emit);
+        }
+        at.emplace(emit, std::move(node));
+    }
+}
