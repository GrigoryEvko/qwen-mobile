+// HTP_OP_ROPE_QKV: the attention input of the vision encoder in one op (refer to op_rope_qkv in rope-ops.c).
+//   src[0]  the Q and K rows of the tokens, F32 [d, 2H, N]: H query heads, then H key heads, each head a
+//           contiguous row of d values (nb1 = 4 d), nb2 the token stride
+//   src[1]  the positions, I32 [4 N]
+//   src[3]  the V rows, the permuted F32 view [d, N, H] with the heads of a token contiguous (nb2 = 4 d)
+//   dst[0]  the ROPE output, F32 [d, 2H, N], contiguous
+//   dst[1]  K, F16 [d, N, H], contiguous: the ROPE output of the key heads
+//   dst[2]  V, F16 [d, N, H], contiguous
+// Each thread takes a range of tokens in blocks of `block` tokens. The VTCM of a thread holds the theta cache
+// and a ring of buffer sets. A set holds the Q and K rows of the block (F32, one token after the other), and with
+// the matching bits of `io` the V rows of the block and the F16 K and V rows of the block (the rows of a head
+// together, thus one DMA row of a head is the block).
+//
+// The bits of `io` select how the op moves each tensor:
+//   HTP_ROPE_QKV_IO_V_DMA    the V rows come into VTCM with DMA. Without it, HVX loads read them from DDR.
+//   HTP_ROPE_QKV_IO_OUT_DMA  the F16 K and V rows go to DDR with DMA. Without it, HVX stores write them.
+//   HTP_ROPE_QKV_IO_2SETS    a ring of 2 sets: the inputs of block b + 2 go into the set of block b while the
+//                            outputs of block b can still be in flight. Without it, a ring of 4 sets.
+#define HTP_ROPE_QKV_MAX_BLOCK   32
+#define HTP_ROPE_QKV_MAX_SETS    4
+#define HTP_ROPE_QKV_IO_V_DMA    1u
+#define HTP_ROPE_QKV_IO_OUT_DMA  2u
+#define HTP_ROPE_QKV_IO_2SETS    4u
+
+struct htp_rope_qkv_kernel_params {
+    uint32_t n_threads;
+    uint32_t block;             // the tokens of one block of a thread
+    uint32_t tokens_per_thread;
+    uint32_t vtcm_size;         // all threads
+    uint32_t bytes_per_thread;
+    uint32_t io;                // the bits HTP_ROPE_QKV_IO_*
+    uint32_t n_sets;
+    uint32_t off_theta;         // the offsets in the VTCM region of a thread
+    uint32_t off_qk[HTP_ROPE_QKV_MAX_SETS];
+    uint32_t off_v[HTP_ROPE_QKV_MAX_SETS];
+    uint32_t off_k16[HTP_ROPE_QKV_MAX_SETS];
+    uint32_t off_v16[HTP_ROPE_QKV_MAX_SETS];
+};
+
+#if defined(__cplusplus)
+static_assert(sizeof(struct htp_rope_qkv_kernel_params) <= 128, "htp_rope_qkv_kernel_params is too large for kernel_params blob");
+#else
+_Static_assert(sizeof(struct htp_rope_qkv_kernel_params) <= 128, "htp_rope_qkv_kernel_params is too large for kernel_params blob");
+#endif
+
+// The plan of HTP_OP_ROPE_QKV for head size d (a multiple of 64), H heads, N tokens, n_threads threads and the
+// access bits io, in vtcm_size bytes. Returns false when no block of one token fits. O(1).
+static inline bool htp_rope_qkv_plan(struct htp_rope_qkv_kernel_params * kp, uint32_t d, uint32_t H, uint32_t N,
+                                     uint32_t n_threads, uint32_t io, size_t vtcm_size) {
+    if (d == 0 || d % 64 != 0 || H == 0 || N == 0 || n_threads == 0) {
+        return false;
+    }
+    const uint32_t threads   = n_threads < N ? n_threads : N;
+    const uint32_t n_sets    = (io & HTP_ROPE_QKV_IO_2SETS) ? 2 : HTP_ROPE_QKV_MAX_SETS;
+    const size_t   qk_bytes  = (size_t) 2 * H * d * sizeof(float);   // the Q and K rows of one token
+    const size_t   v_bytes   = (io & HTP_ROPE_QKV_IO_V_DMA) ? (size_t) H * d * sizeof(float) : 0;
+    const size_t   f16_bytes = (io & HTP_ROPE_QKV_IO_OUT_DMA) ? (size_t) H * d * 2 : 0;  // the F16 K (or V) rows
+    const size_t   theta     = hex_round_up((uint32_t) (d * sizeof(float)), 256);
+    const size_t   per_token = qk_bytes + v_bytes + 2 * f16_bytes;   // one set
+    const size_t   budget    = vtcm_size / threads;
+    if (budget <= theta + n_sets * per_token) {
+        return false;
+    }
+    const uint32_t per_thread = (N + threads - 1) / threads;
+    uint32_t       block      = (uint32_t) ((budget - theta) / (n_sets * per_token));
+    block = block < HTP_ROPE_QKV_MAX_BLOCK ? block : HTP_ROPE_QKV_MAX_BLOCK;
+    block = block < per_thread ? block : per_thread;
+
+    kp->n_threads         = threads;
+    kp->block             = block;
+    kp->tokens_per_thread = per_thread;
+    kp->io                = io;
+    kp->n_sets            = n_sets;
+    kp->off_theta         = 0;
+    uint32_t off          = (uint32_t) theta;
+    for (uint32_t s = 0; s < n_sets; s++) {
+        kp->off_qk[s]  = off; off += (uint32_t) (block * qk_bytes);
+        kp->off_v[s]   = off; off += (uint32_t) (block * v_bytes);
+        kp->off_k16[s] = off; off += (uint32_t) (block * f16_bytes);
+        kp->off_v16[s] = off; off += (uint32_t) (block * f16_bytes);
+    }
+    kp->bytes_per_thread = hex_round_up(off, 128);
+    kp->vtcm_size        = kp->bytes_per_thread * threads;
+    return kp->vtcm_size <= vtcm_size;
+}
+
 #endif // HTP_ROPE_OPS_H
