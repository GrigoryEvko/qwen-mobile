+// The GELU of the ggml CPU reference (ggml_gelu_f32 in ggml-cpu/vec.h):
+//   gelu(x) = 0.5 * x * (1 + tanh(sqrt(2/pi) * x * (1 + 0.044715 * x^2)))
+// The argument of tanh is clamped to [-10, 10]. tanh is 1.0 to 32-bit precision
+// past 10, thus the clamp only keeps the fast sigmoid in its exact range.
+static inline HVX_Vector hvx_vec_gelu_f32(HVX_Vector x) {
+    const HVX_Vector v_coef_a = hvx_vec_splat_f32(0.044715f);
+    const HVX_Vector v_s2pi   = hvx_vec_splat_f32(0.79788456080286535587989211986876f);
+    const HVX_Vector v_one    = hvx_vec_splat_f32(1.0f);
+    const HVX_Vector v_half   = hvx_vec_splat_f32(0.5f);
+    const HVX_Vector v_umax   = hvx_vec_splat_f32(10.0f);
+    const HVX_Vector v_umin   = hvx_vec_splat_f32(-10.0f);
+
+    HVX_Vector x2 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(x, x));
+    HVX_Vector u  = Q6_Vqf32_vmpy_VsfVsf(x2, v_coef_a);
+    u = Q6_Vqf32_vadd_Vqf32Vsf(u, v_one);
+    u = Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(u), x);
+    u = Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(u), v_s2pi);
+
+    HVX_Vector u_sf = Q6_Vsf_equals_Vqf32(u);
+    u_sf = Q6_Vsf_vmin_VsfVsf(u_sf, v_umax);
+    u_sf = Q6_Vsf_vmax_VsfVsf(u_sf, v_umin);
+
+    HVX_Vector th = hvx_vec_tanh_f32(u_sf);
+    HVX_Vector r  = Q6_Vqf32_vadd_VsfVsf(th, v_one);
+    r = Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(r), x);
+    r = Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(r), v_half);
+    return Q6_Vsf_equals_Vqf32(r);
+}
+
+#define hvx_gelu_loop_body(dst_type, src_type, vec_store)             \
+    do {                                                              \
+        dst_type * restrict vdst = (dst_type *) dst;                  \
+        src_type * restrict vsrc = (src_type *) src;                  \
+                                                                      \
+        const uint32_t epv  = 128 / sizeof(float);                    \
+        const uint32_t nvec = n / epv;                                \
+        const uint32_t nloe = n % epv;                                \
+                                                                      \
+        uint32_t i = 0;                                               \
+                                                                      \
+        _Pragma("unroll(4)")                                          \
+        for (; i < nvec; i++) {                                       \
+             vdst[i] = hvx_vec_gelu_f32(vsrc[i]);                     \
+        }                                                             \
+        if (nloe) {                                                   \
+             HVX_Vector tmp = hvx_vec_gelu_f32(vsrc[i]);              \
+             vec_store((void *) &vdst[i], nloe * sizeof(float), tmp); \
+        }                                                             \
+    } while(0)
+
+// gelu of n fp32 elements : source and destination are aligned to HVX Vector (128)
+static inline void hvx_gelu_f32_aa(uint8_t * restrict dst, const uint8_t * restrict src, uint32_t n) {
+    assert((unsigned long) dst % 128 == 0);
+    assert((unsigned long) src % 128 == 0);
+    hvx_gelu_loop_body(HVX_Vector, HVX_Vector, hvx_vec_store_a);
+}
