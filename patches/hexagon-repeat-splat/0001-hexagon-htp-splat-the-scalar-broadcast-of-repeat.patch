@@ -146,8 +196,20 @@ int op_repeat(struct htp_ops_context * octx) {
 
     const uint32_t n_threads = octx->n_threads;
 
+    // One source element per row and a contiguous destination row, thus the
+    // tile along dimension 0 is a splat and needs no memcpy for each element.
+    const bool splat = (src0->ne[0] == 1) && (dst->nb[0] == type_size);
