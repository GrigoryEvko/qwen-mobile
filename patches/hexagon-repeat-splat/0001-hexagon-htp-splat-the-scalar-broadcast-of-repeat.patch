+
+    // A broadcast of one element along dimension 0, which the MTP draft head
+    // uses to build the background of the scatter. The generic loop calls
+    // memcpy once for each destination element, thus a row of 248320 floats
+    // costs 5.4 ms. A typed store loop lets the compiler use HVX instead.
+    bool     splat;
+
+    // Destination elements per thread. The generic split gives one thread the
