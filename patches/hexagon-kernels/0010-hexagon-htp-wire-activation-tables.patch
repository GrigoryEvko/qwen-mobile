+            hvx_sigmoid_f32_aa(dst_local, src_local, ne0);
+        }
     }
 }
 
@@ -445,8 +450,13 @@
         const uint8_t * restrict src_local = (const uint8_t *)src + (ir * src0_row_size_aligned);
         uint8_t * restrict dst_local       = (uint8_t *)dst + (ir * dst_row_size_aligned);
 
-        hvx_sigmoid_f32_aa(dst_local, src_local, ne0);
-        hvx_mul_f32_aaa(dst_local, src_local, dst_local, ne0);
+        // One pass gives the SiLU. The two-pass form reads and writes the row twice.
+        if (htp_act_i16_mode) {
+            hvx_silu_i16_f32_aa(dst_local, src_local, ne0);
+        } else {
+            hvx_sigmoid_f32_aa(dst_local, src_local, ne0);
+            hvx_mul_f32_aaa(dst_local, src_local, dst_local, ne0);
+        }
