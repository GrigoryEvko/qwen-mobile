+// The path of the softplus op. 0 is the f32 path, which keeps its relative accuracy
+// everywhere. 1 is the int16 path, which is faster and whose relative error is unbounded below
+// x = -8. tools/htp-lab (target unary) measures the cycles and the error of each.
+#ifndef HTP_SOFTPLUS_I16_MODE
+#define HTP_SOFTPLUS_I16_MODE 0
+#endif
+static int htp_softplus_i16_mode = HTP_SOFTPLUS_I16_MODE;
+
 static void softplus_f32(const float * restrict src,
                          float * restrict dst,
                          const uint32_t num_rows,
                          const struct htp_unary_context * uctx) {
