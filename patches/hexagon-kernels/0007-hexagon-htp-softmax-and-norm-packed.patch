+// The number of vectors that the exponential and the sum carry at the same time. The exponential
+// is a chain of about 18 dependent operations, and a result is ready two packets after its
+// producer, thus one chain costs about four cycles for each operation and leaves the packets
+// almost empty. Four chains cover the latency and the loop becomes bound by the multiply, which
+// is one qf32 multiply per packet.
+#ifndef SM_X
+#define SM_X 4
+#endif
+
+// The exponential of SM_X vectors, in place: out may be in.
+//
+// THREE CHANGES AGAINST hvx_vec_exp_f32 OF hvx-exp.h, each chosen for this core.
+//
+// 1. THE RANGE REDUCTION USES THE FORCED MANTISSA, NOT floor AND truncate. The checkout calls
+//    hvx_vec_floor_f32 and then hvx_vec_truncate_f32 to get the integer part as a float and as
+//    an integer. Each of those takes the exponent apart with splats, compares, shifts and
+//    selects: together about 27 instructions and about 18 steps of the dependent chain, and the
+//    profile of the first version of this routine showed their vmux and vcmp packets as the
+//    worst stalls, above every multiply.
+//    An IEEE float of magnitude below 2^22 that is added to 1.5 * 2^23 lands in the binade
+//    [2^23, 2^24), where the unit in the last place is exactly 1, thus the add rounds the value
+//    to an integer and puts it in the low bits of the mantissa. Three instructions then give
+//    both forms: the integer is the bit pattern of the sum minus the bit pattern of the
+//    constant, and the float is the sum minus the constant. Here the argument of the reduction
+//    is x * log2(e) with |x| < 88, thus |t| < 128 and the trick holds with a wide margin.
+//    Checked over 4e6 points of [-88, 88]: the integer is equal to rint(t) at every point and
+//    the float is equal to (float) of that integer at every point.
+//
+// 2. THE REDUCTION ROUNDS TO NEAREST, THUS THE SERIES IS FAR MORE ACCURATE. The add above
+//    rounds to nearest, where the checkout rounds down. The reduced argument then lies in
+//    [-ln2/2, ln2/2] instead of [0, ln2), half as wide, and the same six terms of the Taylor
+//    series give a relative error of **7.0e-09** where the checkout gives 7.2e-07: one hundred
+//    times more accurate for the same number of multiplies. (Five terms would give 1.6e-07,
+//    still better than the checkout and one multiply cheaper. The accurate form is preferred.)
+//
+// 3. EACH STEP RUNS FOR ALL SM_X VECTORS BEFORE THE NEXT STEP. A result is ready two packets
+//    after its producer, thus one chain costs about four cycles for each of its steps and
+//    leaves the packets almost empty, which is what the checkout measures. Constants are splat
+//    where they are used, x lives in out[], and the square of the argument is built where it is
+//    consumed, thus the live set stays inside the 32 vector registers.
+static inline __attribute__((always_inline))
+void hvx_vec_exp_f32_xn(const HVX_Vector * restrict in, HVX_Vector * restrict out) {
+    const HVX_Vector zero = Q6_V_vzero();
+
+    HVX_Vector xq[SM_X], y[SM_X], k[SM_X], f[SM_X];
+
+    // clamp to (-88, 88). The clamped value lives in out[], which needs no array of its own,
+    // and every read of in[] ends in this loop, thus out may be in.
+    {
+        const HVX_Vector rng_r = Q6_V_vsplat_R(EXP_RANGE_R);
+        const HVX_Vector rng_l = Q6_V_vsplat_R(EXP_RANGE_L);
+        for (int r = 0; r < SM_X; r++) {
+            const HVX_VectorPred hi = Q6_Q_vcmp_gt_VsfVsf(in[r], rng_r);
+            const HVX_VectorPred lo = Q6_Q_vcmp_gt_VsfVsf(rng_l, in[r]);
+            out[r] = Q6_V_vmux_QVV(lo, rng_l, Q6_V_vmux_QVV(hi, rng_r, in[r]));
+        }
+    }
+    // m = x * log2(e) + 1.5 * 2^23, thus the mantissa of m holds the nearest integer
+    {
+        const HVX_Vector log2e = Q6_V_vsplat_R(EXP_LOG2E);
+        const HVX_Vector magic = Q6_V_vsplat_R(0x4b400000);   // 1.5 * 2^23
+        for (int r = 0; r < SM_X; r++) {
+            f[r] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vsf(Q6_Vqf32_vmpy_VsfVsf(log2e, out[r]), magic));
+        }
+        // the integer part, as an integer and as a float, in one subtract each
+        for (int r = 0; r < SM_X; r++) {
+            k[r] = Q6_Vw_vsub_VwVw(f[r], magic);
+        }
+        for (int r = 0; r < SM_X; r++) {
+            f[r] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vsub_VsfVsf(f[r], magic));
+        }
+    }
+    // xq = x - f * ln(2), the reduced argument in [-ln2/2, ln2/2]. x and f both die here.
+    {
+        const HVX_Vector logn2 = Q6_V_vsplat_R(EXP_LOGN2);
+        for (int r = 0; r < SM_X; r++) {
+            xq[r] = Q6_Vqf32_vsub_Vqf32Vqf32(Q6_Vqf32_vadd_VsfVsf(out[r], zero),
+                                             Q6_Vqf32_vmpy_VsfVsf(f[r], logn2));
+        }
+    }
+    for (int r = 0; r < SM_X; r++) {
+        xq[r] = Q6_Vqf32_vadd_Vqf32Vsf(xq[r], zero);   // normalize before the multiplies
+    }
+    // the Taylor series by Horner, six terms: y = E4 + E5 * x, then E3, E2, E1, E0
+    {
+        const HVX_Vector e5 = Q6_V_vsplat_R(EXP_COEFF_5);
+        for (int r = 0; r < SM_X; r++) {
+            y[r] = Q6_Vqf32_vmpy_VsfVsf(e5, Q6_Vsf_equals_Vqf32(xq[r]));
+        }
+    }
+    {
+        const HVX_Vector e4 = Q6_V_vsplat_R(EXP_COEFF_4);
+        for (int r = 0; r < SM_X; r++) {
+            y[r] = Q6_Vqf32_vadd_Vqf32Vsf(y[r], e4);
+        }
+    }
+#define SM_HORNER(coef)                                                                   \
+    for (int r = 0; r < SM_X; r++) {                                                      \
+        y[r] = Q6_Vqf32_vmpy_Vqf32Vqf32(y[r], xq[r]);                                     \
+    }                                                                                     \
+    {                                                                                     \
+        const HVX_Vector c = Q6_V_vsplat_R(coef);                                         \
+        for (int r = 0; r < SM_X; r++) {                                                  \
+            y[r] = Q6_Vqf32_vadd_Vqf32Vsf(y[r], c);                                       \
+        }                                                                                 \
+    }
+    SM_HORNER(EXP_COEFF_3)
+    SM_HORNER(EXP_COEFF_2)
+    SM_HORNER(EXP_COEFF_1)
+    SM_HORNER(EXP_COEFF_0)
+#undef SM_HORNER
+    // y = x + y * x^2, then y = y + 1. The square is built here, thus it never lives across the
+    // Horner evaluation and costs one register instead of SM_X.
+    for (int r = 0; r < SM_X; r++) {
+        const HVX_Vector z = Q6_Vqf32_vmpy_Vqf32Vqf32(xq[r], xq[r]);
+        y[r] = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_Vqf32_vmpy_Vqf32Vqf32(y[r], z), xq[r]);
+    }
+    {
+        const HVX_Vector one = Q6_V_vsplat_R(EXP_ONE);
+        for (int r = 0; r < SM_X; r++) {
+            y[r] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vsf(y[r], one));
+        }
+    }
+    // y = y * 2^k, by an add to the exponent field. A negative exponent gives zero.
+    for (int r = 0; r < SM_X; r++) {
+        HVX_Vector e = Q6_Vuw_vlsr_VuwR(Q6_Vw_vasl_VwR(y[r], 1), IEEE_VSF_MANTLEN + 1);
+        e            = Q6_Vw_vadd_VwVw(k[r], e);
+        const HVX_VectorPred neg = Q6_Q_vcmp_gt_VwVw(zero, e);
+        out[r] = Q6_V_vmux_QVV(neg, zero, Q6_Vw_vaslacc_VwVwR(y[r], k[r], IEEE_VSF_MANTLEN));
+    }
+}
