+               octx->ctx->mdev.count <= 1 &&
+               octx->ctx->vtcm_size >= (size_t) n_threads * CPY_T_VTCM) {
+        work_queue_run(octx->ctx->work_queue, cpy_thread_f32_transpose2d, &ct, n_threads);
     } else if (sametype) {
