+// Multiplies the S_v floats of the aligned row x by r = s / sqrt(max(a * sum(x^2) + b, c)), the factor
+// of the L2 norm of gdn-step.h. The lanes of the last vector past S_v stay out of the sum. O(S_v).
+static void gdn_qk_norm_row(float * restrict x, uint32_t S_v, const struct gdn_qk_norm * nrm) {
+    const uint32_t nvec = S_v / 32;
+    const uint32_t nloe = S_v % 32;
+
+    HVX_Vector acc = Q6_V_vzero();
+    for (uint32_t i = 0; i < nvec; ++i) {
+        const HVX_Vector v = hvx_vmem(x + i * 32);
+        acc = Q6_Vqf32_vadd_Vqf32Vqf32(acc, Q6_Vqf32_vmpy_VsfVsf(v, v));
+    }
+    if (nloe) {
+        const HVX_Vector v = Q6_V_vmux_QVV(Q6_Q_vsetq2_R(nloe * sizeof(float)), hvx_vmem(x + nvec * 32), Q6_V_vzero());
+        acc = Q6_Vqf32_vadd_Vqf32Vqf32(acc, Q6_Vqf32_vmpy_VsfVsf(v, v));
+    }
+    const float sum = hvx_vec_get_f32(hvx_vec_reduce_sum_f32(Q6_Vsf_equals_Vqf32(acc)));
+
+    float d = nrm->a * sum + nrm->b;
+    d = d > nrm->c ? d : nrm->c;
+    const HVX_Vector vr = hvx_vec_splat_f32(nrm->s / sqrtf(d));
+    for (uint32_t i = 0; i < nvec + (nloe ? 1 : 0); ++i) {
+        hvx_vmem(x + i * 32) = hvx_vec_mul_f32_f32(hvx_vmem(x + i * 32), vr);
+    }
+}
