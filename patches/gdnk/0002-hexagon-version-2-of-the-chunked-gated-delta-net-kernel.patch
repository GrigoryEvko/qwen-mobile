+#include "htp-gdn-params.h"
+
+// The L2 norm of q and k that the op applies when it loads them. The graph normalizes each head
+// of q and k before the op: L2_NORM(x, eps), or SCALE(RMS_NORM(x, eps / n), 1 / sqrt(n)) as
+// build_gdn_l2_norm makes it. The host removes those ops and gives the op the raw rows and these
+// four values. The factor of one head row x is
+//   r = s / sqrt(max(a * sum(x^2) + b, c))
+// thus L2_NORM is (a, b, c, s) = (1, 0, eps^2, 1), and SCALE(RMS_NORM) is (1 / n, eps / n, 0, 1 / sqrt(n)).
+struct gdn_qk_norm {
+    float a;
+    float b;
+    float c;
+    float s;
+};
+
+// The kernel params of the norm, from HTP_GDN_KP_QKNORM on (htp-gdn-params.h): params[0] is 1 when
+// the op normalizes q and k, and params[1..4] hold the bits of a, b, c and s. Returns true and fills
+// n when the op normalizes.
+static inline bool gdn_qk_norm_from_params(const int32_t * params, struct gdn_qk_norm * n) {
+    if (params[0] != 1) {
+        return false;
+    }
+    memcpy(&n->a, &params[1], sizeof(float));
+    memcpy(&n->b, &params[2], sizeof(float));
+    memcpy(&n->c, &params[3], sizeof(float));
+    memcpy(&n->s, &params[4], sizeof(float));
+    return true;
+}
 
