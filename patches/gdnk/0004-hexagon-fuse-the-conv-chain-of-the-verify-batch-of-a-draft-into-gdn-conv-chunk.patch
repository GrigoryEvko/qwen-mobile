@@ -7060,6 +7060,34 @@ static bool is_mergeable_mul_mat_id_pair(const ggml_tensor * n1, const ggml_tens
 // The checks are in htp-gdn-match.h (ggml only, thus a host program can run them on a graph). This part
 // builds the fused ops and logs the first failed condition of each candidate chain.
 
+// graph_optimize: the fused conv chain (GDN_CONV_STEP, GDN_CONV_CHUNK) reads the projection of the tokens
+// while it writes its output, thus the matcher refuses a chain whose projection and output share bytes.
+// In the unfused chain the CONCAT is the last reader of the projection, and ggml-alloc can give those
+// bytes to the SSM_CONV or to the SILU. The verify batch of a draft gets such an allocation. This asks
+// the scheduler to keep the projection allocated until the SILU, the output of the chain. A projection in
+// a weight buffer is not a tensor of ggml-alloc. O(nodes).
+static void ggml_hexagon_gdn_conv_keep_inputs(ggml_cgraph * gf, ggml_backend_graph_optimize_params * params) {
+    if (!params || !params->add_alloc_dep || !ggml_hexagon_is_gdn_state_fusion_enabled()) {
+        return;
+    }
+    for (int i = 0; i < gf->n_nodes; i++) {
+        ggml_tensor * S = gf->nodes[i];
+        if (!ggml_hexagon_gdn_is_conv_candidate(S)) {
+            continue;
+        }
+        ggml_tensor * CI = S->src[0]->src[0];
+        if (!CI || CI->op != GGML_OP_CONCAT || !CI->src[1]) {
+            continue;
+        }
+        ggml_tensor *       xt   = CI->src[1];
+        const ggml_tensor * root = ggml_hexagon_gdn_root(xt);
+        if (root->buffer && ggml_backend_buffer_get_usage(root->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+            continue;
+        }
+        params->add_alloc_dep(params->user_data, xt, S);
+    }
+}
+
 struct ggml_hexagon_gdn_fusion {
     std::vector<uint8_t>                          skip;       // graph index -> the node is replaced by a fused op
     std::unordered_map<int, htp_opnode>           at;         // graph index -> the fused op emitted at that index
@@ -7659,6 +7687,7 @@ static void ggml_backend_hexagon_graph_optimize(ggml_backend_t backend, ggml_cgr
     if (opt_opfusion > 0) {
         ggml_hexagon_gate_keep_inputs(gf, params);
     }
+    ggml_hexagon_gdn_conv_keep_inputs(gf, params);
 
     GGML_UNUSED(backend);
 }
