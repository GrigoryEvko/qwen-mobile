+// ---- the DMA path of the conv over a batch
+//
+// The path above reads each token row of x with vector loads from DDR through the L2 and writes y the
+// same way. Its HVX work is small, and the loads that wait for the DDR take most of its time. This path
+// moves the rows with the DMA instead. For a block of GDN_CONV_DMA_B tokens, one 2D transfer brings the
+// channels of the thread from each token row of x into VTCM, the bands compute from VTCM into VTCM, and
+// one 2D transfer writes the block to y. Two buffers of each kind let the transfers of the next block
+// and of the previous block run while the bands compute.
+//
+// The threads get whole 64-channel units, thus every channel goes through the packed path. When the
+// channel count has an odd 32-channel block, the last thread gets it, padded to a unit. The pad lanes
+// of the VTCM rows are zero and the DMA to y does not write them.
+//
+// The DMA queue of a thread is in order, thus the pops name no buffer: before block b the thread pops
+// the write of block b - 2 and the read of block b.
+
+#define GDN_CONV_DMA_B 36 // the preset tokens of one block, a multiple of the band height 3
+
+struct gdn_conv_dma_span {
+    uint32_t c0;    // the first channel of the thread
+    uint32_t n;     // the channels of the thread
+    uint32_t n_pad; // n rounded up to a unit of 64 channels
+};
+
+// The channels of thread ith: whole units, the remainder units to the first threads, the odd block to
+// the last thread. O(1).
+static inline struct gdn_conv_dma_span gdn_conv_dma_span_of(uint32_t n_ch, uint32_t nth, uint32_t ith) {
+    const uint32_t units = n_ch / (2 * VLEN_FP32);
+    const uint32_t odd   = (n_ch / VLEN_FP32) % 2;
+    const uint32_t base  = units / nth;
+    const uint32_t rem   = units % nth;
+    const uint32_t u0    = ith * base + (ith < rem ? ith : rem);
+    const uint32_t cnt   = base + (ith < rem ? 1 : 0);
+
+    struct gdn_conv_dma_span s;
+    s.c0    = u0 * 2 * VLEN_FP32;
+    s.n     = cnt * 2 * VLEN_FP32 + ((ith == nth - 1 && odd) ? VLEN_FP32 : 0);
+    s.n_pad = hex_round_up(s.n, 2 * VLEN_FP32);
+    return s;
+}
+
+// The VTCM bytes of one thread for n_pad channels and blocks of b tokens: the weight and state planes
+// in f32 (7 rows), their f16 forms (7 half rows), and two x and two y blocks.
+static inline size_t gdn_conv_dma_vtcm_bytes(uint32_t n_pad, uint32_t b) {
+    return (size_t) n_pad * (7 * sizeof(float) + 7 * sizeof(__fp16)) + (size_t) 4 * b * n_pad * sizeof(float);
+}
+
+static void gdn_conv_chunk_dma_thread(unsigned int nth, unsigned int ith, void * data) {
+    struct htp_gdn_conv_chunk_context * cctx = (struct htp_gdn_conv_chunk_context *) data;
+    struct htp_ops_context *            octx = cctx->octx;
+
+    const struct gdn_conv_dma_span sp = gdn_conv_dma_span_of(cctx->n_ch, nth, ith);
+    if (sp.n == 0) {
+        return;
+    }
+    const uint32_t c0    = sp.c0;
+    const uint32_t n     = sp.n;
+    const uint32_t n_pad = sp.n_pad;
+    const uint32_t nb    = n / VLEN_FP32;         // the real 32-channel blocks
+    const uint32_t units = n_pad / (2 * VLEN_FP32);
+    const uint32_t T     = cctx->n_tokens;
+    const uint32_t B     = cctx->dma_block;
+
+    struct gdn_conv_masks mk __attribute__((aligned(VLEN)));
+    gdn_conv_masks_init(&mk);
+
+    uint8_t * base = cctx->vtcm + cctx->vtcm_per_thread * ith;
+    float *   wt   = (float *) base;                   // [4][n_pad] the weight planes
+    float *   st   = wt + 4 * n_pad;                   // [3][n_pad] the state planes
+    __fp16 *  wh   = (__fp16 *) (st + 3 * n_pad);      // [4][n_pad] the f16 weight planes
+    __fp16 *  hist = wh + 4 * n_pad;                   // [3][n_pad] the last 3 rows as f16
+    float *   xbuf[2];
+    float *   ybuf[2];
+    xbuf[0] = (float *) (hist + 3 * n_pad);
+    xbuf[1] = xbuf[0] + (size_t) B * n_pad;
+    ybuf[0] = xbuf[1] + (size_t) B * n_pad;
+    ybuf[1] = ybuf[0] + (size_t) B * n_pad;
+
+    const float * w_ptr = cctx->w + (size_t) c0 * GDN_CONV_D_CONV;
+    const float * s_ptr = cctx->src_slot + (size_t) c0 * (GDN_CONV_D_CONV - 1);
+
+    struct htp_thread_trace * tr = &octx->ctx->trace[ith];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) c0);
+
+    dma_queue * dma = octx->ctx->dma[ith];
+
+    const size_t x_row   = (size_t) cctx->x_stride * sizeof(float);
+    const size_t y_row   = (size_t) cctx->y_stride * sizeof(float);
+    const size_t v_row   = (size_t) n_pad * sizeof(float);
+    const size_t n_bytes = (size_t) n * sizeof(float);
+    const uint32_t n_blk = (T + B - 1) / B;
+
+    // The first two blocks of x go on their way before the planes, thus the prologue hides their wait
+    for (uint32_t b = 0; b < 2 && b < n_blk; b++) {
+        const uint32_t t0 = b * B;
+        const uint32_t bb = MIN(B, T - t0);
+        dma_queue_push(dma, dma_make_ptr(xbuf[b], cctx->x + (size_t) t0 * cctx->x_stride + c0), v_row, x_row, n_bytes, bb);
+    }
+
+    // The planes of the weights and of the state. The pad block of an odd channel count is zero.
+    const HVX_Vector zero = Q6_V_vzero();
+    for (uint32_t i = 0; i < n_pad / VLEN_FP32; i++) {
+        HVX_Vector p0 = zero, p1 = zero, p2 = zero, p3 = zero;
+        HVX_Vector s0 = zero, s1 = zero, s2 = zero;
+        if (i < nb) {
+            gdn_conv_deal4(hvx_vmemu(w_ptr + i * 128), hvx_vmemu(w_ptr + i * 128 + 32),
+                           hvx_vmemu(w_ptr + i * 128 + 64), hvx_vmemu(w_ptr + i * 128 + 96),
+                           &p0, &p1, &p2, &p3);
+            HVX_Vector c[4];
+            gdn_conv_lanes_to_c(&mk, hvx_vmemu(s_ptr + i * 96), hvx_vmemu(s_ptr + i * 96 + 32),
+                                hvx_vmemu(s_ptr + i * 96 + 64), zero, c);
+            HVX_Vector s3;
+            gdn_conv_deal4(c[0], c[1], c[2], c[3], &s0, &s1, &s2, &s3);
+        }
+        hvx_vmem(wt + 0 * n_pad + i * VLEN_FP32) = p0;
+        hvx_vmem(wt + 1 * n_pad + i * VLEN_FP32) = p1;
+        hvx_vmem(wt + 2 * n_pad + i * VLEN_FP32) = p2;
+        hvx_vmem(wt + 3 * n_pad + i * VLEN_FP32) = p3;
+        hvx_vmem(st + 0 * n_pad + i * VLEN_FP32) = s0;
+        hvx_vmem(st + 1 * n_pad + i * VLEN_FP32) = s1;
+        hvx_vmem(st + 2 * n_pad + i * VLEN_FP32) = s2;
+    }
+    for (uint32_t u = 0; u < units; u++) {
+        const uint32_t o = u * 2 * VLEN_FP32;
+        for (uint32_t j = 0; j < 4; j++) {
+            hvx_vmem(wh + (size_t) j * n_pad + o) =
+                hvx_vec_f32_to_f16_shuff(hvx_vmem(wt + j * n_pad + o), hvx_vmem(wt + j * n_pad + o + VLEN_FP32));
+        }
+        for (uint32_t k = 0; k < 3; k++) {
+            hvx_vmem(hist + (size_t) k * n_pad + o) =
+                hvx_vec_f32_to_f16_shuff(hvx_vmem(st + k * n_pad + o), hvx_vmem(st + k * n_pad + o + VLEN_FP32));
+        }
+    }
+
+    // The pad lanes of the x rows stay zero: the DMA writes the first n floats of each row only. The pad
+    // of a row is the one vector after those n floats, thus these stores and the DMA in flight write
+    // different bytes.
+    if (n_pad != n) {
+        for (uint32_t k = 0; k < 2; k++) {
+            for (uint32_t r = 0; r < B; r++) {
+                hvx_vmem(xbuf[k] + (size_t) r * n_pad + n) = zero;
+            }
+        }
+    }
+
+    for (uint32_t b = 0; b < n_blk; b++) {
+        const uint32_t t0 = b * B;
+        const uint32_t bb = MIN(B, T - t0);
+        float * xb = xbuf[b & 1];
+        float * yb = ybuf[b & 1];
+
+        if (b >= 2) {
+            dma_queue_pop(dma); // the write of block b - 2, which used yb
+        }
+        dma_queue_pop(dma);     // the read of block b into xb
+
+        // The band height 3 of the path above. The kernel lab measured the height 2 on this path within
+        // 1 % of it (tools/htp-lab, target gdnconvdma).
+        uint32_t r = 0;
+        for (; r + 3 <= bb; r += 3) {
+            gdn_conv_band_vtcm_3(xb + (size_t) r * n_pad, n_pad, yb + (size_t) r * n_pad, n_pad, hist, wh, n_pad, units);
+        }
+        for (; r < bb; r++) {
+            gdn_conv_band_vtcm_1(xb + (size_t) r * n_pad, n_pad, yb + (size_t) r * n_pad, n_pad, hist, wh, n_pad, units);
+        }
+
+        dma_queue_push(dma, dma_make_ptr(cctx->y + (size_t) t0 * cctx->y_stride + c0, yb), y_row, v_row, n_bytes, bb);
+        if (b + 2 < n_blk) {
+            const uint32_t t2 = (b + 2) * B;
+            const uint32_t b2 = MIN(B, T - t2);
+            dma_queue_push(dma, dma_make_ptr(xb, cctx->x + (size_t) t2 * cctx->x_stride + c0), v_row, x_row, n_bytes, b2);
+        }
+    }
+    dma_queue_flush(dma);
+
+    // The snapshot slots, as in gdn_conv_chunk_thread: the walk reads the last token rows from DDR
+    float * d_ptr = cctx->dst_slot + (size_t) c0 * (GDN_CONV_D_CONV - 1);
+    const uint32_t n_slots = cctx->n_slots;
+    const uint32_t warm    = GDN_CONV_D_CONV - 2;
+    const bool     late    = T >= n_slots + warm;
