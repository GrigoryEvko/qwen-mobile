@@ -34,6 +43,7 @@ static void test_barrier(int n_threads, int n_rounds) {
     }
 
     ggml_build_forward_expand(gf, out);
+    zero_tensors(ctx);
     int n_nodes = ggml_graph_n_nodes(gf);
 
     // Create threadpool
@@ -102,6 +112,7 @@ static void test_active(int n_threads, int n_rounds) {
     }
 
