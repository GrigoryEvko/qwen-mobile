+// The +, - or * (op) of two integers. The double path loses the exact value past 2^53, and the cast
+// of a result outside int64_t back to an integer is undefined. Python gives a larger integer, which
+// int64_t cannot hold, thus a result outside int64_t is an error.
+static int64_t int_arith(char op, int64_t a, int64_t b) {
+    bool overflow = false;
+    if (op == '+') {
+        overflow = (b > 0 && a > INT64_MAX - b) || (b < 0 && a < INT64_MIN - b);
+    } else if (op == '-') {
+        overflow = (b < 0 && a > INT64_MAX + b) || (b > 0 && a < INT64_MIN + b);
+    } else if (a != 0 && b != 0) {
+        overflow = a > 0 ? (b > 0 ? a > INT64_MAX / b : b < INT64_MIN / a)
+                         : (b > 0 ? a < INT64_MIN / b : b < INT64_MAX / a);
+    }
+    if (overflow) {
+        throw std::runtime_error("Integer overflow: " + std::to_string(a) + " " + op + " " + std::to_string(b) +
+                                 " is outside the 64-bit integer range");
+    }
+    return op == '+' ? a + b : op == '-' ? a - b : a * b;
+}
+
+// The % of two integers, with the sign of the dividend, as the fmod of the float path. Jinja raises
+// ZeroDivisionError for a zero divisor. INT64_MIN % -1 is undefined in C++, and its value is 0.
+static int64_t int_mod(int64_t a, int64_t b) {
+    if (b == 0) {
+        throw std::runtime_error("Integer modulo by zero");
+    }
+    return b == -1 ? 0 : a % b;
+}
