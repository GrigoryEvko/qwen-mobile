+// ============================================================================
+// Q8_0 K and V rows into the HMX tiles
+// ============================================================================
+
+// The Q8_0 rows [start_row, end_row) of a K block (rows of src_stride bytes in VTCM) into the
+// transposed K tiles: the tiles of hvx_dequantize_row_q8_0_f16 on each row followed by
+// hmx_interleave_rows_to_tiles, for k a multiple of 64. Each vector of 64 values comes from two
+// Q8_0 blocks, thus the rows need no F16 copy in VTCM. The pair loop has no branch (an odd last
+// row has its own loop) and unrolls, thus the chains of the two rows interleave in the packets.
+static inline void fa_q8_0_rows_to_tiles(__fp16 * restrict vtcm_dst,
+                                         const uint8_t * restrict src,
+                                         uint32_t n_cols,
+                                         uint32_t k,
+                                         size_t src_stride,
+                                         uint32_t start_row,
+                                         uint32_t end_row) {
+    assert(k % 64 == 0);
+
+    const uint32_t   n_k_tiles   = k / HMX_FP16_TILE_N_COLS;
+    const HVX_Vector v_scat_base = hvx_vmem(hmx_transpose_scatter_offsets);
+    const HVX_Vector v_scat_step = Q6_V_vsplat_R(4);
+    const size_t     pair_region = (size_t) (2 * HMX_FP16_TILE_SIZE - 1);
+    const size_t     dst_step    = 2 * (size_t) HMX_FP16_TILE_N_ELMS;
+    const uint32_t   n_pairs     = k / 64;
+    const size_t     pair_bytes  = 2 * sizeof(block_q8_0);
+
+    for (uint32_t r = start_row; r < end_row; r += 2) {
+        const uint32_t   ct             = r / HMX_FP16_TILE_N_ROWS;
+        const uint32_t   local_r        = r % HMX_FP16_TILE_N_ROWS;
+        const bool       next_row_valid = (r + 1) < end_row && (r + 1) < n_cols;
+        const HVX_Vector v_off0         = Q6_Vw_vadd_VwVw(v_scat_base, Q6_V_vsplat_R(local_r * 4));
+        const HVX_Vector v_off1         = Q6_Vw_vadd_VwVw(v_off0, v_scat_step);
+
+        __fp16 *        tile_base = vtcm_dst + (size_t) ct * n_k_tiles * HMX_FP16_TILE_N_ELMS;
+        const uint8_t * p0        = src + (size_t) r * src_stride;
+        const uint8_t * p1        = p0 + src_stride;
+
+        if (next_row_valid) {
+#pragma clang loop unroll_count(4)
+            for (uint32_t i = 0; i < n_pairs; ++i) {
+                const HVX_Vector v0 = hvx_dequantize_pair_q8_0_f16(p0 + i * pair_bytes);
+                const HVX_Vector v1 = hvx_dequantize_pair_q8_0_f16(p1 + i * pair_bytes);
+                Q6_vscatter_RMVwV((size_t) (tile_base + i * dst_step), pair_region, v_off0, v0);
+                Q6_vscatter_RMVwV((size_t) (tile_base + i * dst_step), pair_region, v_off1, v1);
+            }
+        } else {
+            const HVX_Vector vzero = Q6_V_vzero();
+            for (uint32_t i = 0; i < n_pairs; ++i) {
+                const HVX_Vector v0 = hvx_dequantize_pair_q8_0_f16(p0 + i * pair_bytes);
+                Q6_vscatter_RMVwV((size_t) (tile_base + i * dst_step), pair_region, v_off0, v0);
+                Q6_vscatter_RMVwV((size_t) (tile_base + i * dst_step), pair_region, v_off1, vzero);
+            }
+        }
+    }
+}
+
+// The Q8_0 rows [start_row, end_row) of a V block into the V tiles: the tiles of
+// hvx_dequantize_row_q8_0_f16 on each row followed by hmx_interleave_cols_to_tiles, for
+// head_dim a multiple of 64.
+static inline void fa_q8_0_cols_to_tiles(__fp16 * restrict tiles_out,
+                                         const uint8_t * restrict src,
+                                         uint32_t n_rows,
+                                         uint32_t head_dim,
+                                         size_t src_stride,
+                                         uint32_t n_row_tiles,
+                                         uint32_t start_row,
+                                         uint32_t end_row) {
+    assert(head_dim % 64 == 0);
+
+    const size_t   tile_stride_elms = (size_t) n_row_tiles * HMX_FP16_TILE_N_ELMS;
+    const size_t   tb_step          = 2 * tile_stride_elms;
+    const uint32_t n_pairs          = head_dim / 64;
+    const size_t   pair_bytes       = 2 * sizeof(block_q8_0);
+
+    for (uint32_t r = start_row; r < end_row; r += 2) {
+        const bool      next_row_valid = (r + 1) < end_row && (r + 1) < n_rows;
+        const uint8_t * p0             = src + (size_t) r * src_stride;
+        const uint8_t * p1             = p0 + src_stride;
+
+        const uint32_t r0      = r / HMX_FP16_TILE_N_ROWS;
+        const uint32_t r1_half = (r % HMX_FP16_TILE_N_ROWS) / 2;
+
+        __fp16 * tb0 = tiles_out + (size_t) r0 * HMX_FP16_TILE_N_ELMS;
+
+        if (next_row_valid) {
+#pragma clang loop unroll_count(4)
+            for (uint32_t i = 0; i < n_pairs; ++i) {
+                const HVX_Vector     v0 = hvx_dequantize_pair_q8_0_f16(p0 + i * pair_bytes);
+                const HVX_Vector     v1 = hvx_dequantize_pair_q8_0_f16(p1 + i * pair_bytes);
+                const HVX_VectorPair vp = Q6_W_vshuff_VVR(v1, v0, -2);
+                ((HVX_Vector *) (tb0 + i * tb_step))[r1_half]                    = Q6_V_lo_W(vp);
+                ((HVX_Vector *) (tb0 + i * tb_step + tile_stride_elms))[r1_half] = Q6_V_hi_W(vp);
+            }
+        } else {
+            const HVX_Vector vzero = Q6_V_vzero();
+            for (uint32_t i = 0; i < n_pairs; ++i) {
+                const HVX_Vector     v0 = hvx_dequantize_pair_q8_0_f16(p0 + i * pair_bytes);
+                const HVX_VectorPair vp = Q6_W_vshuff_VVR(vzero, v0, -2);
+                ((HVX_Vector *) (tb0 + i * tb_step))[r1_half]                    = Q6_V_lo_W(vp);
+                ((HVX_Vector *) (tb0 + i * tb_step + tile_stride_elms))[r1_half] = Q6_V_hi_W(vp);
+            }
+        }
+    }
+}
