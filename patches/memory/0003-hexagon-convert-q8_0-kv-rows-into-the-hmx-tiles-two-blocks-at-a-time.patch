+// The delta-network controls of hvx_dequantize_pair_q8_0_f16.
+//
+// vrdelta routes the 64 quants of two Q8_0 blocks (bytes 2..33 and 36..67 of the pair) into
+// bytes 0..63. The table is the route of that mapping through the network, stage by stage from
+// the output back to the input. The other network order of vdelta cannot route it.
+static const uint8_t hvx_q8_0_pair_quants_ctl[128] __attribute__((aligned(128))) = {
+    0x02, 0x02, 0x04, 0x04, 0x02, 0x02, 0x0a, 0x0a, 0x02, 0x02, 0x06, 0x06, 0x02, 0x02, 0x16, 0x16,
+    0x02, 0x02, 0x06, 0x06, 0x02, 0x02, 0x0e, 0x0e, 0x02, 0x02, 0x06, 0x06, 0x02, 0x02, 0x2e, 0x2e,
+    0x04, 0x04, 0x06, 0x06, 0x08, 0x08, 0x0c, 0x0c, 0x04, 0x04, 0x04, 0x04, 0x14, 0x14, 0x1c, 0x1c,
+    0x04, 0x04, 0x04, 0x04, 0x0c, 0x0c, 0x0c, 0x0c, 0x04, 0x04, 0x04, 0x04, 0x4c, 0x4c, 0x5c, 0x5c,
+    0x00, 0x00, 0x00, 0x00, 0x04, 0x04, 0x04, 0x04, 0x00, 0x00, 0x00, 0x00, 0x08, 0x08, 0x08, 0x08,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0x10, 0x10, 0x10,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x20, 0x20, 0x20, 0x20,
+};
+
+// vdelta copies d0 (bytes 0..1) into the halfword lanes 0..31 and d1 (bytes 34..35) into the
+// lanes 32..63. Byte L of the control holds the partner choices of lane L: its own bits, with
+// bits 1 and 5 flipped in the upper half, where the source is byte 34 (0b0100010).
+static const uint8_t hvx_q8_0_pair_scales_ctl[128] __attribute__((aligned(128))) = {
+#define HVX_Q8_0_CTL8(k)                                                                      \
+    ((k) & 0x7E) ^ ((k) >= 64 ? 0x22 : 0), ((k + 1) & 0x7E) ^ ((k) >= 64 ? 0x22 : 0),         \
+        ((k + 2) & 0x7E) ^ ((k) >= 64 ? 0x22 : 0), ((k + 3) & 0x7E) ^ ((k) >= 64 ? 0x22 : 0), \
+        ((k + 4) & 0x7E) ^ ((k) >= 64 ? 0x22 : 0), ((k + 5) & 0x7E) ^ ((k) >= 64 ? 0x22 : 0), \
+        ((k + 6) & 0x7E) ^ ((k) >= 64 ? 0x22 : 0), ((k + 7) & 0x7E) ^ ((k) >= 64 ? 0x22 : 0)
+    HVX_Q8_0_CTL8(0),  HVX_Q8_0_CTL8(8),  HVX_Q8_0_CTL8(16),  HVX_Q8_0_CTL8(24),
+    HVX_Q8_0_CTL8(32), HVX_Q8_0_CTL8(40), HVX_Q8_0_CTL8(48),  HVX_Q8_0_CTL8(56),
+    HVX_Q8_0_CTL8(64), HVX_Q8_0_CTL8(72), HVX_Q8_0_CTL8(80),  HVX_Q8_0_CTL8(88),
+    HVX_Q8_0_CTL8(96), HVX_Q8_0_CTL8(104), HVX_Q8_0_CTL8(112), HVX_Q8_0_CTL8(120)
+#undef HVX_Q8_0_CTL8
+};
+
+// Two consecutive Q8_0 blocks (68 bytes at src: d0, 32 quants, d1, 32 quants) as 64 F16 values
+// in one vector, from one unaligned load and no scalar load (a scalar load from VTCM stalls).
+// The values are those of hvx_dequantize_row_q8_0_f16: a quant is exact in F16, the product of
+// two F16 values is exact in qf32, and the same qf32-to-F16 conversion rounds it. The one
+// exception is the sign of a zero product with a negative or a zero scale, which no quantizer
+// writes. The load reads 128 bytes from src, thus the caller keeps 60 readable bytes after the
+// pair (the VTCM row slot of a KV block has them). The kernel lab measures 66 cycles for a row of
+// 256 values against 656 for hvx_dequantize_row_q8_0_f16 (v79, timing mode).
+static inline HVX_Vector hvx_dequantize_pair_q8_0_f16(const uint8_t * restrict src) {
+    const HVX_Vector w = hvx_vmemu(src);
+    const HVX_Vector q = Q6_V_vrdelta_VV(w, hvx_vmem(hvx_q8_0_pair_quants_ctl));
+    const HVX_Vector h = Q6_Vhf_equals_Vh(Q6_V_lo_W(Q6_Wh_vunpack_Vb(q)));
+    const HVX_Vector d = Q6_V_vdelta_VV(w, hvx_vmem(hvx_q8_0_pair_scales_ctl));
+    return Q6_Vhf_equals_Wqf32(Q6_Wqf32_vmpy_VhfVhf(h, d));
+}
+
 static inline void hvx_dequantize_row_f16_f32(float * restrict dst_ptr, const void * restrict src_ptr, int n) {
     const int nb = n / 32;
     const _Float16 * src = (const _Float16 *) src_ptr;
