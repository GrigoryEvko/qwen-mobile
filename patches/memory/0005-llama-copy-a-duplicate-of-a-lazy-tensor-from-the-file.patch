-        const bool from_mapping = use_mmap || lazy.has(cur);
+        // Without mmap, only the lazy tensor itself stays in the file mapping. A tensor with the same
+        // name and a buffer of its own (a duplicate on a device, for example the tied output of the
+        // token embedding) reads from the file: the lazy range has POSIX_MADV_RANDOM, thus a copy
+        // through the mapping would fault in one page at a time.
+        const bool from_mapping = use_mmap || (lazy.has(cur) && cur->data == nullptr);
 
         if (from_mapping) {
             const auto & mapping = mappings.at(weight->idx);
