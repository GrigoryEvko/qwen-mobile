--- /dev/null
+++ b/tests/test-lazy-embd.cpp
@@ -0,0 +1,121 @@
+// The lazy token embedding of qwen35: with LLAMA_LAZY_MODE_ON the loader keeps token_embd.weight in
+// a file mapping and reads its rows on demand. The logits must be those of the load that reads the
+// whole tensor, for the load modes NONE (the load of a device with no mmap support) and MMAP.
+
+#include "arg.h"
+#include "common.h"
+#include "ggml-backend.h"
+#include "llama.h"
+
+#include <clocale>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+// Set by the log callback when the loader reports the lazy read of the token embedding.
+static bool g_embd_lazy = false;
+
+static void log_callback(ggml_log_level level, const char * text, void * user_data) {
+    (void) level;
+    (void) user_data;
+    if (std::strstr(text, "token_embd.weight") != nullptr && std::strstr(text, "lazy read enabled") != nullptr) {
+        g_embd_lazy = true;
+    }
+}
+
+// Load the model with one load mode and one lazy mode, decode a prompt of 12 tokens in one batch,
+// then 4 tokens one at a time, and return the logits of each step. An empty result is a failure.
+static std::vector<float> run(const std::string & path, llama_load_mode load_mode, llama_lazy_mode lazy_mode) {
+    llama_model_params mparams = llama_model_default_params();
+    mparams.n_gpu_layers = 0;
+    mparams.load_mode    = load_mode;
+    mparams.lazy_mode    = lazy_mode;
+    llama_model * model = llama_model_load_from_file(path.c_str(), mparams);
+    if (model == nullptr) {
+        fprintf(stderr, "run : failed to load the model\n");
+        return {};
+    }
+
+    llama_context_params cparams = llama_context_default_params();
+    cparams.n_ctx     = 64;
+    cparams.n_batch   = 16;
+    cparams.n_ubatch  = 16;
+    cparams.n_seq_max = 1;
+    llama_context * ctx = llama_init_from_model(model, cparams);
+    if (ctx == nullptr) {
+        fprintf(stderr, "run : failed to create the context\n");
+        llama_model_free(model);
+        return {};
+    }
+
+    const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    std::vector<float> out;
+    llama_batch batch = llama_batch_init(16, 0, 1);
+    bool ok = true;
+
+    for (int i = 0; i < 12; ++i) {
+        common_batch_add(batch, (llama_token) ((i * 7 + 3) % n_vocab), i, { 0 }, i == 11);
+    }
+    ok = llama_decode(ctx, batch) == 0;
+    for (int step = 0; ok && step < 5; ++step) {
+        const float * logits = llama_get_logits_ith(ctx, -1);
+        out.insert(out.end(), logits, logits + n_vocab);
+        if (step == 4) {
+            break;
+        }
+        common_batch_clear(batch);
+        common_batch_add(batch, (llama_token) ((step * 13 + 5) % n_vocab), 12 + step, { 0 }, true);
+        ok = llama_decode(ctx, batch) == 0;
+    }
+
+    llama_batch_free(batch);
+    llama_free(ctx);
+    llama_model_free(model);
+    if (!ok) {
+        fprintf(stderr, "run : a decode failed\n");
+        return {};
+    }
+    return out;
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+
+    common_params params;
+    common_init();
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_COMMON)) {
+        return 1;
+    }
+    ggml_backend_load_all();
+    llama_log_set(log_callback, nullptr);
+
+    int failures = 0;
+
+    const std::vector<float> ref = run(params.model.path, LLAMA_LOAD_MODE_NONE, LLAMA_LAZY_MODE_OFF);
+    if (ref.empty()) {
+        return 1;
+    }
+    if (g_embd_lazy) {
+        fprintf(stderr, "%s : the token embedding was lazy with LLAMA_LAZY_MODE_OFF\n", __func__);
+        failures++;
+    }
+
+    const llama_load_mode modes[] = { LLAMA_LOAD_MODE_NONE, LLAMA_LOAD_MODE_MMAP };
+    for (llama_load_mode mode : modes) {
+        g_embd_lazy = false;
+        const std::vector<float> got = run(params.model.path, mode, LLAMA_LAZY_MODE_ON);
+        const char * name = mode == LLAMA_LOAD_MODE_NONE ? "none" : "mmap";
+        if (!g_embd_lazy) {
+            fprintf(stderr, "%s : load mode %s: the token embedding was not lazy with LLAMA_LAZY_MODE_ON\n", __func__, name);
+            failures++;
+        }
+        if (got.size() != ref.size() || std::memcmp(got.data(), ref.data(), ref.size() * sizeof(float)) != 0) {
+            fprintf(stderr, "%s : load mode %s: the logits with the lazy embedding differ\n", __func__, name);
+            failures++;
+        }
+    }
+
+    fprintf(stderr, "%s : %s\n", __func__, failures == 0 ? "OK" : "FAILED");
+    return failures == 0 ? 0 : 1;
+}
