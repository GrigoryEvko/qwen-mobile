--- /dev/null
+++ b/tests/test-output-limit.cpp
@@ -0,0 +1,87 @@
+// The output limit of a context: llama_decode refuses a batch that asks for more logits rows
+// than n_outputs_max with an error code, keeps the memory as it was, and then accepts a batch
+// inside the limit.
+
+#include "arg.h"
+#include "common.h"
+#include "ggml-backend.h"
+#include "llama.h"
+
+#include <clocale>
+#include <cstdio>
+
+// A batch of n tokens of sequence 0 from position pos0. Each token asks for logits.
+static int decode_all_rows(llama_context * ctx, llama_pos pos0, int n) {
+    llama_batch batch = llama_batch_init(n, 0, 1);
+    for (int i = 0; i < n; ++i) {
+        common_batch_add(batch, (llama_token) (i + 1), pos0 + i, { 0 }, true);
+    }
+    const int rc = llama_decode(ctx, batch);
+    llama_batch_free(batch);
+    return rc;
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+
+    common_params params;
+    common_init();
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_COMMON)) {
+        return 1;
+    }
+    ggml_backend_load_all();
+
+    llama_model_params mparams = common_model_params_to_llama(params);
+    llama_model * model = llama_model_load_from_file(params.model.path.c_str(), mparams);
+    if (model == nullptr) {
+        fprintf(stderr, "%s : failed to load the model\n", __func__);
+        return 1;
+    }
+
+    const uint32_t n_outputs_max = 5;
+
+    llama_context_params cparams = llama_context_default_params();
+    cparams.n_ctx         = 64;
+    cparams.n_batch       = 16;
+    cparams.n_ubatch      = 16;
+    cparams.n_seq_max     = 1;
+    cparams.n_outputs_max = n_outputs_max;
+    llama_context * ctx = llama_init_from_model(model, cparams);
+    if (ctx == nullptr) {
+        fprintf(stderr, "%s : failed to create the context\n", __func__);
+        llama_model_free(model);
+        return 1;
+    }
+
+    int failures = 0;
+
+    const int rc_over = decode_all_rows(ctx, 0, (int) n_outputs_max + 1);
+    if (rc_over != -1) {
+        fprintf(stderr, "%s : a batch of %u rows gave %d, expected -1\n", __func__, n_outputs_max + 1, rc_over);
+        failures++;
+    }
+
+    const llama_pos pos_max = llama_memory_seq_pos_max(llama_get_memory(ctx), 0);
+    if (pos_max != -1) {
+        fprintf(stderr, "%s : the refused batch left position %d in the memory\n", __func__, (int) pos_max);
+        failures++;
+    }
+
+    const int rc_in = decode_all_rows(ctx, 0, (int) n_outputs_max);
+    if (rc_in != 0) {
+        fprintf(stderr, "%s : a batch of %u rows gave %d, expected 0\n", __func__, n_outputs_max, rc_in);
+        failures++;
+    }
+    for (int i = 0; rc_in == 0 && i < (int) n_outputs_max; ++i) {
+        if (llama_get_logits_ith(ctx, i) == nullptr) {
+            fprintf(stderr, "%s : no logits for row %d\n", __func__, i);
+            failures++;
+        }
+    }
+
+    llama_free(ctx);
+    llama_model_free(model);
+
+    fprintf(stderr, "%s : %s\n", __func__, failures == 0 ? "OK" : "FAILED");
+    return failures == 0 ? 0 : 1;
+}
