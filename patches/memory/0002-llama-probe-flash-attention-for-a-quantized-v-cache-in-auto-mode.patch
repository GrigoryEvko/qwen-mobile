--- /dev/null
+++ b/tests/test-kv-quant-auto-fa.cpp
@@ -0,0 +1,75 @@
+// A quantized V cache and the flash attention type of a context: with AUTO the context
+// initializes and decodes when the device of each attention layer runs flash attention, and
+// with DISABLED the context creation fails.
+
+#include "arg.h"
+#include "common.h"
+#include "ggml-backend.h"
+#include "llama.h"
+
+#include <clocale>
+#include <cstdio>
+
+static llama_context * make_ctx(llama_model * model, ggml_type type_kv, llama_flash_attn_type fa) {
+    llama_context_params cparams = llama_context_default_params();
+    cparams.n_ctx           = 64;
+    cparams.n_batch         = 16;
+    cparams.n_ubatch        = 16;
+    cparams.n_seq_max       = 1;
+    cparams.type_k          = type_kv;
+    cparams.type_v          = type_kv;
+    cparams.flash_attn_type = fa;
+    return llama_init_from_model(model, cparams);
+}
+
+// Decode n tokens of sequence 0 with logits for the last one.
+static bool decode_some(llama_context * ctx, int n) {
+    llama_batch batch = llama_batch_init(n, 0, 1);
+    for (int i = 0; i < n; ++i) {
+        common_batch_add(batch, (llama_token) (i + 1), i, { 0 }, i + 1 == n);
+    }
+    const bool ok = llama_decode(ctx, batch) == 0 && llama_get_logits_ith(ctx, -1) != nullptr;
+    llama_batch_free(batch);
+    return ok;
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+
+    common_params params;
+    common_init();
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_COMMON)) {
+        return 1;
+    }
+    ggml_backend_load_all();
+
+    llama_model_params mparams = common_model_params_to_llama(params);
+    llama_model * model = llama_model_load_from_file(params.model.path.c_str(), mparams);
+    if (model == nullptr) {
+        fprintf(stderr, "%s : failed to load the model\n", __func__);
+        return 1;
+    }
+
+    int failures = 0;
+
+    // AUTO: every backend of this test runs flash attention on Q8_0, thus the context initializes.
+    llama_context * ctx_auto = make_ctx(model, GGML_TYPE_Q8_0, LLAMA_FLASH_ATTN_TYPE_AUTO);
+    if (ctx_auto == nullptr || !decode_some(ctx_auto, 8)) {
+        fprintf(stderr, "%s : a Q8_0 KV cache with flash attention AUTO did not initialize and decode\n", __func__);
+        failures++;
+    }
+    llama_free(ctx_auto);
+
+    // DISABLED: a quantized V cannot work without flash attention.
+    llama_context * ctx_off = make_ctx(model, GGML_TYPE_Q8_0, LLAMA_FLASH_ATTN_TYPE_DISABLED);
+    if (ctx_off != nullptr) {
+        fprintf(stderr, "%s : a Q8_0 V cache with flash attention DISABLED initialized\n", __func__);
+        failures++;
+        llama_free(ctx_off);
+    }
+
+    llama_model_free(model);
+
+    fprintf(stderr, "%s : %s\n", __func__, failures == 0 ? "OK" : "FAILED");
+    return failures == 0 ? 0 : 1;
+}
