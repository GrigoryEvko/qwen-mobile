diff --git a/ggml/src/ggml-hexagon/htp/fwht-ops.c b/ggml/src/ggml-hexagon/htp/fwht-ops.c
new file mode 100644
index 0000000..e8e3581
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/fwht-ops.c
@@ -0,0 +1,193 @@
+#pragma clang diagnostic ignored "-Wunused-function"
+
+#include <math.h>
+#include <string.h>
+
+#include "hex-common.h"
+
+#include "hvx-utils.h"
+
+#include "htp-ctx.h"
+#include "htp-ops.h"
+#include "htp-tensor.h"
+
+// The KV cache rotation of llama.cpp as a fast Walsh-Hadamard transform. llama.cpp rotates Q, K and V
+// with a MUL_MAT by a Hadamard matrix (llama_mul_mat_hadamard) and marks that MUL_MAT with the hint
+// GGML_HINT_SRC0_IS_HADAMARD. The host sends such a MUL_MAT as HTP_OP_FWHT. For each row of src1,
+// dst = H src1, with H the n x n Sylvester matrix times 1/sqrt(n). The op does not read src0.
+// The butterflies run in the sequence of the CPU backend (ggml_compute_forward_fwht_f32: the scale
+// first, then the stages of length 1, 2, 4 and more). O(rows * n * log2(n)).
+
+struct htp_fwht_context {
+    struct htp_ops_context * octx;
+    uint32_t                 n;
+    uint32_t                 row_start;
+    uint32_t                 nrows;
+    uint32_t                 nrows_per_thread;
+    HVX_Vector               scale;
+    HVX_Vector               lane_mask[5];  // lane i is all ones when bit s of i is set
+    HVX_Vector               swap_ctl[5];   // the vdelta control of the swap i <-> i XOR 2^s
+};
+
+// One stage of length 2^s (1 to 16 values) in one vector: a lane with bit s clear gets
+// v[i] + v[i + 2^s], a lane with bit s set gets v[i - 2^s] - v[i].
+static inline HVX_Vector fwht_stage(HVX_Vector v, HVX_Vector swap_ctl, HVX_VectorPred q) {
+    const HVX_Vector p   = Q6_V_vdelta_VV(v, swap_ctl);
+    const HVX_Vector sum = hvx_vec_add_f32_f32(v, p);
+    const HVX_Vector dif = hvx_vec_sub_f32_f32(p, v);
+    return Q6_V_vmux_QVV(q, dif, sum);
+}
+
+// Transforms G rows of NV vectors from src to dst in registers. NV and G are constants at each
+// call, thus the array t stays in vector registers.
+static inline __attribute__((always_inline)) void fwht_group(uint8_t * restrict dst, const uint8_t * restrict src,
+                                                             const uint32_t NV, const uint32_t G,
+                                                             const struct htp_fwht_context * fc) {
+    HVX_Vector t[16];
+#pragma clang loop unroll(full)
+    for (uint32_t j = 0; j < NV * G; ++j) {
+        t[j] = hvx_vec_mul_f32_f32(*(const HVX_UVector *) (src + 128 * j), fc->scale);
+    }
+#pragma clang loop unroll(full)
+    for (int s = 0; s < 5; ++s) {
+        const HVX_VectorPred q = Q6_Q_vand_VR(fc->lane_mask[s], 0xffffffff);
+#pragma clang loop unroll(full)
+        for (uint32_t j = 0; j < NV * G; ++j) {
+            t[j] = fwht_stage(t[j], fc->swap_ctl[s], q);
+        }
+    }
+#pragma clang loop unroll(full)
+    for (uint32_t k = 1; k < NV; k <<= 1) {
+#pragma clang loop unroll(full)
+        for (uint32_t r = 0; r < G; ++r) {
+#pragma clang loop unroll(full)
+            for (uint32_t j = 0; j < NV; j += 2 * k) {
+#pragma clang loop unroll(full)
+                for (uint32_t i = j; i < j + k; ++i) {
+                    const HVX_Vector a = t[r * NV + i];
+                    const HVX_Vector b = t[r * NV + i + k];
+                    t[r * NV + i]      = hvx_vec_add_f32_f32(a, b);
+                    t[r * NV + i + k]  = hvx_vec_sub_f32_f32(a, b);
+                }
+            }
+        }
+    }
+#pragma clang loop unroll(full)
+    for (uint32_t j = 0; j < NV * G; ++j) {
+        *(HVX_UVector *) (dst + 128 * j) = t[j];
+    }
+}
+
+// Transforms the rows [r0, r1) of n values each. Groups of 16 vectors (2 rows of 256, 4 rows of 128,
+// 8 rows of 64) go through the stages together.
+static void fwht_rows(uint8_t * dst, const uint8_t * src, uint32_t n, uint32_t r0, uint32_t r1,
+                      const struct htp_fwht_context * fc) {
+    const size_t row = (size_t) n * sizeof(float);
+    uint32_t     r   = r0;
+    if (n == 256) {
+        for (; r + 2 <= r1; r += 2) {
+            fwht_group(dst + r * row, src + r * row, 8, 2, fc);
+        }
+        for (; r < r1; ++r) {
+            fwht_group(dst + r * row, src + r * row, 8, 1, fc);
+        }
+    } else if (n == 128) {
+        for (; r + 4 <= r1; r += 4) {
+            fwht_group(dst + r * row, src + r * row, 4, 4, fc);
+        }
+        for (; r < r1; ++r) {
+            fwht_group(dst + r * row, src + r * row, 4, 1, fc);
+        }
+    } else {
+        for (; r + 8 <= r1; r += 8) {
+            fwht_group(dst + r * row, src + r * row, 2, 8, fc);
+        }
+        for (; r < r1; ++r) {
+            fwht_group(dst + r * row, src + r * row, 2, 1, fc);
+        }
+    }
+}
+
+static void fwht_thread(unsigned int nth, unsigned int ith, void * data) {
+    const struct htp_fwht_context * fc   = (const struct htp_fwht_context *) data;
+    struct htp_ops_context *        octx = fc->octx;
+    const uint32_t r0 = fc->row_start + fc->nrows_per_thread * ith;
+    const uint32_t r1 = MIN(r0 + fc->nrows_per_thread, fc->row_start + fc->nrows);
+    if (r0 >= r1) {
+        return;
+    }
+    fwht_rows((uint8_t *) octx->dst->data, (const uint8_t *) octx->src[1]->data, fc->n, r0, r1, fc);
+    (void) nth;
+}
+
+// True when the rows of t are packed: nb[0] is one float and each stride is the stride of the
+// dimension before it times its count.
+static bool fwht_rows_packed(const struct htp_tensor * t, uint32_t n) {
+    return t->nb[0] == sizeof(float) && t->nb[1] == n * sizeof(float) && t->nb[2] == t->nb[1] * t->ne[1] &&
+           t->nb[3] == t->nb[2] * t->ne[2];
+}
+
+int op_fwht(struct htp_ops_context * octx) {
+    const struct htp_tensor * src = octx->src[1];
+    const struct htp_tensor * dst = octx->dst;
+
+    // The host sends only an F32 MUL_MAT with packed rows of 64, 128 or 256 values as this op
+    // (ggml_hexagon_is_fwht). These checks refuse a different descriptor, because the op writes
+    // ne[1] * ne[2] * ne[3] rows of src1 into dst.
+    if (src->type != HTP_TYPE_F32 || dst->type != HTP_TYPE_F32) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    const uint32_t n = src->ne[0];
+    if (n != 64 && n != 128 && n != 256) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if (dst->ne[0] != n || dst->ne[1] != src->ne[1] || dst->ne[2] != src->ne[2] || dst->ne[3] != src->ne[3] ||
+        !fwht_rows_packed(src, n) || !fwht_rows_packed(dst, n)) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if (octx->flags & HTP_OPFLAGS_SKIP_COMPUTE) {
+        return HTP_STATUS_OK;
+    }
+
+    const uint32_t nr        = src->ne[1] * src->ne[2] * src->ne[3];
+    uint32_t       row_start = 0;
+    uint32_t       nrows     = nr;
+    if (octx->ctx->mdev.count > 1) {
+        const struct htp_tensor_mdev_range range =
+            htp_tensor_mdev_partition(nr, 0, octx->ctx->mdev.idx, octx->ctx->mdev.count, &octx->ctx->mdev.count_div);
+        row_start = range.start;
+        nrows     = range.count;
+    }
+    if (nrows == 0) {
+        return HTP_STATUS_OK;
+    }
+
+    struct htp_fwht_context fc;
+    fc.octx      = octx;
+    fc.n         = n;
+    fc.row_start = row_start;
+    fc.nrows     = nrows;
+    fc.scale     = hvx_vec_splat_f32(1.0f / sqrtf((float) n));
+    for (int s = 0; s < 5; ++s) {
+        uint32_t m[32] __attribute__((aligned(128)));
+        uint8_t  c[128] __attribute__((aligned(128)));
+        for (int i = 0; i < 32; ++i) {
+            m[i] = (i & (1 << s)) ? 0xffffffffu : 0u;
+        }
+        memset(c, 4 << s, sizeof(c));
+        fc.lane_mask[s] = *(const HVX_Vector *) m;
+        fc.swap_ctl[s]  = *(const HVX_Vector *) c;
+    }
+
+    // A decode step has 2 to 64 rows: one thread and no work queue. A prefill block divides its
+    // rows between the threads.
+    const uint32_t n_threads = nrows >= 256 ? octx->n_threads : 1;
+    if (n_threads <= 1) {
+        fc.nrows_per_thread = nrows;
+        fwht_thread(1, 0, &fc);
+    } else {
+        fc.nrows_per_thread = (nrows + n_threads - 1) / n_threads;
+        work_queue_run(octx->ctx->work_queue, fwht_thread, &fc, n_threads);
+    }
+    return HTP_STATUS_OK;
+}
