+// Returns true when each row of t follows the row before it with no space: nb[0] is the size of one
+// value, and each stride is the stride of the dimension before it times its count. The DSP op
+// HTP_OP_FWHT requires this layout. ggml_is_contiguous permits any stride for a dimension of size 1.
+static bool ggml_hexagon_rows_packed(const struct ggml_tensor * t) {
+    return t->nb[0] == ggml_type_size(t->type) && t->nb[1] == t->nb[0] * t->ne[0] &&
+           t->nb[2] == t->nb[1] * t->ne[1] && t->nb[3] == t->nb[2] * t->ne[2];
+}
+
+// The largest count of values (rows times n) of a rotation with rows of 128 or 256 values that the DSP
+// runs as HTP_OP_FWHT. Rows of 64 values have no limit. Refer to ggml_hexagon_is_fwht.
+static constexpr int64_t GGML_HEXAGON_FWHT_MAX_VALUES = 8192;
+
+// Returns true for a MUL_MAT by the Hadamard matrix of llama.cpp (the hint GGML_HINT_SRC0_IS_HADAMARD)
+// that the DSP runs as a fast Walsh-Hadamard transform (HTP_OP_FWHT, htp/fwht-ops.c). The op does not
+// read src0. It takes F32 src1 and dst with packed rows of 64, 128 or 256 values.
+//
+// The limit of the row count comes from the phone (HTP0, the profile of the 2B and the 4B at the
+// depths 16 to 16384). For rows of 64 values the op is as fast as the MUL_MAT or faster at each
+// measured count (8 to 65536 rows). For rows of 256 values the op takes 2 to 13 us from 2 to 32 rows,
+// against 8 to 19 us for the MUL_MAT. From 64 rows the HMX MUL_MAT is faster: 17.5 against 19 us at
+// 64 rows, 452 against 594 us at 8192 rows. Thus the limit is 32 rows of 256 values (8192 values),
+// which holds each decode step (2 to 16 rows). Rows of 128 values get the same count of values. A
+// different MUL_MAT stays HTP_OP_MUL_MAT, which multiplies by the matrix.
+static bool ggml_hexagon_is_fwht(const struct ggml_tensor * t) {
+    if (t->op != GGML_OP_MUL_MAT || ggml_get_op_params_i32(t, 1) != GGML_HINT_SRC0_IS_HADAMARD) {
+        return false;
+    }
+    const struct ggml_tensor * src1 = t->src[1];
+    const int64_t              n    = src1->ne[0];
+    if (src1->type != GGML_TYPE_F32 || t->type != GGML_TYPE_F32 || t->ne[0] != n) {
+        return false;
+    }
+    if (!ggml_hexagon_rows_packed(src1) || !ggml_hexagon_rows_packed(t)) {
+        return false;
+    }
+    if (n == 64) {
+        return true;
+    }
+    return (n == 128 || n == 256) && ggml_nelements(src1) <= GGML_HEXAGON_FWHT_MAX_VALUES;
+}
