+void llama_kv_cache_dsv4::set_rs_depth(const llama_ubatch & ubatch) {
+    if (n_rs_seq == 0) {
+        return;
+    }
+
+    // The plan of the ubatch writes plane d from the first n - d tokens of the sequence (n is its
+    // token count in the ubatch), and plane d > n from none of them. Plane n is also correct, but
+    // the limit is n - 1: llama_memory_recurrent cannot roll back a full ubatch, and the two
+    // memories keep one rule for the callers. O(n_seqs_unq * n_tokens).
+    for (uint32_t u = 0; u < ubatch.n_seqs_unq; ++u) {
+        const llama_seq_id seq_id = ubatch.seq_id_unq[u];
+        if (seq_id < 0 || (uint32_t) seq_id >= n_seq_max) {
+            continue;
+        }
+
+        uint32_t n = 0;
+        for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+            n += dsv4_token_has_seq(ubatch, i, seq_id) ? 1 : 0;
+        }
+        rs_depth[seq_id] = std::min(n > 0 ? n - 1 : 0, n_rs_seq);
+    }
+}
