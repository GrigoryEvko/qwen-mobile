+void llama_memory_recurrent::set_rs_depth(const llama_ubatch & ubatch) {
+    if (n_rs_seq == 0) {
+        return;
+    }
+
+    // [TAG_RECURRENT_ROLLBACK_DEPTH]
+    // The graph writes min(n_seq_tokens, K) groups, and group g holds the state after the token
+    // n_seq_tokens - g of this ubatch. Thus group 0 is the state that the next step reads, and
+    // the deepest rollback that the ubatch covers is one less than the count of the groups.
+    const uint32_t groups  = n_rs_seq + 1;
+    const uint32_t written = std::min<uint32_t>(ubatch.n_seq_tokens, groups);
+
+    for (uint32_t s = 0; s < ubatch.n_seqs; ++s) {
+        const uint32_t i = s * ubatch.n_seq_tokens; // first token of sequence set s
+
+        for (int32_t j = 0; j < ubatch.n_seq_id[i]; ++j) {
+            const llama_seq_id seq_id = ubatch.seq_id[i][j];
+
+            if (seq_id >= 0 && (size_t) seq_id < rs_depth.size()) {
+                rs_depth[seq_id] = written - 1;
+            }
+        }
+    }
+}
+
 void llama_memory_recurrent::set_rs_idx(llama_seq_id seq_id, uint32_t idx) {
     if (seq_id < 0) {
         std::fill(rs_idx.begin(), rs_idx.end(), 0);
@@ -872,6 +916,13 @@ void llama_memory_recurrent::state_read(llama_io_read_i & io, llama_seq_id seq_i
 
     if (n_rs_seq != 0) {
         set_rs_idx(seq_id, 0);
+        // [TAG_RECURRENT_ROLLBACK_DEPTH] the load writes group 0 only, thus the groups above it
+        // keep the history of this context and no rollback can read them.
+        if (seq_id < 0) {
+            std::fill(rs_depth.begin(), rs_depth.end(), 0);
+        } else if ((size_t) seq_id < rs_depth.size()) {
+            rs_depth[seq_id] = 0;
+        }
     }
 }
 
@@ -1261,6 +1312,7 @@ bool llama_memory_recurrent_context::apply() {
     }
 
     mem->find_slot(ubatches[i_next]);
+    mem->set_rs_depth(ubatches[i_next]);
 
