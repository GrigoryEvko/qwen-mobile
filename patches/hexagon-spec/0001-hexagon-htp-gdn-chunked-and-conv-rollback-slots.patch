diff -urN A/ggml/src/ggml-hexagon/htp/gdn-step.h B/ggml/src/ggml-hexagon/htp/gdn-step.h
--- A/ggml/src/ggml-hexagon/htp/gdn-step.h	1970-01-01 03:00:00.000000000 +0300
+++ B/ggml/src/ggml-hexagon/htp/gdn-step.h	2026-09-20 04:58:58.023975546 +0300
@@ -0,0 +1,41 @@
+// One token of the gated delta rule, on one (sequence, head) row.
+//
+// The sequential kernel of gated-delta-net-ops.c and the tail of the chunked kernel of
+// gdn-chunk-ops.c run the same recurrence, thus one function holds it. The chunked kernel takes
+// chunks of tokens, and the last tokens of a batch need one snapshot of the state each. A chunk
+// gives the state at its boundary only, thus the chunked kernel stops before those tokens and
+// this function does them one by one.
+//
+// The state buffer is transposed, as the state tensor and the snapshot region of the output are:
+//   state[j * S_v + i] = S[i][j], i the key index, j the value index.
+// Thus row j of the buffer is column j of S, and the buffer goes to DDR without a transpose.
+
+#ifndef GDN_STEP_H
+#define GDN_STEP_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+// Applies one token to the state and writes the attention output of that token.
+//
+// The recurrence of token t, with a the decay, k the key, v the value, q the query and beta:
+//   S    = diag(a) S          (a is one value, or one value for each key index with KDA)
+//   d[j] = beta (v[j] - sum_i S[i][j] k[i])
+//   S    = S + k d^T
+//   o[j] = scale sum_i S[i][j] q[i]
+// The state that the function leaves is the state after the token.
+//
+// state:    [S_v * S_v] f32, transposed, in VTCM. The function reads and writes it
+// q_t, k_t: [S_v] f32, the query and the key of the token, in VTCM or in DDR
+// v_t:      [S_v] f32, the value of the token
+// g_t:      the log decay: one value, or [S_v] values when kda is true
+// beta_val: beta of the token
+// attn_out: [S_v] f32, the attention output of the token
+// S_v:      the head size, a maximum of HTP_GDN_MAX_SV
+// kda:      true when the gate is one value for each key index
+// scale:    1 / sqrt(S_v)
+void gdn_step_token_f32(float * restrict state, const float * restrict q_t, const float * restrict k_t,
+                        const float * restrict v_t, const float * restrict g_t, float beta_val,
+                        float * restrict attn_out, uint32_t S_v, bool kda, float scale);
+
+#endif // GDN_STEP_H
