diff --git a/src/llama-cparams.h b/src/llama-cparams.h
index b592de1..68bb782 100644
--- a/src/llama-cparams.h
+++ b/src/llama-cparams.h
@@ -65,3 +65,34 @@ struct llama_cparams {
 
     llama_context * ctx_other;
 };
+
+// [TAG_RECURRENT_ROLLBACK_DEPTH]
+// The count of recurrent snapshot groups that the graph of one ubatch writes.
+//
+// A context with n_rs_seq > 0 keeps n_rs_seq + 1 groups of the recurrent state of each sequence,
+// thus a partial llama_memory_seq_rm undoes up to n_rs_seq tokens with no replay. Group g holds
+// the state after the token n_seq_tokens - g of the ubatch that wrote it.
+//
+// A verify step of speculative decoding submits one token for each drafted token, plus the token
+// of the step before it. Thus it never holds more than n_rs_seq + 1 tokens of one sequence,
+// because common_params_speculative::need_n_rs_seq() sets n_rs_seq to the largest draft. A ubatch
+// that holds more tokens of one sequence is a prompt, and no rollback reaches into it. Such a
+// ubatch writes one group.
+//
+// Two properties make this safe:
+//   - The value depends on the shape of the ubatch only. llm_graph_params::allow_reuse compares
+//     n_seq_tokens, thus a graph that comes from the cache always carries the value of its own
+//     ubatch.
+//   - llama_memory_recurrent::set_rs_depth calls this function as well. Thus a rollback that
+//     reaches a group which the last ubatch did not write makes llama_memory_seq_rm return false,
+//     and the caller replays the tokens or restores a checkpoint instead.
+//
+// On the Hexagon backend the count also selects the kernel of a batch: the chunked delta rule on
+// the HMX and the fused conv chunk both take one group only.
+static inline uint32_t llama_n_rs_groups(uint32_t n_rs_seq, uint32_t n_seq_tokens) {
+    if (n_rs_seq == 0) {
+        return 1;
+    }
+
+    return n_seq_tokens > n_rs_seq + 1 ? 1 : n_rs_seq + 1;
+}
