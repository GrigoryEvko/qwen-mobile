+    // [TAG_RECURRENT_ROLLBACK_DEPTH]
+    // The recurrent layers of this ubatch write llama_n_rs_groups() snapshot groups, and each
+    // model graph reads that count from cparams.n_rs_seq. The copy that the graph gets therefore
+    // carries the count of this ubatch. The context member keeps the count of the whole memory,
+    // which llama_n_rs_seq() reports and which sizes the cache, thus neither the cache nor the
+    // ubatch split changes.
+    llama_cparams cparams_gf = cparams;
+
+    cparams_gf.n_rs_seq = llama_n_rs_groups(cparams.n_rs_seq, ubatch.n_seq_tokens) - 1;
+
     return {
         /*.arch        =*/ model.arch,
